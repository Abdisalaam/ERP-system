@model Accountingsystem.ViewModel.EmployeeSalesDetailsVM


@{
    ViewBag.Title = Accountingsystem.Resources.AdminExterNalEmployee.NewSalesTitle;
    HttpCookie cookie = Request.Cookies["Language"];

}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";

            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


        }
    }

</head>

@using (Html.BeginForm("AddSalesToEmployee", "AdminExternalEmployee", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.NewSalesTitle)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.Ambassador)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedExtrnalEmployeeID, Model.ExtrnalEmployeeList, Accountingsystem.Resources.AdminExterNalEmployee.SelectAmbassador, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedExtrnalEmployeeID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.ExistingClient)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedCustomerID, Model.CustomerList, Accountingsystem.Resources.AdminExterNalEmployee.SelectClient, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedCustomerID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.Amount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.CommissionAmount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.CommissionAmount, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.CommissionAmount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.ParentCommissionAmount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.ParentCommissionAmount, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.ClientName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.ClientEmail)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.CustomerEmail, new { htmlAttributes = new { @class = "form-control mb-4" } })

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.ClientPhoneNumber)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.CustomerMobileNumber, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.Comment)
                                    @Html.TextAreaFor(model => model.Comment, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.AdminExterNalEmployee.NewSale <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                       
                        <a id="backToListBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("IndexOfAllSales")'>
                            @Accountingsystem.Resources.List.CommissionsSales
                            <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

}

@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>



        }
    }

    <script>
        $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }

            $("#SelectedExtrnalEmployeeID").chosen();
            $("#SelectedExtrnalEmployeeID_chosen").addClass("form-control Dropdownlist-select");
            $("#SelectedCustomerID").chosen();
            $("#SelectedCustomerID_chosen").addClass("form-control Dropdownlist-select");


            return false;
        });
    </script>
    <script>

        $('#Amount').on('input', function () {
            $("#Amount").removeClass("addRequiredFieldToInput");
        });
        $('#CommissionAmount').on('input', function () {
            $("#CommissionAmount").removeClass("addRequiredFieldToInput");
        });

        $('#SelectedExtrnalEmployeeID').on('change', function () {
            $("#SelectedExtrnalEmployeeID_chosen").removeClass("addRequiredFieldToInput");
            $('#SelectedExtrnalEmployeeID_chosen span').css('background', '#ffffff');
            $('#SelectedExtrnalEmployeeID_chosen b').css('background', '#ffffff');
        });
    </script>
    <script>
        $('#offerCreateMasterForm').submit(function () {
                $('#createOfferbtn').prop('disabled', true);
            if ($('#Amount').val() == "" || $('#Amount').val() == null || $('#Amount').val() == 0 || $('#CommissionAmount').val() == "" || $('#CommissionAmount').val() == null || $('#SelectedExtrnalEmployeeID').val() == "" || $('#SelectedExtrnalEmployeeID').val() == null || $('#SelectedExtrnalEmployeeID').val() <= 0) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createExpensesSpinner").hide();
                    if ($('#SelectedExtrnalEmployeeID').val() == "" || $('#SelectedExtrnalEmployeeID').val() == null || $('#SelectedExtrnalEmployeeID').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.AdminExterNalEmployee.AmbassadorRequiredMessage",
                        pos: 'top-center'
                    });
                        $("#SelectedExtrnalEmployeeID_chosen").addClass("addRequiredFieldToInput");
                        $('#SelectedExtrnalEmployeeID_chosen span').css('background', 'red');
                        $('#SelectedExtrnalEmployeeID_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#SelectedExtrnalEmployeeID").offset().top
                    }, 2000);
                    }
                    if ($('#Amount').val() == "" || $('#Amount').val() == null || $('#Amount').val() == 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.AdminExterNalEmployee.AmountIsRequiredMessage",
                        pos: 'top-center'
                    });
                        $("#Amount").addClass("addRequiredFieldToInput");
                        $('#Amount').trigger('focus');
                    }
                    if ($('#CommissionAmount').val() == "" || $('#CommissionAmount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.AdminExterNalEmployee.CommissionAmountRequiredMessage",
                        pos: 'top-center'
                    });
                        $("#CommissionAmount").addClass("addRequiredFieldToInput");
                        $('#CommissionAmount').trigger('focus');
                    }
                    event.preventDefault();

                }

                else {
                $("#createExpensesSpinner").show();

                }

            });

    </script>
}

