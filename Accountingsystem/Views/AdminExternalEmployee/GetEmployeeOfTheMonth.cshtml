@using (Html.BeginForm("GetEmployeeOfTheMonth", "AdminExternalEmployee", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.EmployeeOfTheMonth)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReportsNewmakeSalesProductForCustomer.StartDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReportsNewmakeSalesProductForCustomer.EndDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                     <div class="widget-content widget-content-area br-6">
        
                                         <div class="text-center">
          
                                             @Accountingsystem.Resources.AdminExterNalEmployee.TitleIndex
       
                                         </div>
       
                                         <div class="text-center">
            
                                             <label>@ViewBag.Message</label>
        
                                         </div>
      
                                         <div class="table-responsive mb-4 mt-4">
           
                                             <table id="default-ordering" class="table table-hover non-hover" style="width:100%">               
                                                 <thead>                   
                                                     <tr>                      
                                                         <th>                      
                                                             @Html.DisplayName("#")                      
                                                         </th>                      
                                                         <th>                      
                                                             @Html.DisplayName(Accountingsystem.Resources.ExternalEmployee.Name)                      
                                                         </th>                      
                                                         <th>                      
                                                             @Html.DisplayName(Accountingsystem.Resources.AdminExterNalEmployee.RegistrationDate)                      
                                                         </th>                      
                                                         <th>                      
                                                             @Html.DisplayName(Accountingsystem.Resources.AdminExterNalEmployee.ParentName)                      
                                                         </th>                      
                                                         <th>                      
                                                             @Html.DisplayName(Accountingsystem.Resources.AdminExterNalEmployee.TotalSalesAmount)                      
                                                         </th>                      
                                                         <th>                      
                                                             @Html.DisplayName(Accountingsystem.Resources.AdminExterNalEmployee.TotalSalesCount)                      
                                                         </th>                      
                                                         <th>
                                                         </th>                   
                                                     </tr>               
                                                 </thead>               
                                                 <tbody>
                                                     @foreach (var item in Model.ExtrnalSalesEmployees)
                                                     {
                                                         <tr>
                                                             <td>
                                                                 @count
                                                                 @{count = count + 1;}
                                                             </td>
                                                             <td>
                                                                 @item.Name
                                                             </td>
                                                             <td>
                                                                 @item.RegistedDate.ToString("yyyy/MM/dd ")
                                                             </td>
                                                             @{
                                                                 if (item.ParentID != item.Id)
                                                                 {
                                                                     var childName = "";
                                                                     foreach (var child in Model.ExtrnalSalesEmployees)
                                                                     {
                                                                         if (child.Id == item.ParentID)
                                                                         {
                                                                             childName = child.Name;
                                                                         }
                                                                     }
                                                                     <td>
                                                                         @childName
                                                                     </td>

                                                                 }

                                                                 else
                                                                 {
                                                                     <td>
                                                                         @Html.DisplayName(Accountingsystem.Resources.AdminExterNalEmployee.HasNoParent)
                                                                     </td>

                                                                 }


                                                             }

                                                             <td>
                                                                 @Math.Round(item.TotalAmountBalance, 2, MidpointRounding.AwayFromZero)
                                                             </td>
                                                             <td>
                                                                 @item.TotalCustommersCount
                                                             </td>
                                                             <td>
                                                                 <div class="btn-group">
                                                                     <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                                                         <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                                                     </button>
                                                                     <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                                                         <a href="@Url.Action( "Details", new { id = item.Id})" class="dropdown-item">
                                                                             @Accountingsystem.Resources.OfferPriceMasterIndex.Details
                                                                         </a>
                                                                         <a href="@Url.Action( "Edit", new { id = item.Id})" class="dropdown-item">
                                                                             @Accountingsystem.Resources.OfferPriceMasterIndex.Edit
                                                                         </a>
                                                                     </div>
                                                                 </div>
                                                             </td>
                                                         </tr>
                                                     }
                                                 </tbody>           
                                             </table>       
                                         </div>   
                                     </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.ReportsNewmakeSalesProductForCustomer.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.ReportsNewmakeSalesProductForCustomer.Back<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>

}

