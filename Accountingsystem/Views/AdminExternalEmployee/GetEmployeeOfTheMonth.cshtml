    <script type="text/javascript">
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }           
            var currentDate = new Date();
            var priorDate = new Date().setDate(currentDate.getDate() - 30)
            var _StartDate = flatpickr(document.getElementById('StartDate'), {
                defaultDate: priorDate
            });
            var _EndDate = flatpickr(document.getElementById('EndDate'), {
                defaultDate: currentDate
            });
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });  
            return false;
        });
    </script>
    <script>
        $('#StartDate').on('input', function () {
            $("#StartDate").removeClass("addRequiredFieldToInput");           
        });
        $('#EndDate').on('input', function () {
            $("#EndDate").removeClass("addRequiredFieldToInput");
        });
    </script>
    <script>

            $('#catchReceiptCreateForm').submit(function () {
                if ($('#StartDate').val() == "" || $('#StartDate').val() == null || $('#EndDate').val() == "" || $('#EndDate').val() == null) {
                    $("#createExpensesSpinner").hide();
                    if ($('#StartDate').val() == "" || $('#StartDate').val() == null ) {
                          Snackbar.show({
                            text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.StartDateIsRequiredMessage",
                            pos: 'top-center'
                        });
                        $("#StartDate").addClass("addRequiredFieldToInput");
                        $('#StartDate').trigger('focus');
                    }
                    if ($('#EndDate').val() == "" || $('#EndDate').val() == null ) {
                          Snackbar.show({
                            text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.EndDateIsRequiredMessage",
                            pos: 'top-center'
                        });
                        $("#EndDate").addClass("addRequiredFieldToInput");
                        $('#EndDate').trigger('focus');
                    }
                  
                    event.preventDefault();
                }
                else {
                    $("#createExpensesSpinner").show();
                }
            });
        </script>


