                                @Html.DisplayName(Accountingsystem.Resources.AdminExterNalEmployee.Comment)
                            </div>
                            @Html.TextAreaFor(model => model.Comment, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="table-responsive">
                                <table class="table mb-4">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>@Accountingsystem.Resources.AdminExterNalEmployee.Amount</th>

                                            <th>@Accountingsystem.Resources.AdminExterNalEmployee.SalesDate</th>
                                            <th>@Accountingsystem.Resources.AdminExterNalEmployee.ClientName</th>
                                            <th>@Accountingsystem.Resources.AdminExterNalEmployee.ClientEmail</th>
                                            <th>@Accountingsystem.Resources.AdminExterNalEmployee.ClientPhoneNumber</th>
                                            <th></th>
                                        </tr>

                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.EmployeeSalesDetails)
                                        {
                                        <tr>
                                            @{
                                                salesCount = salesCount + 1;
                                            }
                                            <td>@salesCount</td>
                                            <td>@Math.Round(item.Amount, 2, MidpointRounding.AwayFromZero)</td>
                                            <td> @Html.DisplayFor(modelitem => item.SalesDate)</td>
                                            <td> @Html.DisplayFor(modelitem => item.CustommerName)</td>
                                            <td> @Html.DisplayFor(modelitem => item.CustommerEmail)</td>
                                            <td> @Html.DisplayFor(modelitem => item.CustommerMobileNumber)</td>
                                            <td>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                                    </button>
                                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                                        <a href="@Url.Action( "SalesDetails", new { id = item.Id})" class="dropdown-item">
                                                            @Accountingsystem.Resources.OfferPriceMasterIndex.Details
                                                        </a>
                                                        <a href="@Url.Action( "EditSale", new { id = item.Id})" class="dropdown-item">
                                                            @Accountingsystem.Resources.OfferPriceMasterIndex.Edit
                                                        </a>
                                                        <a href="@Url.Action( "DeleteSale", new { id = item.Id})" class="dropdown-item">
                                                            @Accountingsystem.Resources.OfferPriceMasterIndex.Delete
                                                        </a>
                                                    </div>
                                                </div>

