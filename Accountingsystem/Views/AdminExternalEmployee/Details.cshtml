@model Accountingsystem.Models.ExtrnalSalesEmployee

@{
    ViewBag.Title = Accountingsystem.Resources.AdminExterNalEmployee.TitleDetails;
    HttpCookie cookie = Request.Cookies["Language"];
    var paymentsCount = 0;
    var salesCount = 0;
}
