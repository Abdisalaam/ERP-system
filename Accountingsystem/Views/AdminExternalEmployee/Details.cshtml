        <div class="row layout-top-spacing">
            <div class="col-md-4">
                <div class="form-group">
                    <a id="editBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("Edit" , new { id = Model.Id})'>
                        @Accountingsystem.Resources.OfferPriceMasterDetails.Edit
                        <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                    <a id="newPaymentBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("AddPaymentToEmployee" , new { empID = Model.Id})'>
                        @Accountingsystem.Resources.AdminExterNalEmployee.NewPayment
                        <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                   
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <a id="createNewOfferBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("Create")'>
                        @Accountingsystem.Resources.AdminExterNalEmployee.NewAmbassador
                        <span id="createNewOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                    @if (Model.ParentID != Model.Id)
                    {
                        <a id="newPaymentBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("Details" , new { id = Model.ParentID})'>
                            @Accountingsystem.Resources.AdminExterNalEmployee.ParentName
                            <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    }
                    <a id="newSaleBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("AddSalesToEmployee" , new { empID = Model.Id})'>
                        @Accountingsystem.Resources.AdminExterNalEmployee.NewSale
                        <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @{

                        if (!string.IsNullOrEmpty(Model.MobileNumber))
                        {
                            if (Model.MobileNumber.Contains(" "))
                            {
                                Model.MobileNumber = Model.MobileNumber.Replace(" ", string.Empty);
                            }
                            if (Model.MobileNumber.Contains("-"))
                            {
                                Model.MobileNumber = Model.MobileNumber.Replace("-", string.Empty);
                            }
                            if (Model.MobileNumber.Contains("#"))
                            {
                                Model.MobileNumber = Model.MobileNumber.Replace("#", string.Empty);
                            }
                            if (!Model.MobileNumber.StartsWith("0") && Model.MobileNumber.Length == 9)
                            {
                                var phoneNumber = "966";
                                phoneNumber += Model.MobileNumber;
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@phoneNumber" target="_blank">

                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />


                                </a>
                            }

                            if (Model.MobileNumber.StartsWith("0") && Model.MobileNumber.Length == 10)
                            {
                                var phoneNumber = "966";
                                phoneNumber += Model.MobileNumber.Remove(0, 1);
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@phoneNumber" target="_blank">
                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />

                                </a>
                            }
                            if (Model.MobileNumber.StartsWith("00") && Model.MobileNumber.Length > 13)
                            {
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@Model.MobileNumber" target="_blank">
                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />
                                </a>
                            }
                            if (Model.MobileNumber.StartsWith("+966") && Model.MobileNumber.Length >= 12)
                            {
                                Model.MobileNumber = Model.MobileNumber.Remove(0, 1);
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@Model.MobileNumber" target="_blank">
                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />
                                </a>
                            }
                            if (Model.MobileNumber.StartsWith("966") && Model.MobileNumber.Length >= 12)
                            {
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@Model.MobileNumber" target="_blank">

                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />
                                </a>
                            }
                        }
                    }
                    <a id="backToListBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.List.CommissionsIndex
                        <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {

    <script>

        $("#childeringsDetailList").load('@(Url.Action("AllChilderingsIndex", "AdminExternalEmployee"))?empID=' + @Model.Id);
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });

    </script>
}


