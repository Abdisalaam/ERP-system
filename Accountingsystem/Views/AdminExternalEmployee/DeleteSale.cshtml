@model Accountingsystem.Models.EmployeeSalesDetails

@{
    ViewBag.Title = Accountingsystem.Resources.AdminExterNalEmployee.DeleteSale;
    HttpCookie cookie = Request.Cookies["Language"];

}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";


        }
    }

</head>

@using (Html.BeginForm("DeleteSale", "AdminExternalEmployee", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ExtrnalSalesEmployeeId)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.DeleteSale)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.TheCurrentAmbassador)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.ExtrnalSalesEmployee.Name, new { htmlAttributes = new { @class = "form-control mb-4" } })

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExternalEmployee.Email)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.ExtrnalSalesEmployee.Email, new { htmlAttributes = new { @class = "form-control mb-4" } })

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExternalEmployee.MobileNumber)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.ExtrnalSalesEmployee.MobileNumber, new { htmlAttributes = new { @class = "form-control mb-4" } })

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.SalesDate)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.SalesDate, new { htmlAttributes = new { @class = "form-control mb-4" } })

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.Amount)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.CommissionAmount)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.CommissionAmount, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.ParentCommissionAmount)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.ParentCommissionAmount, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.ParentName)
                                    <div class="input-group">
                                        @Html.DisplayFor(model => model.ExtrnalSalesEmployee.ParentName, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.AdminExterNalEmployee.Comment)
                                    @Html.TextAreaFor(model => model.Comment, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                                    @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterDelete.Delete <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("IndexOfAllSales")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList
                            <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

}
