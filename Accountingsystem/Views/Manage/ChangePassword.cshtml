@model Accountingsystem.Models.ChangePasswordViewModel
@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.ManageChangePassword.Title;
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

        }
    }


</head>



@using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.ValidationSummary("", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ManageChangePassword.Title)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ManageChangePassword.CurrentPassword)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.OldPassword, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                            <div>
                                                <span class="form-control">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="toggle-password" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.OldPassword, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ManageChangePassword.NewPassword)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.NewPassword, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                            <div>
                                                <span class="form-control">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="toggle-passwordNew" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ManageChangePassword.ConfirmNewPassword)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                            <div>
                                                <span class="form-control">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="toggle-passwordConfirm" class="feather feather-eye"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.BankCreate.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index", "Home")'>
                            @Accountingsystem.Resources.BankCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

}





@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>
        }
    }

    <script type="text/javascript">
        $(document).ready(function () {
            $("#createExpensesSpinner").hide();

        });
    </script>
    <script> 
        document.getElementById('toggle-password').onclick = function () {
            var textObj = document.getElementById("OldPassword");

            if (textObj.type == 'text') {

                textObj.type = "password";

            } else {
                textObj.type = "text";
            }
        };
        document.getElementById('toggle-passwordNew').onclick = function () {
            var textObj = document.getElementById("NewPassword");

            if (textObj.type == 'text') {

                textObj.type = "password";

            } else {
                textObj.type = "text";
            }
        };
        document.getElementById('toggle-passwordConfirm').onclick = function () {
            var textObj = document.getElementById("ConfirmPassword");

            if (textObj.type == 'text') {

                textObj.type = "password";

            } else {
                textObj.type = "text";
            }
        };
    </script>
    <script>

        $('#OldPassword').on('input', function () {
            $("#OldPassword").removeClass("addRequiredFieldToInput");
        });
        $('#NewPassword').on('input', function () {
            $("#NewPassword").removeClass("addRequiredFieldToInput");
        });
        $('#ConfirmPassword').on('input', function () {
            $("#ConfirmPassword").removeClass("addRequiredFieldToInput");
        });

        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });
    </script>
    <script>
        $('#offerCreateMasterForm').submit(function () {
            if ($('#OldPassword').val() == null || $('#OldPassword').val() == "" || $('#NewPassword').val() == null || $('#NewPassword').val() == "" || $('#ConfirmPassword').val() == null || $('#ConfirmPassword').val() == "") {
                if ($('#OldPassword').val() == "" || $('#OldPassword').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ManageChangePassword.CurrentPassRequired",
                        pos: 'top-center'
                    });
                    $("#OldPassword").addClass("addRequiredFieldToInput");
                    $('#OldPassword').trigger('focus');
                }
                if ($('#NewPassword').val() == "" || $('#NewPassword').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ManageChangePassword.NewPasswordRequired",
                        pos: 'top-center'
                    });
                    $("#NewPassword").addClass("addRequiredFieldToInput");
                    $('#NewPassword').trigger('focus');
                }
                if ($('#ConfirmPassword').val() == "" || $('#ConfirmPassword').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ManageChangePassword.ConfirmNewPasswordRequired",
                        pos: 'top-center'
                    });
                    $("#ConfirmPassword").addClass("addRequiredFieldToInput");
                    $('#ConfirmPassword').trigger('focus');
                }

                $("#createExpensesSpinner").hide();
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }

        });
    </script>

}