@model Accountingsystem.ViewModel.RecalPurchInvoiceMasterVM

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Accountingsystem.Resources.RecalPurchInvoiceMasterDetails.EditReturnData</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>@Accountingsystem.Resources.RecalPurchInvoiceMasterDetails.Edit</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(model => model, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EnumDropDownListFor(model => model.PI_State, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.PI_State, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value=@Accountingsystem.Resources.RecalPurchInvoiceMasterDetails.Save class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink(Accountingsystem.Resources.RecalPurchInvoiceMasterDetails.BackToList, "Index")
</div>
