@model IEnumerable<Accountingsystem.Models.RecallPurchInvDetailsTemp>


<div class="statbox widget box box-shadow">
    <div class="table-responsive">

        <table id="InvoiceMasterDetailList" class="table table-hover" style="width:100%">
            <thead>
                @{decimal tax = 0;
                    decimal TotalAmount = 0;
                    decimal quantity = 0;
                }
                <tr>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Item)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.ItemNumber)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Quantity)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Price)
                    </th>


                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.TotalTaxes)
                    </th>

                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Total)
                    </th>

                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @Html.HiddenFor(modelItem => item.Details_Id)
                    @Html.HiddenFor(modelItem => item.Product_Id)
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Product_Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Product_Code)
                        </td>
                        <td>
                            @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>

                            @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>

                            @Math.Round(item.Detail_total_Tax, 2, MidpointRounding.AwayFromZero)
                        </td>
                        @{ tax += item.Detail_total_Tax;

                        }
                        <td>
                            @Html.DisplayFor(modelItem => item.Detail_Total_Cost)
                            @{ TotalAmount += item.Detail_Total_Cost;
                                quantity += item.Product_Quantity;

                            }
                        <td>
                        <td>
                            <a href='javascript:;' onclick="@("DeleteTemp('"+item.Details_Id+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.OfferPriceMasterDetails.Delete data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                        </td>
                    </tr>
                }
                    <tr>
                        <td>
                            @Accountingsystem.Resources.OfferPriceMasterDetails.Total
                        </td>
                        <td></td>
                        <td>
                            @Math.Round(quantity, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td></td>
                        <td>

                            @Math.Round(tax, 2, MidpointRounding.AwayFromZero)
                        </td>

                        <td>
                            @Math.Round(TotalAmount, 2, MidpointRounding.AwayFromZero)

                        </td>
                        <td></td>
                        <td></td>
                    </tr>
            </tbody>
           

        </table>
        </div>
</div>