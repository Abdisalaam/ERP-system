@model IEnumerable<Accountingsystem.Models.PurchaseDetails>
@{ decimal tax = 0;
    decimal total = 0;
    decimal quantity = 0;
}
<div class="statbox widget box box-shadow">
    <div class="table-responsive">

        <table class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Item)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.ItemNumber)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Quantity)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Price)
                    </th>

                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.TotalTaxes)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Total)
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @Html.HiddenFor(modelItem => item.Details_Id)
                    @Html.HiddenFor(modelItem => item.InvoiceMaster_Id)
                    
                    @Html.HiddenFor(modelItem => item.Product_ID)
                    <tr>
                        <td>
                            @Accountingsystem.Models.Product.GetProdectById(item.Product_ID.Value).Prod_Name
                        </td>
                        <td>
                            @Accountingsystem.Models.Product.GetProdectById(item.Product_ID.Value).Prod_Code
                        </td>
                        <td>
                            @Math.Round(item.Reverse_Quantity, 2, MidpointRounding.AwayFromZero)
                            @{quantity += item.Product_Quantity;}
                        </td>
                        <td>

                            @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>
                            @{tax += item.Reverse_Total_Tax;}

                            @Math.Round(item.Reverse_Total_Tax, 2, MidpointRounding.AwayFromZero)
                        </td>

                        <td>
                            @{total += item.Reverse_Tota_Cost;}

                            @Math.Round(item.Reverse_Tota_Cost, 2, MidpointRounding.AwayFromZero)
                        </td>

                        <td>
                         
                            <div class="col-md-offset-2 col-md-10">

                                <a href='javascript:;' onclick="@("AddDetailToMaster('" + item.Details_Id + "')")" class="btn btn-outline-primary" style="text-decoration:none;">@Accountingsystem.Resources.OfferPriceMasterDetails.Edit</a>
                            </div>
                        </td>
                    </tr>
                }
                <tr>
                    <td>
                        @Accountingsystem.Resources.OfferPriceMasterDetails.Total
                    </td>
                    <td></td>
                    <td>
                        @Math.Round(quantity, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td></td>
                    <td>


                        @Math.Round(tax, 2, MidpointRounding.AwayFromZero)
                    </td>

                    <td>


                        @Math.Round(total, 2, MidpointRounding.AwayFromZero)
                    </td>

                    <td></td>
                </tr>
            </tbody>
           

        </table>
        </div>
    </div>
