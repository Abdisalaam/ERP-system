            var ProductTax =  $("#Product_Tax").val();
            var AssetId =  $("#Asset_Id").val();
            var DetailsId =  $("#Details_Id").val();
            var disc =  $("#Master_Discount").val();

            //var totalAmount= ProductPrice * ProductQuantity;
            //var Detail_Total_Tax = totalAmount * ($("#Product_Tax").val() / 100);
            //var Detail_Total_Cost=totalAmount+Detail_Total_Tax

            var invoiceMasterDetail;
            invoiceMasterDetail = {

                Product_ID:ProductIDs,
                Details_Id:DetailsId,
                Product_Price:ProductPrice,
                Product_Tax:ProductTax,
                Product_Quantity:ProductQuantity,
                dicount:disc,
                RecalPurchInvoiceMasterMaster_Id:RecallInv,
                Asset_Id: AssetId,
                selectedPurchaseInvoice: invoiceMasterIds
                //Total_Amount:totalAmount,
                //Detail_Total_Tax:Detail_Total_Tax,
                //Detail_Total_Cost:Detail_Total_Cost

            };

            $.ajax(
                   {
                       url: '@Url.Action("AddInvoiceDetailsToMaster", "RecalPurchInvoiceMaster")',
                       data: JSON.stringify(invoiceMasterDetail),
                       contentType: 'application/json',
                       dataType: 'json',
