        function AddOrder() {
            var RecallInv=@Model.Master_Id;
            var invoiceMasterIds = $("#selectedPurInvoiceMasterMaster_Id").val();
            var ProductIDs =  $("#Product_ID").val();

            var ProductQuantity =  $("#Product_Quantity").val();
            //var ProductPrice =  $("#Product_Price").val();
