
@model Accountingsystem.Models.InvoiceMaster

@{
    /**/

    ViewBag.Title = Accountingsystem.Resources.InvoiceMasterDetails.InvoiceDetails;
    HttpCookie cookie = Request.Cookies["Language"];
    var package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
}
@{
    decimal TotalAmountbeforeDisc = 0;
    decimal discount = 0;
    decimal AfterDiscount = 0;
    var company = Accountingsystem.Models.Company.GetCompanyById(Model.Company_Id);
    var customer = Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id);
    var store = Accountingsystem.Models.Store.GetStoreById(Model.Store_ID);
    var revenueAccount = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount(Model.RevenueAccount_Id);
    DateTime? operationDate =new DateTime();
    if (Model.QRNumber > 0) {
        operationDate = Accountingsystem.Models.MasterQRInvoice.GetMasterQRInvoiceById(Model.QRNumber.Value).DateOfCreate;
    }
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

        }
    }


</head>

@Html.HiddenFor(model => model.Master_Id)


<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <h3 class="text-center"></h3>
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    <lable class="text-center">@ViewBag.Message</lable>
                    <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                        @Accountingsystem.Resources.InvoiceMasterDetails.InvoiceDetails
                    </div>
                    <hr />
                </div>
            </div>
        </div>

        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceNumber)
                                        </div>
                                        @if (Model.Number == null)
                                        {
                                            <div>
                                                @Html.DisplayFor(model => model.Serial_Number)
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                @Html.DisplayFor(model => model.Number)
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Serial_Number)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceDate)
                                        </div>
                                        <div>
                                            @Model.Invoice_Date.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (operationDate != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.validate.OperationDate)
                                            </div>
                                            <div>
                                                @operationDate.Value.ToString(" HH:mm:ss  dd/MM/yyyy")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Model.QRNumber != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.ProductDetails.Barcode)
                                            </div>
                                            <div>
                                                @*<img src="data:image/jpg;base64,@Convert.ToBase64String(Accountingsystem.Utilites.QRcode.MakeQRcode(Model.QRNumber.Value, Request.Url.ToString()))" alt="Image" style="width:100px" />*@
                                                <img src="data:image/jpg;base64,@Accountingsystem.Models.TLVCls.GenerateInvoiceQRbase(Model.QRNumber.Value)" alt="Image" style="width:100px" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">

                                            </div>
                                            <div>
                                                <img src="data:image/jpg;base64,@Convert.ToBase64String(Accountingsystem.Utilites.QRcode.MakeQRcode(Model.QRNumber.Value, Request.Url.ToString()))" alt="Image" style="width:100px" />

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceCase)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Invoice_State)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.DueDate)
                                        </div>
                                        <div>
                                            @Model.Due_Date.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                    @if (package.Number_Branch > 0)
                    {

                        if (Model.Branch_Id != null && Model.Branch_Id != 0)
                        {
                            var branch = Accountingsystem.Models.SubLedger.getDetail(Model.Branch_Id.Value);
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.BranchName)
                                                </div>
                                                <div>
                                                    @branch.SubLed_Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        if (Model.Department_ID != null && Model.Department_ID != 0)
                        {
                            var branch = Accountingsystem.Models.SubLedger.getDetail(Model.Department_ID.Value);
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Department)
                                                </div>
                                                <div>
                                                    @branch.SubLed_Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }

                        if (Model.BussinesUnit_ID != null && Model.BussinesUnit_ID != 0)
                        {
                            var branch = Accountingsystem.Models.SubLedger.getDetail(Model.BussinesUnit_ID.Value);
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Activity)
                                                </div>
                                                <div>
                                                    @branch.SubLed_Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                    }

                    @{if (Model.Offer_Price_Code != null)
                        {
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">

                                                    @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.OfferPriceNumber)
                                                </div>
                                                <div>
                                                    @Html.DisplayFor(model => model.Offer_Price_Code)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        } }


                    @{if (Model.Reference != null)
                        {
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.BaptismNumber)
                                                </div>
                                                <div>
                                                    @Html.DisplayFor(model => model.Reference)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        } }
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.CustomerNumber)
                                        </div>
                                        <div>
                                            @customer.Customer_Code
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.CustomerName)
                                        </div>
                                        <div>
                                            @customer.Customer_Name
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.RevenueAccountNumber)
                                        </div>
                                        <div>

                                            @{if (revenueAccount != null)
                                                { @revenueAccount.Account_Name} }

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Store)
                                        </div>
                                        <div>
                                            @store.Store_Name
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @{if (Model.Emp_Id != null)
                        {
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.EmployeeName)
                                                </div>
                                                <div>

                                                    @{
                                                        var employee = Accountingsystem.Models.Employee.getEmpById(Model.Emp_Id.Value);
                                                        @employee.Emp_Name
                                                    }

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        } }



                    @if (Model.SubLedger_ID != 0 && Model.SubLedger_ID != null)
                    {
                        var subledger = Accountingsystem.Models.SubLedger.getDetail(Model.SubLedger_ID.Value);
                        if (subledger.SubLed_Type == "مركز تكلفة يدوى" || subledger.SubLed_Type == "مشروع")
                        {
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.CostCenter)
                                                </div>
                                                <div>

                                                    @{if (Model.Branch_Id != null)
                                                        {

                                                            <span>
                                                                @subledger.SubLed_Name

                                                            </span>

                                                        }
                                                    }

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }
                    }


                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="text-center">
                                @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Description)
                            </div>


                            @Html.TextAreaFor(model => model.Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="text-center">
                                @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Notes)
                            </div>

                            @Html.TextAreaFor(model => model.Notes, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                        </div>
                    </div>
                </div>

            </div>

        </div>


        <div class="table-responsive">
            <table class="table mb-4">
                <thead>
                    <tr>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.Item</th>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.ItemNumber</th>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.Quantity</th>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.ItemPrice</th>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.Discount</th>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.DiscountValue</th>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.TotalTax</th>
                        <th>@Accountingsystem.Resources.InvoiceMasterDetails.TotalAmount</th>
                        <th></th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var detail in Model.InvoiceDetails)
                    {
                        <tr>
                            <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_ID).Prod_Name</td>
                            <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_ID).Prod_Code</td>

                            <td>@Math.Round(detail.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero)</td>
                            @if (detail.Detail_Discount > 0)
                            {
                                <td>@Math.Round(detail.Detail_Discount.Value, 2, MidpointRounding.AwayFromZero)</td>
                                <td>@Math.Round(detail.Detail_Discount_Amount.Value, 2, MidpointRounding.AwayFromZero)</td>
                            }
                            else
                            {
                                <td>0</td>
                                <td>0</td>
                            }
                            <td>@Math.Round(detail.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Total_Amount, 2, MidpointRounding.AwayFromZero)</td>
                            @{ TotalAmountbeforeDisc += detail.Product_Quantity * detail.Product_Price;
                                discount += (detail.Product_Quantity * detail.Product_Price) * (Model.Master_Discount / 100);


                            }
                            <td>
                                <a href="@Url.Action("Details", "Product", new { id = detail.Product_ID })" class="btn btn-block btn-outline-primary mb-lg-0">
                                    @Accountingsystem.Resources.ProductDetails.ItemDetails
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
        @{

            AfterDiscount = TotalAmountbeforeDisc - discount;
            var payment = Model.TotaL_After_Fixed - Model.TotalAmountAfMat;
        }


        <div class=''>
            <div class="row layout-top-spacing">
                <div class="col-md-12">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Total)
                                    </div>
                                    <div>
                                        @Math.Round(TotalAmountbeforeDisc, 2, MidpointRounding.AwayFromZero)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                @if (Model.Master_Discount > 0)
                {
                    <div class="col-md-12">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Accountingsystem.Resources.InvoiceMasterDetails.Discount   @Math.Round(Model.Master_Discount, 2, MidpointRounding.AwayFromZero) %
                                        </div>
                                        <div>
                                            @Math.Round(discount, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
                @if (Model.Total_Tax > 0)
                {
                    <div class="col-md-12">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.TotalTax)
                                        </div>
                                        <div>
                                            @Math.Round(Model.Total_Tax, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
                @if (Model.InvoiceTaxes != null)
                {
                    foreach (var taxo in Model.InvoiceTaxes)
                    {
                        var taxinfo = Accountingsystem.Models.Tax.GetTaxesbyId(Convert.ToInt32(taxo.Tax_Id));
                        <div class="col-md-12">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @taxinfo.Tax_Name @taxinfo.Tax_Percentage %
                                            </div>
                                            <div>
                                                @Math.Round(taxo.Amount, 2, MidpointRounding.AwayFromZero)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                }
                @if (Model.FixedDiscount != 0 && Model.FixedDiscount != null)
                {
                    <div class="col-md-12">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.AllouwdDiscount)
                                        </div>
                                        <div>
                                            @Math.Round(Model.FixedDiscount.Value, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
                <div class="col-md-12">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.FinalTotal)
                                    </div>
                                    <div>
                                        @Math.Round(Model.TotaL_After_Fixed.Value, 2, MidpointRounding.AwayFromZero)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>


        </div>

        @if (Model.SalesFileDetails.Any())
        {
            <div class="row inv--product-table-section">
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table">
                            <thead class="">
                                <tr>
                                    <th>@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileNumber</th>
                                    <th>@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileName</th>
                                    <th>@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileExtension</th>
                                    <th>@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileLength</th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var file in Model.SalesFileDetails)
                                {
                                    <tr>
                                        <td>@file.Id</td>
                                        <td>@file.FileName</td>
                                        <td>@file.FileType</td>
                                        <td>@file.ContentLength</td>
                                        <td>

                                            <a href='@Url.Action("ReturnInvoicetFile", new { fileId = file.Id })' class="bs-tooltip" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Download" data-original-title="Download">
