@using (Html.BeginForm("EditForPending", "InvoiceMaster", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()


    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Document_Type)
    @Html.HiddenFor(model => model.Master_Id)
    @Html.HiddenFor(model => model.Serial_Number)

    @Html.HiddenFor(model => model.isCopy)
    @Html.HiddenFor(model => model.SelectedCompany_Id)
    @Html.HiddenFor(model => model.SelectedCurrencyId)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                @if (Model.isCopy == 1)
                {
                    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.CreateSalesInvoice)</h3>
                }
                else
                {
                    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.EditSalesInvoice)</h3>
                }
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterDetails.OfferPriceNumber)
                                    <div class="input-group">

                                        @Html.DropDownListFor(model => model.order_Id, Model.OrderList, Accountingsystem.Resources.InvoiceMasterAddNewInvoice.SelectOfferPrice, htmlAttributes: new { @class = "form-control  mb-4 Dropdownlist-select" })
                                        @Html.ValidationMessageFor(model => model.order_Id, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                                    @Html.EditorFor(model => model.Serial_Number, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Serial_Number, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.BaptismNumber)
                                    @Html.EditorFor(model => model.Reference, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Invoice_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Invoice_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.DurationOfOfferInDays)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Payment_Policy, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Payment_Policy, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.EndDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Due_Date, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Due_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.RevenueInformation)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.RevenueAccount_Id, Model.AccountList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.RevenueAccount_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.EmployeeNumber)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Emp_Id, Model.EmpList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListEmployee, htmlAttributes: new { @class = "form-control  mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Emp_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Customer)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedCustomerId, Model.MyCustomerList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListCustomer, htmlAttributes: new { @class = "Dropdownlist-select form-control mb-4" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                            <button id="addNewCustomerBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#customerModal">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedCustomerId, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (package.Number_Branch > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.BranchOrDepartment)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Branch_Id, Model.BranchList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Department)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Department_ID, Model.DepList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenterOrMainDepartment, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Activity)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BussinesUnit_ID, Model.BUList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.ActivityInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_subLedgger > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.CostCenter)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.SubLedger_ID, Model.SubList, Accountingsystem.Resources.InvoiceMasterAddNewInvoice.CostCenterInformation, htmlAttributes: new { @class = "Dropdownlist-select form-control mb-4" })
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_store > 1)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Store)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.SelectedStoreId, Model.MyStoresList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                            <div class="input-group-append">

                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>



                                            </div>
                                            @Html.ValidationMessageFor(model => model.SelectedStoreId, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.AddAttachments</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="list-unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDescriptionInformation)
                                    @Html.TextAreaFor(model => model.Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDescriptionInformation })
                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes)
                                    @Html.TextAreaFor(model => model.Notes, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                                    @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div id="InvoicesDetail" class="col-md-11 mx-auto"></div>
            </div>
            <div id="InvoicesDetailList"></div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPercentage)
                        <div class="input-group mb-4">
                            <input class="form-control mb-4 text-box single-line" data-val="true" data-val-number="The field Master_Discount must be a number." data-val-range="The field Master_Discount must be between 0 and 100." data-val-range-max="100" data-val-range-min="0" data-val-required="The Master_Discount field is required." id="Master_Discount" name="Master_Discount" step="any" type="number" value="@Model.Master_Discount">

                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">%</span>
                                </div>
                                <div>
                                    <span class="form-control text-danger">*</span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.TotalDiscountAmount)
                        <div class="input-group">
                            <input id="masterTotalDiscountAmount" class="form-control mb-4" style="background:#ffffff" />
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                @if (package.ExtraTaxes == true)
                {
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.ExtraTaxes)
                            <div class="input-group">
                                @{
                                    if (cookie != null && cookie.Value != null)
                                    {
                                        if (cookie.Value == "en")
                                        {
                                            @Html.ListBoxFor(model => model.Taxes, Model.TaxList, new Dictionary<string, Object> { { "class", "chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddExtraTaxes }, { "multiple", "true" } })
                                            @Html.ValidationMessageFor(model => model.Taxes, "", new { @class = "text-danger" })

                                        }
                                        else
                                        {
                                            @Html.ListBoxFor(model => model.Taxes, Model.TaxList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddExtraTaxes }, { "multiple", "true" } })
                                            @Html.ValidationMessageFor(model => model.Taxes, "", new { @class = "text-danger" })

                                        }
                                    }
                                    else
                                    {
                                        @Html.ListBoxFor(model => model.Taxes, Model.TaxList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddExtraTaxes }, { "multiple", "true" } })
                                        @Html.ValidationMessageFor(model => model.Taxes, "", new { @class = "text-danger" })

                                    }
                                }




                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(@Accountingsystem.Resources.OfferPriceMasterCreateOffer.TotalTaxexOfExtraTaxes)
                            <div class="input-group">
                                <h3 id="masterTotalTaxesAmount" class="form-control mb-4" style="background:#ffffff"></h3>
                                <div class="input-group-append">
                                    <div>
                                        <span class="form-control">$</span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
                @*<div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountAllowedOnBill)
                            <div class="input-group">
                                @Html.EditorFor(model => model.Fixed_Discount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                @Html.ValidationMessageFor(model => model.Fixed_Discount, "", new { @class = "text-danger" })
                                <div class="input-group-append">

                                    <div>
                                        <span class="form-control">$</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>*@
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.TotalFinal)
                        <div class="input-group">
                            <input id="masterTotalInvoiceAmount" class="form-control mb-4" style="background:#ffffff">
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
            </div>
        </form>
    </div>
    <div id="customerModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddNewCustomer</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="customerPartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-outline-secondary mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>


    <div id="productModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
