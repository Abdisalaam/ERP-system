            var selectedValue = $(this).val();

            $.ajax({

                url: '@Url.Action("GetBussines", "InvoiceMaster")',

                type: 'get',

                data: { code: selectedValue }

                    }).done(function (result) {

                        $("#BussinesUnit_ID").empty();
                       var bussinesSubledgerOptions = new Option("@Accountingsystem.Resources.OfferPriceMasterCreateOffer.SelectActivity", 0);
                        $("#BussinesUnit_ID").append(bussinesSubledgerOptions);
                        for (var i = 0; i < result.length; i++) {
                            var item = result[i];
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#BussinesUnit_ID").append(p);
                        }
                        $('#BussinesUnit_ID').trigger('chosen:updated');

                });
            updateDescribtionAndNotes(selectedValue);
        });
