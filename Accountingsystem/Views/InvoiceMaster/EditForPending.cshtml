@model Accountingsystem.ViewModel.MasterVM
@{
    HttpCookie cookie = Request.Cookies["Language"];
    if (Model.isCopy == 1)
    {
        ViewBag.Title = Accountingsystem.Resources.InvoiceMasterAddNewInvoice.CreateSalesInvoice;
    }
    else
    {
        ViewBag.Title = Accountingsystem.Resources.InvoiceMasterAddNewInvoice.EditSalesInvoice;
    }

    Model.SelectedCompany_Id = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault().Comp_Id;
    Model.SelectedCurrencyId = 1;
    var package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
}

