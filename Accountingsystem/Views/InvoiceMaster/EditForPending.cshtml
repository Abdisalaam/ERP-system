    <script>
        $('#Files').change(function () {
            $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
            $('#selectedtFiles').empty();
            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Files').empty();
                    $('#selectedtFiles').empty();
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.TotalSizeOfSelectedFiles : " + totalConteLength + " " + " @Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Byte " +'</li> ');
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.MaxOfFilesSize" + '.</li> ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                    text: "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileName : " + fileName + '</li> ');
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Byte" +'</li> ');

                }
            }
            $('#selectedtFiles').append('<li>' +"@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Byte" +'</li > ');
        });
    </script>

