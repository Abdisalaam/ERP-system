@model Accountingsystem.ViewModel.EmpVacationVM


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">



    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Employee_Id)
   



  

    <div class="row">

        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.EmployeeGetTheSallaryForAllEmployeeForThatMounth.Vacation)

                <div class="input-group mb-4">
                    @Html.DropDownListFor(model => model.Vacation_TypesId, Model.VacationTypeList, Accountingsystem.Resources.EmployeemakManualGL.SelectVacation, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger"></label>
                        </div>
                       
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.EmployeeGetTheSallaryForAllEmployeeForThatMounth.NumberOfDays)
                @Html.EditorFor(model => model.DaysInyear, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })

            </div>
        </div>

    </div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">

            <a href='javascript:;' onclick='AddVacationToEmployee();' class="btn btn-outline-info mb-2" style="text-decoration:none;">@Accountingsystem.Resources.ReversePOSInvoiceDetails.AddToRegulation</a>
        </div>
    </div>
</div>
}



<script>
    $("#Vacation_TypesId").chosen();
    $("#Vacation_TypesId_chosen").addClass("form-control Dropdownlist-select");
</script>