@model Accountingsystem.ViewModel.Employee_SalesVM

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Employee_ID, new { htmlAttributes = new { @class = "form-control" } })
        <div class="row">
            <div class="col-md-5">
                <div class="col-md-5">
                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Net_Sales, new { htmlAttributes = new { @class = "form-control",@readonly="readonly" } })
                        @Html.ValidationMessageFor(model => model.Net_Sales, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.EmployeeRoleList.NetSales)
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="col-md-5">
                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Target_Sales, new { htmlAttributes = new { @class = "textfield" } })
                        @Html.ValidationMessageFor(model => model.Target_Sales, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.EmployeeRoleList.SalesTarget)
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-5">
                <div class="col-md-5">
                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Collected, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.Collected, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.EmployeeRoleList.Collected)
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="col-md-5">
                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Target_Collected, new { htmlAttributes = new { @class = "textfield" } })
                        @Html.ValidationMessageFor(model => model.Target_Collected, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.EmployeeRoleList.CollectedTarget)
                    </div>
                </div>
            </div>
        </div>
    
    </div>
}

