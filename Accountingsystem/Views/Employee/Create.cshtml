        function AddDetailToMaster() {

            var EmpId = @Model.Emp_Id;
            var Account_Id =  $("#Account_Id").val();
            var Account_Amount =  $("#Account_Amount").val();

            var PurchaseDetailsVM;
            PurchaseDetailsVM = {
                Employee_Id:EmpId,
                Account_Id:Account_Id,
                Account_Amount:Account_Amount,

            };

            $.ajax(
            {
                url: '@Url.Action("AddSalaryDetailsToMaster", "Employee")',
                data: JSON.stringify(PurchaseDetailsVM),
                contentType: 'application/json',
                dataType: 'json',
                type: 'POST',
                success: function (data) {
                    
                    Snackbar.show({
