@model Accountingsystem.ViewModel.RoleCreateVM

@{
    ViewBag.Title = Accountingsystem.Resources.EmployeeAllRoleList.AddRole;
    Layout = "~/Views/Shared/_Layout.cshtml";
}




@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal">
    <h2 class="HEADTITLE-STYLE">@Accountingsystem.Resources.EmployeeAllRoleList.AddRole</h2>
    @Html.HiddenFor(model => model.ID, new { htmlAttributes = new { @class = "form-control" } })
    <h4></h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @Html.Label(Accountingsystem.Resources.EmployeeAllRoleList.RoleName)
        <div class="col-md-2">
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-5">
            <input type="submit" value=@Accountingsystem.Resources.EmployeeAllRoleList.Create class="btn BTN-style final-BTN" />
            <a class="btn BTN-style final-BTN" href='@Url.Action("AllRoleList")'>

                @Accountingsystem.Resources.EmployeeAllRoleList.BackToList

            </a>
        </div>
    </div>
</div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
