    <script>
        $("#BankAccount").chosen();
        $("#BankAccount_chosen").addClass("form-control Dropdownlist-select");
    $("#sallaryList").load('@(Url.Action("GetAllSallaryThatNotExpense", "Employee"))');

    </script>
    <script>


        $('#BankAccount').on('input', function () {
            $("#BankAccount").removeClass("addRequiredFieldToInput");
        });

        var currentDate = new Date();
        var _ExpensesDate = flatpickr(document.getElementById('Date'), {
            defaultDate: currentDate
        });

    </script>
    <script>
        $('#Date').on('change', function (e)
        {
            var selectedValue = $(this).val();
             $.ajax({
                        url: '@Url.Action("CheckStartdate", "GLMaster")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                            var currentDate = new Date();

                            var _OfferDate = flatpickr(document.getElementById('Date'), {
                                defaultDate: currentDate
                            });

                        }
                    }
                    );
            $.ajax({
                url: '@Url.Action("CheckEndDate", "Company")',
                data: { date : selectedValue },
            type: 'get',
            }).done(function (result) {
                if (result == "" || result == null) {

                }
                else {
                    Snackbar.show({
                        text: result,
                        pos: 'top-center'
                    });
                }
            }
            );
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {

            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);

            if ($('#BankAccount').val() == "" || $('#BankAccount').val() == null || $('#Date').val() == "" || $('#Date').val() == null) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($('#BankAccount').val() == "" || $('#BankAccount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.EmployeemakManualGL.SelectPaymentMethod",
                        pos: 'top-center'
                    });
                    $("#BankAccount").addClass("addRequiredFieldToInput");
                    $('#BankAccount').trigger('focus');
                }

                if ($('#Date').val() == "" || $('#Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CatchReceiptCreate.DateIsRquiredMessage",
                        pos: 'top-center'
                    });
                    $("#Date").addClass("addRequiredFieldToInput");
                    $('#Date').trigger('focus');
                }
              



                event.preventDefault();
            }



        });

    </script>

}
