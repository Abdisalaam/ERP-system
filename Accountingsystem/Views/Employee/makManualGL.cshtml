@using (Html.BeginForm("makManualGL", "Employee", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">


        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
            <form id="offerCreateMasterForm">
                <div class="">
                    <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.EmployeemakManualGL.ManualSalaryReceipt)</h3>
                    <hr />
                    <div class="row">
                        <div class="col-md-11 mx-auto">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <a id="backToListBtn" class="btn btn-block btn-outline-info mb-lg-0" href='@Url.Action("EditStatusSalaryforAll")'>
                                            @Accountingsystem.Resources.EmployeemakManualGL.EmployeesCaseExchange<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                                        </a>
                                    </div>
                                    <div class="col-md-12">
                                        <div id="sallaryList"></div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.EmployeemakManualGL.PaymentMethod)
                                            <div class="input-group mb-4">
                                                @Html.DropDownListFor(model => model.BankAccount, Model.AccountList, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                                <div class="input-group-append">
                                                    <div class="form-control">
                                                        <label class="text-danger">*</label>
                                                    </div>

                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.BankAccount, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.CatchReceiptDate)
                                            <div class="input-group">
                                                @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                                <div class="input-group-append">
                                                    <div>
                                                        <span class="form-control text-danger">*</span>
                                                    </div>
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.Description)
                                            @Html.TextAreaFor(model => model.Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.CatchReceiptCreate.Description })
                                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>



                    <div class="col-md-12">
                        <div class="form-group">
                            @*<a id="backToListBtn" class="btn btn-block btn-outline-info mb-lg-0" href='@Url.Action("EditStatusSalaryforAll")'>
                                    @Accountingsystem.Resources.EmployeemakManualGL.EmployeesCaseExchange<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                                </a>*@
                            <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                            @if (Request.IsAuthenticated && !User.IsInRole("بائع"))
                            {
                                <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                                    @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                                </a>
                            }

                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
}



