@model Accountingsystem.ViewModel.Salary_ComponentsVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">

    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Employee_Id)
    @Html.HiddenFor(model => model.Salary_Components_Id)
    @Html.HiddenFor(model => model.Account_Name)
 
    <div class="row">

        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.EmployeeRoleList.Account)

                <div class="input-group mb-4">
                    @Html.DropDownListFor(model => model.Account_Id, Model.AccountList, Accountingsystem.Resources.EmployeeRoleList.SelectAccount, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger"></label>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.EmployeeRoleList.Value)
                @Html.EditorFor(model => model.Account_Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })

            </div>
        </div>

    </div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">

            <a href='javascript:;' onclick='AddDetailToMaster();' class="btn btn-outline-info mb-2" style="text-decoration:none;">@Accountingsystem.Resources.ReversePOSInvoiceDetails.AddToRegulation</a>
        </div>
    </div>

   



</div>
}

<script>
    $("#Account_Id").chosen();
    $("#Account_Id_chosen").addClass("form-control Dropdownlist-select");
</script>
