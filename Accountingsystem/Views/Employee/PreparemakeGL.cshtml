@using (Html.BeginForm("makeGL", "Employee", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))

{
    @Html.AntiForgeryToken()

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>

                <h3 class="text-center"><label> @Accountingsystem.Resources.EmployeeIndex.PaySalariesPreparation</label></h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">

                            @Html.HiddenFor(model => model.date)

                            @{
                                var date = Convert.ToDateTime(Model.date);
                            }




                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.Mounth)
                                    <div class="input-group">
                                        @*@Html.Editor(date, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })*@
                                        <input value=" @date.Month-@date.Year" disabled class="form-control mb-4" />
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        

                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-4 mt-4">
                    <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                        <thead>
                            <tr>
                               
                                <th>
                               @Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Employee

                                </th>
                                <th>
                                    @Accountingsystem.Resources.EmployeeGetTheSallaryForAllEmployeeForThatMounth.TotalSalary
                                </th>



                                <th>
                                    @Accountingsystem.Resources.Atttendace.RewardsOrPenalties
                                </th>
                                <th>
                                    @Accountingsystem.Resources.OfferPriceMasterCreateOffer.TotalFinal
                                </th>

                                <th></th>

                            </tr>
                        </thead>
                        <tbody>
                            @{
                                decimal totalSal = 0;
                                decimal totalSalBefor = 0;
                                decimal totalDifference = 0;

                            }
                            @foreach (var item in Model.EmployeeList)

                            {
                                totalSal += item.Total_Salary.Value;
                                totalSalBefor += item.TotalSalaryBeforPenality.Value;
                                totalDifference += item.TotalSalaryBeforPenality.Value - item.Total_Salary.Value;

                                <tr>


                                    <td>@item.Emp_Name</td>

                                    <td>@Math.Round(item.TotalSalaryBeforPenality.Value, 2, MidpointRounding.AwayFromZero)</td>
                                    <td>@Math.Round(item.TotalSalaryBeforPenality.Value - item.Total_Salary.Value, 2, MidpointRounding.AwayFromZero)</td>

                                    <td>@Math.Round(item.Total_Salary.Value, 2, MidpointRounding.AwayFromZero)</td>
                                    <td>
                                     <div class="btn-group">

                                        <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </button>
                                        <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                            <a href="@Url.Action("Details", new { id = item.Emp_Id })" class="dropdown-item">
                                                @Accountingsystem.Resources.OfferPriceMasterIndex.Details
                                            </a>
                                            @if (package.Attendingandleaving == true)
                                            {
                                            <a href='@Url.Action("GetEmployeePenalties", new { controller = "AttendingAndLeaving", EmpId = item.Emp_Id })' class="dropdown-item">
                                                @Accountingsystem.Resources.Atttendace.AttendingAndLeavingDetails

                                            </a>
                                            }

                                        </div>
                                    </div>
                                        </td>
                                </tr>
                            }
                         
                        </tbody>
                        <thead>
                            <tr>


                                <th>الاجمالي</th>

                                <th>@Math.Round(totalSalBefor, 2, MidpointRounding.AwayFromZero)</th>
                                <th>@Math.Round(totalDifference, 2, MidpointRounding.AwayFromZero)</th>

                                <th>@Math.Round(totalSal, 2, MidpointRounding.AwayFromZero)</th>
                                <th></th>
                            </tr>
                        </thead>
                    </table>

                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
            </div>

        </form>
    </div>
}

