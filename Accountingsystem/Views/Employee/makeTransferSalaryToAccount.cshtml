@model Accountingsystem.ViewModel.TransferSalaryToAccountVM

@{
    ViewBag.Title = Accountingsystem.Resources.EmployeemakeGL.CreateAutomaticTransferEntry;

    var msg = ViewBag.Message;
}

<h2>@Accountingsystem.Resources.EmployeemakeGL.CreateAutomaticTransferEntry </h2>
<h2>@msg</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.HiddenFor(model => model.Total_Sallary)
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">
            <div class="col-md-5">
                <div class="col-md-5">
                    <div class="Dropdownlist">
                        @Html.DropDownListFor(model => model.Account, Model.AccountList, Accountingsystem.Resources.EmployeemakeGL.SelectBankOrTreasuryAccount, htmlAttributes: new { @class = "Dropdownlist-select" })
                        @Html.ValidationMessageFor(model => model.Account, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Account, htmlAttributes: new { @class = "control-label" })
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="col-md-5">
                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Total_Sallary, new { htmlAttributes = new { @class = "textfield", @disabled = "disable" } })
                        @Html.ValidationMessageFor(model => model.Total_Sallary, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Total_Sallary, htmlAttributes: new { @class = "control-label" })
                    </div>
                </div>

            </div>
        </div>


        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value=@Accountingsystem.Resources.EmployeemakeGL.Create class="btn btn-default" />
            </div>
        </div>
    </div>
}

<link href="~/Content/css/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/select2.min.js" type="text/javascript"></script>
<script src="~/Scripts/UiUtils.js" type="text/javascript"></script>
<script type="text/javascript">

        $(document).ready(function () {

            fillDropdownWithResponse("@Url.Action("getProductBatchJsondrobDown", "Product")", "#Account");
          

        })

</script>
