</head>


@using (Html.BeginForm("Create", "PointOfSale", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.POS_Id)
        @Html.HiddenFor(model => model.Company_Id)
        @Html.HiddenFor(model => model.Currency_Id)

        <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

            <form id="offerCreateMasterForm">
                <div class="">
                    <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.PointOfSaleCreate.CreateQuickInventorySalesCenter)</h3>
                    <hr />
                    <div class="row">
                        <div class="col-md-11 mx-auto">
                            <div class="row">

                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.PointOfSaleCreate.CenterName)
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.POS_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                            <div class="input-group-append">
                                                <div class="input-group-append">
                                                    <div class="form-control">
                                                        <label class="text-danger">*</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.PointOfSaleCreate.Adress)
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.Adress, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                            <div class="input-group-append">
                                                <div class="input-group-append">
                                                    <div class="form-control">
                                                        <label class="text-danger">*</label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>






                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.EmployeeNumber)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Employee_Id, Model.EmpList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListEmployee, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Employee_Id, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                @if (package.Number_Branch > 0)
                                {
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.BranchOrDepartment)
                                            <div class="input-group">
                                                @Html.DropDownListFor(model => model.BranchSubledger_Id, Model.BranchSubList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Department)
                                            <div class="input-group">
                                                @Html.DropDownListFor(model => model.DepartSubledger_Id, Model.DepartSubList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenterOrMainDepartment, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Activity)
                                            <div class="input-group">
                                                @Html.DropDownListFor(model => model.BussinesSubledger_Id, Model.BussinessList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListActivity, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (package.Number_subLedgger > 0)
                                {
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.CostCenter)
                                            <div class="input-group">
                                                @Html.DropDownListFor(model => model.Subledger_Id, Model.SubledgerList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.SelectCostCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (package.Number_store > 1)
                                {
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Store)
                                            <div class="input-group">
                                                @Html.DropDownListFor(model => model.Store_Id, Model.StoreList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                                <div class="input-group-append">
                                                    <div class="form-control">
                                                        <label class="text-danger">*</label>
                                                    </div>
                                                </div>
                                            </div>
                                            @Html.ValidationMessageFor(model => model.Store_Id, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                }


                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div id="POSPrepare" class="col-md-11 mx-auto"></div>
                    </div>
                    <div id="POSList"></div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
}


@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }
    <script>
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });
    </script>
    <script>
        if ($('.chosen-container').length > 0) {
            $('.chosen-container').on('touchstart', function (e) {
                e.stopPropagation(); e.preventDefault();
                $(this).trigger('mousedown');

            });
        }
        $("#createOfferSpinner").hide();
        $("#Employee_Id").chosen();


        $("#BranchSubledger_Id").chosen();
        $("#DepartSubledger_Id").chosen();
        $("#BussinesSubledger_Id").chosen();
        $("#Subledger_Id").chosen();
        $("#Store_Id").chosen();

        $("#DepartSubledger_Id_chosen").addClass("form-control Dropdownlist-select");
        $("#BussinesSubledger_Id_chosen").addClass("form-control Dropdownlist-select");
        $("#Subledger_Id_chosen").addClass("form-control Dropdownlist-select");
        $("#BranchSubledger_Id_chosen").addClass("form-control Dropdownlist-select");
        $("#Store_Id_chosen").addClass("form-control Dropdownlist-select");

        $("#Employee_Id_chosen").addClass("form-control Dropdownlist-select");

    </script>
    <script type="text/javascript">

     $("#DepartSubledger_Id").empty();
        var departmentsOptions = new Option("@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenterOrMainDepartment", 0);
        $("#DepartSubledger_Id").append(departmentsOptions);
        $('#DepartSubledger_Id').trigger('chosen:updated');

        $("#BussinesSubledger_Id").empty();
        var bussinesSubledgerOptions = new Option("@Accountingsystem.Resources.OfferPriceMasterCreateOffer.SelectActivity", 0);
        $("#BussinesSubledger_Id").append(bussinesSubledgerOptions);
        $('#BussinesSubledger_Id').trigger('chosen:updated');
        $("#BranchSubledger_Id").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("GetProvinces", "Expense")',
                        type: 'get',
                        data: { countryId: selectedValue }
                    }).done(function (result) {
                        $("#DepartSubledger_Id").empty();
                        var d = new Option("@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenterOrMainDepartment", 0);
                        $("#DepartSubledger_Id").append(d);
                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#DepartSubledger_Id").append(p);
                        }
                        $('#DepartSubledger_Id').trigger('chosen:updated');
                    });
                });
                $("#DepartSubledger_Id").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("GetCities", "Expense")',
                        type: 'get',
                        data: { provinceId: selectedValue }
                    }).done(function (result) {

                        $("#BussinesSubledger_Id").empty();
                         var bussinesSubledgerOptions = new Option("@Accountingsystem.Resources.OfferPriceMasterCreateOffer.SelectActivity", 0);
                        $("#BussinesSubledger_Id").append(bussinesSubledgerOptions);
                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#BussinesSubledger_Id").append(p);

                        }
                        $('#BussinesSubledger_Id').trigger('chosen:updated');
                    });


                });




    </script>
    <script>
        function DeleteTemp(e) {

            var ids = e;



        $.ajax({

            url: '@Url.Action("DeleteTemp", "PointOfSale")',
            type: 'POST',
            data: { ids: ids }
        }).done(function (result) {


              $("#POSList").load('@(Url.Action("TempPayment", "PointOfSale"))?POSTemp=' + @Model.POS_Id);
            Snackbar.show({
                text: '@Accountingsystem.Resources.MasterPOSInvoice.DeleteSuccessfully',
                pos: 'top-center'
            });

        });
    }
    </script>
    <script type="text/javascript">

        $("#POSList").load('@(Url.Action("TempPayment", "PointOfSale"))?POSTemp=' + @Model.POS_Id);

        $("#POSPrepare").load('@(Url.Action("PreparePayment", "PointOfSale"))');




    </script>
    <script type="text/javascript">


        function AddDetailToMaster() {

            var invoiceMasterId = @Model.POS_Id;

            var PaymentMethod_Id = $("#PaymentMethod_Id").val();




         var invoiceMasterDetail;
         invoiceMasterDetail = {
             POS_ID:invoiceMasterId,
             PaymentMethod_Id: PaymentMethod_Id

         };

         $.ajax(
          {
              url: '@Url.Action("AddPayemnt", "PointOfSale")',
              data: JSON.stringify(invoiceMasterDetail),
              contentType: 'application/json',
              dataType: 'json',
              type: 'POST',
              success: function (data) {


                  Snackbar.show({
                      text: data,
                      pos: 'top-center'
                  });
                  $("#POSList").load('@(Url.Action("TempPayment", "PointOfSale"))?POSTemp=' + @Model.POS_Id);


              },
              error: function () { alert('error'); }
          });



        };
    </script>
    <script>
    
        $('#Employee_Id').on('change', function () {
            $("#Employee_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Employee_Id_chosen span').css('background', '#ffffff');
            $('#Employee_Id_chosen b').css('background', '#ffffff');
        });

        $('#POS_Name').on('input', function () {
            $("#POS_Name").removeClass("addRequiredFieldToInput");
        });
        $('#Adress').on('input', function () {
            $("#Adress").removeClass("addRequiredFieldToInput");
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#POS_Name').val() == "" || $('#POS_Name').val() == null || $('#Adress').val() == "" || $('#Adress').val() == null ||  $('#Employee_Id').val() == "" || $('#Employee_Id').val() == null || $('#creatOfferDetailList tr').length < 2) {
                $("#createOfferSpinner").hide();
                $('#createOfferbtn').prop('disabled', false);
                if ($('#POS_Name').val() == "" || $('#POS_Name').val() == null) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.PointOfSaleCreate.NameMust',
                        pos: 'top-center'
                    });
                    $("#POS_Name").addClass("addRequiredFieldToInput");
                    $('#POS_Name').trigger('focus');
                }
                if ($('#Adress').val() == "" || $('#Adress').val() == null) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.PointOfSaleCreate.AddressMust',
                        pos: 'top-center'
                    });
                    $("#Adress").addClass("addRequiredFieldToInput");
                    $('#Adress').trigger('focus');
                }










                if ($('#creatOfferDetailList tr').length < 3) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.PointOfSaleCreate.AddPayment',
                        pos: 'top-center'
                    });
                    $("#creatOfferDetailList").addClass("addRequiredFieldToInput");

                }
                if ($('#Employee_Id').val() == "" || $('#Employee_Id').val() == null) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.PointOfSaleCreate.EmpChoose',
                        pos: 'top-center'
                    });

                    $("#Employee_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Employee_Id_chosen span').css('background', 'red');
                    $('#Employee_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Employee_Id").offset().top
                    }, 2000);
                }




                event.preventDefault();
            }


        });

    </script>

}
