@model Accountingsystem.ViewModel.POSDetailPaymentVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()



<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <hr />
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.PointOfSaleCreate.PaymentMethod)
                @{ Html.EnableClientValidation(false); }

                <div class="input-group mb-4">
                    @Html.DropDownListFor(model => model.PaymentMethod_Id, Model.PaymentList, Accountingsystem.Resources.PointOfSaleCreate.PaymentMethodInformation, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger">*</label>
                        </div>
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">

            <a href='javascript:;' onclick='AddDetailToMaster();' class="btn btn-outline-info mb-2" style="text-decoration:none;">@Accountingsystem.Resources.PointOfSaleCreate.AddToRegulation</a>
        </div>
    </div>
</div>

    }

<script>
    $("#PaymentMethod_Id").chosen();
    $("#PaymentMethod_Id_chosen").addClass("form-control Dropdownlist-select");

</script>