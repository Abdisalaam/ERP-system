@using (Html.BeginForm("Update", "Payment", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))


{
    @Html.HiddenFor(model => model.Pay_Number)
    @Html.HiddenFor(model => model.Pay_ID)
    @Html.HiddenFor(model => model.Pay_Currency_ID)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Accountingsystem.Resources.PaymentDetails.CreateSupplierSpentReceipt</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PaymentDetails.SpentReceiptNumber)
                                    @Html.EditorFor(model => model.Pay_Number, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Pay_Number, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PaymentDetails.ReceiptDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Pay_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Pay_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PaymentCreate.Amount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Pay_Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="form-control text-danger">*</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Pay_Amount, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PrintReports.PaymentMethod)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedChartOfAccountId, Model.MyChartOfAccountList, Accountingsystem.Resources.ReceiptCreate.PaymentMethodsInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
