    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            var remain = parseFloat(document.getElementById("reminingShow").innerHTML);

            if ($('#Pay_Date').val() == "" || $('#Pay_Date').val() == null || $('#Pay_Amount').val() == "" || $('#Pay_Amount').val() == null || $('#Pay_Amount').val() <= 0 || $('#SelectedChartOfAccountId').val() == "" || $('#SelectedChartOfAccountId').val() == null || $('#Supplier_Id').val() == "" || $('#Supplier_Id').val() == null || $('#SelectedPurInvoiceMaster_Id').val() == "" || $('#SelectedPurInvoiceMaster_Id').val() == null || $('#SelectedPurInvoiceMaster_Id').val() == 0 || $('#SelectedPurInvoiceMaster_Id').val() == "null" || remain < $('#Pay_Amount').val()) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($('#Pay_Date').val() == "" || $('#Pay_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.DateMust",
                        pos: 'top-center'
                    });
                    $("#Pay_Date").addClass("addRequiredFieldToInput");
                    $('#Pay_Date').trigger('focus');
                }
                if (remain < $('#Pay_Amount').val()) {
                     Snackbar.show({
                        text: "@Accountingsystem.Resources.SupplierCreate.PaymentValueIsGreater",
                        pos: 'top-center'
                    });
                }
                if ($('#Pay_Amount').val() == "" || $('#Pay_Amount').val() == null || $('#Pay_Amount').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.AmountMust ",
                        pos: 'top-center'
                    });
                    $("#Pay_Amount").addClass("addRequiredFieldToInput");
                    $('#Pay_Amount').trigger('focus');
                }
                if ($('#SelectedChartOfAccountId').val() == "" || $('#SelectedChartOfAccountId').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.PaymentMust",
                        pos: 'top-center'
                    });
                    $("#SelectedChartOfAccountId_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedChartOfAccountId_chosen span').css('background', 'red');
                    $('#SelectedChartOfAccountId_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedChartOfAccountId").offset().top
                    }, 2000);
                }


                if ($('#Supplier_Id').val() == "" || $('#Supplier_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SupplierCreate.SupplierNameValidation",
                        pos: 'top-center'
                    });

                    $("#Supplier_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Supplier_Id_chosen span').css('background', 'red');
                    $('#Supplier_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Supplier_Id").offset().top
                    }, 2000);
                }

                if ($('#SelectedPurInvoiceMaster_Id').val() == "" || $('#SelectedPurInvoiceMaster_Id').val() == null || $('#SelectedPurInvoiceMaster_Id').val() == 0 || $('#SelectedPurInvoiceMaster_Id').val() == "null") {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.invoicemust",
                        pos: 'top-center'
                    });
                    $("#SelectedPurInvoiceMaster_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedPurInvoiceMaster_Id_chosen span').css('background', 'red');
                    $('#SelectedPurInvoiceMaster_Id_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#SelectedPurInvoiceMaster_Id").offset().top
                    }, 2000);
                }


                event.preventDefault();
            }



        });

    </script>
