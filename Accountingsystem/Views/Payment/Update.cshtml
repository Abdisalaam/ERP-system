    <script>
    function addSupplier() {

        var SupplierId = $("#Supp_Id").val();
        var SupplierName = $("#Supp_Name").val();
        var SupplierAddress = $("#Supp_Address").val();
        var SupplierPhone = $("#Supp_Phone").val();
        var SupplierMail = $("#Supp_Mail").val();
        var CharId = $("#SelectedChartOfAccountId").val();
        var ProvinceId = $("#SelectedProvinceId").val();
        var CountryId = $("#SelectedCountryId").val();
        var CityId = $("#SelectedCityId").val();
        var SupplierFax = $("#Supp_Fax").val();
        var SupplierCode = $("#Supp_Code").val();
        var SupplierMobile = $("#Supp_Mobile").val();
        var PurchasePrice = $("#Purchase_Price").val();
        var PaymentPolicy = $("#Payment_Policy_Id").val();
        var SupplierWebsite = $("#Supp_Website").val();
        var BranchId = $("#Branch_Id").val();
        var Files1 = $("#Files").val();
        var DataForSupplier;
        DataForSupplier = {
            Supp_Id: SupplierId,
            Supp_Name: SupplierName,
            Supp_Address: SupplierAddress,
            Supp_Phone: SupplierPhone,
            Supp_Mail: SupplierMail,
            SelectedChartOfAccountId: CharId,
            SelectedProvinceId: ProvinceId,
            SelectedCountryId: CountryId,
            SelectedCityId: CityId,
            Supp_Fax: SupplierFax,
            Supp_Code: SupplierCode,
            Supp_Mobile: SupplierMobile,
            Purchase_Price: PurchasePrice,
            Payment_Policy_Id: PaymentPolicy,
            Supp_Website: SupplierWebsite,
            Branch_Id: BranchId,
            Files: Files1
        };

        $.ajax(
         {
            url: "@Url.Action("AddNewSupplierPartial", "Payment")",
             data: JSON.stringify(DataForSupplier),
             contentType: 'application/json',
             dataType: 'json',
             type: 'POST',
             success: function (data) {
                 alert(data);
                 //$("#partialDialogDiv").hide();
                 //$("SelectedCustomerId").reload();
                 $("#partialDialogDiv").reload($(this).attr('#Supplier_Id'));


             },
             error: function () { alert('ffffffff'); }
