@model Accountingsystem.ViewModel.SlicesVM

@{
    ViewBag.Title = "Create";
    Layout = null;
}

@using (Html.BeginForm("PartialDialogSlicePost", "Customer", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()


    <h2 class="HEADTITLE-STYLE">@Accountingsystem.Resources.SlicesCreate.CreateNewSlice</h2>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form>
            <div class="">
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SlicesCreate.SliceNumber)
                                    @Html.EditorFor(model => model.Slice_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Slice_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SlicesCreate.SliceName)
                                    @Html.EditorFor(model => model.Slice_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Slice_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-12">
                                <div class="form-group">
                                    <a href='javascript:;' onclick='addslice();' class="btn btn-block btn-dark mb-lg-0" style="text-decoration:none;">@Accountingsystem.Resources.SlicesCreate.CreateNewSlice <div id="slicePartialSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></div></a>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
            </div>

        </form>

    </div>

}


<script>
    function addslice() {
        debugger;
        var Slice_Code = $("#Slice_Code").val();
        var Slice_Name = $("#Slice_Name").val();
       
        if (Slice_Name == "" || Slice_Name == null ) {

            if (Slice_Name == "" || Slice_Name == null) {
                Snackbar.show({
                    text:"@Accountingsystem.Resources.validate.AddName",
                    pos: 'top-center'
                });
                $("#Slice_Name").addClass("addRequiredFieldToInput");
                $('#Slice_Name').trigger('focus');
            }
           
        }
        else {
            $('#sliceModal').modal('toggle');
            $("#slicePartialSpinner").show();
        var DataForslice;
        DataForslice = {
            Slice_Name: Slice_Name,
            Slice_Code: Slice_Code
           
        };
            var formData = new FormData();
            formData.append("Slice_Name", DataForslice.Slice_Name);
            formData.append("Slice_Code", DataForslice.Slice_Code);
            

        $.ajax(
         {
                url: "@Url.Action("PartialDialogSlicePost", "Customer")",
                data: formData,
                type: "post",
                contentType: false,
                processData: false,
                cache: false,
                success: function (data) {

                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.AddSliceSuccessful" + data,
                        pos: 'top-center'
                    });
                   $("#slicePartialDialogDiv").load('@(Url.Action("PartialDialogSlice", "Customer"))');
                    $("#slicePartialSpinner").hide();
                    $.ajax({

                        url: '@Url.Action("GetSlicDropdownList", "Customer")',
                        type: 'get'
                    }).done(function (result) {

                        $("#CustomerSelectSlice_Id").empty();

                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);
                            
                            $("#CustomerSelectSlice_Id").append(p);
                            $("#CustomerSelectSlice_Id option:last").attr("selected", "selected");

                        }
                        $('#CustomerSelectSlice_Id').trigger('chosen:updated');
                        $("#CustomerSelectSlice_Id_chosen").removeClass("addRequiredFieldToInput");
                        $('#CustomerSelectSlice_Id_chosen span').css('background', '#1b2e4b');
                        $('#CustomerSelectSlice_Id_chosen b').css('background', '#1b2e4b');
                        $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#1b2e4b");
                      
                    });




             },
                error: function () {

                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.Error",
                        pos: 'top-center'
                    });
                    $("#customerPartialSpinner").hide();
                }
         });
        }

    };



</script>