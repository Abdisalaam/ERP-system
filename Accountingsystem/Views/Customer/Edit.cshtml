    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#Customer_Phone').val() == "" || $('#Customer_Phone').val() == null || $('#Customer_Name').val() == "" || $('#Customer_Name').val() == null || $('#CustomerSelectSlice_Id').val() == "" || $('#CustomerSelectSlice_Id').val() == null) {
                $("#createOfferSpinner").hide();
                $('#createOfferbtn').prop('disabled', false);
                if ($('#Customer_Phone').val() == "" || $('#Customer_Phone').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CustomerCreate.CustomerPhoneValidation",
                        pos: 'top-center'
                    });
                    $("#Customer_Phone").addClass("addRequiredFieldToInput");
                    $('#Customer_Phone').trigger('focus');
                }
                if ($('#Customer_Name').val() == "" || $('#Customer_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CustomerCreate.CustomerNameValidation",
                        pos: 'top-center'
                    });
                    $("#Customer_Name").addClass("addRequiredFieldToInput");
                    $('#Customer_Name').trigger('focus');
                }





                if ($('#CustomerSelectSlice_Id').val() == "" || $('#CustomerSelectSlice_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CustomerCreate.SliceValidation",
                        pos: 'top-center'
                    });

                    $("#CustomerSelectSlice_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#CustomerSelectSlice_Id_chosen span').css('background', 'red');
                    $('#CustomerSelectSlice_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#CustomerSelectSlice_Id").offset().top
                    }, 2000);
                }


                $("#createOfferSpinner").hide();
                event.preventDefault();
            }


        });

    </script>
