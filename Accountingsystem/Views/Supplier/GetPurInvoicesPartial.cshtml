@model IEnumerable<Accountingsystem.Models.PurInvoiceMaster>

<h4>@Accountingsystem.Resources.SupplierCreate.Bills</h4>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Master_Id)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Serial_Number)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Invoice_Date)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Due_Date)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.GL_Date)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Master_Discount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Invoice_Currency)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Total_Amount)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Total_Tax)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Total_Cost)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Supplier_Id)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Store_ID)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Company_Id)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TotalAmountAfMat)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Master_Id)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Serial_Number)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Description)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Invoice_Date)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Due_Date)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.GL_Date)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Master_Discount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Invoice_Currency)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Total_Amount)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Total_Tax)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Total_Cost)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Supplier_Id)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Store_ID)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Company_Id)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TotalAmountAfMat)
        </td>
        <td>
            @Html.ActionLink("Details", "Details", "PurchaseInvoice", new { id = item.Supplier_Id }, null)
        </td>
    </tr>
}

</table>
