@model Accountingsystem.Models.Supplier

@{
    ViewBag.Title = Accountingsystem.Resources.SupplierDetails.SupplierDetailss;
    var Package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
    HttpCookie cookie = Request.Cookies["Language"];
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }


</head>
<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">

    <div class="statbox widget box box-shadow">
        
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    @ViewBag.Message
                </div>
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    @Accountingsystem.Resources.SupplierDetails.SupplierDetailss
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">

                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.SupplierCode)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Supp_Code)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.SupplierName)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Supp_Name)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.SupplierPhone)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Supp_Phone)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.Adress)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Supp_Address)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.SupplierWebsite)
                                        </div>
                                        <div>
                                            <a style="color:dodgerblue" href="http://@Model.Supp_Website">@Model.Supp_Website</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.SupplierEmail)
                                        </div>
                                        <div>
                                            <a style="color:dodgerblue" href="mailto:@Model.Supp_Mail">@Model.Supp_Mail</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.CustomerDetails.Country)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Country)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.Governorate)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Province)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.CustomerDetails.City)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.City)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.Fax)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Supp_Fax)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.NumberOfSupplier)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Supp_Mobile)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Package.Number_Branch > 0 && Model.Branch_Id != null && Model.Branch_Id != 0)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.CustomerDetails.Branch)
                                            </div>
                                            <div>
                                                @{ var branch = Accountingsystem.Models.Branch.GetBranchById(Model.Branch_Id.Value).Branch_Name;
                                                }
                                                <h>@branch</h>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    
                    @if (Model.Payment_Policy_Id != 0 && Model.Payment_Policy_Id != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.PrintReports.PaymentMethod)
                                            </div>
                                            <div>
                                                @{
                                                    var pay = Accountingsystem.Models.PaymentMethod.GetPaymentMethodById(Model.Payment_Policy_Id.Value).Payment_Type;
                                                }
                                                @Html.Display(pay)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierCreate.TaxNumber)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Tax_Number)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.SupplierDetails.SupplierCase)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Supplier_state)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


              
                @if (Model.SupplierFileDetails.Any())
                {

                    <div class="table-responsive">
                        <table class="table mb-4">
                            <thead>

                                <tr>


                                    <th>@Accountingsystem.Resources.validate.Number</th>
                                    <th>@Accountingsystem.Resources.validate.Name</th>
                                    <th>@Accountingsystem.Resources.validate.Type</th>
                                    <th>@Accountingsystem.Resources.validate.Size</th>
                                    <th></th>
                                    <th></th>

                                </tr>
                            </thead>
                            <tbody>
                                @{var countfile = 0; }
                                @foreach (var file in Model.SupplierFileDetails)
                                {
                                    countfile += 1;
                                    <tr>
                                        <td>@countfile</td>
                                        <td>@file.FileName</td>
                                        <td>@file.File_Type</td>
                                        <td>@file.ContentLength</td>

                                        <td>

                                            <a href="@Url.Action("ReturnInvoicetFile", new { fileId = file.Id })" class="bs-tooltip" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Download" data-original-title="Download">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>

                                            </a>
                                        </td>
                                        <td>
                                            @if (Request.IsAuthenticated @*&& !User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع") && !User.IsInRole("مساعد محاسب")*@)
                                            {
                                                <a href='@Url.Action("deleteFile", new { fileId = file.Id })' class="bs-tooltip" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Delete" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>


                                            }
                                        </td>

                                    </tr>
                                }
                            </tbody>




                        </table>




                    </div>
                }
                <div class="row layout-top-spacing">
                    @if (Request.IsAuthenticated @*&& !User.IsInRole("بائع")*@)
                    {
                        <div class="col-md-4">
                            <div class="form-group">

                                <a id="newbtn" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action( "Create")">
                                    @Accountingsystem.Resources.SupplierDetails.CreateSupplier
                                    <span id="newbtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                                </a>
                                <a id="Editbtn" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("Edit", new { id = Model.Supp_Id })">
                                    @Accountingsystem.Resources.CustomerDetails.Edit
                                    <span id="EditbtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                                </a>
                              



                            </div>
                        </div>


                        <div class="col-md-4">
                            <div class="form-group">
                                @if (Request.IsAuthenticated @*&& !User.IsInRole("مدخل بيانات")*@)
                                {
                                    <a id="suprbtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("getListofLedgerChild", new { controller = "ReportsNew", code = Model.Supp_Code })'>
                                        @Accountingsystem.Resources.SupplierDetails.SupplierReport
                                        <span id="suprbtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                                    </a>


                                }
                                <a id="purbtn" class="btn btn-block btn-outline-primary mb-lg-0" href=" @Url.Action("CreatePurchaseInv","PurchaseInvoice",new { supId = Model.Supp_Id })">
                                    @Accountingsystem.Resources.SupplierDetails.CreatePurchaseInvoice
                                    <span id="purbtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                                </a>
                                <a id="paybtn" class="btn btn-block btn-outline-primary mb-lg-0" href="@Url.Action( "Create","Payment",new {suppId = Model.Supp_Id })">
                                    @Accountingsystem.Resources.SupplierDetails.CreatePurchasesSpentReceipt
                                    <span id="paybtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                                </a>
                            </div>
                        </div>


                        <div class="col-md-4">
                            <div class="form-group">
                                <a id="spentbtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action( "Create","SpentRecipt",new {child=Model.Supp_Id,type="supplier" })">
                                    @Accountingsystem.Resources.SupplierDetails.CreateSpentReceipt
                                    <span id="spentbtnspinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                                </a>
                                <a id="backToListbtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index")">
                                    @Accountingsystem.Resources.SupplierDetails.BackToList
                                    <span id="backToListbtnspinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                                </a>


                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div>




        </div>
    </div>
</div>

@section scripts{
    <script>
        
        $("#newbtn").click(function (e) {
            $("#newbtnspinner").show();
        });
        $("#suprbtn").click(function (e) {
            $("#suprbtnspinner").show();
        });
        $("#purbtn").click(function (e) {
            $("#purbtnspinner").show();
        });
        $("#paybtn").click(function (e) {
            $("#paybtnspinner").show();
        });
        $("#spentbtn").click(function (e) {
            $("#spentbtnspinner").show();
        });
        
        $("#backToListbtn").click(function (e) {
            $("#backToListbtnspinner").show();
        });
        $("#reportbtn").click(function (e) {
            $("#reportbtnSpinner").show();
        });
        $("#Editbtn").click(function (e) {
            $("#EditbtnSpinner").show();
        });

    </script>



}

