@using (Html.BeginForm("Create", "Supplier", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center"><label>@Accountingsystem.Resources.SupplierCreate.CreateSupplier</label></h3>

                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierNumber)
                                    @Html.EditorFor(model => model.Supp_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Supp_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Supp_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Supp_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierPhone)
                                        <div class="input-group mb-4">
                                            @Html.EditorFor(model => model.Supp_Phone, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="form-control text-danger">*</span>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Supp_Phone, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierAdress)
                                    @Html.EditorFor(model => model.Supp_Address, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Supp_Address, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierWebsite)
                                    @Html.EditorFor(model => model.Supp_Website, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Supp_Website, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierEmail)
                                    @Html.EditorFor(model => model.Supp_Mail, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Supp_Mail, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.Country)
                                    @Html.EditorFor(model => model.Country, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.Governorate)
                                    @Html.EditorFor(model => model.Province, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.City)
                                    @Html.EditorFor(model => model.City, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierFax)
                                    @Html.EditorFor(model => model.Supp_Fax, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Supp_Fax, "", new { @class = "text-danger" })

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SupplierPhoneNumber)
                                    @Html.EditorFor(model => model.Supp_Mobile, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Supp_Mobile, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.Branch)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Branch_Id, Model.BranchList, Accountingsystem.Resources.CustomerCreate.SelectBranch, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.Branch_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SelectPaymentPolicy)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Payment_Policy_Id, Model.MyPaymentPolicy, Accountingsystem.Resources.CustomerCreate.SelectPaymentMethod, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.Payment_Policy_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.TaxNumber)
                                    @Html.EditorFor(model => model.Tax_Number, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Tax_Number, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">

                                    @Html.Label(Accountingsystem.Resources.SupplierCreate.SelectFile)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.SuppFiles2, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.CustomerCreate.SeletFolder</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul class="list-unstyled" id="SuppselectedtFiles"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SuppFiles2, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                                        @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </form>

    </div>


}




@section Scripts {
    @{
        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }


    }
    <script>
        if ($('.chosen-container').length > 0) {
            $('.chosen-container').on('touchstart', function (e) {
                e.stopPropagation(); e.preventDefault();
                $(this).trigger('mousedown');

            });
        }
        $("#Branch_Id").chosen();
        $("#Payment_Policy_Id").chosen();



        $("#Branch_Id_chosen").addClass("form-control Dropdownlist-select");
        $("#Payment_Policy_Id_chosen").addClass("form-control Dropdownlist-select");

    </script>
    <script>
        $(document).ready(function () {
            $("#SupplierPartialSpinner").hide();

            $("#Branch_Id").chosen();
            $("#Payment_Policy_Id").chosen();


            $("#Branch_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Payment_Policy_Id_chosen").addClass("form-control Dropdownlist-select");


        });
    $('#SuppFiles2').change(function () {
        $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
        $('#SuppselectedtFiles').empty();
            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#SuppFiles2').empty();
                    $('#SuppselectedtFiles').empty();
                    $('#SuppselectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.CustomerCreate.TotalSizeOfSelectedFiles : " + totalConteLength + " " + " @Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Byte " +'</li> ');
                    $('#SuppselectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.CustomerCreate.MaxOfFilesSize" + '.</li> ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                    text: "@Accountingsystem.Resources.CustomerCreate.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#SuppselectedtFiles').append('<li>' + "@Accountingsystem.Resources.CustomerCreate.FileName : " + fileName + '</li> ');
                    $('#SuppselectedtFiles').append('<li>' + "@Accountingsystem.Resources.CustomerCreate.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.CustomerCreate.Byte" +'</li> ');

                }
            }
        $('#SuppselectedtFiles').append('<li>' +"@Accountingsystem.Resources.CustomerCreate.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.CustomerCreate.Byte" +'</li > ');
        });
    </script>
    <script>

       
        $('#Supp_Phone').on('input', function () {
            $("#Supp_Phone").removeClass("addRequiredFieldToInput");
        });
        $('#Supp_Name').on('input', function () {
            $("#Supp_Name").removeClass("addRequiredFieldToInput");
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            if ($("#Supp_Name").val() == "" || $("#Supp_Name").val() == null || $("#Supp_Phone").val() == "" || $("#Supp_Phone").val() == null) {
                $('#createOfferbtn').prop('disabled', false);

                if ($("#Supp_Name").val() == "" || $("#Supp_Name").val() == null ) {
                Snackbar.show({
                    text: "@Accountingsystem.Resources.SupplierCreate.SupplierName",
                    pos: 'top-center'
                });
                $("#Supp_Name").addClass("addRequiredFieldToInput");
                $('#Supp_Name').trigger('focus');
            }
                if ($("#Supp_Phone").val() == "" || $("#Supp_Phone").val() == null) {
                Snackbar.show({
                    text: "@Accountingsystem.Resources.SupplierCreate.SupplierPhoneValidation",
                    pos: 'top-center'
                });
                $("#Supp_Phone").addClass("addRequiredFieldToInput");
                $('#Supp_Phone').trigger('focus');
            }
                return false;



            }
            else {
                $("#createOfferSpinner").show();
            }


        });

    </script>
}