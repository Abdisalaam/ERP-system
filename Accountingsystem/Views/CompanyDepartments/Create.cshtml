    <script>
        if ($('.chosen-container').length > 0) {
            $('.chosen-container').on('touchstart', function (e) {
                e.stopPropagation(); e.preventDefault();
                $(this).trigger('mousedown');

            });
        }
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });
      
    </script>
    <script>


        $('#CompDept_Name').on('input', function () {
            $("#CompDept_Name").removeClass("addRequiredFieldToInput");
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();


            if ($('#CompDept_Name').val() == "" || $('#CompDept_Name').val() == null) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($('#CompDept_Name').val() == "" || $('#CompDept_Name').val() == null) {
                  
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CompanyDepartmentsCreate.CreateDepartmentMessage",
                        pos: 'top-center'
                    });
                    $("#CompDept_Name").addClass("addRequiredFieldToInput");
                    $('#CompDept_Name').trigger('focus');
                }



                event.preventDefault();
            }



        });

    </script>
