                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.SelectedPurInvoiceMaster_Id, "فاتورة المشتريات", htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>


                <div class="col-md-5">
                    <div class="col-md-5">
                      

                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedPaymentPay_ID, Model.MyPaymentPay, "اختر الايصال", htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.SelectedPaymentPay_ID, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.SelectedPaymentPay_ID, "تحديد الايصال", htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">


                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Date, htmlAttributes: new { @class = "control-label" })
