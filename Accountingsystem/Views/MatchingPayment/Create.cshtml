                    </div>
                </div>

                <div class="col-md-5">
                    <div class="col-md-5">
                       

                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.Comp_ID, Model.MyCompanyList, "اختر الشركة", htmlAttributes: new { @class = "Dropdownlist-select" })
