@model Accountingsystem.ViewModel.SalesReceiptMasterVM

@{
    ViewBag.Title = Accountingsystem.Resources.SalesReceiptMasterAddnewSaleReciept.CashReceiptDetailsTitle;
    HttpCookie cookie = Request.Cookies["Language"];
    Model.Company_Id = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault().Comp_Id;
    Model.Invoice_Currency = 1;
    var package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
}

<head>
    @{

