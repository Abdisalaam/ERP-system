            if ($('#Account_Id').val() == "" || $('#Account_Id').val() == null || $('#Invoice_Date').val() == "" || $('#Invoice_Date').val() == null || $('#Emp_Id').val() == "" || $('#Emp_Id').val() == null || $('#PaymentMethod_Id').val() == "" || $('#PaymentMethod_Id').val() == null || $('#Master_Discount').val() == "" || $('#Master_Discount').val() == null || $('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100 || $('#invoiceMasterDetailList tr').length < 3) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#Invoice_Date').val() == "" || $('#Invoice_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDateIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Invoice_Date").addClass("addRequiredFieldToInput");
                    $('#Invoice_Date').trigger('focus');
                }

                if ($('#Master_Discount').val() == "" || $('#Master_Discount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPrecentageIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }
                if ($('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPrecentageCorrectAmountMessage",
                        pos: 'top-center'

                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }

                @*if ($('#Fixed_Discount').val() == "" || $('#Fixed_Discount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AlouwedDiscountIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Fixed_Discount").addClass("addRequiredFieldToInput");
                    $('#Fixed_Discount').trigger('focus');
                }*@

                if ($('#Fixed_Discount').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AlouwedDiscountCorrectAmountMessage",
                        pos: 'top-center'
                    });
                    $("#Fixed_Discount").addClass("addRequiredFieldToInput");
                    $('#Fixed_Discount').trigger('focus');
                }


                if ($('#invoiceMasterDetailList tr').length < 3) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddProductsToTheListMessage",
                        pos: 'top-center'
                    });
                    $("#invoiceMasterDetailList").addClass("addRequiredFieldToInput");
                    $("#productNotBatched_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#productNotBatched_ID_chosen span').css('background', 'red');
                    $('#productNotBatched_ID_chosen b').css('background', 'red');
                    $('#productNotBatched_ID_chosen').trigger('focus');
                }
                if ($('#Emp_Id').val() == "" || $('#Emp_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.EmployeeIsRequiredMessage",
                        pos: 'top-center'
                    });

                    $("#Emp_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Emp_Id_chosen span').css('background', 'red');
                    $('#Emp_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Emp_Id").offset().top
                    }, 2000);
                }




                if ($('#PaymentMethod_Id').val() == "" || $('#PaymentMethod_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SalesReceiptMasterAddnewSaleReciept.PaymentMethodeIsRequired",
                        pos: 'top-center'
                    });
                    $("#PaymentMethod_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#PaymentMethod_Id_chosen span').css('background', 'red');
                    $('#PaymentMethod_Id_chosen b').css('background', 'red');

                }



                if ($('#Account_Id').val() == "" || $('#Account_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AccountRevenueIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Account_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Account_Id_chosen span').css('background', 'red');
                    $('#Account_Id_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#Account_Id").offset().top
                    }, 2000);
                }

                event.preventDefault();
            }
            else {
                $("#createOfferSpinner").show();
            }


        });

    </script>
