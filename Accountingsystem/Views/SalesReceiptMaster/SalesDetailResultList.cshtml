@model IEnumerable<Accountingsystem.Models.SalesReceiptDetailsTemp>


<table class="table table-bordered table-striped">
    @{decimal tax = 0;
        decimal TotalAmount = 0;
        decimal com = 0;
        decimal cost = 0;
    }

    <tr>

        <th>
            @Html.DisplayName("الصنف")
        </th>
        <th>
            @Html.DisplayName("رقم الصنف")
        </th>
        <th>
            @Html.DisplayName("الكمية")
        </th>
        <th>
            @Html.DisplayName("السعر")
        </th>

        <th>
            @Html.DisplayName("اجمالى الضريبة")
        </th>
        <th>
            @Html.DisplayName("الاجمالى")
        </th>
         <th>
            @Html.DisplayName("اجمالى التكلفة")
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        @Html.HiddenFor(modelItem => item.Details_Id)
        @Html.HiddenFor(modelItem => item.SalesReceiptMasterTempMaster_Id)
        @Html.HiddenFor(modelItem => item.comition)
        //{
        //    com += item.comition.Value;

        //}
    <tr>
        <td>
            @Html.DisplayFor(modelItem => Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Code)
        </td>
        <td>
            @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
        </td>
        <td>
         
            @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
        </td>


        <td>
      
            @Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)
            @{ tax += item.Detail_Total_Tax;

            }
        </td>
        <td>
          
            @Math.Round(item.Total_Amount, 2, MidpointRounding.AwayFromZero)
            @{ TotalAmount += item.Total_Amount;

            }
        </td>
        <td>
        
            @Math.Round(item.Detail_Total_Cost, 2, MidpointRounding.AwayFromZero)
            @{
                cost += item.Detail_Total_Cost;
            }
        </td>
        <td>
            <div class="col-md-offset-2 col-md-10">
                <a href='javascript:;' onclick="@("DeleteTemp('"+item.Details_Id+"')")" class="BTN-style-danger" style="text-decoration:none;">حذف</a>
            </div>
        </td>


    </tr>
    }

</table>
<div class="row" style="text-align:right;">
    <div class="col-md-1">
        <div class="textfieldcont">
            <h>@Math.Round(tax, 2, MidpointRounding.AwayFromZero)</h>
        </div>
    </div>
    <div class="col-md-1">

        <div class="form-group">
            اجمالي الضرائب

        </div>
    </div>
    <div class="col-md-1">
        <div class="textfieldcont">
            <h>@Math.Round(cost, 2, MidpointRounding.AwayFromZero)</h>
        </div>
    </div>
    <div class="col-md-1">

        <div class="form-group">
            اجمالي التكلفة

        </div>
    </div>

    <div class="col-md-1">
        <div class="textfieldcont">
            @{if (Model.FirstOrDefault() == null)
                {
                }

                else
                {
                    var d = @TotalAmount;
                    <h> @Math.Round(d, 2, MidpointRounding.AwayFromZero) </h>
                }

            }




        </div>
    </div>
    <div class="col-md-1">

        <div class="form-group">
            اجمالي الفاتورة

        </div>
    </div>
</div>

