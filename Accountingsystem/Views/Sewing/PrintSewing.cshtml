@model Accountingsystem.Models.Sewing

@{
    Layout = null;
    var customer = Accountingsystem.Models.Customer.GetCustomerById(Model.CustomerId);
    int i = 0;
    var Sewinarr = Model.SewingDetails.OrderBy(a=>a.AnswerId).ToArray();
}

<!DOCTYPE html>

<html>
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
    <!-- Bootstrap CSS -->
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }

        .column {
            float: left;
            width: 50%;
            padding: 5px;
        }



        .tho {
            text-align: left;
            padding: 16px;
        }

        * {
            box-sizing: border-box;
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>

    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <title> نموذج </title>
</head>
<body>

    <div class="container">

        <div style="text-align: center;">

            <text style="text-align: center;  font-size:30px;">فاتورة ضريبية  | Tax Invoice  </text>

        </div>

        <br />
        <div class="row">
            <div id="header" style="height:15%;width:100%;">

                <div style='float:left'>
                    <table width="500" border="1" @*style="margin-left:10%;"*@>
                        <tr>
                            <th style="text-align:center; padding-top:0px;width:200px">
                              العميل
                            </th>
                         
                                <td style="text-align:center; padding-top:0px;width:200px">
                                    @customer.Customer_Name   
                                </td>
                          
                           
                            <th style="text-align:center; padding-top:0px;width:200px">
                                customer
                            </th>



                        </tr>
                   



                    </table>
                    <br />
                    <table width="500" border="1" @*style="margin-left:10%;"*@>
                        <tr>
                            <th style="text-align:center; padding-top:0px;width:200px">
                                Invoice NO
                            </th>

                            <td style="text-align:center; padding-top:0px;width:200px">
                                @Model.OrderNumber
                            </td>


                            <th style="text-align:center; padding-top:0px;width:200px">
                                الرقم
                            </th>



                        </tr>
                        <tr>
                            <th style="text-align:center; padding-top:0px;width:200px">
                                 Date
                            </th>
                            <td style="text-align:center; padding-top:0px;width:200px">
                                @Convert.ToDateTime(Model.Date).ToString("dd-MM-yyyy")
                            </td>
                            <th style="text-align:center; padding-top:0px;width:200px">
                                التاريخ 
                            </th>



                        </tr>

              
                   
                            <tr>
                                <th style="text-align:center; padding-top:0px">
                                    Due Date
                                </th>
                                <td style="text-align:center; padding-top:0px">
                                    @Accountingsystem.Models.Sewing.ConvertDateCalendar(Model.Date, "Hijri", "en-US");
                                </td>
                                <th style="text-align:center; padding-top:0px">
                                   الموافق
                                </th>
                              


                            </tr>
                        
                     



                    </table>
                </div>

         

            </div>
        </div>
    </div>

    <br />


    <table width="1100" border="1" style="text-align:right;">
        @*@while (i>Sewinarr.Count())
        {
        <tr>

            <th style="text-align:center;border-right:hidden; padding-top:0px">
                @Sewinarr[i].Question
            </th>
            @if (Sewinarr[i].AnswerId > 0)
            {
                <td style="text-align:center;border-right:hidden;width:200px; padding-top:0px">
                    @Sewinarr[i].Answer.Desc
                </td>
            }
            else
            {
                <td style="text-align:center;border-right:hidden;width:200px; padding-top:0px">
                    @Sewinarr[i].Description
                </td>
            }
            <th style="text-align:center;border-right:hidden; padding-top:0px">
                @Sewinarr[i+1].Question
            </th>
            @if (Sewinarr[i+1].AnswerId > 0)
            {
                <td style="text-align:center;border-right:hidden;width:200px; padding-top:0px">
                    @Sewinarr[i+1].Answer.Desc
                </td>
            }
            else
            {
                <td style="text-align:center;border-right:hidden;width:200px; padding-top:0px">
                    @Sewinarr[i+1].Description
                </td>
            }
        </tr>
        }*@
        <tr>
            @foreach (var sew in Model.SewingDetails.OrderBy(a => a.AnswerId))
            {


            <th style="text-align:center;border-right:hidden; padding-top:0px">
                @sew.Question
            </th>




            }
        </tr>
        <tr>
            @foreach (var sew in Model.SewingDetails.OrderBy(a => a.AnswerId))
            {


            <td style="text-align:center;border-right:hidden; padding-top:0px">
                @sew.Description
            </td>




            }
        </tr>


    </table>
    <br />


  




    <footer style="margin-top:0%;"></footer>

</body>

</html>
