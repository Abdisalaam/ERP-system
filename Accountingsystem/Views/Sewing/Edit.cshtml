    <script>
        $("#ProductId").chosen();
        $("#ProductId_chosen").addClass("form-control Dropdownlist-select");
        $("#SelectedCustomerId").chosen();
        $("#SelectedCustomerId_chosen").addClass("form-control Dropdownlist-select");

        $("#TaxId").chosen();
        $("#TaxId_chosen").addClass("form-control Dropdownlist-select");
        var currentDate = new Date();
        var _OfferDate = flatpickr(document.getElementById('Date'), {
            defaultDate: $("#Date").val()
        });
     

        var _DeadLineDate = flatpickr(document.getElementById('DueDate'), {
            defaultDate: $("#DueDate").val()
        });
         $("#customerPartialDialogDiv").load('@(Url.Action("PartialDialog", "Sewing"))');
    </script>



    <script>

        function fun() {


            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);
            var orderArr = [];
            orderArr.length = 0;
            debugger
            $.each($("#default-ordering tbody tr"), function () {
                orderArr.push({

                    QuestionId: $(this).find('td:eq(0)').html(),
                    QuestionName: $(this).find('td:eq(1)').html(),
                    AnswerDesc: $(this).find('td:eq(2)').find('input').val(),
                    AnswerId: $(this).find('td:eq(3)').find('input[type="radio"]:checked').val(),
                    Required: $(this).find('td:eq(4)').html()

                });

            });
            var FiledRequired = null;
            var filterArray = orderArr.filter(item => item.AnswerDesc == '' && item.Required == 'True' && item.AnswerId == undefined);
            if (filterArray.length > 0) {
                FiledRequired = orderArr.find(item => item.AnswerDesc == '' && item.Required == 'True' && item.AnswerId == undefined);



            }


            if ($('#SelectedCustomerId').val() == "" || $('#SelectedCustomerId').val() == null || FiledRequired != null) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($('#SelectedCustomerId').val() == "" || $('#SelectedCustomerId').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CategoryCreate.CategoryNameValidation",
                        pos: 'top-center'
                    });
                    $("#SelectedCustomerId").addClass("addRequiredFieldToInput");
                    $('#SelectedCustomerId').trigger('focus');
                }

                if (FiledRequired != null) {
                    Snackbar.show({
                        text: ('  ادخل ' + FiledRequired.QuestionName),
                        pos: 'top-center'
                    });

                    event.preventDefault();
                }




            }
            else {

                var date = $("#Date").val(),
                    DueDate = $("#DueDate").val(),
                    CustomerId = $("#SelectedCustomerId").val(),
                    ProductId = $("#ProductId").val(),
                    NumberOfSewing = $("#NumberOfSewing").val(),
                    order = $("#order").val(),
                    Amount = $("#Amount").val(),
                    iscopy = $("#iscopy").val();
                var Id = $("#Id").val();
                var Quantity = $("#Quantity").val();
                var datao = JSON.stringify(orderArr);

                var data = { 'detail': datao, 'Date': date, 'DueDate': DueDate, 'CustomerId': CustomerId, 'ProductId': ProductId, 'NumberOfSewing': NumberOfSewing, 'iscopy': iscopy, 'Amount': Amount, "iscopy": iscopy, "Id": Id, 'quantity': Quantity };
                var data = JSON.stringify(data);
                debugger
                console.log(data);
                $.ajax(
                    {

                        url: '@Url.Action("Edit", "Sewing")',
                        data: data,
                        contentType: 'application/json; charset=utf-8',
                        dataType: 'json',
                        type: 'POST',


                    }).done(function (result) {

                        setTimeout(function () {

                            window.location = result;

                        }, 5000);
                    });

            };
        }
    </script>



