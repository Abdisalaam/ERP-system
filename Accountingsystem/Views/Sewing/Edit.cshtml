<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <form id="offerCreateMasterForm">

        <div class="text-center">
            @Html.Label(Accountingsystem.Resources.InvoiceMasterDetails.Edit)
        </div>
        <br />
        <div class=''>
            <div class="row">
                @Html.HiddenFor(model => model.iscopy)
                @Html.HiddenFor(model => model.Id)
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDate)
                        <div class="input-group">
                            @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control text-danger">*</span>
                                </div>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.Sewing.receiveddate)
                        <div class="input-group">
                            @Html.EditorFor(model => model.DueDate, new { htmlAttributes = new { @class = "form-control mb-4" } })
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control text-danger">*</span>
                                </div>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(model => model.DueDate, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Customer)
                        <div class="input-group">
                            @Html.DropDownListFor(model => model.SelectedCustomerId, Model.CustList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListCustomer, htmlAttributes: new { @class = "Dropdownlist-select form-control mb-4" })
                            <div class="input-group-append">
                                <div class="form-control">
                                    <label class="text-danger">*</label>
                                </div>

                                <button id="addNewCustomerBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#customerModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                </button>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(model => model.SelectedCustomerId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.Sewing.Number)
                        <div class="input-group">
                            @Html.EditorFor(model => model.NumberOfSewing, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                            @Html.ValidationMessageFor(model => model.NumberOfSewing, "", new { @class = "text-danger" })
                            <div class="input-group-append">



                            </div>
                        </div>
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.ProductOrService)
                        <div class="input-group">
                            @Html.DropDownListFor(model => model.ProductId, Model.ProdductList, Accountingsystem.Resources.InvoiceMasterAddNewInvoice.ProductOrService, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                            <div class="input-group-append">
                                <div class="form-control">
                                    <label class="text-danger"></label>
                                </div>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(model => model.ProductId, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Quantity)
                        <div class="input-group">
                            @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                            @Html.ValidationMessageFor(model => model.Quantity, "", new { @class = "text-danger" })
                            <div class="input-group-append">



                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.Sewing.Amount)
                        <div class="input-group">
                            @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                            @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                            <div class="input-group-append">



                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
