<div id="customerModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddNewCustomer</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <div class="modal-body">
                <div id="customerPartialDialogDiv"></div>
            </div>
            <div class="md-button">
                <button class="btn btn-block btn-outline-secondary mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

            </div>
        </div>
    </div>
</div>

<div class="table-responsive mb-4 mt-4">
    @{ 
        var sewing = Accountingsystem.Models.Sewing.GetsewingById(Model.Id);
    }
    <table id="default-ordering" class="table table-hover">

        <tbody>
            @foreach (var item in Model.QuestionList)
            {

            <tr>
                <td hidden>@item.Id</td>

                <td>@item.Name</td>
                @if (item.Answers.Count() == 0)
                {
                    var realAnswer = sewing.SewingDetails.Where(a => a.QuestionId == item.Id && a.Description != "").FirstOrDefault();
                    if (realAnswer != null)
                    {
                        <td><input id="answerDesc" value="@realAnswer.Description" class="details-form-control" /></td>
                    }
                    else
                    {
                        <td><input id="answerDesc" class="details-form-control" /></td>
                    }
                    <td hidden></td>

                }
                else
                {
                    <td hidden></td>
                    <td>

                        @*<select name="picture" id="picture" class="details-form-control Dropdownlist-select ">
                    <option value=0>اختر اجابة</option>
                    @foreach (var a in item.Answers)
                    {



                        <option value=@a.Id imagesrc="~@a.PathImage">@a.Desc </option>
                    }
                </select>*@
                        @foreach (var a in item.Answers)
                        {
                            <label>

                                @if (a.PathImage != "")
                                {
                                    <img src="@a.PathImage" width="100" height="150" alt="@a.Id">

                                    <br />
                                }
                                @if (sewing.SewingDetails.Where(k => k.AnswerId == a.Id).FirstOrDefault() != null)
                                {
                                    <input type="radio" name="@a.QuestionId" value="@a.Id" checked>
                                }
                                else
                                {
                                    <input type="radio" name="@a.QuestionId" value="@a.Id">
                                }

                                <a style="color:white"> @a.Desc</a>

                            </label>


                        }

                    </td>

                }
                <td hidden>@item.IsRequired</td>
            </tr>
            }
        </tbody>
    </table>

    <div class="col-md-12">
        <div class="form-group">
            <button type="submit" id="createOfferbtn" onclick="fun()" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
            <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
            </a>
        </div>
    </div>
</div>



