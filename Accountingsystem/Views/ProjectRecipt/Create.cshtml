            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
        }
    }

    <script type="text/javascript">
       $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
           var _Recipt_Date = flatpickr(document.getElementById('Recipt_Date'), {
                defaultDate: currentDate
           });

           $("#Payment_Method").chosen();
           $("#Payment_Method_chosen").addClass("form-control Dropdownlist-select");

             $('#Files').change(function () {
                 $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
            $('#selectedtFiles').empty();

            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                conteLength = this.files[i].size;
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Files').empty();
                    $('#selectedtFiles').empty();
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.TotalSizeOfSelectedFiles : " + totalConteLength + " "+ "@Accountingsystem.Resources.Expenses.Byte" + '</li > ');
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.MaxOfFilesSize" + '.</li > ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Expenses.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileName : " + fileName + '</li> ');
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li> ');
                }
            }
            $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li > ');
        });

        });
    </script>

    <script>
        $('#Pay_Amount').on('input', function () {
            $("#Pay_Amount").removeClass("addRequiredFieldToInput");
        });
        $('#Recipt_Date').on('input', function () {
            $("#Recipt_Date").removeClass("addRequiredFieldToInput");
        });
        $('#Payment_Method').on('change', function () {
            $("#Payment_Method_chosen").removeClass("addRequiredFieldToInput");
            $('#Payment_Method_chosen span').css('background', '#ffffff');
            $('#Payment_Method_chosen b').css('background', '#ffffff');
        });
    </script>
    <script>
        $('#catchReceiptCreateForm').submit(function () {
            $('#subBut').prop('disabled', true);
            if ($('#Payment_Method').val() == "" || $('#Payment_Method').val() == null || $('#Payment_Method').val() < 1 || $('#Recipt_Date').val() == "" || $('#Recipt_Date').val() == null || $('#Pay_Amount').val() == null || $('#Pay_Amount').val() == "" || $('#Pay_Amount').val() <= 0) {
                $('#subBut').prop('disabled', false);
                if ($('#Payment_Method').val() == "" || $('#Payment_Method').val() == null || $('#Payment_Method').val() < 1) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ProjectReciptCreate.PaymentMethodVaildation",
                        pos: 'top-center'
                    });
                    $("#Payment_Method_chosen").addClass("addRequiredFieldToInput");
                    $('#Payment_Method_chosen span').css('background', 'red');
                    $('#Payment_Method_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Payment_Method").offset().top
                    }, 2000);
                }
                if ($('#Pay_Amount').val() == "" || $('#Pay_Amount').val() == null || $('#Pay_Amount').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ProjectReciptCreate.PaidAmountVaildation",
                        pos: 'top-center'
                    });
                    $("#Pay_Amount").addClass("addRequiredFieldToInput");
                    $('#Pay_Amount').trigger('focus');
                }

                if ($('#Recipt_Date').val() == "" || $('#Recipt_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ProjectReciptCreate.CatchReceiptDateValidation",
                        pos: 'top-center'
                    });
                    $("#Recipt_Date").addClass("addRequiredFieldToInput");
                    $('#Recipt_Date').trigger('focus');
                }

                $("#createExpensesSpinner").hide();
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }

        });
    </script>
    <script>
        $('#Recipt_Date').on('dp.change', function (e)
       {
        var selectedValue = $(this).val();
            $.ajax({
                url: '@Url.Action("CheckEndDate", "Company")',
                data: { date : selectedValue },
            type: 'get',
            }).done(function (result) {
                if (result == "" || result == null) {

                }
                else {
                    Snackbar.show({
                        text: result,
                        pos: 'top-center'
                    });
                }
            }
            );
        });

    </script>

}
