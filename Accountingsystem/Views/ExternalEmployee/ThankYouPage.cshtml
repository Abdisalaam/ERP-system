@{
    ViewBag.Title = Accountingsystem.Resources.ExternalEmployee.ThankYouPageTitle;
    HttpCookie cookie = Request.Cookies["Language"];
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_ExternalEmployeeLayout.cshtml";

            }
            else
            {
                Layout = "~/Views/Shared/_ExternalEmployeeLayoutAR.cshtml";

            }
        }
        else
        {
            Layout = "~/Views/Shared/_ExternalEmployeeLayoutAR.cshtml";
        }
    }

</head>

<div class="row" style="padding-top:20%;">
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing text-center">
                <h4 class="text-center">@Accountingsystem.Resources.ExternalEmployee.ThankYouPageTitle</h4>
                <h3 class="text-center">@Accountingsystem.Resources.ExternalEmployee.ThankYouPageMessage</h3>
            </div>
        </div>
    </div>
</div>