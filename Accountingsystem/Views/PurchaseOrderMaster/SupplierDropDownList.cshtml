@model Accountingsystem.ViewModel.PurchaseOrderMasterVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

            <div class="col-md-5">
                <div class="Dropdownlist">
                    @Html.DropDownListFor(model => model.Supplier_Id, Model.MySupplierList, Accountingsystem.Resources.SupplierCreate.SelectSupplier, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    @Html.ValidationMessageFor(model => model.Supplier_Id, "", new { @class = "text-danger" })
                    </div>

                </div>
                <span class="required-mark col-md-1"></span>

                <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.SupplierCreate.SelectSupplier>
                    <i class="fas fa-question-circle"></i>
                </div>
                <div class="col-md-5">
                    <div class="form-group">
                        <label class="control-label" for="Supplier_Id">@Accountingsystem.Resources.SupplierCreate.Supplier</label>
                        </div>
                    </div>
         
}

