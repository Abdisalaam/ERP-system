@model IEnumerable<Accountingsystem.Models.PurchaseOrderDetail>


<table class="table">
    <tr>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.Item)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.Quantity)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.ItemPrice)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.Total)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.Tax)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.TotalTaxes)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.TotalCost)
        </th>
      
    
   
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        @Html.HiddenFor(modelItem => item.Details_Id)
        @Html.HiddenFor(modelItem => item.Product_ID)
        @Html.HiddenFor(modelItem => item.Product_Tax)
        @Html.HiddenFor(modelItem => item.InvoiceMaster_Id)
        @{var thispord = "";
            var thistax = "";}
        @if (item.Product_ID != 0 || item.Product_ID != null)
        {
            thispord = Accountingsystem.Models.Product.GetProdectById(Convert.ToInt32(item.Product_ID.ToString())).Prod_Name;
        }
        else
        {
            thispord = "";
        }
        @if (item.Product_Tax.HasValue == true)
        {
            thistax = Accountingsystem.Models.Tax.GetTaxesbyId(Convert.ToInt32(item.Product_Tax.ToString())).Tax_Name;
        }
        else
        { thistax = ""; }
        <td>
            <h>@thispord</h>
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Product_Quantity)
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Product_Price)*@
            @Math.Round(item.Product_Price,2, MidpointRounding.AwayFromZero)
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
            @Math.Round(item.Total_Amount, 2, MidpointRounding.AwayFromZero)
        </td>
        <td>
            <h>@thistax</h>
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Detail_Total_Tax)*@
            @Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Detail_Total_Cost)*@
            @Math.Round(item.Detail_Total_Cost, 2, MidpointRounding.AwayFromZero)
        </td>



        <td>
            <div class="col-md-offset-2 col-md-10">
                <a href='javascript:;' onclick="@("AddDetailToMasterss('"+item.Details_Id+"')")" class="btn BTN-style final-BTN" style="text-decoration:none;">@Accountingsystem.Resources.PurchaseOrderMasterDetails.Edit</a>
            </div>
        </td>
    </tr>
}

</table>
