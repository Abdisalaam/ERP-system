    <script type="text/javascript">


     $(function () {

         var purchaseInvoiceMasterId = @Model.Master_Id;


         $("#PurchaseInvoicesDetailList").load('@(Url.Action("getDetailTtempFirst", "PurchaseOrderMaster"))?MasterID=' + purchaseInvoiceMasterId);

            $("#PurchaseInvoicesDetail").load('@(Url.Action("PreparePurchaseMasterDetails", "PurchaseOrderMaster"))');
            });

       function AddDetailToMasterers() {

            var purchaseInvoiceMasterId = @Model.Master_Id;
           var productId =  $("#Product_ID").val();
            var qty =  $("#Product_Quantity").val();
            var productPrice =  $("#Product_Price").val();
           var productTax = $("#Product_Tax").val();
           var disc = $('#Master_Discount').val();
            var PurchaseDetailsVM;
            PurchaseDetailsVM = {
            InvoiceMaster_Id:purchaseInvoiceMasterId,
            Product_ID:productId,
            Product_Price:productPrice,
            Product_Tax:productTax,
            Product_Quantity: qty,
            Master_Discount:disc
            };

            $.ajax(
            {
            url: '@Url.Action("AddPurchaseInvoiceDetailsToMaster", "PurchaseOrderMaster")',
            data: JSON.stringify(PurchaseDetailsVM),
            contentType: 'application/json',
            dataType: 'json',
            type: 'POST',
            success: function (data) {

            //alert(data);
                $("#PurchaseInvoicesDetailList").load('@(Url.Action("GetAllTempPurchaseInvoiceDetails", "PurchaseOrderMaster"))?tempPurchaseInvoiceMasterId=' + purchaseInvoiceMasterId);
                 $("#PurchaseInvoicesDetail").load('@(Url.Action("PreparePurchaseMasterDetails", "PurchaseOrderMaster"))');

            },
            error: function () { alert('error'); }
            });

            };




    </script>

    <script>
        $(document).ready(function () {
            $('.btn-primarys').on('click', function () {
                $("#partialDialogDiv").dialog({
                    autoOpen: true,
                    resizable: false,
                    title: '@Accountingsystem.Resources.SupplierCreate.AddNewSupplier',
                    modal: true,
                    height: 650,
                    width: 1000,
                    draggable: false,
                    open: function () {

                        $(this).load('@Url.Action("PartialDialog", "PurchaseOrderMaster")');

                    },
                    close: function (event, ui) {
                        $(this).dialog('close');
                    },
                    buttons: [
                    {
                        text: "OK",
                            "class": 'btn BTN-style final-BTN',
                        click: function () {
                            // OK button click event

                            $(this).dialog("close");
                            $("#SupplierDropDownList").load('@(Url.Action("GetSupplierDropdownList", "PurchaseOrderMaster"))');



                        }
                    },
                    {
                        text: "Cancel",
                        "class": 'btn BTN-style final-BTN',
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                    ],
                });
                $("#advancedSearchDialog").dialog('open');
                return false;
            });
        });
    </script>

    <script>

        $('#Supplier_Id').on('change', function () {
            $("#Supplier_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Supplier_Id_chosen span').css('background', '#ffffff');
            $('#Supplier_Id_chosen b').css('background', '#ffffff');
        });


        $('#Invoice_Date').on('input', function () {
            $("#Invoice_Date").removeClass("addRequiredFieldToInput");
        });
        $('#Master_Discount').on('input', function () {
            $("#Master_Discount").removeClass("addRequiredFieldToInput");
        });



    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            if ($('#orderDate').val() == "" || $('#orderDate').val() == null ||$('#Supplier_Id').val() == "" || $('#Supplier_Id').val() == null || $('#Master_Discount').val() == "" || $('#Master_Discount').val() == null || $('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100 || $('#invoiceMasterDetailList tr').length < 3) {
                $('#createOfferbtn').prop('disabled', false);
                event.preventDefault();

                $("#createOfferSpinner").hide();

                 if ($('#orderDate').val() == "" || $('#orderDate').val() == null) {
                    Snackbar.show({
                           text: "@Accountingsystem.Resources.InvoiceMasterDetails.InvoiceDate",
                        pos: 'top-center'
                    });
                    $("#orderDate").addClass("addRequiredFieldToInput");
                    $('#orderDate').trigger('focus');
                }
                

                if ($('#Supplier_Id').val() == "" || $('#Supplier_Id').val() == null) {
                    Snackbar.show({
                        text:"@Accountingsystem.Resources.validate.SupplierIsRequired",
                        pos: 'top-center'
                    });
                    $("#Supplier_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Supplier_Id_chosen span').css('background', 'red');
                    $('#Supplier_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedSupplierId").offset().top
                    }, 2000);
                }

                if ($('#Master_Discount').val() == "" || $('#Master_Discount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPrecentageIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }
                if ($('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPrecentageCorrectAmountMessage",
                        pos: 'top-center'
                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }



                if ($('#invoiceMasterDetailList tr').length < 3) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.validate.invoiceProductMust',
                        pos: 'top-center'
                    });
                    $("#invoiceMasterDetailList").addClass("addRequiredFieldToInput");
                    $("#Product_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#Product_ID_chosen span').css('background', 'red');
                    $('#Product_ID_chosen b').css('background', 'red');
                    $('#Product_ID_chosen').trigger('focus');
                }


                return false;



            }
            else {
                $("#createOfferSpinner").show();
            }


        });

    </script>



