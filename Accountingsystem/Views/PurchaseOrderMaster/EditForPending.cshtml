            }).done(function (result) {


                $("#PurchaseInvoicesDetailList").load('@(Url.Action("GetAllTempPurchaseInvoiceDetails", "PurchaseOrderMaster"))?tempPurchaseInvoiceMasterId=' + serialId);
            }
            );
        });
    </script>
