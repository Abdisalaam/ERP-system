@using (Html.BeginForm("EditForPending", "PurchaseOrderMaster", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Master_Id)
    @Html.HiddenFor(model => model.isCopy)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
