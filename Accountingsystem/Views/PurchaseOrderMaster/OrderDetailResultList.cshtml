
@model Accountingsystem.ViewModel.PurchaseDetailsTempVM
@{
    /**/

    decimal Totals = 0;
    decimal Totaltax = 0;
    decimal quantity = 0;
    decimal TotalBeforDiscount = 0;
    decimal cost = 0;
}

<div class="statbox widget box box-shadow">
    <div class="table-responsive">

        <table id="invoiceMasterDetailList" class="table table-hover">
            <thead>
                <tr>
                    <th>

                        @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.Item)
                    </th>
                    <th>

                        @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.Quantity)
                    </th>
                    <th>

                        @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.ItemPrice)
                    </th>
                    <th>

                        @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.Tax)
                    </th>
                    <th>

                        @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.TotalTaxes)
                    </th>
                    <th>

                        @Html.DisplayName(Accountingsystem.Resources.PurchaseOrderMasterDetails.TotalValue)
                    </th>







                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.invoiceTemp)
                {
                    @Html.HiddenFor(modelItem => item.ItemDesc)
                    @Html.HiddenFor(modelItem => item.Asset_Id)
                    @Html.HiddenFor(modelItem => item.Product_ID)

                <tr>
                    <td hidden>
                        @Html.HiddenFor(modelItem => item.Details_Id, htmlAttributes: new { @class = "Details_Id" })
                    </td>


                    <td>
                        @if (item.Product_ID != null)
                        {
                            var thisporduct = Accountingsystem.Models.Product.GetProdectById(Convert.ToInt32(item.Product_ID.ToString()));

                            <h> @thisporduct.Prod_Name</h>
                        }
                        else
                        {



                            <h> @item.ItemDesc</h>

                        }
                    </td>
                    <td>

                        @*@Html.EditorFor(modelItem => item.Product_Quantity, new { htmlAttributes = new { @class = "form-control" } })*@
                        @Html.EditorFor(model => item.Product_Quantity, new { htmlAttributes = new { onchange = "OnChangeEvent(this)", @class = "details-form-control", @type = "number", @step = "any" } })

                    </td>
                    <td>
                        @*@Html.DisplayFor(modelItem => item.Product_Price)*@
                        @Html.EditorFor(model => item.Product_Price, new { htmlAttributes = new { onchange = "OnChangeEventPrice(this)", @class = "details-form-control", @type = "number", @step = "any" } })
                    </td>
                    <td>

                        <select class="details-form-control Dropdownlist-select" onchange="OnChangeDrop(this)">
                            <option value=0>بدون ضريبة</option>
                            @foreach (var a in Accountingsystem.Models.Tax.GetAlltaxes().Where(e => e.Tax_Code.StartsWith("01") && e.IsActive != false))
                            {
                                if (a.Tax_ID == item.Product_Tax)
                                {
                                    <option value=@a.Tax_ID selected>@a.Tax_Name % @a.Tax_Percentage </option>
                                }
                                else
                                {
                                    <option value=@a.Tax_ID>@a.Tax_Name% @a.Tax_Percentage </option>
                                }
                            }
                        </select>
                    </td>
                    <td>
                        @*@Html.DisplayFor(modelItem => item.Detail_Total_Tax)*@
                        @Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)
                    </td>
                    @{Totals = Totals + item.Detail_Total_Cost;

                        Totaltax += item.Detail_Total_Tax;
                        quantity += item.Product_Quantity;
                        TotalBeforDiscount += item.Product_Quantity * item.Product_Price;
                        cost += item.Detail_Total_Cost;

                    }
                    <td>
                        @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
                        @Html.EditorFor(model => item.Detail_Total_Cost, new { htmlAttributes = new { onchange = "OnChangeEventCost(this)", @class = "details-form-control", @type = "number", @step = "any" } })
                    </td>






                    <td>
                        <a href='javascript:;' onclick="@("DeleteTemps('"+item.Details_Id+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Delete" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                    </td>



                </tr>
                }
                <tr>
                    <td hidden></td>
                    <td>
                        @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Total)
                    </td>

                    <td>


                        @Math.Round(quantity, 2, MidpointRounding.AwayFromZero)

                    </td>
                    <td></td>
                    <td></td>
                    <td>
                        @Math.Round(Totaltax, 2, MidpointRounding.AwayFromZero)

                    </td>

                    <td>
                        @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
                        @Math.Round(cost, 2, MidpointRounding.AwayFromZero)

                    </td>



                    <td></td>



                </tr>
            </tbody>

        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        var detailsTotalDiscountAmount = @Math.Round((TotalBeforDiscount + Totaltax) - cost, 2, MidpointRounding.AwayFromZero);

        var detailsTotalInvoiceAmount = @Math.Round(Totals, 2, MidpointRounding.AwayFromZero);
        $("#masterTotalDiscountAmount").html(detailsTotalDiscountAmount);

        $("#masterTotalInvoiceAmount").html(detailsTotalInvoiceAmount);
    });
</script>
<script>
    function OnChangeEvent(obj) {
        //    alert($(e).val());

        var quantity = $(obj).val();

        var detailId = $(obj).parents('tr').find('.Details_Id').val();
        var invoiceMasterId =@Model.invoice_Id;
        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePurchaseDependOnquantity", "PurchaseOrderMaster")',
                        data: { detailId: detailId, quantity: quantity, masterDiscount: masterDiscount },
                type: 'get',
            }).done(function (result) {


                  $("#PurchaseInvoicesDetailList").load('@(Url.Action("GetAllTempPurchaseInvoiceDetails", "PurchaseOrderMaster"))?tempPurchaseInvoiceMasterId=' + invoiceMasterId);
                if (result == "") {

                }
                else {
                    alert(result);
                }
            }
            );

    }







</script>
<script>
    function OnChangeEventCost(obj) {
        //    alert($(e).val());

        var TotalCost = $(obj).val()
        var detailId = $(obj).parents('tr').find('.Details_Id').val();
        var invoiceMasterId =@Model.invoice_Id;
        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePurchaseDependOnTotalCost", "PurchaseOrderMaster")',
                        data: { detailId: detailId, TotalCost: TotalCost, masterDiscount: masterDiscount },
                type: 'get',
                    }).done(function (result) {


                             $("#PurchaseInvoicesDetailList").load('@(Url.Action("GetAllTempPurchaseInvoiceDetails", "PurchaseInvoice"))?tempPurchaseInvoiceMasterId=' + invoiceMasterId);
                if (result == "") {

                }
                else {
                    alert(result);
                }
            }
            );

    }







</script>
<script>
    function OnChangeEventPrice(obj) {
        //    alert($(e).val());

        var price = $(obj).val()
        var detailId = $(obj).parents('tr').find('.Details_Id').val();
        var invoiceMasterId =@Model.invoice_Id;
        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePurchaseDependOnPrice", "PurchaseOrderMaster")',
                        data: { detailId: detailId, price: price, masterDiscount: masterDiscount },
                type: 'get',
                    }).done(function (result) {


                             $("#PurchaseInvoicesDetailList").load('@(Url.Action("GetAllTempPurchaseInvoiceDetails", "PurchaseOrderMaster"))?tempPurchaseInvoiceMasterId=' + invoiceMasterId);
                if (result == "") {

                }
                else {
                    alert(result);
                }
            }
            );

    }







</script>
<script>
    function OnChangeDrop(obj) {


        var Tax = $(obj).val()

        var detailId = $(obj).parents('tr').find('.Details_Id').val();


        var invoiceMasterId =@Model.invoice_Id;

        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePurchaseDependTax", "PurchaseOrderMaster")',
                        data: { detailId: detailId, Tax: Tax, masterDiscount: masterDiscount },
                type: 'get',
            }).done(function (result) {


                $("#PurchaseInvoicesDetailList").load('@(Url.Action("GetAllTempPurchaseInvoiceDetails", "PurchaseOrderMaster"))?tempPurchaseInvoiceMasterId=' + invoiceMasterId);

                if (result == "") {

                }
                else {
                    alert(result);
                }
            }
        );


    }







</script>
