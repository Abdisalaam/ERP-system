@model Accountingsystem.ViewModel.PurchaseOrderDetailVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
}
<div class="form-horizontal">

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


</div>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.InvoiceMasterDetails.ProductOrService)
            @{ Html.EnableClientValidation(false); }

            <div class="input-group mb-4">
                @Html.DropDownListFor(model => model.Product_ID, Model.MyProductList, Accountingsystem.Resources.InvoiceMasterDetails.SelectProduct, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                <div class="input-group-append">
                    <div class="form-control">
                        <label class="text-danger">*</label>
                    </div>
                    <button id="addProductBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#productModal">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    $(function () {
        $("#Product_ID").change(function (e) {

            var selectedValue = $(this).val();
            $.ajax({
                url: '@Url.Action("GetProductPrice", "PurchaseInvoice")',
                type: 'get',
                data: { id: selectedValue}
            }).done(function (result) {


                $("#Product_Price").val(result["Prod_Cost_Price"]);
                $("#Product_Tax").val(result["Tax_Id"]);
                var quantity = 1;
                $("#Product_Quantity").val(result[quantity]);
                AddDetailToMasterers();

            });
        });
    });

        $(document).ready(function () {
            $('.btn-dialog').on('click', function () {
                $("#partialDialogDiv").dialog({
                    autoOpen: true,
                    resizable: false,
                    title: '@Accountingsystem.Resources.PurchaseOrderMasterCreatePurchaseOrd.AddNewProduct',
                    modal: true,
                    height: 700,
                    width: 1000,
                    draggable: false,
                    open: function () {
                        $(this).load('@Url.Action("PartialDialog2", "PurchaseInvoice")');
                    },
                    close: function (event, ui) {
                        $(this).dialog('close');
                    },
                    buttons: [
                    {
                        text: "OK",
                            "class": 'btn BTN-style',
                        click: function () {
                            // OK button click event

                            //$("#partialDialogDiv").reload();
                            //$("#CustomerList").load($(this).attr('#SelectedCustomer'));

                            $(this).dialog("close");
                            $("#ProductDropDownList").load('@(Url.Action("GetProudectDropdownList", "PurchaseInvoice"))');

                        }
                    }, {
                        text: "Cancel",
                            "class": 'btn BTN-style',
                        click: function () {
                            $(this).dialog("close");
                        }
                    }
                    ],
                });
                $("#advancedSearchDialog").dialog('open');
                return false;
            });
        });
</script>


<script>
    function addProudect() {

        var ProdID = $("#Prod_ID").val();
        var ProdName = $("#Prod_Name").val();
        var ProdCode = $("#Prod_Code").val();
        var ProdDescrip = $("#Prod_Descrip").val();
        var CategoryID = $("#SelectedCategory_ID").val();
        var MeasuringUnitID = $("#SelectedMeasuringUnit_ID").val();
        var ProdMark = $("#Prod_Mark").val();
        var DemandLimit = $("#Demand_Limit").val();
        var StoreId = $("#Store_Id").val();
        var ProdStored = $("#Prod_Stored").val();
        var BarCode = $("#Bar_Code").val();
        var TaxId = $("#SelectedTaxId").val();
        var ProdSalePrice = $("#Prod_Sale_Price").val();
        var ProdcostPrice = $("#Prod_cost_Price").val();
        var DataForProudect;
        DataForProudect = {
            Prod_ID: ProdID,
            Prod_Name: ProdName,
            Prod_Code: ProdCode,
            Prod_Descrip: ProdDescrip,
            SelectedCategory_ID: CategoryID,
            SelectedMeasuringUnit_ID:MeasuringUnitID,
            Prod_Mark: ProdMark,
            Demand_Limit: DemandLimit,
            Store_Id: StoreId,
            Prod_Stored: ProdStored,
            Bar_Code: BarCode,
            SelectedTaxId: TaxId,
            Prod_Sale_Price: ProdSalePrice,
              Prod_cost_Price: ProdcostPrice
        };

        $.ajax(
         {
            url: "@Url.Action("AddNewProudectPartial", "PurchaseInvoice")",
             data: JSON.stringify(DataForProudect),
             contentType: 'application/json',
             dataType: 'json',
             type: 'POST',
             success: function (data) {
                 alert(data);



             },
             error: function () { alert('error'); }
         });
    };
</script>

<script>
    $("#Product_ID").chosen();


    $("#Product_ID_chosen").addClass("form-control Dropdownlist-select");
</script>

