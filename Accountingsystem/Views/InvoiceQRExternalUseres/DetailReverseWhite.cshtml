    <br />

    @if (Accountingsystem.Utilites.PackageRecognize.checkLanguage(Model.Description) == true)
    {

        <div style="text-align: right;">
            <span style="white-space: pre-line" dir="rtl" ;>@Model.Description</span>
        </div>
    }
    else
    {
        <div style="text-align: left;">
            <span style="white-space: pre-line" dir="ltr" ;>@Model.Description</span>
        </div>
    }

    <div>
        <table class="table" style="text-align:right; direction:rtl">
            <thead>
                <tr style="text-align:right;">

                    <th style="text-align:right">NatureOfGoodsOrServices<br />تفاصيل السلع و الخدمات</th>

                    <th style="text-align:right">MeasureUnit<br />وحدة القياس</th>




                    <th style="text-align:right">Unit Price<br />سعر الوحدة</th>
                    <th style="text-align:right">Quantity <br />الكمية</th>
                    <th style="text-align:right">Taxable Amount <br />المبلغ الخاضع للضريبة</th>
                    <th style="text-align:right">Discount Rate <br />نسبة الخصم</th>
                    <th style="text-align:right">Discount Amount <br />مبلغ الخصم</th>
                    <th style="text-align:right">Tax Rate <br />نسبة الضريبة</th>
                    <th style="text-align:right">Tax Amount <br />مبلغ الضريبة</th>
                    <th style="text-align:right">Item SubTotal(Including VAT) <br />المجموع شامل الضريبة</th>

                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model.ReversePOSDetails)
                {
                    var product = Accountingsystem.Models.Product.GetProdectById(item.Product_Id);
                    var measure = new Accountingsystem.Models.MeasuringUnit();
                    if (product != null)
                    {
                        if (product.MeasuringUnit_ID != null)
                        {
                            measure = Accountingsystem.Models.MeasuringUnit.GetMeasruingUnitById(product.MeasuringUnit_ID.Value);
                        }
                    }

                    <tr>
                        <td>

                            @product.Prod_Code @product.Prod_Name

                        </td>
                        @if (measure != null)
                        {
                            <td>
                                @measure.MUnit_Descrip
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }



                        <td>
                            @String.Format("{0:n}", Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero))
                        </td>
                        <td>

                            @String.Format("{0:n}", Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero))
                        </td>

                        <td>
                            @String.Format("{0:n}", Math.Round(item.Total_Amount - item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero))
                        </td>
                        @if (item.Detail_Discount != null)
                        {
                            <td>
                                @String.Format("{0:n}", Math.Round(item.Detail_Discount.Value, 2, MidpointRounding.AwayFromZero))
                            </td>
                            <td>
                                @String.Format("{0:n}", Math.Round(item.Detail_Discount_Amount.Value, 2, MidpointRounding.AwayFromZero))
                            </td>
                        }
                        else
                        {
                            <td>
                                0
                            </td>
                            <td>
                                0
                            </td>
                        }

                        @if (item.Product_Tax > 0)
                        {
                            var tax = Accountingsystem.Models.Tax.GetTaxesbyId(item.Product_Tax);

                            <td>

                                @tax.Tax_Percentage%

                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>

                            @String.Format("{0:n}", Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero))
                        </td>
                        <td>

                            @String.Format("{0:n}", Math.Round(item.Total_Amount, 2, MidpointRounding.AwayFromZero))
                        </td>


                    </tr>
                    if (string.IsNullOrEmpty(product.Prod_Descrip))
                    {





                    }
                    else
                    {
                        <tr dir="rtl">
                            <td style="border-top-style:hidden" colspan="7"> <span style="white-space: pre-line" dir="ltr" ;>@product.Prod_Descrip</span></td>
                        </tr>
                    }
                    counter++;
                    totals = totals + (item.Product_Quantity * item.Product_Price);
                    if (item.Detail_Total_Tax > 0)
                    {
                        totalbeforTax = totalbeforTax + (item.Total_Amount - item.Detail_Total_Tax);
                    }

                }

            </tbody>
        </table>
    </div>

    <div>
        <table width="1100" style="text-align:right;">
            @{
                var totalstr = "الاجمالي(غير شامل ضريبة القيمة المضافة";
                var taxable = "الاجمالي الخاضع للضريبة(غير شامل ضريبة القيمة المضافة";
                discount = totals * (Model.Master_Discount.Value / 100);
            }
            <thead>

                <tr style="text-align:right;">


                    <td style="text-align:center;width:300px"> @String.Format("{0:n}", Math.Round(totals, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right" width="400px">Total(Excluding VAT)</td>
                    <td style="text-align:right" width="400px">(@totalstr </td>

                </tr>
                @if (Model.Master_Discount > 0)
                {
                    <tr style="text-align:right;">


                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(discount, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right"> @Math.Round(Model.Master_Discount.Value, 2, MidpointRounding.AwayFromZero)%Discount</td>
                        <td style="text-align:right">  @Math.Round(Model.Master_Discount.Value, 2, MidpointRounding.AwayFromZero)%مجموع الخصومات</td>

                    </tr>
                }
                <tr style="text-align:right;">


                    <td style="text-align:center"> @String.Format("{0:n}", Math.Round(totalbeforTax, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right">Total Taxable Amount(Excluding VAT)</td>
                    <td style="text-align:right"> (@taxable</td>

                </tr>



                @foreach (var detailTax in Model.ReversePOSDetails.Where(a => a.Product_Tax > 0).Select(a => a.Product_Tax).Distinct())
                {
                    var taxo = Accountingsystem.Models.Tax.GetTaxesbyId(detailTax);
                    <tr style="text-align:right;">


                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(Model.ReversePOSDetails.Where(a => a.Product_Tax == detailTax).Select(a => a.Detail_Total_Tax).Sum(), 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total VAT</td>
                        <td style="text-align:right">مجموع %  @taxo.Tax_Name @taxo.Tax_Percentage</td>

                    </tr>
                }




                <tr style="text-align:right;">


                    <td style="text-align:center;font-weight:900"> @String.Format("{0:n}", Math.Round(Model.Total_Amount, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right;font-weight:900">Total Amount Due</td>
                    <td style="text-align:right;font-weight:900">صافي المبلغ المستحق</td>

                </tr>



            </thead>

        </table>
    </div>
    <br />
