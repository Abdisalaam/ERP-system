<body>

    <div class="container">
        
        <div style="text-align: center;">

            <text style="text-align: center;  font-size:30px;">اشعار دائن للفاتورة الضريبية </text>

        </div>

        <br />
        <div class="row">
            <div id="header" style="height:15%;width:100%;">

                <div style='float:left'>
                    <table width="500" border="1" @*style="margin-left:10%;"*@>
                        <tr>
                            <th style="text-align:center; padding-top:0px">
                                Notice NO
                            </th>
                            @if (Model.Number == null)
                            {
                                <td style="text-align:center; padding-top:0px">
                                    @Model.Serial_Number     - 0 @Model.Store_ID
                                </td>
                            }
                            else
                            {

                                <td style="text-align:center; padding-top:0px">
                                    @Model.Number     - 0 @Model.Store_ID
                                </td>

                            }
                            <th style="text-align:center; padding-top:0px">
                                رقم الاشعار
                            </th>



                        </tr>
                        <tr>
                            <th style="text-align:center; padding-top:0px">
                                Invoice NO
                            </th>
                            @if (Model.MasterQRInvoice.Number == null)
                            {
                                <td style="text-align:center; padding-top:0px">
                                    @Model.MasterQRInvoice.Serial_Number     - 0 @Model.Store_ID
                                </td>
                            }
                            else
                            {

                                <td style="text-align:center; padding-top:0px">
                                    @Model.MasterQRInvoice.Number     - 0 @Model.Store_ID
                                </td>

                            }
                            <th style="text-align:center; padding-top:0px">
                                رقم الفاتورة
                            </th>



                        </tr>




                    </table>
                    <br />
                    <table width="500" border="1" @*style="margin-left:10%;"*@>
                        <tr>
                            <th style="text-align:center; padding-top:0px">
                                Notice Date
                            </th>
                            <td style="text-align:center; padding-top:0px">
                                @Convert.ToDateTime(Model.Invoice_Date).ToString("dd-MM-yyyy")
                            </td>
                            <th style="text-align:center; padding-top:0px">
                                تاريخ الاشعار
                            </th>



                        </tr>






                    </table>
                </div>

                <div style=' text-align:center; '>
                    <img src="data:image/jpg;base64,@Accountingsystem.Models.TLVCls.GenerateInvoiceQRbase(Model.MasterQRInvoice.Id)" alt="Image" style="width:200px;" />

                </div>

            </div>
