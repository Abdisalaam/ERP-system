@model Accountingsystem.Models.MasterQRInvoice

@{
    Layout = null;
    decimal totals = 0;
    int counter = 1;
    var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    var settingword = Accountingsystem.Models.InvoiceWordPrintSetting.GetTheSetting();
    var customer = new Accountingsystem.Models.Customer();
    var detaildiscount = 0;
    var employee = Accountingsystem.Models.Employee.getEmpById(Model.Employee_Id);

    decimal TotalAmountbeforeDisc = 0;
    decimal discount = 0;
    decimal AfterDiscount = 0;
    decimal totalbeforTax = 0;
    decimal totalaftertax = 0;
    var branch = Accountingsystem.Models.Branch.getAddressForInvoice(Model.Branch_Id);
    if (Model.Customer_Id > 0)
    {
        customer = Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id.Value);
    }
    string dateto = null;
    string datefrom = null;
    if (Model.StartDate != null)
    {
        dateto = "الي" + Convert.ToDateTime(Model.EndDate).ToString("yyyy/MM/dd ");
        datefrom = "من" + Convert.ToDateTime(Model.StartDate).ToString("yyyy/MM/dd ");
    }
}



<!DOCTYPE html>

<html>



<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
    <!-- Bootstrap CSS -->
