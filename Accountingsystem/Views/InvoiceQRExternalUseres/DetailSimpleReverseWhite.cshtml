        }

        .column {
            float: left;
            width: 50%;
            padding: 5px;
        }



        .tho {
            text-align: left;
            padding: 16px;
        }

        * {
            box-sizing: border-box;
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
