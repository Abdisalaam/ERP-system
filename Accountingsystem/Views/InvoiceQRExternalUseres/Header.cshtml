@model Accountingsystem.Models.Branch

@{
    Layout = null;

    var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    var banks = Accountingsystem.Models.Bank.GetAllBank();
}

<!DOCTYPE html>

<html>



<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
    <!-- Bootstrap CSS -->
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }

        .column {
            float: left;
            width: 50%;
            padding: 5px;
        }



        .tho {
            text-align: left;
            padding: 16px;
        }

        * {
            box-sizing: border-box;
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>

    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />



</head>
<body>

    <div class="container">
        <div class="row">
            <div class="col-md-6">


                @if (Model.BranchLogo == null)
                {
                    <div>
                        <h style="padding-top:100px">

                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                        </h>
                    </div>
                }
                else
                {

                    <img src="data:image/jpg;base64,@Convert.ToBase64String(Model.BranchLogo )" alt="Image" style="width:200px " height="150" />


                }
            </div>
            <div class="col-md-6" style="margin-top:-160px">
                <br />
                <table style="text-align:right;" data-sortable="" width="1100">


                    <tr>
                        <td style="text-align:right;font-weight:900">@company.Comp_Name</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>
                    @if (Model.Branch_Name != null && Model.Branch_Name != "")
                    {
                        <tr>
                            <td style="text-align:right;font-weight:900">@Model.Branch_Name</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                    }
                    @if (company.Comp_Field != null)
                    {
                        <tr>
                            <td style="text-align:right;">@company.Comp_Field </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                            <td></td>
                            <td></td>
                            <td> </td>
                        </tr>
                    }
                    <tr>
                        <td style="text-align:right;"> @Model.Branch_Address  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    @if (company.CRN != null)
                    {
                        <tr>
                            <td style="text-align:right;"> @company.CRN  </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    <tr>
                        <td style="text-align:right;">@Model.Branch_Phone  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td style="text-align:right;">@Model.Branch_Email  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>
                    @if (banks.Any())
                    {
                        foreach (var bank in banks)
                        {
                            <tr>
                                <td style="text-align:right;"> @bank.Bank_Eban_Number : @bank.Bank_Name  </td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                       
                    }

                    @*<tr>
            <td style="text-align:right; padding-top:20px">
                @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                &nbsp&nbsp  : تاريخ عرض السعر
            </td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>

            <td></td>
            <td></td>
            <td> </td>
        </tr>*@


                </table>
            </div>
        </div>


</body>







</html>
