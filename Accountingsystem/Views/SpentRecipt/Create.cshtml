@using (Html.BeginForm("Create", "SpentRecipt", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.SpentReceipt_Id)
    @Html.HiddenFor(model => model.Company_Id)
    @Html.HiddenFor(model => model.Currency_Id)
    @Html.HiddenFor(model => model.SpentReceiptOrderId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.SpentReceiptCreate.SpentReceipt)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.SpentReceiptNumber)
                                    @Html.EditorFor(model => model.SpentReceipt_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.SpentReceipt_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.SpentReceiptDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.SpentReceipt_date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SpentReceipt_date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.Supplement)
                                    @Html.EditorFor(model => model.Reference, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.Value)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.SpentReceipt_Value, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SpentReceipt_Value, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.SelectPayment)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.AccountCredit_Id, Model.AccCreditList, Accountingsystem.Resources.SpentReceiptCreate.PaymentMethodInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountCredit_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(" ")
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.AccountsubCredit_Id, Model.AccsubCreditList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountsubCredit_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.Account)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.AccountDebit_Id, Model.AccDebitList, Accountingsystem.Resources.SpentReceiptCreate.AccountInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountDebit_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(" ")
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Child_AccountDepit_Id, Model.ChildList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.SpentReceiptCreate.SelectFile</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="list-unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.Description)
                                    @Html.TextAreaFor(model => model.SpentReceipt_Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.SpentReceiptCreate.Description })
                                    @Html.ValidationMessageFor(model => model.SpentReceipt_Description, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.SpentReceiptCreate.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.CatchReceiptCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>


}


