@model Accountingsystem.ViewModel.PurchaseDetailsVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()





    <div class="col-md-5">

        <div class="Dropdownlist">
            @Html.DropDownListFor(model => model.AssetId, Model.MyAssetList, Accountingsystem.Resources.AssetsReports.SelectAsset, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
            @Html.ValidationMessageFor(model => model.AssetId, "", new { @class = "text-danger" })
        </div>

    </div>
    <span class="required-mark col-md-1">*</span>
    <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.AssetsReports.SelectAsset>
        <i class="fas fa-question-circle"></i>
    </div>
    <div class="col-md-5">
        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.AssetsReports.AssetName)
        </div>
    </div>



       


}