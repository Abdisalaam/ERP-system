@model Accountingsystem.ViewModel.PurMasterVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="col-md-5">
        <div class="textfieldcont">
            @Html.DropDownListFor(model => model.SelectedSupplierId, Model.MySupplierList, Accountingsystem.Resources.SupplierCreate.SelectSupplier, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
            @Html.ValidationMessageFor(model => model.SelectedSupplierId, "", new { @class = "text-danger" })
        </div>
    </div>
    <span class="required-mark col-md-1">*</span>
    <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.SupplierCreate.SelectSupplier>
        <i class="fas fa-question-circle"></i>
    </div>
    <div class="col-md-5">
        <div class="form-group">
            @*<label class="control-label" for="SelectedSupplierId">المورد</label>*@
            @Html.Label(Accountingsystem.Resources.SupplierCreate.Supplier)

        </div>
    </div>



}

<link href="~/Content/css/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/select2.min.js" type="text/javascript"></script>
<script src="~/Scripts/UiUtils.js" type="text/javascript"></script>
<script type="text/javascript">

    $(document).ready(function () {
        fillDropdownWithResponse("@Url.Action("getProductBatchJsondrobDown", "Product")", "#SelectedSupplierId");
       

    })
</script>
