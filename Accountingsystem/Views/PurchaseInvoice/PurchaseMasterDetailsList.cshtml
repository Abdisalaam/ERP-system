@model IEnumerable<Accountingsystem.Models.PurchaseDetailsTemp>

@{
    decimal Totals = 0;
}
<table class="table">
    <tr>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PrintReports.Product)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PrintReports.ProductNumber)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.ProductQuantity)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.PriceInformation)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.TotalBeforeTax)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PrintReports.TotalTax)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PrintReports.TotalAfterTax)
        </th>

        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        @Html.HiddenFor(modelItem => item.Details_Id)
        @Html.HiddenFor(modelItem => item.Product_Tax)
        @Html.HiddenFor(modelItem => item.Asset_Id)
        @Html.HiddenFor(modelItem => item.Product_ID)
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.ItemDesc)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Product_Code)
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Product_Quantity)*@
            @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Product_Price)*@
            @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
            @Math.Round(item.Total_Amount, 2, MidpointRounding.AwayFromZero)
        </td>
        <td>
            @*@Html.DisplayFor(modelItem => item.Detail_Total_Tax)*@
            @Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)
        </td>
        @{Totals = Totals + item.Detail_Total_Cost; }
        <td>
            @*@Html.DisplayFor(modelItem => item.Detail_Total_Cost)*@
            @Math.Round(item.Detail_Total_Cost, 2, MidpointRounding.AwayFromZero)
        </td>


        <td>
            <div class="col-md-offset-2 col-md-10">
                <a href='javascript:;' onclick="@("DeleteTemp('"+item.Details_Id+"')")" class="btn BTN-style final-BTN" style="text-decoration:none;">@Accountingsystem.Resources.PurchaseInvoiceDetails.Delete</a>
            </div>

        </td>
    </tr>
    }

</table>
<div class="row" style="text-align:right;">
    <div class="col-md-1">
        <div class="textfieldcont">

        </div>
    </div>
    <div class="col-md-1">

        <div class="form-group">


        </div>
    </div>

    <div class="col-md-1">
        <div class="textfieldcont">
            <h>@Math.Round(Totals, 2, MidpointRounding.AwayFromZero)</h>
        </div>
    </div>
    <div class="col-md-1">

        <div class="form-group">
            @Accountingsystem.Resources.PrintReports.Net;

        </div>
    </div>
</div>
@Scripts.Render("~/bundles/jqueryval")