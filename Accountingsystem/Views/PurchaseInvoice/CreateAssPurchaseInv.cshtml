@using (Html.BeginForm("CreateAssPurchaseInv", "PurchaseInvoice", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.SelectedAccount_Id)
    @Html.HiddenFor(model => model.Master_Id)
    @Html.HiddenFor(model => model.SelectedCurrencyId)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.AssetPurchasesInvoice)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.AssetNumber)
                                    @Html.EditorFor(model => model.Serial_Number, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Serial_Number, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.InvoiceDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Invoice_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Invoice_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.TreasuryOrBankAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.PaymentMethod_Id, Model.PaymentMethodList, Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.TreasuryOrBankAccount, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.PaymentMethod_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.Supplier)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedSupplierId, Model.MySupplierList, Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.SelectSuplier, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedSupplierId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.SupplierInvoiceNumber)
                                    @Html.EditorFor(model => model.Supp_Inv_Serial, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Supp_Inv_Serial, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.PaymentTermsInMonths)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Payment_Policy, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Payment_Policy, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.EarnedDiscount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Fixed_Discount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control">$</span>
                                            </div>
                                            
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Fixed_Discount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.Discount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Master_Discount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control">%</span>
                                            </div>
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Master_Discount, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input form-control mb-4" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.SelectFile</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="list-unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.Description)
                                    @Html.TextAreaFor(model => model.Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div id="DueDatePartial"></div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div id="PurchaseInvoicesDetailForAsset" class="row"></div>
                    </div>

                </div>
                <div id="PurchaseInvoicesDetailListForAsset" class="col-md-12"></div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.Create <span id="createSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("IndexAssetPurchase")'>
                        @Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>

    </div>




}



