        });*@
        $(function () {
            $("#Supp_Inv_Serial").change(function (e) {
                if ($("#SelectedSupplierId").val() > 0) {
                      var serialNum = $(this).val();
                var selectedValue = $("#SelectedSupplierId").val();
                $.ajax({
                    url: '@Url.Action("CheckSerialNum", "PurchaseInvoice")',
                    type: 'get',
                    data: { supId: selectedValue, serialNum: serialNum }
                }).done(function (result) {
                    if (result > 0) {
                       Snackbar.show({
                    text: "@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.SerialNumberExisitAlready",
                    pos: 'top-center'
                    });
                        $("#Serial_Number").val(' ');
                    }
                    else {
                         Snackbar.show({
                    text: "@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.SuplierInvoiceNrIsUnique",
                    pos: 'top-center'
                    });
                    }
