    <script type="text/javascript">


          $(function () {

            var purchaseInvoiceMasterId = @Model.Master_Id;

            $("#PurchaseInvoicesDetailListForAsset").load('@(Url.Action("GetAllTempPurchaseInvoiceForAssetDetails", "PurchaseInvoice"))?tempPurchaseInvoiceMasterId=' + purchaseInvoiceMasterId);
            $("#PurchaseInvoicesDetailForAsset").load('@(Url.Action("PreparePurchaseMasterDetailsForAsset", "PurchaseInvoice"))');

        });


        function AddDetailToMaster() {
            if ($('#AssetId').val() == "" || $('#AssetId').val() == null || $('#AssetId').val() <= 0 || $('#Product_Quantity').val() == "" || $('#Product_Quantity').val() == null || $('#Product_Quantity').val() <= 0 || $('#Product_Price').val() == "" || $('#Product_Price').val() == null || $('#Product_Price').val() <= 0) {
                if ($('#AssetId').val() == "" || $('#AssetId').val() == null || $('#AssetId').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.AssetIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#AssetId_chosen").addClass("addRequiredFieldToInput");
                    $('#AssetId_chosen span').css('background', 'red');
                    $('#AssetId_chosen b').css('background', 'red');
                    $('#AssetId').trigger('focus');
                }
                if ($('#Product_Quantity').val() == "" || $('#Product_Quantity').val() == null || $('#Product_Quantity').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.QuantiyIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Product_Quantity").addClass("addRequiredFieldToInput");
                    $('#Product_Quantity').trigger('focus');
                }

                if ($('#Product_Price').val() == "" || $('#Product_Price').val() == null || $('#Product_Price').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.PriceIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Product_Price").addClass("addRequiredFieldToInput");
                    $('#Product_Price').trigger('focus');
                }
            }
            else {
                var PurInvoiceMasterTempMaster_Id = @Model.Master_Id;
            var AssetId =  $("#AssetId").val();
            var ItemDesc =  $("#ItemDesc").val();
            var qty =  $("#Product_Quantity").val();
            var productPrice =  $("#Product_Price").val();
            var productTax =  $("#SelectProduct_Tax").val();
            var Disc =  $("#Master_Discount").val();
            var PurchaseDetailsVM;
            PurchaseDetailsVM = {
                InvoiceMaster_Id:PurInvoiceMasterTempMaster_Id,
                AssetId:AssetId,
                ItemDesc:ItemDesc,
                Product_Price:productPrice,
                SelectProduct_Tax:productTax,
                Product_Quantity:qty,
                Discount:Disc
            };
            $.ajax(
             {
                 url: '@Url.Action("AddPurchaseInvoiceForAssetDetailsToMaster", "PurchaseInvoice")',
                 data: JSON.stringify(PurchaseDetailsVM),
                 contentType: 'application/json',
                 dataType: 'json',
                 type: 'POST',
                 success: function (data) {           
                     $("#PurchaseInvoicesDetailListForAsset").load('@(Url.Action("GetAllTempPurchaseInvoiceForAssetDetails", "PurchaseInvoice"))?tempPurchaseInvoiceMasterId=' + PurInvoiceMasterTempMaster_Id);
                 },
                    error: function () {
                          Snackbar.show({
                    text: "@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.ErrorMessage",
                    pos: 'top-center'
                    });

                    }
             });
            }
        };
        $(function () {
            $("#Payment_Policy").change(function (e) {
            var start = $("#Invoice_Date").val();
            var selectedValue = $("#Payment_Policy").val();
            $.ajax({
                url: '@Url.Action("GetDueDate", "PurchaseInvoice")',
                type: 'get',
                data: { pay: selectedValue, StartDate: start }
            }).done(function (result) {
                Snackbar.show({
                    text: "@Accountingsystem.Resources.PurchaseInvoiceCreateAssPurchaseInv.DueDateDisplayMessage" + " : " + result,
                    pos: 'top-center'
                    });
            });

        });
          
        });
        
        @*$(function () {
            $("#SelectedSupplierId").change(function (e) {
                var serialNum = $("#Supp_Inv_Serial").val();
                var selectedValue = $(this).val();
                $.ajax({
                    url: '@Url.Action("CheckSerialNum", "PurchaseInvoice")',
                    type: 'get',
