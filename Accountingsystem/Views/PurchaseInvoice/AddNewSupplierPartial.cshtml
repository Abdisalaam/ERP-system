                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Purchase_Price, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Purchase_Price, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.SupplierCreate.PriceSlice)
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.Payment_Policy_Id, Model.MyPaymentPolicy, Accountingsystem.Resources.SupplierCreate.SelectPaymentPolicy, htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.Payment_Policy_Id, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Payment_Policy_Id, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Supp_Website, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Supp_Website, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Supp_Website, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>

            </div>
        </div>

    </div>
}


<div class="modal-footer">
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">

            <a href='javascript:;' onclick='addSupplier();' class="btn btn-primary" style="text-decoration:none;">@Accountingsystem.Resources.SupplierCreate.CreateSupplier</a>
        </div>
    </div>
</div>




    <script type="text/javascript">

        $(function () {

            $("#SelectedCountryId").change(function (e) {

                var selectedText = $(this).find("option:selected").text();

                var selectedValue = $(this).val();

                $.ajax({

                    url: '@Url.Action("GetProvinces", "Supplier")',
                    type: 'get',
                    data: { countryId: selectedValue }
                }).done(function (result) {

                    $("#SelectedProvinceId").empty();



                    for (var i = 0; i < result.length; i++) {
                        var item = result[i];
                        var p = new Option(result[i].Text, result[i].Value);
                        $("#SelectedProvinceId").append(p)

                    }
                    GetAllcity();

                });
            });

            function GetAllcity() {

                var selectedValue = $("#SelectedProvinceId").val();

                $.ajax({

                    url: '@Url.Action("GetCities", "Supplier")',
                    type: 'get',
                    data: { provinceId: selectedValue }
                }).done(function (result) {

                    $("#SelectedCityId").empty();

                    for (var i = 0; i < result.length; i++) {
                        var item = result[i];
                        var p = new Option(result[i].Text, result[i].Value);
                        $("#SelectedCityId").append(p)

                    }

                });
            }

            $("#SelectedProvinceId").change(function (e) {

                var selectedText = $(this).find("option:selected").text();

                var selectedValue = $(this).val();

                $.ajax({

                    url: '@Url.Action("GetCities", "Supplier")',
                    type: 'get',
                    data: { provinceId: selectedValue }
                }).done(function (result) {

                    $("#SelectedCityId").empty();

                    for (var i = 0; i < result.length; i++) {
                        var item = result[i];
                        var p = new Option(result[i].Text, result[i].Value);
                        $("#SelectedCityId").append(p)

                    }

                });


            });
        });


    </script>

