                        <div class="form-group">
                            @Html.LabelFor(model => model.Files, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                    <div class="col-md-6">
                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple" })
                        @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Supp_Code, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Supp_Code, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Supp_Code, htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Supp_Name, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Supp_Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Supp_Name, htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Supp_Phone, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Supp_Phone, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Supp_Phone, htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Supp_Mail, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Supp_Mail, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Supp_Mail, htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedCountryId, Model.MyCountryList, Accountingsystem.Resources.SupplierCreate.CountryInformation, htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.SelectedCountryId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.SupplierCreate.Country)
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedProvinceId, Model.MyProvinceList, Accountingsystem.Resources.SupplierCreate.GovernorateInformation, htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.SelectedProvinceId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.SupplierCreate.Governorate)
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedCityId, Model.MyCitiesList, Accountingsystem.Resources.SupplierCreate.CityInformation, htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.SelectedCityId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.SupplierCreate.City)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Supp_Address, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Supp_Address, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Supp_Address, htmlAttributes: new { @class = "control-label" })
