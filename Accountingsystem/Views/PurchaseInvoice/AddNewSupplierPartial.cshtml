@model Accountingsystem.ViewModel.SupplierVM

@{
    ViewBag.Title = "Purchase Invoice";

}

<h2>@Accountingsystem.Resources.SupplierCreate.CreateNewSupplier</h2>

@using (Html.BeginForm("AddNewSupplierPartial", "PurchaseInvoice", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Supp_Code)
    <div class="form-horizontal">



        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="container">
