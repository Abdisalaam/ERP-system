    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            if ($('#Invoice_Date').val() == "" || $('#Invoice_Date').val() == null || $('#Payment_Policy').val() == "" || $('#Payment_Policy').val() == null || $('#SelectedSupplierId').val() == "" || $('#SelectedSupplierId').val() == null || $('#Master_Discount').val() == "" || $('#Master_Discount').val() == null || $('#Fixed_Discount').val() == "" || $('#Fixed_Discount').val() == null || $('#Fixed_Discount').val() < 0 || $('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100 || $('#invoiceMasterDetailList tr').length < 3) {
                $('#createOfferbtn').prop('disabled', false);
                event.preventDefault();
                $("#createOfferSpinner").hide();
                if ($('#Invoice_Date').val() == "" || $('#Invoice_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.DateIsRequired",
                        pos: 'top-center'
                    });
                    $("#Invoice_Date").addClass("addRequiredFieldToInput");
                    $('#Invoice_Date').trigger('focus');
                }
                if ($('#Payment_Policy').val() == "" || $('#Payment_Policy').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.PaymentPoiceIsRequired",
                        pos: 'top-center'
                    });
                    $("#Payment_Policy").addClass("addRequiredFieldToInput");
                    $('#Payment_Policy').trigger('focus');
                }

                if ($('#SelectedSupplierId').val() == "" || $('#SelectedSupplierId').val() == null) {
                    Snackbar.show({
                        text:"@Accountingsystem.Resources.validate.SupplierIsRequired",
                        pos: 'top-center'
                    });
                    $("#SelectedSupplierId_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedSupplierId_chosen span').css('background', 'red');
                    $('#SelectedSupplierId_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedSupplierId").offset().top
                    }, 2000);
                }

                if ($('#Master_Discount').val() == "" || $('#Master_Discount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPrecentageIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }
                if ($('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPrecentageCorrectAmountMessage",
                        pos: 'top-center'
                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }

                if ($('#Fixed_Discount').val() == "" || $('#Fixed_Discount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AlouwedDiscountIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Fixed_Discount").addClass("addRequiredFieldToInput");
                    $('#Fixed_Discount').trigger('focus');
                }

                if ($('#Fixed_Discount').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AlouwedDiscountCorrectAmountMessage",
                        pos: 'top-center'
                    });
                    $("#Fixed_Discount").addClass("addRequiredFieldToInput");
                    $('#Fixed_Discount').trigger('focus');
                }

                if ($('#invoiceMasterDetailList tr').length < 3) {
                    Snackbar.show({
                        text: '"@Accountingsystem.Resources.validate.invoiceProductMust"',
                        pos: 'top-center'
                    });
                    $("#invoiceMasterDetailList").addClass("addRequiredFieldToInput");
                    $("#SelectedProductId_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedProductId_chosen span').css('background', 'red');
                    $('#SelectedProductId_chosen b').css('background', 'red');
                    $('#SelectedProductId_chosen').trigger('focus');
                }


                return false;



            }
            else {
                $("#createOfferSpinner").show();
            }


        });

    </script>
