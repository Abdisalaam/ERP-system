    if (Model.isCopy == 1)
    {
        ViewBag.Title = Accountingsystem.Resources.PurchaseInvoiceCreatePurchase.CreatePurchaseInvoice;
    }
    else
    {
        ViewBag.Title = Accountingsystem.Resources.PurchaseInvoiceEditForPending.EditPurchaseInvoice;
    }
    Model.SelectedCurrencyId = 1;
