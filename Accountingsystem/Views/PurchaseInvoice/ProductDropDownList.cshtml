@model Accountingsystem.ViewModel.PurchaseDetailsVM
@using (Html.BeginForm())
{



    <div class="col-md-6">
        <div class="col-md-5">
            <div class="textfieldcont">
                <div class="Dropdownlist">
                    @Html.DropDownListFor(model => model.SelectedProductId, Model.MyProductList, Accountingsystem.Resources.PurchaseInvoiceIndex.SelectItem, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    @Html.ValidationMessageFor(model => model.SelectedProductId, "", new { @class = "text-danger" })

                </div>
            </div>
        </div>
        <span class="required-mark col-md-1">*</span>

        <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.PurchaseInvoiceCreatePurchase.ItemName>
            <i class="fas fa-question-circle"></i>
        </div>
        <div class="col-md-5">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.PurchaseInvoiceCreatePurchase.ItemName)
            </div>
        </div>
    </div>



}


<script type="text/javascript">

    $(function () {
        $("#SelectedProductId").change(function (e) {

            var selectedValue = $(this).val();
            $.ajax({
                url: '@Url.Action("GetProductPrice", "PurchaseInvoice")',
                type: 'get',
                data: { id: selectedValue}
            }).done(function (result) {


                $("#Product_Price").val(result["Prod_Cost_Price"]);
                $("#SelectProduct_Tax").val(result["Tax_Id_Purch"]);
                AddDetailToMasterers();

            });
        });
    });
</script>

<link href="~/Content/css/select2.min.css" rel="stylesheet" />
<script src="~/Scripts/select2.min.js" type="text/javascript"></script>
<script src="~/Scripts/UiUtils.js" type="text/javascript"></script>
<script type="text/javascript">

    $(document).ready(function () {
        fillDropdownWithResponse("@Url.Action("getProductBatchJsondrobDown", "Product")", "#SelectedProductId");
        @*fillDropdownWithResponse("@Url.Action("getProductBatchJsondrobDown", "Product")", "#productNotBatched_ID");*@
    })
</script>