@model IEnumerable<Accountingsystem.Models.PurInvoiceMaster>


@{
    ViewBag.Title = Accountingsystem.Resources.PurchaseInvoiceIndex.PurchaseInvoicesList;

    var mesg = ViewBag.msg;
    HttpCookie cookie = Request.Cookies["Language"];
    var package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
    int count = 1;
    var sup = new Accountingsystem.Models.Supplier(); ;
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }




</head>



<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">


                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "Index",new {all=1 })"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.validate.ALL</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "CreatePurchaseInv",new { supId = 0 })"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.PurchaseInvoiceIndex.CreatePurchaseInvoice</a>
                                        </div>
                                    </li>




                                </ul>

                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->
    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div class="text-center">
            @Accountingsystem.Resources.PurchaseInvoiceIndex.PurchaseInvoicesList
        </div>

        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>

                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterIndex.Number)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterIndex.InvoiceNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.validate.InvoiceSup)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterIndex.InvoiceDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterIndex.DueDateOfInvoice)
                        </th>
                        @if (package.Number_store > 1)
                        {
                            <th>
                                @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterIndex.StoreName)
                            </th>
                        }


                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterIndex.Net)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.PurchaseInvoiceIndex.SupplierNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.PurchaseInvoiceIndex.SupplierName)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.PurchaseInvoiceIndex.SupplierBalance)
                        </th>



                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterIndex.InvoiceCase)
                        </th>

                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td>
                            @count
                            @{count = count + 1;}
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Serial_Number)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Supp_Inv_Serial)
                        </td>
                        <td>
                            @item.Invoice_Date.ToString("yyyy/MM/dd ")
                        </td>
                        <td>
                            @item.Due_Date.Value.ToString("yyyy/MM/dd ")
                        </td>
                        @if (package.Number_store > 1)
                        {
                            <td>

                                @{ if (item.Store_ID == null || item.Store_ID == 0)
                                    {

                                    }
                                    else

                                    {
                                        var store = Accountingsystem.Models.Store.GetStoreById(item.Store_ID.Value);
                                        <h>@store.Store_Name</h> }
                                }
                            </td>
                        }





                        <td>

                            @Math.Round(item.Total_Cost, 2, MidpointRounding.AwayFromZero)
                        </td>
                        @if (item.Supplier_Id == 0 || item.Supplier_Id == null)
                        {
                            <td></td>
                            <td></td>
                            <td></td>
                        }
                        else
                        {
                             sup = Accountingsystem.Models.Supplier.GetSupplierById(item.Supplier_Id);
                            <td>
                                @sup.Supp_Code
                            </td>
                            <td>
                                @sup.Supp_Name
                            </td>
                            <td>
                                @{String SupBalance = "";
                                    decimal account = Accountingsystem.Models.Accounts.RefreshTheBallanceOfCustomer(sup.Supp_Code);
                                    if (Math.Round(account, 2, MidpointRounding.AwayFromZero) < 0)
                                    {
                                        SupBalance = "(" + (Math.Round(account, 2, MidpointRounding.AwayFromZero) * -1).ToString() + ")";
                                    }
                                    else
                                    {
                                        SupBalance = Math.Round(account, 2, MidpointRounding.AwayFromZero).ToString();
                                    }

                                    @SupBalance
                                }
                            </td>
                        }
                        <td>
                            @Html.DisplayFor(modelItem => item.Invoice_State)
                        </td>
                        <td>
                            <div class="btn-group">

                                <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                    <a href="@Url.Action( "Details", new { id = item.Master_Id })" class="dropdown-item">
                                        @Accountingsystem.Resources.InvoiceMasterIndex.Details
                                    </a>
                                    @if (item.Invoice_State.ToString() == "Pending" && Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع") && !User.IsInRole("مساعد محاسب"))
                                    {
                                        <a class="dropdown-item" href="@Url.Action("EditForPending", new { id = item.Master_Id ,isCopy=0})">
                                            @Accountingsystem.Resources.InvoiceMasterIndex.Edit
                                        </a>
                                    }
                                    <a class="dropdown-item" href='@Url.Action("PrintPurchaseInvoiceNew", new { controller = "Reports", id = item.Master_Id })'>
                                        @Accountingsystem.Resources.InvoiceMasterIndex.Print
                                    </a>
                                    @if (sup != null)
                                    {
                                    <a href='@Url.Action("FillGlForCreateSettelment", new { controller = "GLMaster", code = sup.Supp_Code })' class="dropdown-item">
                                        @Accountingsystem.Resources.validate.SettlementGL
                                    </a>
                                    }
                                </div>
                            </div>

                        </td>


                    </tr>
                    }
                </tbody>
                
            </table>
        </div>
    </div>

</div>


@section Scripts {

