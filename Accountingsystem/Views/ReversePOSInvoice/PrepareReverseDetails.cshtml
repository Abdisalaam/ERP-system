@model Accountingsystem.ViewModel.ReversePOSDetailVM
@{ var product = Accountingsystem.Models.Product.GetProdectById(Model.Product_Id).Prod_Name; }
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">

    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Details_Id)
    @Html.HiddenFor(model => model.SalesReceiptMasterTempMaster_Id)
    @Html.HiddenFor(model => model.Product_Id)
    @Html.HiddenFor(model => model.Master_Id)
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.ReversePOSInvoiceDetails.Product)
                <h3 class="form-control mb-4">@product</h3>

            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.ReversePOSInvoiceDetails.Quantity)
                @Html.EditorFor(model => model.Product_Quantity, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })

            </div>
        </div>

    </div>


</div>
    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">

            <a href='javascript:;' onclick='AddOrder();' class="btn btn-outline-info mb-2" style="text-decoration:none;">@Accountingsystem.Resources.ReversePOSInvoiceDetails.AddToRegulation</a>
        </div>
    </div>

}


