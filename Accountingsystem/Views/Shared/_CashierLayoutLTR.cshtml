@using Microsoft.AspNet.Identity
@{ var package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
    Accountingsystem.Models.ProductBatches.CreateProductBatch();
    Accountingsystem.Models.ChartOfAccounting.changeAccountValue();
    var usermanger = User.Identity.GetUserId();
    var usermangername = User.Identity.GetUserName();
    var role = Accountingsystem.Models.SystemRole.getsystemFunctionByUser(usermanger);
    var expence = true;
    var project = true;
    var hr = true;
    var subscript = true;
    var asset = true;
    var Accounting = true;
    var ChartOfAccount = true;
    var Report = true;
    var Maintenance = false;
    var Casher = false;
    var sewing = false;
    var Supplier = true;
    var purchase = true;
    var sales = true;
    var commissions = false;
    var Attendingandleaving = false;
    var numberOfStore = 5000;
    var numberofPOS = 5000;
    var subledger = 5000;
    var store = 5000;
    var lang = "";
    HttpCookie cookie = Request.Cookies["Language"];
    if (cookie == null || cookie.Value == null || cookie.Value == "ar")
    {
        lang = "ar";
    }
    else
    {
        lang = "en";
    }
    if (package != null)
    {
        if (package.Expenses != null)
        {
            expence = package.Expenses.Value;
        }
        if (package.Casher != null)
        {
            Casher = package.Casher.Value;
        }
        if (package.Commission != null)
        {
            commissions = package.Commission.Value;
        }
        if (package.Accounting != null)
        {
            Accounting = package.Accounting.Value;
        }
        if (package.ChartOfAccount != null)
        {
            ChartOfAccount = package.ChartOfAccount.Value;
        }
        if (package.ReportsAndPending != null)
        {
            Report = package.ReportsAndPending.Value;
        }
        if (package.Maintenance != null)
        {
            Maintenance = package.Maintenance.Value;
        }
        if (package.Suppliers != null)
        {
            Supplier = package.Suppliers.Value;
        }
        if (package.Purchase != null)
        {
            purchase = package.Purchase.Value;
        }
        if (package.Sales != null)
        {
            sales = package.Sales.Value;
        }
        if (package.Attendingandleaving != null)
        {
            Attendingandleaving = package.Attendingandleaving.Value;
        }
        if (package.Sewing != null)
        {
            sewing = package.Sewing.Value;
        }
        project = package.Project;
        hr = package.HR;
        asset = package.Asset;
        subscript = package.Subscribtion;
        numberOfStore = package.Number_store;
        numberofPOS = package.Number_POS;
        subledger = package.Number_subLedgger;
        store = package.Number_store;
    }
}
