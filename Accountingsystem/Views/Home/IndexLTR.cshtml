@model Accountingsystem.ViewModel.TotalDashBoardVM
@{
    Layout = "~/Views/Shared/_LayoutLTR.cshtml";
    ViewBag.Title = Accountingsystem.Resources.List.Dashboard;
    var totalProfit = (Math.Round(Model.revenu, 2, MidpointRounding.AwayFromZero) - (Math.Round(Model.Expences, 2, MidpointRounding.AwayFromZero) + Math.Round(Model.CostOfSales, 2, MidpointRounding.AwayFromZero)));
}


<head>
    <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/ContentLTR/plugins/apex/apexcharts.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/ContentLTR/assets/css/dashboard/dash_1.css")" rel="stylesheet" type="text/css" />
</head>
<!--  BEGIN CONTENT AREA  -->
<div class="row layout-top-spacing">
    <div class="col-md-12">
        <h4 style="text-align:center">
            @ViewBag.Message
        </h4>
    </div>
</div>
<div class="layout-px-spacing" style="letter-spacing:normal !important">
    <div class="row layout-top-spacing">
        <div class="col-xl-8 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="widget widget-chart-one">
                <div class="widget-heading">
                    <h4 class="">@Accountingsystem.Resources.List.IncomeAndExpences</h4>
                    <ul class="tabs tab-pills">
                        <li><a href="javascript:void(0);" id="tb_1" class="tabmenu">@Accountingsystem.Resources.List.Monthly</a></li>
                    </ul>
                </div>
                <div class="widget-content">

                    <div class="tabs tab-content">
                        <div id="content_1" class="tabcontent">
                            <div id="revenueMonthly"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="widget widget-chart-two">
                <div class="widget-heading">
                    <h5 class="">@Accountingsystem.Resources.List.BanksAndTreasury</h5>
                </div>
                <div class="widget-content">
                    <div id="chart-2" class=""></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-6 col-md-6 col-sm-6 col-12 layout-spacing">
            <div class="widget-two">
                <div class="widget-content">
                    <div class="w-numeric-value">
                        <div class="w-content">
                            <span class="w-value">@Accountingsystem.Resources.List.DailySales</span>
                            <span class="w-numeric-title">@Accountingsystem.Resources.List.GoToColumns</span>
                        </div>
                        <div class="w-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-dollar-sign"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                        </div>
                    </div>
                    <div class="w-chart">
                        <div id="daily-sales"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-6 col-md-6 col-sm-6 col-12 layout-spacing">
            <div class="widget-three">
                <div class="widget-heading">
                    <h5 class="">@Accountingsystem.Resources.List.Summary</h5>
                </div>
                <div class="widget-content">
                    <div class="order-summary">
                        <div class="summary-list">
                            <div class="w-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-bag"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                            </div>
                            <div class="w-summary-details">

                                <div class="w-summary-info">
                                    <h6>@Accountingsystem.Resources.List.Income</h6>
                                    <p class="summary-count" dir="ltr">@Math.Round(Model.revenu, 2, MidpointRounding.AwayFromZero)</p>
                                </div>
                                <div class="w-summary-stats">
                                    <div class="progress">
                                        <div class="progress-bar bg-gradient-secondary" role="progressbar" style="width: 90%" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="summary-list">
                            <div class="w-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-tag"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7" y2="7"></line></svg>
                            </div>
                            <div class="w-summary-details">
                                @{ }
                                <div class="w-summary-info">
                                    <h6>@Accountingsystem.Resources.List.Profit</h6>
                                    <p class="summary-count">@totalProfit</p>
                                </div>
                                <div class="w-summary-stats">
                                    <div class="progress">
                                        @{
                                            if (totalProfit < 0)
                                            {
                                                <div class="progress-bar bg-gradient-success" role="progressbar" style="width: 65%" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                                            }
                                            else
                                            {
                                                <div class="progress-bar bg-gradient-danger" role="progressbar" style="width: 65%" aria-valuenow="65" aria-valuemin="0" aria-valuemax="100"></div>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="summary-list">
                            <div class="w-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-credit-card"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
                            </div>
                            <div class="w-summary-details">

                                <div class="w-summary-info">
                                    <h6>@Accountingsystem.Resources.List.Expense</h6>
                                    <p class="summary-count" dir="ltr">@(Math.Round(Model.Expences, 2, MidpointRounding.AwayFromZero) + Math.Round(Model.CostOfSales, 2, MidpointRounding.AwayFromZero))</p>
                                </div>
                                <div class="w-summary-stats">
                                    <div class="progress">
                                        <div class="progress-bar bg-gradient-warning" role="progressbar" style="width: 80%" aria-valuenow="80" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-12 col-md-6 col-sm-12 col-12 layout-spacing">
            <div class="widget-one">
                <div class="widget-content">
                    <div class="w-numeric-value">
                        <div class="w-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        </div>
                        <div class="w-content">
                            <span id="inventoryTotalBalance" class="w-value"></span>
                            <span class="w-numeric-title">@Accountingsystem.Resources.List.StorageDepartment</span>
                        </div>
                    </div>
                    <div class="w-chart">
                        <div id="total-orders"></div>
                    </div>
                </div>
            </div>
        </div>
        <div id="myAllPendingDocuments" class="col-xl-6 col-lg-12 col-md-6 col-sm-12 col-12 layout-spacing">

        </div>
        <div id="chartArea" class="col-xl-6 col-lg-12 col-md-6 col-sm-12 col-12 layout-spacing">
            <div class="statbox widget box box-shadow">
                <div class="widget-header">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-sm-12 col-12">
                            <h4>@Accountingsystem.Resources.List.CustomersAndSupliersTitle</h4>
                        </div>
                    </div>
                </div>
                <div class="widget-content widget-content-area">
                    <div id="s-line-area" class=""></div>

                </div>
            </div>
        </div>


        <input type="hidden" value="@Accountingsystem.Utilites.PackageRecognize.alertForRenew()" id="h_var1" />

    </div>
</div>

<!--  END CONTENT AREA  -->

@section Scripts {


    <script src="@Url.Content("~/ContentLTR/plugins/apex/apexcharts.min.js")" charset="utf-8" type="text/javascript"></script>
    <script src="@Url.Content("~/ContentLTR/assets/js/dashboard/dash_1.js")" charset="utf-8" type="text/javascript"></script>
    <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $("#myAllPendingDocuments").load('@(Url.Action("GetAllPendingsDocuments", "Home"))');
        });
    </script>
    <script>
        var var1 = $("#h_var1").val();
        if (var1 == null || var1 == "") {

        }
        else {
            Snackbar.show({
                text: var1,
                pos: 'top-center'
            });
        }
    </script>

}