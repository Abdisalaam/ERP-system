@model IEnumerable<Accountingsystem.ViewModel.AllSectionPendingVM>

@{

    var count = 1;

}

<div class="widget widget-table-one">
    <div class="widget-heading">
        <h5 class="">@Accountingsystem.Resources.List.UncommitedDocuments</h5>
    </div>
    <div class="widget-content">
        @foreach (var item in Model)
        {
            <div class="transactions-list">
                <div class="t-item">
                    <div class="t-company-name">
                        <div class="t-icon">
                            <div class="icon">
                                @count
                                @{count = count + 1;}
                            </div>
                        </div>
                        <div class="t-name">
                            <h4>@Html.DisplayFor(modelItem => item.Serial)</h4>
                            <p class="meta-date">@Html.DisplayFor(modelItem => item.date)</p>
                        </div>
                    </div>
                    <div class="t-rate rate-inc">
                        <p>
                            <span>@Math.Round(item.TotalAmount, 2, MidpointRounding.AwayFromZero)</span>
                            @if (item.Serial.StartsWith("PUR"))
                            {
                                <a href="@Url.Action("Details", "PurchaseInvoice", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                            else if (item.Serial.StartsWith("REVP"))
                            {
                                <a href="@Url.Action("Details", "RecalPurchInvoiceMaster", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                            else if (item.Serial.StartsWith("PAY"))
                            { <a href="@Url.Action("Details", "Payment", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                            else if (item.Serial.StartsWith("TMain"))
                            { <a href="@Url.Action("Details", "TransferToMaintenance", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                            else if (item.Serial.StartsWith("PINV"))
                            { <a href="@Url.Action("DetailsofInvoice", "Project", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
