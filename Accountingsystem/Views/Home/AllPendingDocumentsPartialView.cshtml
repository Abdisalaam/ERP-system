                                </a>
                            }
                            else if (item.Serial.StartsWith("REC"))
                            { <a href="@Url.Action("Details", "Receipt", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                            else if (item.Serial.StartsWith("SPRE"))
                            { <a href="@Url.Action("Details", "SpentRecipt", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                            else if (item.Serial.StartsWith("CARECI"))
                            { <a href="@Url.Action("Details", "CatchReceipt", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                         else if (item.Serial.StartsWith("EXP") && item.TotalAmount > 0)
                            { <a href="@Url.Action("DetailsNew", "Expense", new { id = item.MasterID })" class="BTN-style">
                                   <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                              </a>
                            }
                            else if (item.Serial.StartsWith("EXP"))
                            { <a href="@Url.Action("Details", "Expense", new { id = item.MasterID })" class="BTN-style">
                               <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                              </a>
                            }
                            else if (item.Serial.StartsWith("SUBS"))
                            { <a href="@Url.Action("Details", "Subscription", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                            else if (item.Serial.StartsWith("SETSTO"))
                            { <a href="@Url.Action("Details", "SettlementOfStores", new { id = item.MasterID })" class="BTN-style">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trello"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="9"></rect><rect x="14" y="7" width="3" height="5"></rect></svg>
                                </a>
                            }
                        </p>
                    </div>
                </div>
            </div>
        }

        </div>
</div>

