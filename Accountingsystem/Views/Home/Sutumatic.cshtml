                    <h3> <img class="SUTUMATIC-LOGO" src="~/Content/Images/Sutumatic/Asset 1.png" /></h3>
                    @if (HttpContext.Current.Request.Cookies["Language"] == null)
                    {

                        HttpCookie cookie = HttpContext.Current.Request.Cookies["Language"];
