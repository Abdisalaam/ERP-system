                        HttpCookie cookie = HttpContext.Current.Request.Cookies["Language"];
                        if (cookie != null && cookie.Value != null)
                        {
                            <p dir="auto" class="about-P" style="text-align:left;">
                                @HomeSutumatic.SUTUMATICLOGO
