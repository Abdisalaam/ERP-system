@model Accountingsystem.Models.Tax

@{
    ViewBag.Title = Accountingsystem.Resources.TaxDetails.TaxData;
    HttpCookie cookie = Request.Cookies["Language"];
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";

        }
    }


</head>

<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <h3 class="text-center"></h3>
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                        @Accountingsystem.Resources.TaxDetails.TaxData
                    </div>
                    <hr />
                </div>
            </div>
        </div>

        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TaxDetails.TaxName)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Tax_Name)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TaxDetails.TaxType)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Tax_Type)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TaxDetails.TaxNumber)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Tax_Code)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TaxDetails.TaxPercentage)
                                        </div>
                                        <div>
                                            @Math.Round(Model.Tax_Percentage, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row layout-top-spacing">
            <div class="col-md-12">
                <div class="form-group">
                    <a id="EditTax" class="btn btn-block btn-outline-primary mb-lg-0" href="@Url.Action("Edit", new { id = Model.Tax_ID })">
                        @Accountingsystem.Resources.TaxDetails.Edit
                        <span id="EditTaxSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                    <a id="ChangeTaxCase" class="btn btn-block btn-outline-primary mb-lg-0" href="@Url.Action("Delete", new { id = Model.Tax_ID })">
                        @Accountingsystem.Resources.TaxDetails.ChangeActivationCase
                        <span id="ChangeTaxCaseSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>

                    <a id="BackToList" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index")">
                        @Accountingsystem.Resources.TaxDetails.BackToList
                        <span id="BackToListSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>



@section scripts{

    <script>
        $("#EditTax").click(function (e) {
            $("#EditTaxSpinner").show();
        });
        $("#ChangeTaxCase").click(function (e) {
            $("#ChangeTaxCaseSpinner").show();
        });
       
        $("#BackToList").click(function (e) {
            $("#BackToListSpinner").show();
        });
    </script>
}

