@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>



        }
    }

    <script type="text/javascript">

            $(document).ready(function () {

                if ($('.chosen-container').length > 0) {
                    $('.chosen-container').on('touchstart', function (e) {
                        e.stopPropagation(); e.preventDefault();
                        $(this).trigger('mousedown');

                    });
                }
                if (@Model.rewardsAndPenaltiesCodingCategory.Id> 3) {

                   
                    $("#min").hide();

                    $("#hour").hide();
                    $("#day").show();

                }
                else {
                 
                    $("#min").show();
                    $("#hour").show();
                    $("#day").hide();
                }
               
               
                
                $("#backToListBtn").click(function (e) {
                    $("#backTolistBtnSpinner").show();
                });
                $("#RewardsAndPenaltiesCodingCategoryId").chosen();
                $("#RewardsAndPenaltiesCodingCategoryId_chosen").addClass("form-control Dropdownlist-select");
                $("#TypeOfDetailSalaryId").chosen();
                $("#TypeOfDetailSalaryId_chosen").addClass("form-control Dropdownlist-select");

                return false;
            });


    </script>

    <script>

        $('#offerCreateMasterForm').submit(function () {
            debugger
            var DurationInMinute = parseFloat($('#DurationInMinute').val());
            var DurationInDay = parseFloat($('#DurationInDay').val());
            var DurationInhour = parseFloat($('#DurationInhour').val());

            var RewordinHour = parseFloat($('#RewordinHour').val());
            var RewordInDay = parseFloat($('#RewordInDay').val());

            var Name = $('#Name').val();
                $('#createOfferbtn').prop('disabled', true);
            if ($('#Name').val() == "" || $('#Name').val() == null 
                   /* ||(DurationInMinute == 0 && DurationInDay == 0 && DurationInhour == 0)*/ ||
                    (RewordinHour == 0 && RewordInDay == 0 )
                ) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createExpensesSpinner").hide();
                    if ($('#Name').val() == "" || $('#Name').val() == null) {
                    Snackbar.show({
                       text:"@Accountingsystem.Resources.Atttendace.Name",
                        pos: 'top-center'
                    });
                        $("#Name").addClass("addRequiredFieldToInput");
                        $('#Name').trigger('focus');
                }
                    if ($('#RewardsAndPenaltiesCodingCategoryId').val() == "" || $('#RewardsAndPenaltiesCodingCategoryId').val() == null) {
                    Snackbar.show({
                         text:"@Accountingsystem.Resources.Atttendace.Type",
                        pos: 'top-center'
                    });
                        $("#RewardsAndPenaltiesCodingCategoryId").addClass("addRequiredFieldToInput");
                        $('#RewardsAndPenaltiesCodingCategoryId').trigger('focus');
                    }
                    if ($('#TypeOfDetailSalaryId').val() == "" || $('#TypeOfDetailSalaryId').val() == null || $('#TypeOfDetailSalaryId').val() == "0") {
                    Snackbar.show({
                        text: "ادخل مفرد المرتب",
                        pos: 'top-center'
                    });
                        $("#TypeOfDetailSalaryId").addClass("addRequiredFieldToInput");
                        $('#TypeOfDetailSalaryId').trigger('focus');
                    }
                    @*if (DurationInMinute == 0 && DurationInDay == 0 && DurationInhour == 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Atttendace.duration",
                        pos: 'top-center'
                    });
                        //$("#TypeOfDetailSalaryId").addClass("addRequiredFieldToInput");
                        //$('#TypeOfDetailSalaryId').trigger('focus');
                }*@
                    if (RewordinHour == 0 && RewordInDay == 0) {
                    Snackbar.show({
                         text:"@Accountingsystem.Resources.Atttendace.procedure",
                        pos: 'top-center'
                    });
                        //$("#TypeOfDetailSalaryId").addClass("addRequiredFieldToInput");
                        //$('#TypeOfDetailSalaryId').trigger('focus');
                }
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }


        });

    </script>
    <script>
        $("#RewardsAndPenaltiesCodingCategoryId").change(function (e) {
            debugger
            var selectedValue = $(this).val();
            if (selectedValue == "3") {
                $("#DurationInMinute").val("0")
                $("#DurationInDay").val("0")
                $("#DurationInhour").val("0")
                $("#min").hide();

                $("#hour").hide();
                $("#day").show();


            }
            else {
                $("#DurationInMinute").val("0")
                $("#DurationInDay").val("0")
                $("#DurationInhour").val("0")
                $("#min").show();
                $("#hour").show();
                $("#day").hide();

            }
                              $.ajax({
                                url: '@Url.Action("GetSalaryType", "RewardsAndPenaltiesCoding")',
                                type: 'get',
                                  data: { PenaltyAndReward: selectedValue }
                            }).done(function (result) {

                                $("#TypeOfDetailSalaryId").empty();
                                  var d = new Option("@Accountingsystem.Resources.Atttendace.Type", 0);
                                $("#TypeOfDetailSalaryId").append(d);

                                for (var i = 0; i < result.length; i++) {
                                    var item = result[i];
                                    var p = new Option(result[i].Text, result[i].Value);
                                    $("#TypeOfDetailSalaryId").append(p);
                                }
                                $('#TypeOfDetailSalaryId').trigger('chosen:updated');

                });

                });
    </script>


}
