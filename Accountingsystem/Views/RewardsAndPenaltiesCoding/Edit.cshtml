@using (Html.BeginForm("Edit", "RewardsAndPenaltiesCoding", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    @Html.HiddenFor(model => model.Id)
    <form id="offerCreateMasterForm">
        <div class="">
            <h3 class="text-center"><label>@ViewBag.Message</label></h3>
            <h3 class="text-center">@Html.Label(Accountingsystem.Resources.Atttendace.EditRewardsOrPenalties)</h3>
