@using (Html.BeginForm("Create", "RewardsAndPenaltiesCoding", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
   
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.Atttendace.CreateRewardsOrPenalties)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.RewardOrPenaltyName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.Type)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.RewardsAndPenaltiesCodingCategoryId, Model.RewardsAndPenaltiesCodingCategoryList, Accountingsystem.Resources.Atttendace.Type, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.SalaryCode)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.TypeOfDetailSalaryId, Model.TypeOfDetailSalaryList, Accountingsystem.Resources.Atttendace.SalaryCode, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.TypeOfDetailSalaryId, "", new { @class = "text-danger" })
                                </div>
                            </div>









                        </div>
                    </div>
                </div>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.Atttendace.duration)</h3>
                <div class="row">
                    <div class="col-md-6" id="min">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.Atttendace.Minute)
                            <div class="input-group">
                                @Html.EditorFor(model => model.DurationInMinute, new { htmlAttributes = new { @class = "form-control mb-1" } })
                                <div class="input-group-append">
                                    <div class="input-group-append">
                                        <div class="form-control">
                                            <label class="text-danger">*</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-6" id="hour">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.Atttendace.Hour)
                            <div class="input-group">
                                @Html.EditorFor(model => model.DurationInhour, new { htmlAttributes = new { @class = "form-control mb-1" } })
                                <div class="input-group-append">
                                    <div class="input-group-append">
                                        <div class="form-control">
                                            <label class="text-danger">*</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-6" id="day">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.Atttendace.Day)
                            <div class="input-group">
                                @Html.EditorFor(model => model.DurationInDay, new { htmlAttributes = new { @class = "form-control mb-1" } })
                                <div class="input-group-append">
                                    <div class="input-group-append">
                                        <div class="form-control">
                                            <label class="text-danger">*</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.Atttendace.procedure)</h3>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.Atttendace.Hour)
                            <div class="input-group">
                                @Html.EditorFor(model => model.RewordinHour, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                <div class="input-group-append">
                                    <div class="input-group-append">
                                        <div class="form-control">
                                            <label class="text-danger">*</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.Atttendace.Day)
                            <div class="input-group">
                                @Html.EditorFor(model => model.RewordInDay, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                <div class="input-group-append">
                                    <div class="input-group-append">
                                        <div class="form-control">
                                            <label class="text-danger">*</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.BankCreate.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.BankCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

}

@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>



        }
    }

    <script type="text/javascript">
      
            $(document).ready(function () {

                if ($('.chosen-container').length > 0) {
                    $('.chosen-container').on('touchstart', function (e) {
                        e.stopPropagation(); e.preventDefault();
                        $(this).trigger('mousedown');

                    });
                }
                $("#min").hide();
                $("#hour").hide();
                $("#day").hide();
                $("#backToListBtn").click(function (e) {
                    $("#backTolistBtnSpinner").show();
                });
                $("#RewardsAndPenaltiesCodingCategoryId").chosen();
                $("#RewardsAndPenaltiesCodingCategoryId_chosen").addClass("form-control Dropdownlist-select");
                $("#TypeOfDetailSalaryId").chosen();
                $("#TypeOfDetailSalaryId_chosen").addClass("form-control Dropdownlist-select");
            
                return false;
            });


    </script>

    <script>

        $('#offerCreateMasterForm').submit(function () {
            debugger
            var DurationInMinute = parseFloat($('#DurationInMinute').val());
            var DurationInDay = parseFloat($('#DurationInDay').val());
            var DurationInhour = parseFloat($('#DurationInhour').val());

            var RewordinHour = parseFloat($('#RewordinHour').val());
            var RewordInDay = parseFloat($('#RewordInDay').val());
         
            var Name = $('#Name').val();
                $('#createOfferbtn').prop('disabled', true);
            if ($('#Name').val() == "" || $('#Name').val() == null || $('#RewardsAndPenaltiesCodingCategoryId').val() == "" || $('#RewardsAndPenaltiesCodingCategoryId').val() == null || $('#TypeOfDetailSalaryId').val() == "" || $('#TypeOfDetailSalaryId').val() == "0"|| $('#TypeOfDetailSalaryId').val() == null
                    ||(DurationInMinute == 0 && DurationInDay == 0 && DurationInhour == 0) ||
                    (RewordinHour == 0 && RewordInDay == 0 )
                ) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createExpensesSpinner").hide();
                    if ($('#Name').val() == "" || $('#Name').val() == null) {
                    Snackbar.show({
                        text:"@Accountingsystem.Resources.Atttendace.Name",
                        pos: 'top-center'
                    });
                        $("#Name").addClass("addRequiredFieldToInput");
                        $('#Name').trigger('focus');
                }
                    if ($('#RewardsAndPenaltiesCodingCategoryId').val() == "" || $('#RewardsAndPenaltiesCodingCategoryId').val() == null) {
                    Snackbar.show({
                        text:"@Accountingsystem.Resources.Atttendace.Type",
                        pos: 'top-center'
                    });
                        $("#RewardsAndPenaltiesCodingCategoryId").addClass("addRequiredFieldToInput");
                        $('#RewardsAndPenaltiesCodingCategoryId').trigger('focus');
                    }
                    if ($('#TypeOfDetailSalaryId').val() == "" || $('#TypeOfDetailSalaryId').val() == null || $('#TypeOfDetailSalaryId').val() == "0") {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Atttendace.SalaryCode",
                        pos: 'top-center'
                    });
                        $("#TypeOfDetailSalaryId").addClass("addRequiredFieldToInput");
                        $('#TypeOfDetailSalaryId').trigger('focus');
                    }
                    if (DurationInMinute == 0 && DurationInDay == 0 && DurationInhour == 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Atttendace.duration",
                        pos: 'top-center'
                    });
                        //$("#TypeOfDetailSalaryId").addClass("addRequiredFieldToInput");
                        //$('#TypeOfDetailSalaryId').trigger('focus');
                }
                    if (RewordinHour == 0 && RewordInDay == 0) {
                    Snackbar.show({
                        text:"@Accountingsystem.Resources.Atttendace.procedure",
                        pos: 'top-center'
                    });
                        //$("#TypeOfDetailSalaryId").addClass("addRequiredFieldToInput");
                        //$('#TypeOfDetailSalaryId').trigger('focus');
                }
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }


        });

    </script>
    <script>
        $("#RewardsAndPenaltiesCodingCategoryId").change(function (e) {
            debugger
            var selectedValue = $(this).val();
            if (selectedValue == "3") {
                $("#DurationInMinute").val("0")
                $("#DurationInDay").val("0")
                $("#DurationInhour").val("0")
                $("#min").hide();
               
                $("#hour").hide();
                $("#day").show();

           
            }
            else {
                $("#DurationInMinute").val("0")
                $("#DurationInDay").val("0")
                $("#DurationInhour").val("0")
                $("#min").show();
                $("#hour").show();
                $("#day").hide();
            
            }
                              $.ajax({
                                url: '@Url.Action("GetSalaryType", "RewardsAndPenaltiesCoding")',
                                type: 'get',
                                  data: { PenaltyAndReward: selectedValue }
                            }).done(function (result) {

                                $("#TypeOfDetailSalaryId").empty();
                                 var d = new Option("@Accountingsystem.Resources.Atttendace.Type", 0);
                                $("#TypeOfDetailSalaryId").append(d);

                                for (var i = 0; i < result.length; i++) {
                                    var item = result[i];
                                    var p = new Option(result[i].Text, result[i].Value);
                                    $("#TypeOfDetailSalaryId").append(p);
                                }
                                $('#TypeOfDetailSalaryId').trigger('chosen:updated');

                });
                  
                });
    </script>


}
