@using (Html.BeginForm("Create", "Product", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Prod_ID)

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ProductCreate.CreateItem)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.ItemNumber)

                                    @Html.EditorFor(model => model.Prod_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })

                                    @Html.ValidationMessageFor(model => model.Prod_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.ItemName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Prod_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.Classification)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedCategory_ID, Model.CategoryList, Accountingsystem.Resources.ProductCreate.SelectClassification, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger"></label>
                                            </div>
                                            <button id="addNewClassBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#ClassModal">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedCategory_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.ItemType)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Prod_Type, ListType, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger"></label>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductDetails.CostPrice)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Prod_cost_Price, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Prod_cost_Price, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.SellingPrice)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Sale_Price, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Sale_Price, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.PurchaseTax)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedTax_Purch, Model.MyTaxListPurchas, Accountingsystem.Resources.ProductCreate.SelectTax, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger"></label>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.SalesTax)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedTaxId, Model.MyTaxList, Accountingsystem.Resources.ProductCreate.SelectTax, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger"></label>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.MeasruingUnit)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedMeasuringUnit_ID, Model.MeasruingUnitList, Accountingsystem.Resources.ProductCreate.SelectMeasruingUnit, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger"></label>
                                            </div>
                                            <button id="addNewUnitBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#UnitModal">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedCategory_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.Barcode)
                                    @Html.EditorFor(model => model.Bar_Code, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Bar_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.Model)
                                    @Html.EditorFor(model => model.Prod_Mark, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Prod_Mark, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductDetails.Thevalidityisindays)
                                    @Html.EditorFor(model => model.Validity, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                    @Html.ValidationMessageFor(model => model.Validity, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.DemandLimit)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Demand_Limit, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Demand_Limit, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.ProductPicture)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Pro_Img2, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.ProductCreate.SelectFile</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul class="list-unstyled" id="productSelectedtFiles"></ul>
                                    </div>

                                    @Html.ValidationMessageFor(model => model.Pro_Img2, "", new { @class = "text-danger" })
                                </div>

                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProductCreate.ItemDescription)
                                    @Html.TextAreaFor(model => model.Prod_Descrip, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription })
                                    @Html.ValidationMessageFor(model => model.Prod_Descrip, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes)
                                    @Html.TextAreaFor(model => model.Notess, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                                    @Html.ValidationMessageFor(model => model.Notess, "", new { @class = "text-danger" })
                                </div>
                            </div>



                        </div>
                    </div>
                </div>

            </div>
            @if (Package.CompoundProduct == true)
            {
            <div class="row">
                <div id="CompoundVM" class="col-md-11 mx-auto"></div>
            </div>
            <div class="row">
                <div id="CompoundList" class="col-md-11 mx-auto"></div>
            </div>
            }
            <div class="row">
                <div id="SliceProductDetailCreation" class="col-md-11 mx-auto"></div>
            </div>
            <div class="row">
                <div id="SliceProductDetailTemp" class="col-md-11 mx-auto"></div>
            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                    @if (Request.IsAuthenticated && !User.IsInRole("بائع"))
                    {
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    }

                </div>
            </div>
        </form>

    </div>
    <div id="SliceModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.CustomerCreate.AddNewSlice</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="slicePartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-dark mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>
    <div id="ClassModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.ProductCreate.AddCategory</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="ClassPartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-dark mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>
    <div id="UnitModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.ProductCreate.AddMeasruingUnit</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="UnitPartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-dark mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>

}

