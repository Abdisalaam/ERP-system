    <script>
        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            var name = document.getElementById("Prod_Name").value;

            var CostPrice = document.getElementById("Prod_cost_Price").value;

            var salesPrice = document.getElementById("Sale_Price").value;
            var Type = document.getElementById("Prod_Type").value;
            debugger


            if (name == "" || name == null || CostPrice == "" || CostPrice == null || (CostPrice == 0 && Type!=2) || salesPrice == "" || salesPrice == null || salesPrice == 0) {
                     $("#createOfferSpinner").hide();
                     $('#createOfferbtn').prop('disabled', false);
                    if (name == "" || name == null) {
                        Snackbar.show({
                            text: "@Accountingsystem.Resources.ProductCreate.ProductNameIsReqiuredMessage",
                            pos: 'top-center'
                        });
                        $("#Prod_Name").addClass("addRequiredFieldToInput");
                        $('#Prod_Name').trigger('focus');
                    }
                if (CostPrice == "" || CostPrice == null || (CostPrice == 0 && Type != 2)) {
                        Snackbar.show({
                            text: "@Accountingsystem.Resources.ProductCreate.ProductCostPriceIsReqiuredMessage",
                            pos: 'top-center'
                        });
                        $("#Prod_cost_Price").addClass("addRequiredFieldToInput");
                        $('#Prod_cost_Price').trigger('focus');
                    }
                    if (salesPrice == "" || salesPrice == null || salesPrice == 0) {
                        Snackbar.show({
                            text: "@Accountingsystem.Resources.ProductCreate.ProductSalePriceIsRequiredMessage",
                            pos: 'top-center'
                        });
                        $("#Sale_Price").addClass("addRequiredFieldToInput");
                        $('#Sale_Price').trigger('focus');
                    }

                event.preventDefault();
            }
            else {
                $("#createOfferSpinner").show();
            }


        });

    </script>

