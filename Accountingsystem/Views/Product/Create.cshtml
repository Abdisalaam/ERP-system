@model Accountingsystem.ViewModel.ProductVM

@{
    ViewBag.Title = Accountingsystem.Resources.ProductCreate.CreateItem;
    HttpCookie cookie = Request.Cookies["Language"];
    var Package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
    var ListType = Enum.GetValues(typeof(Accountingsystem.Models.Prod_Type)).Cast<Accountingsystem.Models.Prod_Type>().Select(v => new SelectListItem
    {
        Text = v.ToString(),
        Value = ((int)v).ToString()
    }).ToList();
    if (Package.CompoundProduct==null||Package.CompoundProduct == false) {
        ListType= ListType.Where(z => z.Value != "4").ToList();
    }
    if (Package.Purchase == null || Package.Purchase == false)
    {
        ListType = ListType.Where(z => z.Value == "2").ToList();
    }
}
