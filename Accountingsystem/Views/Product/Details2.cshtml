@model Accountingsystem.Models.Product

@{
    ViewBag.Title = Accountingsystem.Resources.ProductDetails.ItemDetails;
}

<h2>@Accountingsystem.Resources.ProductDetails.ItemDetails</h2>

    <h4>@Accountingsystem.Resources.ProductDetails.Item</h4>
    <div class="container">
        <div class="container">
            <div class="row">
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-2" id="Master_Id">
                            @Html.DisplayFor(model => model.Prod_ID)
                        </div>
                        <div class="col-md-2">
                            @Html.DisplayName(Accountingsystem.Resources.ProductDetails.ItemNumber)
                        </div>
                        <div class="col-md-2">
                            @Html.DisplayFor(model => model.Prod_Name)
                        </div>
                        <div class="col-md-2">
                            @Html.DisplayName(Accountingsystem.Resources.ProductDetails.Item)
                        </div>
                        <div class="col-md-2">
                            @Html.DisplayFor(model => model.Prod_Code)

                        </div>
                        <div class="col-md-2">
                            @Html.DisplayName(Accountingsystem.Resources.ProductDetails.Code)
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-2" id="Master_Id">
                            @Html.DisplayFor(model => model.Prod_Descrip)
                        </div>
                        <div class="col-md-2">
                            @Html.DisplayName(Accountingsystem.Resources.ProductDetails.Description)
                        </div>
                        <div class="col-md-2">
                            @Html.DisplayFor(model => model.Category_ID)
                        </div>
                        <div class="col-md-2">
                            @Html.DisplayName(Accountingsystem.Resources.ProductDelete.CategoryNumber)
                        </div>
                   
                    </div>
                </div>
            </div>
        </div>

    </div>
<p>
    @Html.ActionLink(Accountingsystem.Resources.ProductDetails.Edit, "Edit", new {  id = Model.Prod_ID  }) |
    @Html.ActionLink(Accountingsystem.Resources.ProductDetails.BackToList, "Index")
</p>
