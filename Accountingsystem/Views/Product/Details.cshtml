                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.ProductCreate.DemandLimit)
                                            </div>
                                            <div>
                                                @Model.Demand_Limit.Value
                                            </div>
                                        </div>
                                    </div>
                                </div>
