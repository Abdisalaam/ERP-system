                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Batch_Date, htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="col-md-5">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Batch_ExpireDate, new { htmlAttributes = new { @class = "textfield" } })
                        </div>
                    </div>
                    <span class="required-mark col-md-1"></span>
                    <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title="تاريخ انتهاء الصنف ">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Batch_ExpireDate, htmlAttributes: new { @class = "control-label" })
