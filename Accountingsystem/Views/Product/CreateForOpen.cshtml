    </div>
}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $('#Batch_Date').datetimepicker({ format: 'DD/MM/YYYY' });
        $('#Batch_ExpireDate').datetimepicker({ format: 'DD/MM/YYYY' });
    </script>

    <script type="text/javascript">

  $(function () {

        var sliceProductId = @Model.Prod_ID;
        //alert(sliceProductId);
      $("#SliceProductDetailCreationForOpen").load('@(Url.Action("PrepareSliceProductDetailForOpen", "Product"))');
      $("#SliceProductDetailTempForOpen").load('@(Url.Action("GetAllTempSlicesDetailsForOpen", "Product"))?tempProductId=' + sliceProductId);

    });


    function AddDetailToMaster() {

        var sliceProductIds = @Model.Prod_ID;
        var SlicesSlice_Ids =  $("#SlicesSlice_Id").val();
        var Slice_Prices =  $("#Slice_Price").val();

        var slicesDetail;
        slicesDetail = {
            Product_ID:sliceProductIds,
            SlicesSlice_Id:SlicesSlice_Ids,
            Slice_Price:Slice_Prices

        };

        $.ajax(
         {
             url: '@Url.Action("AddSliceToProductForOpen", "Product")',
             data: JSON.stringify(slicesDetail),
             contentType: 'application/json',
             dataType: 'json',
             type: 'Post',
             success: function (data) {

                  alert(data);
                 $("#SliceProductDetailTempForOpen").load('@(Url.Action("GetAllTempSlicesDetailsForOpen", "Product"))?tempProductId=' + sliceProductIds);


             },
             error: function () { alert('error'); }
         });
     };


    function DeleteTemp(e) {

        var ids = e;
        var productId=@Model.Prod_ID;

        $.ajax({

            url: '@Url.Action("DeleteTempDetailForOpen", "Product")',
            type: 'get',
            data: {iD:ids}
        }).done(function (result) {


            $("#SliceProductDetailTempForOpen").load('@(Url.Action("GetAllTempSlicesDetailsForOpen", "Product"))?tempProductId=' + productId);


        });
    }

    </script>

    <link href="~/Content/css/select2.min.css" rel="stylesheet" />
    <script src="~/Scripts/select2.min.js" type="text/javascript"></script>
    <script src="~/Scripts/UiUtils.js" type="text/javascript"></script>
    <script type="text/javascript">

        $(document).ready(function () {
             fillDropdownWithResponse("@Url.Action("getProductBatchJsondrobDown", "Product")", "#SelectedStore_ID");
            fillDropdownWithResponse("@Url.Action("getProductBatchJsondrobDown", "Product")", "#Prod_ID");

    })
    </script>
}




