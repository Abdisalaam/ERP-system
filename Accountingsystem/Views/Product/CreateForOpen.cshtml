                </div>
            </div>*@

            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-5">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedCurrency_ID, Model.CurrencyList, htmlAttributes: new { @class = "Dropdownlist-select" })
