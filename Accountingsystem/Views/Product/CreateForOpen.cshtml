@model Accountingsystem.ViewModel.ProductOpenBalanceVM

@{
    ViewBag.Title = Accountingsystem.Resources.ProductCreate.CreateOpeningBalanceForItems;
    Layout = "~/Views/Shared/_Layout.cshtml";
