@model IEnumerable<Accountingsystem.Models.ProductBatches>
@{
    ViewBag.Title = Accountingsystem.Resources.StoreCreate.EditProductPriceForStores;
    HttpCookie cookie = Request.Cookies["Language"];
    var TaxList = Accountingsystem.Models.Tax.GetAlltaxes();
    int count = 0;
}

@{


    if (cookie != null && cookie.Value != null)
    {
        if (cookie.Value == "en")
        {
            Layout = "~/Views/Shared/_LayoutLTR.cshtml";
            <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
        <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
    }
}











<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">

    <div class="text-center">
        @Accountingsystem.Resources.StoreCreate.EditProductPriceForStore
    </div>
    <div class="widget-content widget-content-area">
        <div class=''>
            <div class="row">
                <div class="col-md-6">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.ProductDetails.ItemNumber)
                                    </div>
                                    <div>
                                        @Html.DisplayFor(model => model.FirstOrDefault().Product.Prod_Code)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.ProductDetails.Item)
                                    </div>
                                    <div>
                                        @Html.DisplayFor(model => model.FirstOrDefault().Product.Prod_Name)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.ProductDetails.Barcode)
                                    </div>
                                    <div>
                                        @Html.DisplayFor(model => model.FirstOrDefault().Product.Bar_Code)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="table-responsive mb-4 mt-4">
        <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
            <thead>
                <tr>
                    <th hidden></th>
                    <th hidden></th>
                    <th>
                        @Accountingsystem.Resources.InvoiceMasterIndex.Number
                    </th>

                    <th>
                        @Accountingsystem.Resources.StoreCreate.StoreName

                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ProductDetails.Minimum)

                    </th>

                    <th>
                        @Accountingsystem.Resources.ProductCreate.EstimatedCost

                    </th>
                    <th>
                        @Accountingsystem.Resources.ProductDetails.SellingPrice

                    </th>

                    <th>
                        @Accountingsystem.Resources.StoreCreate.NewPrice

                    </th>
                    <th>
                        @Accountingsystem.Resources.TaxCreate.TaxPercentage

                    </th>
                    <th>
                        @Accountingsystem.Resources.validate.PriceWithTax

                    </th>


                    <th>
                        <input type="checkbox" name="select-all" id="select-all" />
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderByDescending(a=>a.IsActive))
                {
                    decimal taxpercentage = 0;
                    decimal salePrice = 0;
                    decimal SalepriceWithTax = 0;
                    if (item.Product.Tax_Id > 0)
                    {
                        taxpercentage = TaxList.Where(a => a.Tax_ID == item.Product.Tax_Id).FirstOrDefault().Tax_Percentage;
                    }
                    if (item.SalesPrice != null)
                    {
                        salePrice = item.SalesPrice.Value;


                    }
                    else
                    {
                        salePrice = item.Product.Sale_Price.Value;

                    }

                    if (item.IsActive == null)
                    {
                        item.IsActive = true;
                    }
                <tr>
                    @{
                        SalepriceWithTax = salePrice * (taxpercentage / 100) + salePrice;
                        count++;
                    }
                    <td hidden>
                        @Html.HiddenFor(a => taxpercentage, htmlAttributes: new { @class = "taxPercentage" })
                    </td>
                    <td>@count</td>
                    <td hidden>@item.Batch_ID</td>
                    <td>@item.Store.Store_Name</td>

                    <td>0</td>

                    <td><input type="number"  class="cost" id="Prod_Cost_Price" value="@Math.Round(item.Product.Prod_Cost_Price.Value, 2, MidpointRounding.AwayFromZero)"></td>
                    <td>@Math.Round(salePrice, 2, MidpointRounding.AwayFromZero)</td>
                    <td><input type="number" onchange="OnChangeSalesPrice(this)" class="SalesPrices" id="SalesPrice" value="@Math.Round(salePrice, 2, MidpointRounding.AwayFromZero)"></td>


                    <td id="taxPercentage">@taxpercentage</td>
                    <td><input type="number" onchange="OnChangeSalesWithTax(this)" class="SalesPriceWithTax" id="SalesPriceWithTax" value="@Math.Round(SalepriceWithTax, 2, MidpointRounding.AwayFromZero)"></td>



                    <td>@Html.EditorFor(model => item.IsActive.Value)</td>
                </tr>
                }
            </tbody>
        </table>
        <div class="col-md-12">
            <div class="form-group">
                <button type="submit" id="createOfferbtn" onclick="fun()" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.InvoiceMasterIndex.Edit <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

            </div>
        </div>
    </div>
</div>


