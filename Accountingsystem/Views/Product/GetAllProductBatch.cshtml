    <script>
        $('#select-all').click(function (event) {
            if (this.checked) {
                // Iterate each checkbox
                $(':checkbox').each(function () {
                    this.checked = true;
                });
            } else {
                $(':checkbox').each(function () {
                    this.checked = false;
                });
            }
        });
    </script>
    <script>
        function OnChangeSalesPrice(obj) {
            debugger
            var Price = $(obj).val();

            var TaxPercentage = $(obj).parents('tr').find('.taxPercentage').val();
            var category = $(obj).parents('tr').find('.Cat').val();
            var priceWithTax = (parseFloat(TaxPercentage) / 100) * parseFloat(Price) + parseFloat(Price);


            $(obj).parents('tr').find('.SalesPriceWithTax').val(priceWithTax);

        }

    </script>
    <script>
        function OnChangeSalesWithTax(obj) {
            debugger
            var PriceWithTax = $(obj).val();
            var TaxPercentage = $(obj).parents('tr').find('.taxPercentage').val();
            var price = parseFloat(PriceWithTax) * (100 / (parseFloat(TaxPercentage) + 100));
        

            $(obj).parents('tr').find('.SalesPrices').val(price);

        }

    </script>
