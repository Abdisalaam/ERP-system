            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Customer_Website, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Customer_Website, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Customer_Website, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="modal-footer">
        @*<div class="col-md-offset-2 col-md-10">
                <input type="button" value="انشاء عميل" class="btn btn-primary" onclick="addCustomer()" />

            </div>*@

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">

                <a href='javascript:;' onclick='addCustomer();' class="btn btn-primary" style="text-decoration:none;">انشاء عميل</a>
            </div>
        </div>
    </div>

}
