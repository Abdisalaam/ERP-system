@model Accountingsystem.ViewModel.CustomerVM

@{
    ViewBag.Title = "Create";

}
@using (Html.BeginForm("AddNewCustomerPartial", "Contacts", FormMethod.Post, new { @class = "form-horizontal", role = "form", enctype = "multipart/form-data" }))
{
    <h2>انشاء عميل جديد</h2>
    <div class="form-horizontal">
        @Html.HiddenFor(model => model.Customer_Code)
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="container">
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Files, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                    <div class="col-md-6">
                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple" })
                        @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-5">
                    <div class="col-md-6">

                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Customer_Name, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Customer_Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            @Html.LabelFor(model => model.Customer_Name, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Customer_Address, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Customer_Address, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Customer_Address, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Customer_Phone, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Customer_Phone, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Customer_Phone, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Customer_Mail, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Customer_Mail, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Customer_Mail, htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedProvinceId, Model.MyProvinceList, "اختر المحافظة", htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.SelectedProvinceId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.SelectedProvinceId, "المحافظة", htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedCountryId, Model.MyCountryList, "اختر الدولة", htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.SelectedCountryId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.SelectedCountryId, "الدول", htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.SelectedCityId, Model.MyCitiesList, "اختر المدينة", htmlAttributes: new { @class = "Dropdownlist-select" })
