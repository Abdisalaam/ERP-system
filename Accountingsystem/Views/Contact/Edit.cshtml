@model Accountingsystem.ViewModel.ContactVM

@{
    ViewBag.Title = "Edit";
}

<h2>تعديل</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.HiddenFor(model => model.Contact_Id, new { htmlAttributes = new { @class = "textfield" } })
        <div class="container">
            <div class="row">

                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.Customer_Id, Model.MyCustomerList, "اختر العميل", htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.Customer_Id, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Customer_Id, "اسم العميل", htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Contact_Name, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Contact_Name, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Contact_Name, "اسم جهة الاتصال", htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Contact_Company, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Contact_Company, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Contact_Company, "شركة التابعة لي جهة الاتصال", htmlAttributes: new { @class = "control-label " })
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Contact_Email, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Contact_Email, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Contact_Email, "لبريد الالكتروني لجهة الاتصال", htmlAttributes: new { @class = "control-label" })
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="تعديل" class="btn btn-primary" />
        </div>
    </div>

}


<div>
    @Html.ActionLink("العودة الي القائمة", "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
