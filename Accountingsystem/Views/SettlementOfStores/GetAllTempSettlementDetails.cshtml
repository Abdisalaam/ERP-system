@model IEnumerable<Accountingsystem.Models.SettlementOfStoresDetailsTemp>
@{ 
    decimal quantity = 0;
    decimal cost = 0;

}

<div class="statbox widget box box-shadow">
    <div class="table-responsive">

        <table id="InvoiceMasterDetailList" class="table table-hover" style="width:100%">
            <thead>
                <tr>

                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.SettlementOfStoresDetails.Item)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.SettlementOfStoresDetails.ItemNumber)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.SettlementOfStoresDetails.Quantity)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.SettlementOfStoresDetails.ItemCost)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.SettlementOfStoresDetails.Total)
                    </th>

                    <th></th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                { quantity += item.Product_Quantity;
                    cost += item.Total_Cost_Detail;

                    @Html.HiddenFor(modelItem => item.Settlement_DetailsId)
                    @Html.HiddenFor(modelItem => item.SettlementOfStoresTempId)
                    <tr>

                        <td> @Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Name</td>
                        <td> @Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Code</td>
                        <td>
                            @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>
                            @Math.Round(item.Product_Cost, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>
                            @Math.Round(item.Total_Cost_Detail, 2, MidpointRounding.AwayFromZero)
                        </td>



                        <td>
                            <a href='javascript:;' onclick="@("DeleteTemp('"+item.Settlement_DetailsId+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.InvoiceMasterDetails.Delete data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                        </td>
                    </tr>
                }
                <tr>

                    <td> الاجمالي</td>
                    <td> </td>
                    <td>
                        @Math.Round(quantity, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>
                       
                    </td>
                    <td>
                        @Math.Round(cost, 2, MidpointRounding.AwayFromZero)
                    </td>



                    <td>
                       
                    </td>
                </tr>
            </tbody>
        </table>
        </div>
</div>