@model Accountingsystem.ViewModel.SettlementOfStoresDetailsVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Settlement_DetailsId)
    @Html.HiddenFor(model => model.ProductId_In)
    @Html.HiddenFor(model => model.ProductId_Out)
    @Html.HiddenFor(model => model.SettlementOfStoresId)




    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.SettlementOfStoresDetails.Item)
                @Html.EditorFor(model => model.Product_Name, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })

            </div>
        </div>

        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Quantity)
                @Html.EditorFor(model => model.Product_Quantity, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })

            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.SettlementOfStoresDetails.ActualQuantity)
                @Html.EditorFor(model => model.Product_QuantityReal, new { htmlAttributes = new { @class = "form-control mb-4", @readonly = "readonly" } })

            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.SettlementOfStoresDetails.ItemCost)
                @Html.EditorFor(model => model.Product_Cost, new { htmlAttributes = new { @class = "form-control mb-4", @readonly = "readonly" } })

            </div>
        </div>

    </div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">

            <a href='javascript:;'  onclick='AddToTemp();' class="btn btn-outline-info mb-2" style="text-decoration:none;">@Accountingsystem.Resources.ReversePOSInvoiceDetails.AddToRegulation</a>
        </div>
    </div>
</div>
}
