@using (Html.BeginForm("Edit", "SettlementOfStores", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.SettlementId)
    @Html.HiddenFor(model => model.StoreId)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.SettlementOfStoresCreate.EditSettlement)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SettlementOfStoresCreate.ReceiptNumber)
                                    @Html.EditorFor(model => model.Settlement_Code, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Settlement_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SalesReceiptMasterAddnewSaleReciept.InvoiceDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group" id="productBat">
                                    @Html.Label(Accountingsystem.Resources.SettlementOfStoresCreate.ChooseItemsInStock)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ProductId_In, Model.MyProductListInStore, Accountingsystem.Resources.SettlementOfStoresCreate.ChooseItemsInStockInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ProductId_In, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6" id="prodNot">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SettlementOfStoresCreate.ItemsAreNotInStock)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ProductId_Out, Model.MyProductListOutStore, Accountingsystem.Resources.SettlementOfStoresCreate.ItemsAreNotInStockInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ProductId_In, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Expenses.ExpenseAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Expence_Id, Model.Expences_List, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Expence_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (package.Number_Branch > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.BranchOrDepartment)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BranchSubledger_Id, Model.BranchSubList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.SettlementOfStoresCreate.Department)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.DepartSubledger_Id, Model.DepartSubList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenterOrMainDepartment, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Activity)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BussinesSubledger_Id, Model.BussinessList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.ActivityInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_subLedgger > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.CostCenter)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Subledger_Id, Model.SubledgerList, Accountingsystem.Resources.InvoiceMasterAddNewInvoice.CostCenterInformation, htmlAttributes: new { @class = "Dropdownlist-select form-control mb-4" })
                                        </div>
                                    </div>
                                </div>
                            }




                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div id="PrepareData" class="col-md-11 mx-auto"></div>
            </div>
            <div id="TempList"></div>

            <div class="row">

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.CustomerIndex.Edit <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
            </div>
        </form>
    </div>

}



