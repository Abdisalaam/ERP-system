    <script type="text/javascript">
        if ($('.chosen-container').length > 0) {
            $('.chosen-container').on('touchstart', function (e) {
                e.stopPropagation(); e.preventDefault();
                $(this).trigger('mousedown');

            });
        }
        var _OfferDate = flatpickr(document.getElementById('Date'), {
            defaultDate: $("#Date").val()
        });
        var settlementId = '@Model.SettlementId';
        $("#TempList").load('@(Url.Action("GetAllTempOfferresult", "SettlementOfStores"))?settlementId=' + settlementId);

        $.ajaxSetup({ cache: false });




            $(function () {
                $("#ProductId_In").change(function (e) {

                    var selectedValue = $("#ProductId_In").val();
                    var storID = $("#StoreId").val();
                    $("#PrepareData").load('@(Url.Action("PreparerecallDetailsInStore", "SettlementOfStores"))?prodID=' + selectedValue + '&storID=' + storID);
                });
            });

            $(function () {
                $("#ProductId_Out").change(function (e) {

                    var selectedValue = $(this).val();

                    var storID = $("#StoreId").val();
                    $("#PrepareData").load('@(Url.Action("PreparerecallDetailsOutStore", "SettlementOfStores"))?prodID=' + selectedValue + '&storID=' + storID);
                });
        });
    </script>
    <script type="text/javascript">
                $("#BranchSubledger_Id").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("GetProvinces", "Expense")',
                        type: 'get',
                        data: { countryId: selectedValue }
                    }).done(function (result) {
                        $("#DepartSubledger_Id").empty();
                       var departmentSubledgerOptions = new Option("@Accountingsystem.Resources.Expenses.ChooseDepartment", 0);
                        $("#DepartSubledger_Id").append(departmentSubledgerOptions);
                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#DepartSubledger_Id").append(p);
                        }
                        $('#DepartSubledger_Id').trigger('chosen:updated');
                    });
                });
                $("#DepartSubledger_Id").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("GetCities", "Expense")',
                        type: 'get',
                        data: { provinceId: selectedValue }
                    }).done(function (result) {
                        $("#BussinesSubledger_Id").empty();
                       var activitySubledgerOptions = new Option("@Accountingsystem.Resources.Expenses.ChooseBusinessField", 0);
                        $("#BussinesSubledger_Id").append(activitySubledgerOptions);
                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#BussinesSubledger_Id").append(p);
                        }
                        $('#BussinesSubledger_Id').trigger('chosen:updated');
                    });
                });

    </script>
    <script type="text/javascript">
        function clearItem() {
            $("#ProductId_In").val('');
            $("#ProductId_Out").val('');
            $("#Product_Quantity").val('');
            $("#Product_Cost").val('');
        }
            function AddToTemp() {

                var settlementId = @Model.SettlementId;

                var prodID = $("#ProductId_In").val();
                var ProductId_Out = $("#ProductId_Out").val();
                var storID = $("#StoreId").val();
                var Quantity = $("#Product_Quantity").val();
                var QuantityReal = $("#Product_QuantityReal").val();
                var Product_Cost = $("#Product_Cost").val();

                var ofStoresDetailsVM;
                ofStoresDetailsVM = {
                    SettlementOfStoresId: settlementId,
                    ProductId_In: prodID,
                    StoreId: storID,
                    Product_Quantity: Quantity,
                    Product_QuantityReal: QuantityReal,
                    Product_Cost: Product_Cost,
                    ProductId_Out: ProductId_Out

                };

                $.ajax(
                 {
                     url: '@Url.Action("AddDetailsToMaster", "SettlementOfStores")',
                        data: JSON.stringify(ofStoresDetailsVM),
                     contentType: 'application/json',
                     dataType: 'json',
                     type: 'POST',
                        success: function (data) {
                            //alert(data);
                         @*$("#TempList").load('@(Url.Action("GetAllTempSettlementDetails", "SettlementOfStores"))');*@
                            $("#TempList").load('@(Url.Action("GetAllTempSettlementDetails", "SettlementOfStores"))?tempSettlementId=' + settlementId);


                            $('#ProductId_In').prop('disabled', false).trigger("chosen:updated")
                            $('#ProductId_Out').prop('disabled', false).trigger("chosen:updated")

                     },
                     error: function () { alert('error'); }
                 });

        };

  function DeleteTemp(e) {

            var ids = e;
      var settlementId =@Model.SettlementId;
            $.ajax({

                url: '@Url.Action("DeleteTempDetail", "SettlementOfStores")',
                type: 'get',
                data: { iD:ids}
            }).done(function (result) {
               // alert(result);
                $("#TempList").load('@(Url.Action("GetAllTempSettlementDetails", "SettlementOfStores"))?tempSettlementId=' + settlementId);


            });
        }


    </script>

    <script type="text/javascript">
        $("#ProductId_In").chosen();


        $("#ProductId_In_chosen").addClass("form-control Dropdownlist-select");
        $("#ProductId_Out").chosen();


        $("#ProductId_Out_chosen").addClass("form-control Dropdownlist-select");


        $("#BranchSubledger_Id").chosen();
