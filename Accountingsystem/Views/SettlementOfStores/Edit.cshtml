    <script>
        $('#Date').on('change', function (e)
       {

        var selectedValue = $(this).val();
             $.ajax({
                        url: '@Url.Action("CheckStartdate", "GLMaster")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                            var currentDate = new Date();

                            var _OfferDate = flatpickr(document.getElementById('Date'), {
                                defaultDate: currentDate
                            });

                        }
                    }
                    );
            $.ajax({
                url: '@Url.Action("CheckEndDate", "Company")',
                data: { date : selectedValue },
            type: 'get',
            }).done(function (result) {
                if (result == "" || result == null) {

                }
                else {
                    Snackbar.show({
                        text: result,
                        pos: 'top-center'
                    });

                }
            }
            );
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#InvoiceMasterDetailList') == null || $('#InvoiceMasterDetailList tr').length < 3 || $('#Date').val() == "" || $('#Date').val() == null) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();



                var a = $('#InvoiceMasterDetailList tr').length;

                if ($('#InvoiceMasterDetailList tr').length < 3) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SettlementOfStoresCreate.AddItemsToSettlement",
                        pos: 'top-center'
                    });

                }
                if ($('#Date').val() == "" || $('#Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDateIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Date").addClass("addRequiredFieldToInput");
                    $('#Date').trigger('focus');
                }


                // Eng Mohammed
                $("#createOfferSpinner").hide();


                event.preventDefault();
            }


        });

    </script>
}
