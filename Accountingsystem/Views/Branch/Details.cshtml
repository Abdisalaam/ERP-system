@model Accountingsystem.Models.Branch

@{
    ViewBag.Title = Accountingsystem.Resources.BranchDetails.BranchDetailss;
    HttpCookie cookie = Request.Cookies["Language"];

}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

        }
    }


</head>


<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">


    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    <div class="text-center">
                        <label>@ViewBag.Message</label>
                    </div>
                    <div class="text-center">
                        @Accountingsystem.Resources.BranchDetails.BranchDetailss
                    </div>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">

                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.BranchNumber)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Branch_Code)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.BranchName)
                                        </div>
                                        <div>
                                            @Model.Branch_Name
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">

                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.BranchAddress)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Branch_Address)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.CountryBranch)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Branch_Country)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.GovernorateBranch)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Branch_Province)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.BranchPhone)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Branch_Phone)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.CityBranch)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Branch_City)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.BranchEmail)
                                        </div>
                                        <div>
                                            <a style="color:dodgerblue" href="mailto:@Model.Branch_Email">@Model.Branch_Email</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.BranchDetails.BranchFax)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Branch_Fax)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Model.BranchLogo != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.CompanyEdit.CompanyLogo)
                                            </div>
                                            <div>
                                                <img src="data:image/jpg;base64,@Convert.ToBase64String(Model.BranchLogo)" alt="Image" style="width:100px" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.ImageHeader != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.validate.FrontPage)
                                            </div>
                                            <div>
                                                <img src="data:image/jpg;base64,@Convert.ToBase64String(Model.ImageHeader)" alt="Image" style="width:100px" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.ImageFooter != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.validate.EndPage)
                                            </div>
                                            <div>
                                                <img src="data:image/jpg;base64,@Convert.ToBase64String(Model.ImageFooter)" alt="Image" style="width:100px" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.ImageWaterMark != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.validate.ImageWaterMark)
                                            </div>
                                            <div>
                                                <img src="data:image/jpg;base64,@Convert.ToBase64String(Model.ImageWaterMark)" alt="Image" style="width:100px" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
         
            <div class="row layout-top-spacing">
                <div class="col-md-4">
                    <div class="form-group">
                        @if (Request.IsAuthenticated@*&& !User.IsInRole("مدخل بيانات") && !User.IsInRole("مساعد محاسب")*@)
{






        <a id="editExpensesBtn" href="@Url.Action("Edit", new { id = Model.Branch_Id })" class="btn btn-block btn-outline-info mb-lg-0">
            @Accountingsystem.Resources.CatchReceiptDetails.Edit
            <span id="editExpensesBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
        </a>




    }
                        <a id="printEmailbtn" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("DeleteTrans", new { id = Model.Branch_Id })">
                            @if (Model.IsActive != false)
                            {
                                @Accountingsystem.Resources.ProductDetails.TransferToNotActive
                            }
                            else
                            {
                                @Accountingsystem.Resources.ProductDetails.TransferToActive
                            }
                            <span id="printEmailbtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">

                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index",new {id=Model.CompanyComp_Id })">
                            @Accountingsystem.Resources.CatchReceiptDetails.BackToList
                            <span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>



            </div>
        </div>

    </div>

</div>
@section scripts{
    <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

    <script>

        $("#editExpensesBtn").click(function (e) {
            $("#editExpensesBtnSpinner").show();
        });
       
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });


    </script>
}

