    <script>
        if ($('.chosen-container').length > 0) {
            $('.chosen-container').on('touchstart', function (e) {
                e.stopPropagation(); e.preventDefault();
                $(this).trigger('mousedown');

            });
        }
   
    $('#Photo').change(function () {

        $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
         $('#selectedtPhoto').empty();
            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Photo').empty();
                    $('#selectedtPhoto').empty();
                    $('#selectedtPhoto').append('<li class="addRequiredFieldToInput">' +"@Accountingsystem.Resources.validate.TotalFilesSize " + totalConteLength + ' @Accountingsystem.Resources.validate.bytee </li > ');
                    $('#selectedtPhoto').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.validate.LimitOfSizeFile" + '</li > ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.ReduceSize ",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtPhoto').append('<li>' + "@Accountingsystem.Resources.validate.FileName "  + fileName + '</li> ');
                    $('#selectedtPhoto').append('<li>' +"  @Accountingsystem.Resources.validate.TotalFileSize"  + this.files[i].size + ' @Accountingsystem.Resources.validate.bytee  </li> ');

                }
            }
         $('#selectedtPhoto').append('<li>' + "@Accountingsystem.Resources.validate.TotalFilesSize " + totalConteLength + ' @Accountingsystem.Resources.validate.bytee  </li >');

