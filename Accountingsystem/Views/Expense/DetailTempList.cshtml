@model IEnumerable<Accountingsystem.Models.ExpenseAccountTemp>
@{
    decimal totalDebits = 0;
    decimal totalCredits = 0;
}
<div class="statbox widget box box-shadow">
    <div class="table-responsive">
        <table id="expensesDetailList" class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.Debtor)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.Creditor)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.Account)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.AssistantAccount)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.CostCenter)
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.ExpenseDescription)
                    </th>


                </tr>

            </thead>
            <tbody>


                @foreach (var item in Model)
                {

                    @Html.HiddenFor(modelItem => item.Id)
                    @Html.HiddenFor(modelItem => item.Tax_Bool)
                    @Html.HiddenFor(modelItem => item.SubLedger_ID)
                    @Html.HiddenFor(modelItem => item.RandoumVAlue)
                    @Html.HiddenFor(modelItem => item.Expense_ID)


                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.AccountExp_Debit)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.AccountTreat_Credit)
                        </td>

                        <td>
                            @if (item.AccountExp_ID > 0 && item.Tax_Bool == false)
                            {
                                var Exp = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount((int)item.AccountExp_ID).Account_Name;


                                <h>@Exp</h>
                            }
                            else if (item.AccountExp_ID > 0 && item.Tax_Bool == true)
                            {
                                var taxName = Accountingsystem.Models.Tax.GetTaxesbyId((int)item.AccountExp_ID).Tax_Name;


                                <h>@taxName</h>
                            }
                            else
                            {

                                var Tresuary = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount((int)item.AccountTreasury_ID).Account_Name;


                                <h>@Tresuary</h>
                            }
                        </td>
                        @if (item.ChildAccount_Id != null && item.ChildAccount_Id != 0)
                        {
                            <td>
                                @Accountingsystem.Models.Accounts.findAccountbyID(item.ChildAccount_Id.Value).Account_Name
                            </td>
                        }
                        else
                        {
                            <td></td>



                        }
                        <td>
                            @{
                                totalDebits = totalDebits + item.AccountExp_Debit;
                                totalCredits = totalCredits + item.AccountTreat_Credit;
                            }
                            @if (item.SubLedger_ID > 0)
                            {
                                var SubLed = Accountingsystem.Models.SubLedger.getDetail(item.SubLedger_ID.Value);


                                <h>@SubLed.SubLed_Name</h>
                            }
                            else
                            {

                            }

                        </td>
                        <td>

                            @Html.DisplayFor(modelItem => item.ExpDesc)
                        </td>


                    </tr>

                }
            </tbody>
        </table>
    </div>

    <div class="media  d-md-flex d-block text-sm-left text-center">

        <div class="media-body details-form-control mb-4">
            <div class="d-xl-flex d-block justify-content-between">
                <div class="">
                    @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.TotalDebtor)
                </div>
                <div>
                    @Math.Round(totalDebits, 2, MidpointRounding.AwayFromZero)
                </div>
            </div>
        </div>
    </div>
    <div class="media  d-md-flex d-block text-sm-left text-center">

        <div class="media-body details-form-control mb-4">
            <div class="d-xl-flex d-block justify-content-between">
                <div class="">
                    @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.TotalCreditor)
                </div>
                <div>
                    @Math.Round(totalCredits, 2, MidpointRounding.AwayFromZero)
                </div>
            </div>
        </div>
    </div>
</div>

       
