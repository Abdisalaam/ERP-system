@using (Html.BeginForm("Edit", "Expense", FormMethod.Post, new { @id = "expensesCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.RandomValue)
    @Html.HiddenFor(model => model.Expense_Id)
    @Html.HiddenFor(model => model.Expense_Code)
    @Html.HiddenFor(model => model.Company_Id)
    @Html.HiddenFor(model => model.Currency_Id)

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="expensesCreateForm">
            <div class="">
                <label class="text-center">@ViewBag.Message</label>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ExpensesEdit.EditExpense)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.ExpenseCode)
                                    @Html.EditorFor(model => model.Expense_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Expense_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.ExpenseDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Expense_date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Expense_date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.Amount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Expense_Value, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Expense_Value, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.Refrence)
                                    @Html.EditorFor(model => model.Refference, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Refference, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6" id="EXPID">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.ExpenseAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.AccountExpense_Id, Model.Account_List, Accountingsystem.Resources.ExpensesEdit.ChooseExpensesAccount, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountExpense_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6" id="TREID">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.PaymentMethod)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.AccountTreasure_Id, Model.Treasure_List, Accountingsystem.Resources.ExpensesEdit.ChoosePaymentMethode, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountTreasure_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6" id="expensesTaxId">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.Tax)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.selecteTax_ID, Model.taxList, Accountingsystem.Resources.ExpensesEdit.ChooseTax, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" id="supId">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.Suppliers)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ChildAccount, Model.ChildAcountList, Accountingsystem.Resources.ExpensesEdit.ChooseSuplier, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (package.Number_Branch > 0)

                            {
                                <div class="col-md-6" id="expensesBranchId">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.ExpensesEdit.BranchOrSection)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BranchSubledger_Id, Model.BranchSubList, Accountingsystem.Resources.ExpensesEdit.ChooseBranchOrSection, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6" id="expensesDepartmentId">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.ExpensesEdit.Department)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.DepartSubledger_Id, Model.DepartSubList, Accountingsystem.Resources.ExpensesEdit.ChooseDepartment, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6" id="expensesBussinessFieldId">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.ExpensesEdit.BusinessField)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BussinesSubledger_Id, Model.BussinessList, Accountingsystem.Resources.ExpensesEdit.ChooseBusinessField, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_subLedgger > 0)

                            {
                                <div class="col-md-6" id="expensesCostCenterId">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.ExpensesEdit.CostCenter)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Subledger_Id, Model.SubledgerList, Accountingsystem.Resources.ExpensesEdit.ChooseCostCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>

                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.ExpensesEdit.AddFile</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ExpensesEdit.Description)
                                    @Html.TextAreaFor(model => model.Expense_Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.ExpensesEdit.Description })
                                    @Html.ValidationMessageFor(model => model.Expense_Description, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <a href='javascript:;' onclick='addExpense();' class="btn btn-block btn-outline-success mb-lg-0" style="text-decoration:none;">
                                @Accountingsystem.Resources.ExpensesEdit.AddAccount
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                <span id="addToAccountBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                            </a>
                        </div>
                    </div>
                </div>
                <div id="getTempList"></div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.ExpensesEdit.EditExpense <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span></button>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.ExpensesEdit.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>

        </form>
    </div>
}

