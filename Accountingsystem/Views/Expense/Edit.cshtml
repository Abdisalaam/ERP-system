    <script>
        function addExpense() {
           
            if (($('#AccountExpense_Id').val() == "" && $('#AccountTreasure_Id').val() == "" && $('#ChildAccount').val() == "") || $("#Expense_Value").val() <= 0)
            {
                if ($('#AccountExpense_Id').val() == "" && $('#AccountTreasure_Id').val() == "" && $('#ChildAccount').val() == "") {
                     Snackbar.show({
                    text: "@Accountingsystem.Resources.Expenses.SelectOneOfTheAccount",
                    pos: 'top-center'
                    });
                    $("#AccountExpense_Id").addClass("addRequiredFieldToInput");
                    $("#AccountExpense_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#AccountExpense_Id_chosen span').css('background', 'red');
                    $('#AccountExpense_Id_chosen b').css('background', 'red');
                    $('#AccountExpense_Id_chosen').trigger('focus');

                    $("#AccountTreasure_Id").addClass("addRequiredFieldToInput");
                    $("#AccountTreasure_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#AccountTreasure_Id_chosen span').css('background', 'red');
                    $('#AccountTreasure_Id_chosen b').css('background', 'red');
                    $('#AccountTreasure_Id_chosen').trigger('focus');

                    $("#ChildAccount").addClass("addRequiredFieldToInput");
                    $("#ChildAccount_chosen").addClass("addRequiredFieldToInput");
                    $('#ChildAccount_chosen span').css('background', 'red');
                    $('#ChildAccount_chosen b').css('background', 'red');
                    $('#ChildAccount_chosen').trigger('focus');
                    $('html, body').animate({
                        scrollTop: $("#ChildAccount").offset().top
                    }, 2000);
                }
                if ($("#Expense_Value").val() <= 0) {
                      Snackbar.show({
                    text: "@Accountingsystem.Resources.Expenses.EmptyAmountValueMessage",
                    pos: 'top-center'
                    });
                    $("#Expense_Value").addClass("addRequiredFieldToInput");
                    $('#Expense_Value').trigger('focus');
                }
              

                
            }
            else
            {
                $("#addToAccountBtnSpinner").show();
                var ExpID = @Model.Expense_Id;
                var AccEXPID = $("#AccountExpense_Id").val();
                var AccTreasID = $("#AccountTreasure_Id").val();
                var ValueEXP = $("#Expense_Value").val();
                var EXPDesc = $("#Expense_Description").val();
                var BranchID = $("#BranchSubledger_Id").val();
                var DepID = $("#DepartSubledger_Id").val();
                var BUID = $("#BussinesSubledger_Id").val();
                var SubLEdID = $("#Subledger_Id").val();
                var RandNu = $("#RandomValue").val();
                var supp = $("#ChildAccount").val();
                var TaxIDs = $("#selecteTax_ID").val();
                var EXpTVM;
                EXpTVM = {
                    Expense_ID: ExpID,
                    AccountExp_ID: AccEXPID,
                    AccountTreasury_ID: AccTreasID,
                    SubLedger_ID: SubLEdID,
                    ExpDesc: EXPDesc,
                    Amount: ValueEXP,
                    BussinesSubledger_Id: BUID,
                    DepartSubledger_Id: DepID,
                    BranchSubledger_Id: BranchID,
                    taxid: TaxIDs,
                    ChildAccount: supp,
                    RandoumVAlue: RandNu
            };
            $.ajax(
             {
                 url: '@Url.Action("addExpenseGltoTemp", "Expense")',
                    data: JSON.stringify(EXpTVM),
                 contentType: 'application/json',
                 dataType: 'json',
                 type: 'POST',
                 success: function (data) {
                     $("#getTempList").load('@(Url.Action("GetExpenseGLList", "Expense"))?ExpRandNum=' + RandNu);
                     $("#AccountExpense_Id").val(null);
                     $('#AccountExpense_Id').trigger('chosen:updated');
                     $("#AccountTreasure_Id").val(null);
                     $('#AccountTreasure_Id').trigger('chosen:updated');
                     $('#ChildAccount').val(null);
                     $('#ChildAccount').trigger('chosen:updated');
                     $('#Expense_Description').val(null).trigger('change');
                     $("#Expense_Value").val("");
                     $("#TREID").show();
                     $("#supId").show();
                     $("#EXPID").show();
                     $("#expensesBranchId").show();
                     $("#expensesDepartmentId").show();
                     $("#expensesBussinessFieldId").show();
                     $("#expensesCostCenterId").show();
                     $("#expensesTaxId").show();
                     $("#addToAccountBtnSpinner").hide();
                     CheckTotals();
                 },
                    error: function () {
                        $("#addToAccountBtnSpinner").hide();
                        alert('error');
                    }
             });

            };
        };

  function DeleteTemp(e) {
            var ids = e;
            var RandNums=@Model.RandomValue;
            $.ajax({
                url: '@Url.Action("DeleteExpFromTemp", "Expense")',
                type: 'get',
                data: { ExpTempID: ids}
            }).done(function (result) {
                $("#getTempList").load('@(Url.Action("GetExpenseGLList", "Expense"))?ExpRandNum=' + RandNums);
                CheckTotals();
            });
        }
      function CheckTotals() {
        var randV = $("#RandomValue").val();
        $.ajax({
            url: '@Url.Action("CheckTotals", "Expense")',
            type: 'get',
            data: { RandNum: randV }
        }).done(function (result) {
            var res = result;
            if (res=="0")
            {
                $("#subBut").show();
                document.getElementById("subBut").disabled = false;
            }
            else
            {
                $("#subBut").show();
                document.getElementById("subBut").disabled = true;
            }
        });
        };
    </script>
