@model Accountingsystem.ViewModel.SystemRoleVM


@{
    ViewBag.Title = Accountingsystem.Resources.EmployeeRoleList.EditRole;
    HttpCookie cookie = Request.Cookies["Language"];
}

@{


    if (cookie != null && cookie.Value != null)
    {
        if (cookie.Value == "en")
        {
            Layout = "~/Views/Shared/_LayoutLTR.cshtml";
            <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }
    else
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
        <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
        <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
    }
}



        <div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
            @Html.HiddenFor(model => model.Id)
       
            <div class="text-center">
                @Accountingsystem.Resources.EmployeeRoleList.EditRole
            </div>
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.EmployeeRoleList.Name)
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })

                </div>
            </div>

            <div class="table-responsive mb-4 mt-4">
                <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                    <thead>
                        <tr>

                            <th>
                                @Accountingsystem.Resources.EmployeeRoleList.Number
                            </th>
                            <th>
                                @Accountingsystem.Resources.EmployeeRoleList.Role
                            </th>

                            <th>
                                @Accountingsystem.Resources.EmployeeRoleList.Department
                            </th>
                            <th>
                                <input type="checkbox" name="select-all" id="select-all" />
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.RoleFunctions)
                        {
                            <tr>


                                <td>@item.SystemFunction.Id</td>
                                @if (item.SystemFunction.Level == 1)
                                {
                                    <td><h3>@item.SystemFunction.ArabName</h3></td>
                                }
                                @if (item.SystemFunction.Level == 2)
                                {
                                    <td><h4>@item.SystemFunction.ArabName</h4> </td>
                                }
                                @if (item.SystemFunction.Level == 3)
                                {
                                    <td><h6>@item.SystemFunction.ArabName</h6></td>
                                }
                                <td>@Accountingsystem.Models.SystemRole.getDepartment(item.SystemFunction.Id)</td>
                                <td>@Html.EditorFor(model => item.isExist)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" onclick="fun()" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.InvoiceMasterIndex.Edit <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>


