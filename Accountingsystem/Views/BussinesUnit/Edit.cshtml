@model Accountingsystem.ViewModel.BussinesUnitVM


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>انشطة الشركة</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">

            <div class="col-md-10">
                @Html.HiddenFor(model => model.BU_Id, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.BU_Id, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
          
            <div class="col-md-10">
                @Html.HiddenFor(model => model.BU_Code, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.BU_Code, "", new { @class = "text-danger" })
            </div>
        </div>

       

        <div class="form-group">

            <div class="col-md-10">
                @Html.HiddenFor(model => model.CompanyComp_Id, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CompanyComp_Id, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.BU_Name, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.BU_Name, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="col-md-5">

                        <div class="form-group">
                            @Html.LabelFor(model => model.BU_Name, htmlAttributes: new { @class = "control-label col-md-2" })

                        </div>
                    </div>


                </div>
                <div class="col-md-6">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.BU_Description, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.BU_Description, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-5">

                        <div class="form-group">
                            @Html.LabelFor(model => model.BU_Description, htmlAttributes: new { @class = "control-label col-md-2" })

                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.BU_Type, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.BU_Type, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="col-md-5">

                        <div class="form-group">
                            @Html.LabelFor(model => model.BU_Type, htmlAttributes: new { @class = "control-label col-md-2" })

                        </div>
                    </div>


                </div>
               
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="حفظ التعديل" class="btn btn-primary" />
            </div>
        </div>
    </div>
}


<a class="btn btn-primary" href='@Url.Action("Index")'>
    <p>

        العودة الى القائمة
    </p>
</a>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
