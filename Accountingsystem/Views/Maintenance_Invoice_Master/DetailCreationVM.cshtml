@model Accountingsystem.ViewModel.Maintenance_Invoice_DetailVM

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
       
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.Main_Detail_Id)
@Html.HiddenFor(model => model.Maintenance_Invoice_MasterMain_Invoice_Id)
        <div class="container">
        <div class="row">
            <div class="col-md-5">
                <div class="col-md-6">
                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Subscription_Name, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Subscription_Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Subscription_Name, htmlAttributes: new { @class = "control-label col-md-2" })
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="col-md-6">

                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Subscription_Cost, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Subscription_Cost, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        @Html.LabelFor(model => model.Subscription_Cost, htmlAttributes: new { @class = "control-label col-md-2" })
                    </div>
                </div>
            </div>
        </div>
        </div>
        </div>






        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <a href='javascript:;' onclick='AddDetailToMaster();' class="btn btn-success" style="text-decoration:none;">اضف الى الائحة</a>
            </div>
        </div>

}


