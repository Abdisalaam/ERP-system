    <div class="widget-content widget-content-area br-6">
        <div>
            @using (Html.BeginForm("Index", "MasterPOSInvoice", FormMethod.Get, new { @id = "sub-form", @class = "form-group", role = "form" }))
            {
                <form id="sub-form">
                    <div class="col-md-6">




                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.MasterPOSInvoiceIndex.GetInvoiceStartingFromThisDate)

                            <div class="input-group">

                                <input id="invoicesDate" type="date" name="invoicesDate" class="form-control mb-4">

                                <div class="input-group-append">

                                    <div>

                                        <input type="submit" class="btn btn-block btn-outline-secondary form-control" value="@Accountingsystem.Resources.InvoiceMasterDetails.BackToList">

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>

                </form>
            }
        </div>
        <div class="text-center">
            @msg
        </div>

        <div class="text-center">
            @Accountingsystem.Resources.MasterPOSInvoice.QuickInventorySalesInvoicesList
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.Number)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.InvoiceNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.InvoiceDate)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.SaleCenter)
                        </th>




                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.Net)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.CustomerNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.CustomerName)
                        </th>



                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.PaymentMethod)
                        </th>
                        <th></th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var payment = item.PosPaymentMethods.FirstOrDefault();
                        <tr>
                            <td>
                                @count
                                @{count = count + 1;}
                            </td>
                            @if (item.Number == null)
                            {
                                <td>
                                    @Html.DisplayFor(model => item.Serial_Number)
                                </td>
                            }
                            else
                            {
                                <td>
                                    @Html.DisplayFor(model => item.Number)
                                </td>
                            }
                            <td>
                                @Html.DisplayFor(modelItem => item.Serial_Number)
                            </td>

                            <td>
                                @item.Invoice_Date.Value.ToString("yyyy/MM/dd ")
                            </td>

                            <td>

                                @item.PointOfSale.POS_Name
                            </td>



                            <td>
                                @Math.Round(item.Total_Amount.Value, 2, MidpointRounding.AwayFromZero)
                            </td>

                            <td>

                                @{ if (item.Customer_Id == null || item.Customer_Id == 0)
                                    {

                                    }
                                    else

                                    {
                                        var customerCode = Accountingsystem.Models.Customer.GetCustomerById(item.Customer_Id.Value);
                                        <h>@customerCode.Customer_Code</h> }
                                }
                            </td>
                            <td>

                                @{ if (item.Customer_Id == null || item.Customer_Id == 0)
                                    {

                                    }
                                    else

                                    {
                                        var customer = Accountingsystem.Models.Customer.GetCustomerById(item.Customer_Id.Value);
                                        <h>@customer.Customer_Name</h> }
                                }
                            </td>
                            @if (payment != null)
                            {
                                <td>
                                    @Accountingsystem.Models.PaymentMethod.GetPaymentMethodById(payment.PaymentMethod_Id).Payment_Type
                                </td>
                            }
                            else
                            {
                                <td></td>
                            }
                            <td>
                                <div class="btn-group">

                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                        <a href="@Url.Action( "Detail", new { id = item.MasterPOSInvoiceId })" class="dropdown-item">
                                            @Accountingsystem.Resources.InvoiceMasterIndex.Details
                                        </a>

                                        @*<a class="dropdown-item" href='@Url.Action("PrintPOSInvoiceWhite", new { controller = "Reports", id = item.MasterPOSInvoiceId })'>
                                            @Accountingsystem.Resources.InvoiceMasterIndex.Print
                                        </a>*@
                                    </div>
                                </div>
                            </td>





                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
