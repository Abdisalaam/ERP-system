    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);

            var remain = parseFloat(document.getElementById("reminingShow").innerHTML);
            var total = parseFloat(document.getElementById("TotalShow").innerHTML);
            $("#createOfferSpinner").show();
            if ($('#Emp_Id').val() == "" || $('#Emp_Id').val() == null || $('#Master_Discount').val() == "" || $('#Master_Discount').val() == null || $('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100 || total <= 0 || (remain < total && remain > 0)) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();

                if (remain < total && remain != 0) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.MasterPOSInvoice.TotalinvoiceisBigger',
                        pos: 'top-center'
                    });
                }


                if ($('#Master_Discount').val() == "" || $('#Master_Discount').val() == null) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.MasterPOSInvoice.DiscountMust',
                        pos: 'top-center'
                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }
                if ($('#Master_Discount').val() < 0 || $('#Master_Discount').val() > 100) {
                    Snackbar.show({
                        text:'@Accountingsystem.Resources.MasterPOSInvoice.DiscountValue',
                        pos: 'top-center'
                    });
                    $("#Master_Discount").addClass("addRequiredFieldToInput");
                    $('#Master_Discount').trigger('focus');
                }

                @*if ($('#AllowDiscount').val() == "" || $('#AllowDiscount').val() == null) {
                    var detail2 = $('#AllowDiscount').val();
                    Snackbar.show({
                        text:'@Accountingsystem.Resources.MasterPOSInvoice.FixedDiscountMust',
                        pos: 'top-center'
                    });
                    $("#AllowDiscount").addClass("addRequiredFieldToInput");
                    $('#AllowDiscount').trigger('focus');
                }

                if ($('#AllowDiscount').val() < 0) {
                    Snackbar.show({
                        text:'@Accountingsystem.Resources.MasterPOSInvoice.FixedDiscountValue',
                        pos: 'top-center'
                    });
                    $("#AllowDiscount").addClass("addRequiredFieldToInput");
                    $('#AllowDiscount').trigger('focus');
                }*@


                if (total <= 0) {
                    Snackbar.show({
                        text: '@Accountingsystem.Resources.validate.invoiceProductMust',
                        pos: 'top-center'
                    });
                    var detail = $('#InvoiceMasterDetailList tr').length;
                    $("#InvoiceMasterDetailList").addClass("addRequiredFieldToInput");
                    $("#Batch_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#Batch_ID_chosen span').css('background', 'red');
                    $('#Batch_ID_chosen b').css('background', 'red');
                    $('#Batch_ID_chosen').trigger('focus');
                }
                if ($('#Emp_Id').val() == "" || $('#Emp_Id').val() == null) {
                    Snackbar.show({
                        text: "الموظف الزامي",
                        pos: 'top-center'
                    });

                    $("#Emp_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Emp_Id_chosen span').css('background', 'red');
                    $('#Emp_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Emp_Id").offset().top
                    }, 2000);
                }


                // Eng Mohammed



                $("#createOfferSpinner").hide();
                event.preventDefault();
            }


        });

    </script>
