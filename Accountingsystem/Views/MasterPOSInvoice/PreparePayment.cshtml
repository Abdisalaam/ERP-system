@model Accountingsystem.ViewModel.PosPaymentMethodVM



@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <hr />
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.MasterPOSInvoice.PaymentMethod)
                @{ Html.EnableClientValidation(false); }

                <div class="input-group mb-4">
                    @Html.DropDownListFor(model => model.PaymentMethod_Id, Model.PaymentList, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger">*</label>
                            '
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.MasterPOSInvoice.Amount)
                @{ Html.EnableClientValidation(false); }

                <div class="input-group mb-4">
                    @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control", @type = "number", @step = "any" } })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger">*</label>
                            
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">

                <a href='javascript:;' onclick='AddAAlDetailToMaster();' class="btn btn-outline-info mb-2"  style="text-decoration:none;">@Accountingsystem.Resources.MasterPOSInvoice.AddToRegulation</a>
            </div>
        </div>
    </div>
    



    
</div>
}



<script type="text/javascript">
    $("#PaymentMethod_Id").chosen();
    $("#PaymentMethod_Id_chosen").addClass("form-control Dropdownlist-select");
</script>
