@model Accountingsystem.Models.MasterPOSInvoice
@{
    var _Company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    var branch = Accountingsystem.Models.Branch.getAddressForInvoice(Model.PointOfSale.BranchSubledger_Id);
    decimal paiedAmount = 0;
    decimal subTotalBeforeTax = 0;
  
    var employee = Accountingsystem.Models.Employee.getEmpById(Model.Employee_Id.Value);

    Layout = null;
}
<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link href="~/Content/PrintPOS.css" rel="stylesheet" />
    <title>Receipt Cashier</title>
</head>
<body>
    <center>
        <div class="ticket" style="font-size:smaller;">
            @if (branch.BranchLogo != null)
            {
                <img src="data:image/jpg;base64,@Convert.ToBase64String(branch.BranchLogo)" alt="Sutumatic" style="width:150px; height:50px;" />
            }
            <p class="centered" style="border-bottom:dotted;border-top:dotted;">
                <span style="font-size:14px;"><strong>فاتورة ضريبية مبسطة</strong></span>
                <br />
                <span style="font-size:14px"><strong>Simplified Tax Invoice</strong></span>
            </p>
            <table>

                <tr style="border-top:hidden; border-bottom:dotted">


                    <th style="font-size:12px; width:200px">

                        <span style="font-size:15px"> @_Company.Comp_Name</span>
                        <br />
                        <span style="font-size:15px"> @Model.PointOfSale.POS_Name</span>
                        <br />
                        <span style="font-size:15px"> @branch.Branch_Name</span>
                        <br />

                        <span style="font-size:15px">@branch.Branch_Address</span>
                        <br />
                        <span style="font-size:15px">@_Company.Tax_Number / </span>  <span style="font-size:15px"> الرقم الضريبي </span>

                        <br />
                        <span style="font-size:15px">@employee.Emp_Name</span>
                        <br />
                        <span style="font-size:15px">Tel:  @branch.Branch_Phone</span>
                        <br />
                        <span style="font-size:15px">Email:  @branch.Branch_Email</span>
                    </th>

                </tr>

            </table>

            <table>

                <tr style="border-top:hidden">
                    <th class="description" style="font-size:15px; text-align:left; padding-left:5px"> Invoice Number</th>
                    @if (Model.Number == null)
                    {
                        <th class="description" style="font-size:15px; padding-right:10px"> <b>@Model.Serial_Number </b></th>
                    }
                    else
                    {
                        <th class="description" style="font-size:15px; padding-right:10px"> <b>@Model.Number </b></th>
                    }
                
                    <th class="quantity" style="font-size:15px; text-align:right; padding-right:5px"> رقم الفاتورة</th>

                </tr>
                <tr style="border-top:hidden; text-align:center;">
                    <th class="description" style="font-size:15px; text-align:left; padding-left:5px"> Invoice Date</th>

                    <th class="description" style="font-size:15px;">@DateTime.Now</th>
                    <th class="quantity" style="font-size:15px; text-align:right; padding-right:5px">تاريخ الفاتورة</th>

                </tr>

            </table>
            @if (Model.Customer_Id > 0)
            {
                var customer = Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id.Value);
            <table>

                <tr>
                    <th class="description" style="font-size:15px"> Customer</th>

                    <th class="description" style="font-size:15px">@customer.Customer_Name</th>
                    <th class="quantity" style="font-size:15px">العميل</th>

                </tr>
                <tr style="border-top:hidden">
                    <th class="description" style="font-size:15px">Phone</th>

                    <th class="description" style="font-size:15px">@customer.Customer_Phone</th>
                    <th class="quantity" style="font-size:15px">الهاتف</th>

                </tr>
                @if (customer.Customer_TaxNumber != null)
                {
                    <tr style="border-top:hidden">
                        <th class="description" style="font-size:15px">Tax No</th>

                        <th class="description" style="font-size:15px">@customer.Customer_TaxNumber</th>
                        <th class="quantity" style="font-size:15px">الرقم الضريبي</th>

                    </tr>


                }

            </table>

            }
            <br />
            <table>
                <thead>
                    <tr>
                        <th class="description" style="font-size:15px;"> <b> Price | السعر </b></th>

                        <th class="quantity" style="font-size:15px"> <b>QTY | الكمية</b></th>

                        <th class="description" style="font-size:15px; text-align:right; padding-right:5px"><b>Item | الصنف</b></th>
                    </tr>
                   
                </thead>
                <tbody>
                    @foreach (var detail in Model.DetailPOSInvoices)
                    {
                        var a = Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero);

                        var product = Accountingsystem.Models.Product.GetProdectById(detail.Product_Id);

                        <tr style="border-top:hidden; text-align:center">
                            <th class="description" style="font-size:15px"> <b>@Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero) </b></th>

                            <th class="quantity" style="font-size:15px"> <b>@Math.Round(detail.Product_Quantity, 2, MidpointRounding.AwayFromZero)</b></th>

                            <th class="description" style="font-size:15px; word-break: break-all; text-align:right; padding-right:5px"> <b>@product.Prod_Name </b></th>
                        </tr>
                        subTotalBeforeTax += detail.Product_Quantity * detail.Product_Price;


                    }

                    <tr></tr>
                </tbody>
            </table>
            <br />
            <p class="centered">
                <table style="width:250px">
                    <tr>
                        <th class="description" style="font-size:15px;width:100px">Total exclude Tax</th>
                        <th class="quantity" style="font-size:15px;width:50px">@Math.Round(subTotalBeforeTax, 2, MidpointRounding.AwayFromZero)</th>
                        <th class="description" style="font-size:15px;width:50px">المجموع غير شامل الضريبة</th>

                    </tr>
                    @if (Model.Master_Discount > 0)
                    {
                        <tr>
                            <th class="description" style="font-size:15px">Discount</th>
                            <th class="quantity" style="font-size:15px">@Math.Round(subTotalBeforeTax * (Model.Master_Discount.Value / 100), 2, MidpointRounding.AwayFromZero)</th>
                            <th class="description" style="font-size:15px">الخصم % @Math.Round(Model.Master_Discount.Value, 2, MidpointRounding.AwayFromZero) </th>

                        </tr>

                    }





                    <tr>
                        <th class="description" style="font-size:15px">Total VAT Amount</th>
                        <th class="quantity" style="font-size:15px">
                            @Math.Round(Model.Total_Tax.Value, 2, MidpointRounding.AwayFromZero)


                        </th>
                        <th class="description" style="font-size:15px">مجموع ضريبة القيمة المضافة</th>

                    </tr>
                    @if (Model.TotalNewTaxs != null)
                    {
                        foreach (var exttax in Model.TaxPOSInvoices)
                        {
                        <tr>
                            <th class="description" style="font-size:15px">Extra Tax</th>
                            <th class="quantity" style="font-size:15px">
                                @Math.Round(exttax.Amount, 2, MidpointRounding.AwayFromZero)


                              



                                
                            

                            </th>
                            <th class="description" style="font-size:15px">@Accountingsystem.Models.Tax.GetTaxesbyId(Convert.ToInt32( exttax.Tax_Id)).Tax_Name</th>


                        </tr>
                        }
                    }
                        <tr>
                            <th class="description" style="font-size:15px">Total including VAT</th>
                            <th class="quantity" style="font-size:15px">@Math.Round(Model.Total_Amount.Value, 2, MidpointRounding.AwayFromZero)</th>
                            <th class="description" style="font-size:15px">مجموع المبلغ المستحق</th>

                        </tr>


                        @{
                            int _counter = 0;
                            if (Model.PosPaymentMethods.Count() > 0)
                            {
                                foreach (var paymentMethode in Model.PosPaymentMethods)
                                {
                                    paiedAmount += paymentMethode.Amount;
                                    if (_counter == 0)
                                    {
                                        <tr>
                                            <th class="description" style="font-size:15px">Payment Method</th>
                                            <th class="quantity" style="font-size:15px">@Accountingsystem.Models.PaymentMethod.GetPaymentMethodById(paymentMethode.PaymentMethod_Id).Payment_Type</th>
                                            <th class="description" style="font-size:15px">طريقة الدفع</th>

                                        </tr>

                                    }
                                    else
                                    {
                                        <tr style="border-top:hidden">
                                            <th class="description" style="font-size:15px"></th>
                                            <th class="quantity" style="font-size:15px">@Accountingsystem.Models.PaymentMethod.GetPaymentMethodById(paymentMethode.PaymentMethod_Id).Payment_Type</th>
                                            <th class="description" style="font-size:15px"></th>

                                        </tr>

                                    }
                                    _counter++;

                                }

                            }
                            else
                            {
                                var payemntvalue = Accountingsystem.Models.POSReceipt.getAllPayForthatInvoicebyCode(Model.Serial_Number);
                                <tr>
                                    <th class="description" style="font-size:15px">Total paied amount</th>
                                    <th class="quantity" style="font-size:15px"><b>@Math.Round(payemntvalue, 2, MidpointRounding.AwayFromZero)</b></th>
                                    <th class="description" style="font-size:15px">المبلغ  المدفوع</th>

                                </tr>
                                <tr>
                                    <th class="description" style="font-size:15px">Total Remaining Amount</th>
                                    <th class="quantity" style="font-size:15px"><b>@Math.Round(Model.Total_Amount.Value - payemntvalue, 2, MidpointRounding.AwayFromZero)</b></th>
                                    <th class="description" style="font-size:15px">المبلغ  المتبقي</th>

                                </tr>
                            }

                        }



                    </table>
            </p>



            <div style=' text-align:center; '>
                @if (Model.QRNumber != null)
                {

                    <br />
                    <img src="data:image/jpg;base64,@Accountingsystem.Models.TLVCls.GenerateInvoiceQRbase(Model.QRNumber.Value)" alt="Image" width="150px" height="150px" />

                }

            </div>

        </div>

    </center>

    <script type="text/javascript">
        window.onload = function () {
            window.print(); window.onfocus = function () { window.close(); }

        }
    </script>
</body>
</html>
