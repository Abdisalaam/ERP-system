@model Accountingsystem.ViewModel.DetailPOSInvoiceVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">

    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Details_Id)
    @Html.HiddenFor(model => model.Master_Id)
    

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.InvoiceMasterDetails.ProductOrService)
                @{ Html.EnableClientValidation(false); }

                <div class="input-group mb-4">
                    @Html.DropDownListFor(model => model.Batch_ID, Model.BatchList, Accountingsystem.Resources.InvoiceMasterDetails.SelectProduct, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger">*</label>
                        </div>
                        <button id="addProductBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#productModal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
}

<script type="text/javascript">
    $("#Batch_ID").chosen();
    $("#Batch_ID_chosen").addClass("form-control Dropdownlist-select");
</script>
<script>

    $("#Batch_ID").change(function (e) {
        //var serialId = 0;
        serialId = $("#Customer_Id").val();
        if (serialId == 0 || serialId == null)
        {
            serialId = 0;
        }
        var selectedValue = $(this).val();
       
            $.ajax({
                url: '@Url.Action("GetProductPrice", "MasterPOSInvoice")',
                data: { proId: selectedValue, customer: serialId },
                type: 'get',
            }).done(function (result) {

                $("#Product_Tax").val(result["Tax"]).trigger('change');
                $("#Product_Price").val(result["price"]);
                AddDetailToMaster();
            }
            );
        });
    </script>
<script>

    $("#Customer_Id").change(function (e) {
        //var serialId = 0;
        serialId = $("#Batch_ID").val();
        if (serialId == 0 || serialId == null)
        {
            serialId = 0;
        }
        var selectedValue = $(this).val();
       
            $.ajax({
                url: '@Url.Action("GetProductPrice", "MasterPOSInvoice")',
                data: { proId: serialId, customer: selectedValue },
                type: 'get',
            }).done(function (result) {

                $("#Product_Tax").val(result["Tax"]);
                $("#Product_Price").val(result["price"]);

            }
            );
        });


</script>
<script>
    $("#Product_Price").change(function (e) {
        var Price= $("#Product_Price").val();

        var batch = $("#Batch_ID").val();
       

        $.ajax({
            url: '@Url.Action("GetmessageForPOS", "InvoiceMaster")',
            data: { price: Price, batchId: batch },
                type: 'get',
        }).done(function (result) {
            alert(result);

            }
            );
        });
</script>
