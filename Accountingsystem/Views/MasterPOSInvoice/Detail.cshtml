    <script type="text/javascript">
            updateButtonText();
            hideEditAndDeleteActions();
            function updateButtonText() {
                var Invoice_State = '@Model.Invoice_State';
                if (Invoice_State == "Void") {
                    $("#changeState").hide();
                    return;
                }
                else if (Invoice_State == "Pending")
                    $("#changeState").val("Post");
                else if (Invoice_State == "Post")
                    $("#changeState").val("Void");
            }
            function updateInvoiceStateText() {
                var Invoice_State =  '@Model.Invoice_State';
                if (Invoice_State == "Pending")
                    $("#Invoice_State").text("Post");
                else if (Invoice_State == "Post")
                    $("#Invoice_State").text("Void");
            }

            function hideEditAndDeleteActions() {
                /// <summary>Hides the edit and delete actions if the invoice is not pending
                var Invoice_State =   '@Model.Invoice_State';
                if (Invoice_State != "Pending")
                    $("#EditAndDelete").hide();
            }

            function updateInvoiceState(data) {
                return $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    type: 'POST',
                         url: '@Url.Action("Edit", "MasterPOSInvoice")',
                    data: data,
                    success: function (result) {
                        Snackbar.show({
                            text: result,
                            pos: 'top-center'

                        });
                        setTimeout(function () {

                            location.reload();

                        }, 5000);
                    },
                    error: function () {
                        alert("Error!")
                    }
                });
            }

            $("#changeState").click(function (e) {
                this.disabled = true;
                e.preventDefault();
                var data = JSON.stringify({
                    MasterPOSInvoiceId: @Model.MasterPOSInvoiceId,
                    Invoice_State: $("#changeState").val()
                });

                $.when(updateInvoiceState(data)).then(function (response) {
                    console.log(response);
                }).fail(function (err) {
                    console.log(err);
                });
                updateButtonText();
                updateInvoiceStateText();
                hideEditAndDeleteActions();

            })
    </script>

