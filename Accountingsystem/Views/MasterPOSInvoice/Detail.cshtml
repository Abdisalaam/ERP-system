                    var taxinfo = Accountingsystem.Models.Tax.GetTaxesbyId(Convert.ToInt32(taxo.Tax_Id));
                    <div class="media  d-md-flex d-block text-sm-left text-center">

                        <div class="media-body details-form-control mb-4">
                            <div class="d-xl-flex d-block justify-content-between">
                                <div class="">
                                    @taxinfo.Tax_Name @taxinfo.Tax_Percentage %
                                </div>
                                <div>
                                    @Math.Round(taxo.Amount, 2, MidpointRounding.AwayFromZero)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            @if (Model.AllowDiscount != 0 && Model.AllowDiscount != null)
            {
                <div class="media  d-md-flex d-block text-sm-left text-center">

                    <div class="media-body details-form-control mb-4">
                        <div class="d-xl-flex d-block justify-content-between">
                            <div class="">
                                @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.AllowableDiscount)
                            </div>
                            <div>
                                @Math.Round(Model.AllowDiscount.Value, 2, MidpointRounding.AwayFromZero)
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="media  d-md-flex d-block text-sm-left text-center">

                <div class="media-body details-form-control mb-4">
                    <div class="d-xl-flex d-block justify-content-between">
                        <div class="">
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.Net)
                        </div>
                        <div>
                            @Math.Round(Model.Total_Amount.Value, 2, MidpointRounding.AwayFromZero)
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.PosPaymentMethods.Any())
            {
                <div class="row inv--product-table-section">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="">
                                    <tr>
                                        <th>@Accountingsystem.Resources.MasterPOSInvoice.PaymentMethod</th>

                                        <th>@Accountingsystem.Resources.MasterPOSInvoice.Amount</th>


                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pay in Model.PosPaymentMethods)
                                    {
                                        <tr>
                                            <td>@Accountingsystem.Models.PaymentMethod.GetPaymentMethodById(pay.PaymentMethod_Id).Payment_Type</td>

                                            <td>@Math.Round(pay.Amount, 2, MidpointRounding.AwayFromZero)</td>


                                            @{payTotal += pay.Amount; }

                                        </tr>
                                    }
                                    <tr>
                                        <td>@Accountingsystem.Resources.MasterPOSInvoice.Total</td>

                                        <td>@Math.Round(payTotal, 2, MidpointRounding.AwayFromZero)</td>




                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }







