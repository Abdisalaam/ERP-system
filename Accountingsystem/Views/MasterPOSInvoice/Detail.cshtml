@model Accountingsystem.Models.MasterPOSInvoice

@{
    ViewBag.Title = Accountingsystem.Resources.MasterPOSInvoice.SalesCenterInvoiceDetails;

    var msg = ViewBag.message;
    var revenueAccount = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount(Model.Account_Id.Value);
    decimal total = 0;
    decimal discount = 0;
    decimal TotalAmountbeforeDisc = 0;
    decimal payTotal = 0;
    HttpCookie cookie = Request.Cookies["Language"];
    var incoceDate = Model.Invoice_Date.ToString();
    var _CompanyId = Convert.ToInt32(Model.Company_Id);
    var _Company = Accountingsystem.Models.Company.GetCompanyById(_CompanyId);
    var customer = new Accountingsystem.Models.Customer();
    if (Model.Customer_Id > 0)
    {
        customer = Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id.Value);
    }
    DateTime? operationDate = new DateTime();
    if (Model.QRNumber > 0)
    {
        operationDate = Accountingsystem.Models.MasterQRInvoice.GetMasterQRInvoiceById(Model.QRNumber.Value).DateOfCreate;
    }

    }

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

        }
    }


</head>
<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <div class="statbox widget box box-shadow">

