                                        </a>
                                    }
                                    if (customer.Customer_Phone.StartsWith("00") && customer.Customer_Phone.Length > 13)
                                    {
                                        <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@customer.Customer_Phone" target="_blank">
                                            <img src="~/Image/WhatsApp.png" style="height:23px;" />
                                        </a>
                                    }
                                    if (customer.Customer_Phone.StartsWith("+966") && customer.Customer_Phone.Length >= 12)
                                    {
                                        customer.Customer_Phone = customer.Customer_Phone.Remove(0, 1);
