                        </div>
                    </div>
                    @{if (Model.Employee_Id != null)
                        {
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.EmployeeName)
                                                </div>
                                                <div>
                                                    @{
                                                        var employee = Accountingsystem.Models.Employee.getEmpById(Model.Employee_Id.Value);
                                                        @employee.Emp_Name
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        } }

                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="text-center">
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Description)
                        </div>


                        @Html.TextAreaFor(model => model.Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="text-center">
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Notes)
                        </div>

                        @Html.TextAreaFor(model => model.Notes, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                    </div>
                </div>

            </div>
            <div class="table-responsive">
                <table class="table mb-4">
                    <thead>
                        <tr>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.Item</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.ItemNumber</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.Quantity</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.ItemPrice</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.Discount</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.DiscountValue</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.TotalTax</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.TotalAmount</th>
                        </tr>

                    </thead>
                    <tbody>
                        @foreach (var detail in Model.DetailPOSInvoices)
                        {
                            total += detail.Product_Price * detail.Product_Quantity;
                        <tr>
                            <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_Id).Prod_Name</td>
                            <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_Id).Prod_Code</td>

                            <td>@Math.Round(detail.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero)</td>
                            @if (detail.Detail_Discount > 0)
                            {
                                <td>@Math.Round(detail.Detail_Discount.Value, 2, MidpointRounding.AwayFromZero)</td>
                                <td>@Math.Round(detail.Detail_Discount_Amount.Value, 2, MidpointRounding.AwayFromZero)</td>
                            }
                            else
                            {
                                <td>0</td>
                                <td>0</td>
                            }

                            <td>@Math.Round(detail.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Total_Amount, 2, MidpointRounding.AwayFromZero)</td>
                            @{TotalAmountbeforeDisc += detail.Product_Quantity * detail.Product_Price; }
                        </tr>
                        }
                    </tbody>
                </table>

            </div>


            <div class="media  d-md-flex d-block text-sm-left text-center">

                <div class="media-body details-form-control mb-4">
                    <div class="d-xl-flex d-block justify-content-between">
                        <div class="">
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Total)
                        </div>
                        <div>
                            @Math.Round(total, 2, MidpointRounding.AwayFromZero)
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Master_Discount > 0)
            {
                <div class="media  d-md-flex d-block text-sm-left text-center">

                    <div class="media-body details-form-control mb-4">
                        <div class="d-xl-flex d-block justify-content-between">
                            <div class="">
                                @Accountingsystem.Resources.MasterPOSInvoice.DiscountPercentage  @Math.Round(Model.Master_Discount.Value, 2, MidpointRounding.AwayFromZero) %
                            </div>
                            <div>
                                @Math.Round(total * (Model.Master_Discount.Value / 100), 2, MidpointRounding.AwayFromZero)
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Total_Tax > 0)
            {
