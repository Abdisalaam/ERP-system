<script>
    function OnChangeDetailTotal(obj) {
        var detailTotalAmount = $(obj).val()
        var detailId = $(obj).parents('tr').find('.Detail_Id').val();
        var invoiceMasterId =@Model.invoice_Id;




                    $.ajax({
                        url: '@Url.Action("updatePOSDependOnDetailTotalAmount", "MasterPOSInvoice")',
                        data: { detailId: detailId, detailTotalAmount: detailTotalAmount },
                type: 'get',
                    }).done(function (result) {
                        debugger

