</script>
<script>
    function OnChangeDrop(obj) {


        var Tax = $(obj).val()

        var detailId = $(obj).parents('tr').find('.Detail_Id').val();


        var invoiceMasterId =@Model.invoice_Id;

        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePOSDependTax", "MasterPOSInvoice")',
                        data: { detailId: detailId, Tax: Tax, masterDiscount: masterDiscount },
                type: 'get',
            }).done(function (result) {


                updateTaxes();

            }
        );


    }







</script>
