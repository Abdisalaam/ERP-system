        function PrintElem() {
            var divContents = document.getElementById("contentToPrint").innerHTML;
            var height = $("#contentToPrint").height();
            document.body.style.height = height;
            var myWindow = window.open('', 'contentToPrint', 'height=400,width=600');
            myWindow.document.write('<html style="page-break-inside: avoid;"><head><title>my div</title><link href="~/Content/PrintPOS.css" media = "print" rel="stylesheet" />');
            /*optional stylesheet*/ //myWindow.document.write('<link rel="stylesheet" href="main.css" type="text/css" />');
            myWindow.document.write('</head><body style="page-break-inside: avoid;">');

            //myWindow.document.write('<html style="margin:0;padding:0; max-height: ' + height + ';' + 'height:' + height+ '; "><head><title>my div</title><link href="~/Content/PrintPOS.css" rel="stylesheet" />');
