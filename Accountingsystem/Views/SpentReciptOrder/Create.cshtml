    <script>

        //$('#End_Date_Vacations').datetimepicker({ format: 'DD/MM/YYYY' });
        //$('#Start_Date_Vacations').datetimepicker({ format: 'DD/MM/YYYY' });
        var currentDate = new Date();
        var _OfferDate = flatpickr(document.getElementById('Date'), {
            defaultDate: currentDate
        });

    </script>
    <script>
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }


            $("#Employee_Id").chosen();

            $("#Employee_Id_chosen").addClass("form-control Dropdownlist-select");


        });


    </script>
    <script>


        $('#Employee_Id').on('input', function () {
            $("#Employee_Id").removeClass("addRequiredFieldToInput");
        });
        $('#Date').on('input', function () {
            $("#Date").removeClass("addRequiredFieldToInput");
        });
        $('#Value').on('input', function () {
            $("#Value").removeClass("addRequiredFieldToInput");
        });
        $('#Description').on('input', function () {
            $("#Description").removeClass("addRequiredFieldToInput");
        });
      

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            debugger
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#Employee_Id').val() == "" || $('#Employee_Id').val() == null||
                $('#Date').val() == "" || $('#Date').val() == null||
                $('#Value').val() == "" || $('#Value').val() == null ||$('#Value').val() == 0||
                $('#Description').val() == "" || $('#Description').val() == null
            ) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($('#Date').val() == "" || $('#Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SpentReciptOrder.EnterDate",
                        pos: 'top-center'
                    });
                    $("#Date").addClass("addRequiredFieldToInput");
                    $('#Date').trigger('focus');
                }
                if ($('#Value').val() == "" || $('#Value').val() == null || $('#Value').val() == 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SpentReciptOrder.EnterAmount",
                        pos: 'top-center'
                    });
                    $("#Value").addClass("addRequiredFieldToInput");
                    $('#Value').trigger('focus');
                }
                if ($('#Description').val() == "" || $('#Description').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SpentReciptOrder.EnterDescribtion",
                        pos: 'top-center'
                    });
                    $("#Description").addClass("addRequiredFieldToInput");
                    $('#Description').trigger('focus');
                }
                if ($('#Employee_Id').val() == "" || $('#Employee_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SpentReciptOrder.ChooseEmployee",
                        pos: 'top-center'
                    });

                    $("#Employee_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Employee_Id_chosen span').css('background', 'red');
                    $('#Employee_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Employee_Id").offset().top
                    }, 2000);
                }

                $("#createOfferSpinner").hide();
                event.preventDefault();
            }

        });
       

    </script>
}