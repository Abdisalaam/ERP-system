        }
    }


</head>


@using (Html.BeginForm("Create", "Subscription_Type", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.Subscription_TypeCreate.CreateSubscriptionType)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Subscription_TypeCreate.SubscriptionNumber)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.Subscrip_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Subscrip_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Subscription_TypeCreate.SubscriptionName)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.Subscrip_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Subscrip_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Subscription_TypeCreate.SubscriptionPeriodInMonth)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.Durationsubscription, new { htmlAttributes = new { @Value = "", @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Durationsubscription, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Subscription_TypeCreate.RevenueAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedRvenuo_ID, Model.MyRvenuoList, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedRvenuo_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Subscription_TypeCreate.DescriptionOfSubscription)
                                    @Html.TextAreaFor(model => model.Subscrip_Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.Subscription_TypeCreate.DescriptionOfSubscription })
                                    @Html.ValidationMessageFor(model => model.Subscrip_Description, "", new { @class = "text-danger" })
                                </div>
                            </div>





                        </div>
                    </div>
                </div>

            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.VacationsCreate.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index")">
                        @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>


                </div>
            </div>
        </form>

    </div>

}

@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }

    <script>
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }


            $("#SelectedRvenuo_ID").chosen();

            $("#SelectedRvenuo_ID_chosen").addClass("form-control Dropdownlist-select");


        });

    </script>
    <script>


        $('#Subscrip_Name').on('input', function () {
            $("#Subscrip_Name").removeClass("addRequiredFieldToInput");
        });
        $('#Durationsubscription').on('input', function () {
            $("#Durationsubscription").removeClass("addRequiredFieldToInput");
        });
       

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#Subscrip_Name').val() == "" || $('#Subscrip_Name').val() == null||
                $('#Durationsubscription').val() == "" || $('#Durationsubscription').val() == null
               
            ) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#Subscrip_Name').val() == "" || $('#Subscrip_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Subscription_TypeCreate.SubscriptionNameMandatory",
                        pos: 'top-center'
                    });
                    $("#Subscrip_Name").addClass("addRequiredFieldToInput");
                    $('#Subscrip_Name').trigger('focus');
                }
                if ($('#Durationsubscription').val() == "" || $('#Durationsubscription').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Subscription_TypeCreate.SubscriptionPeriodInMonthMandatory",
                        pos: 'top-center'
                    });
                    $("#Durationsubscription").addClass("addRequiredFieldToInput");
                    $('#Durationsubscription').trigger('focus');
                }
                

                $("#createOfferSpinner").hide();
                event.preventDefault();
            }


        });

    </script>


}
