@model Accountingsystem.ViewModel.ProjectClauseVM

<div class="col-md-12">
    <p class="text-center">@Accountingsystem.Resources.ProjectAdvanced.AddClauseOfProject</p>
    <hr />
</div>
<div class="col-md-6">
    <div class="form-group">
        @Html.Label(Accountingsystem.Resources.ProjectAdvanced.name)
        <div class="input-group">
            @Html.EditorFor(model => model.clauseName, new { htmlAttributes = new { @class = "form-control mb-4" } })
            <div class="input-group-append">
                <div>
                    <span class="form-control text-danger">*</span>
                </div>
            </div>
        </div>
        @Html.ValidationMessageFor(model => model.clauseName, "", new { @class = "text-danger" })
    </div>
</div>


<div class="col-md-12">
    <div class="form-group">
        <a href='javascript:;' onclick='addClause();' class="btn btn-block btn-outline-success mb-lg-0" style="text-decoration:none;">
            @Accountingsystem.Resources.ProjectCreateProjectInvs.AddToList
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
            <span id="addToAccountBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
        </a>
    </div>
</div>
