@using (Html.BeginForm("Create", "ProjectAdvanced", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Project_Id)


    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ProjectAdvanced.AddnewSupledgerForProject)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreate.ProjectNumber)
                                    @Html.EditorFor(model => model.Project_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Project_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreate.ProjectName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Project_Name, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Project_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>



                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div id="PrepareSubledger" class="row"></div>
                        <div id="SubledgerList" class="col-md-12"></div>
                        <div id="PrepareSubSubledger" class="row"></div>
                        <div id="SubSubledgerList" class="col-md-12"></div>
                        <div id="PrepareClause" class="row"></div>
                        <div id="ClauseList" class="col-md-12"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.ProjectCreate.CreateProject<span id="createSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Details","Project",new {id=Model.Project_Id})'>
                        @Accountingsystem.Resources.ProjectDetails.ProjectDetail<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>


}



