    <script type="text/javascript">
        function addSubledger() {



                  var Project_Id = @Model.Project_Id;
            var name = $("#SubledgerName").val();
            var number = $("#number").val();
            var incremental = $("#incremental").prop('checked');
            var vm;
            vm = {
                    SubledgerName: name,
                    number: number,
                    incremental: incremental,
                    projecttempId: Project_Id
                    };
                $.ajax(
                {
                        url: '@Url.Action("AddSubledgerToMaster", "ProjectAdvanced")',
                        data: JSON.stringify(vm),
                        contentType: 'application/json',
                        dataType: 'json',
                         type: 'POST',
                        success: function (datao) {
                            Snackbar.show({
                        text:  datao,
                        pos: 'top-center'
                            });


                           
                    $.ajax({

                        url: '@Url.Action("GetSubList", "ProjectAdvanced")?Pro_Id=@Model.Project_Id',
                        type: 'get',

                        contentType: 'application/json',
                        dataType: 'json',

                    }).done(function (result) {

                        $("#projectSubledgerId").empty();

                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);

                            $("#projectSubledgerId").append(p);
                            $("#projectSubledgerId option:last").attr("selected", "selected");

                        }
                        var p = new Option("@Accountingsystem.Resources.ProjectAdvanced.All", 0);
                        $("#projectSubledgerId").append(p);
                        $("#projectSubledgerId option:last").attr("selected", "selected");
                        $('#projectSubledgerId').trigger('chosen:updated');
                        $("#projectSubledgerId_chosen").removeClass("addRequiredFieldToInput");
                        $('#projectSubledgerId_chosen span').css('background', '#ffffff');
                        $('#projectSubledgerId_chosen b').css('background', '#ffffff');
                        $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");

                    });

                  $("#SubledgerList").load('@(Url.Action("GetProjectSubLedgertempsByProId", "ProjectAdvanced"))?protemp_Id=' + @Model.Project_Id);
                        },
                        error: function () { alert('error'); }
                    });
            }
        ;

    </script>
