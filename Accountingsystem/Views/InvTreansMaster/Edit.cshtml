<div id="InventoryHdList"></div>

<div id="InventoryDetailsPartial"></div>


<div id="InventoryH_dDetailsList2222"></div>



@section Scripts {
@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript">

    $('#Date').datetimepicker({ format: 'DD/MM/YYYY' });
    function getLists()
    {
        var inv=$("#TransferHd_Id").val();
        alert(inv)

        $("#InventoryHdList").load('@(Url.Action("GetAllInventoryeDetailresult", "InvTreansMaster"))?TemptH_dDetailes='+ inv);
    }
    function AddInf() {
        var inventory=@Model.TransferHd_Id;
        alert(inventory);

        $("#InventoryDetailsPartial").load('@(Url.Action("PrepareTransDetails", "InvTreansMaster"))?serial='+ inventory);
    };
    function AddDetailToMaster1() {
        var InventoryTransfer_Id=@Model.TransferHd_Id;
        var TransferDetail_Id =  $("#TransferDetail_Id").val();
        var Product_Qty =  $("#Product_Qty").val();
        var TransHd_Id = parseFloat($("#TransHd_Id").val());
        var Detail_TotalCoct =  $("#Detail_TotalCoct").val();
        var Product_ID =  $("#Product_ID").val();
        var Batch_ID =  $("#Batch_ID").val();
        var Detail;
        Detail = {
            TransferDetail_Id:TransferDetail_Id,
            Product_Qty:Product_Qty,
            TransHd_Id:TransHd_Id,
            Detail_TotalCoct:Detail_TotalCoct,
            Product_ID:Product_ID,
            Batch_ID:Batch_ID,
            InventoryTransfer_Id:InventoryTransfer_Id,
        };
        $.ajax(
                    {
                        url: '@Url.Action("AddInventoryDetailsToMaster", "InvTreansMaster")',
                        data: JSON.stringify(Detail),
                        contentType: 'application/json',
                        dataType: 'json',
                        type: 'POST',
                        success: function (data) {
                           
                            $("#InventoryH_dDetailsList2222").load('@(Url.Action("GetAllTempInventoryDetails", "InvTreansMaster"))?tempInventoryH_dId=' + InventoryTransfer_Id);
                        },
                    });

    };

</script>

}

