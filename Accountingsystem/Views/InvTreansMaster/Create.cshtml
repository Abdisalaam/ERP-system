@using (Html.BeginForm("Create", "InvTreansMaster", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.TransferHd_Id)
    @Html.HiddenFor(model => model.SelectedCompanyId)


    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.InvTreansMasterCreate.CreateStoreTransferring)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceNumber)
                                    @Html.EditorFor(model => model.Inv_Code, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Inv_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvTreansMasterCreate.Date)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group" id="productBat">
                                    @Html.Label(Accountingsystem.Resources.InvTreansMasterCreate.StoreTransferredFromIt)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedSourceStore_Id, Model.MySoursStoreList, Accountingsystem.Resources.InvTreansMasterCreate.StoreTransferredFromItInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedSourceStore_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6" id="prodNot">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvTreansMasterCreate.TransferredStore)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedDestStore_Id, Model.MyDestStoreList, Accountingsystem.Resources.InvTreansMasterCreate.TransferredStoreInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedDestStore_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterDetails.Description)
                                    @Html.TextAreaFor(model => model.InvTransfere_Notes, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                                    @Html.ValidationMessageFor(model => model.InvTransfere_Notes, "", new { @class = "text-danger" })
                                </div>
                            </div>





                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div id="InventoryDetail" class="col-md-11 mx-auto"></div>
            </div>
            <div class="row">
                <div id="InventoryDetailList" class="col-md-11 mx-auto"></div>
            </div>

            <div class="row">

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
            </div>
        </form>
    </div>

}



