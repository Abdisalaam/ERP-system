    <script type="text/javascript">

    //$('#Date').datetimepicker({ format: 'DD/MM/YYYY' });

    $(function () {
        $("#SelectedSourceStore_Id").change(function (e) {

            var storeId = $("#SelectedSourceStore_Id").val();

            var InventoryH_dDetailsid = @Model.TransferHd_Id;

            $("#InventoryDetailList").load('@(Url.Action("GetAllTempInventoryDetails", "InvTreansMaster"))?tempInventoryH_dId=' + InventoryH_dDetailsid, 'delete=' + 1);

            $("#InventoryDetail").load('@(Url.Action("PrepareInventoryeH_dDetail", "InvTreansMaster"))?storeId='+storeId,'InventoryTrans=' +InventoryH_dDetailsid);

            });
        });

        function AddDetailToMaster1() {
            var storeId = $("#SelectedSourceStore_Id").val();
            var inventoryH_dId = @Model.TransferHd_Id;
            var Batch_ID = $("#Batch_ID").val();
           // var Batch_ID =$("#SelectedBtachtId").val();

            var Product_Qty =$("#Product_Qty").val();
            var inventoryH_dDetail;
            inventoryH_dDetail={
                InventoryTransfer_Id:inventoryH_dId,
                Batch_ID: Batch_ID,
                //SelectedBtachtId:Batch_ID,
                Product_Qty: Product_Qty,
            };
            $.ajax(
          {
            url: '@Url.Action("AddInventoryDetailsToMaster", "InvTreansMaster")',
            data: JSON.stringify(inventoryH_dDetail),
            contentType: 'application/json',
            dataType: 'json',
            type: 'POST',
            success: function (data) {
                //alert(data);
                Snackbar.show({
                    text: data,
                    pos: 'top-center'
                });
                $("#InventoryDetailList").load('@(Url.Action("GetAllTempInventoryDetails", "InvTreansMaster"))?tempInventoryH_dId=' + inventoryH_dId, 'delete=' + 0);
                @*$("#InventoryDetailList").load('@(Url.Action("GetAllTemprecallInventoryDetailsresult", "InvTreansMaster"))?TemptH_dDetailes='+ inventoryH_dId);*@
            },
            error: function () { alert('error'); }
        });
        };



            function DeleteTemp(e) {

            var ids = e;

            var masterId=@Model.TransferHd_Id;

            $.ajax({

                url: '@Url.Action("DeleteTempDetail", "InvTreansMaster")',
                type: 'get',
                data: {iD:ids}
            }).done(function (result) {
                //alert(result);
                Snackbar.show({
                    text: result,
                    pos: 'top-center'
                });
                $("#InventoryDetailList").load('@(Url.Action("GetAllTempInventoryDetails", "InvTreansMaster"))?tempInventoryH_dId=' + masterId, 'delete=' + 0);


            });
        }

    </script>



    <script>
            $(function () {

                $("#SelectedSourceStore_Id").change(function (e) {

            var selectedText = $(this).find("option:selected").text();

            var selectedValue = $(this).val();

            $.ajax({

                url: '@Url.Action("GetStore", "InvTreansMaster")',
                type: 'get',
                data: { store: selectedValue }
            }).done(function (result) {

                $("#SelectedDestStore_Id").empty();



               
                for (var i = 0; i < result.length; i++) {
                    var item = result[i];
                    var p = new Option(result[i].Text, result[i].Value);
                    $("#SelectedDestStore_Id").append(p)
                    $('#SelectedDestStore_Id').trigger('chosen:updated');

                }

            });
        });
    });

    </script>
    <script>

    
        $('#Date').on('input', function () {
            $("#Date").removeClass("addRequiredFieldToInput");
        });

  
     
        $('#SelectedSourceStore_Id').on('change', function () {
            $("#SelectedSourceStore_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#SelectedSourceStore_Id_chosen span').css('background', '#ffffff');
            $('#SelectedSourceStore_Id_chosen b').css('background', '#ffffff');

        });
        $('#SelectedDestStore_Id').on('change', function () {
            $("#SelectedDestStore_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#SelectedDestStore_Id_chosen span').css('background', '#ffffff');
            $('#SelectedDestStore_Id_chosen b').css('background', '#ffffff');
        });

       

    </script>
    <script>
        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            if ($('#SelectedSourceStore_Id').val() == "" || $('#SelectedSourceStore_Id').val() == null || $('#Date').val() == "" || $('#Date').val() == null || $('#SelectedDestStore_Id').val() == "" || $('#SelectedDestStore_Id').val() == null || $('#SelectedDestStore_Id').val() == $('#SelectedSourceStore_Id').val() || $('#invoiceMasterDetailList tr').length < 3) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#Date').val() == "" || $('#Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDateIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Date").addClass("addRequiredFieldToInput");
                    $('#Date').trigger('focus');
                }
              
               
                if ($('#invoiceMasterDetailList tr').length < 3) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.InvTreansMasterCreate.EnterItemsToRegulation",
                        pos: 'top-center'
                    });
                    $("#invoiceMasterDetailList").addClass("addRequiredFieldToInput");
                    $("#productNotBatched_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#productNotBatched_ID_chosen span').css('background', 'red');
                    $('#productNotBatched_ID_chosen b').css('background', 'red');
                    $('#productNotBatched_ID_chosen').trigger('focus');
                }
                if ($('#SelectedSourceStore_Id').val() == "" || $('#SelectedSourceStore_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.InvTreansMasterCreate.StoreTransferredFromItValidation",
                        pos: 'top-center'
                    });
                    $("#SelectedSourceStore_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedSourceStore_Id_chosen span').css('background', 'red');
                    $('#SelectedSourceStore_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedSourceStore_Id").offset().top
                    }, 2000);
                }

                if ($('#SelectedDestStore_Id').val() == "" || $('#SelectedDestStore_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.InvTreansMasterCreate.TransferredStoreValidation",
                        pos: 'top-center'
                    });

                    $("#SelectedDestStore_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedDestStore_Id_chosen span').css('background', 'red');
                    $('#SelectedDestStore_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedDestStore_Id").offset().top
                    }, 2000);
                }

                if ($('#SelectedDestStore_Id').val() == $('#SelectedSourceStore_Id').val() ) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.InvTreansMasterCreate.TransferringNotAllowed",
                        pos: 'top-center'
                    });
                    $("#SelectedDestStore_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedDestStore_Id_chosen span').css('background', 'red');
                    $('#SelectedDestStore_Id_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#SelectedDestStore_Id").offset().top
                    }, 2000);
                }
               

                event.preventDefault();

            }
            else {
                $("#createOfferSpinner").show();
            }

        });

    </script>

}



