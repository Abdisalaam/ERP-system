@model Accountingsystem.ViewModel.InventorytransferHdDetailsVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
      
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })        
        @Html.HiddenFor(model => model.Detail_TotalCoct, new { htmlAttributes = new { @class = "textfield" } })
    
        <div class="form-group">
            <div class="col-md-10">
                @Html.HiddenFor(model => model.TransferDetail_Id, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.TransferDetail_Id, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-10">
                @Html.HiddenFor(model => model.InventoryTransfer_Id, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.InventoryTransfer_Id, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="col-md-5">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.Batch_ID, Model.MyBatchsList, Accountingsystem.Resources.ProductCreate.ItemNameInformation, htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.Batch_ID, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <span class="required-mark col-md-1">*</span>

                    <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.OfferPriceMasterCreateOffer.ItemName>
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.ItemName)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="col-md-5">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Product_Qty, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Product_Qty, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <span class="required-mark col-md-1">*</span>

                    <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.ProductDetails.Quantity>
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <div class="col-md-5">

                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.ProductDetails.Quantity)
                        </div>
                    </div>
                </div>
            </div>

        </div>

            @*<div class="form-group">
                @Html.LabelFor(model => model.Product_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Product_ID, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Product_ID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Batch_ID, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Batch_ID, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Batch_ID, "", new { @class = "text-danger" })
                </div>
            </div>*@

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <a href='javascript:;' onclick='AddOrder();' class="btn BTN-style" style="text-decoration:none;">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddToRegulation</a>
            </div>
        </div>
  </div>
}

