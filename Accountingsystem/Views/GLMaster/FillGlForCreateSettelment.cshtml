            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }
    <script type="text/javascript">
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
            var _ExpensesDate = flatpickr(document.getElementById('GL_Date'), {
                defaultDate: currentDate
            });
            $("#Account_Child_ID").empty();
             var childAccountOption = new Option("@Accountingsystem.Resources.GLMasterFillGlForCreate.SubAccountInformation", 0);
            $("#Account_Child_ID").append(childAccountOption);
            $('#Account_Child_ID').trigger('chosen:updated');

            $("#SubLed_Id").chosen();
            $("#Account_Child_ID").chosen();
            $("#selectedAccount").chosen();

            $("#SubLed_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Account_Child_ID_chosen").addClass("form-control Dropdownlist-select");
            $("#selectedAccount_chosen").addClass("form-control Dropdownlist-select");
            $("#GLDetail_Debit").val("0");
            $("#GLDetail_Credit").val("0");
            $("#AccountSettlement").chosen();

            $("#AccountSettlement_chosen").addClass("form-control Dropdownlist-select");
        });
    </script>
    <script>
        $("#debit").change(function () {
            if ($(this).val() == "" || $(this).val() == 0) {
                $(this).val(0);
                document.getElementById('Credit').disabled = false;
            }
            else
                document.getElementById('Credit').disabled = true;
        });

        $("#Credit").change(function () {
            if ($(this).val() == "" || $(this).val() == 0) {
                $(this).val(0);
                document.getElementById('debit').disabled = false;
            }
            else
                document.getElementById('debit').disabled = true;
        });

              $("#selectedAccount").change(function (e) {

             var selectedValue = $(this).val();
                            $.ajax({

                 url: '@Url.Action("GetAccountLedger","GLMaster")',
                                type: 'get',
                                data: { Acc_ID: selectedValue }
             }).done(function (result) {

                $("#Account_Child_ID").empty();

                 for (var i = 0; i < result.length; i++) {
                     var item = result[i];
                     var p = new Option(result[i].Text, result[i].Value);
                     $("#Account_Child_ID").append(p);
                     $("#Account_Child_ID").trigger('chosen:updated');
                                }

                      });
        });

    </script>
    <script>
        $('#GL_Date').on('change', function (e)
       {

        var selectedValue = $(this).val();

            $.ajax({
                url: '@Url.Action("CheckEndDate", "Company")',
                data: { date : selectedValue },
            type: 'get',
            }).done(function (result) {
                if (result == "" || result == null) {

                }
                else {

                    Snackbar.show({
                        text: result,
                     pos: 'top-center'
                    });

                }
            }
            );
             $.ajax({
                 url: '@Url.Action("CheckStartdate", "GLMaster")',
                data: { date : selectedValue },
            type: 'get',
            }).done(function (result) {
                if (result == "" || result == null) {

                }
                else {
                    Snackbar.show({
                        text: result,
                        pos: 'top-center'
                    });
                    var currentDate = new Date();
                    var _OfferDate = flatpickr(document.getElementById('GL_Date'), {
                        defaultDate: currentDate
                    });
                }
            }
            );
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();


            if ($.trim($("#GL_Date").val()) == "" || $.trim($("#GL_Date").val()) == null || $("#selectedAccount").val() == "" || $("#selectedAccount").val() < 1 || $("#selectedAccount").val() == null || $("#AccountSettlement").val() == "" || $("#AccountSettlement").val() < 1 || $("#AccountSettlement").val() == null) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($.trim($("#GL_Date").val()) == "" || $.trim($("#GL_Date").val()) == null) {
                    Snackbar.show({
                                text: "@Accountingsystem.Resources.GLMasterFillGlForCreate.ErorMessage",
                                pos: 'top-center'
                            });
                    $("#GL_Date").addClass("addRequiredFieldToInput");
                    $('#GL_Date').trigger('focus');
                }
                if ($("#selectedAccount").val() == "" || $("#selectedAccount").val() < 1 || $("#selectedAccount").val() == null) {
                    $("#selectedAccount").addClass("addRequiredFieldToInput");
                    $("#selectedAccount_chosen").addClass("addRequiredFieldToInput");
                    $('#selectedAccount_chosen span').css('background', 'red');
                    $('#selectedAccount_chosen b').css('background', 'red');
                    $('#selectedAccount_chosen').trigger('focus');
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.GLMasterFillGlForCreate.ErorMessage",
                        pos: 'top-center'
                    });
                }
                if ($("#AccountSettlement").val() == "" || $("#AccountSettlement").val() < 1 || $("#AccountSettlement").val() == null) {
                    $("#selectedAccount").addClass("addRequiredFieldToInput");
                    $("#selectedAccount_chosen").addClass("addRequiredFieldToInput");
                    $('#selectedAccount_chosen span').css('background', 'red');
                    $('#selectedAccount_chosen b').css('background', 'red');
                    $('#selectedAccount_chosen').trigger('focus');
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.SettlementAccount",
                        pos: 'top-center'
                    });
                }

                event.preventDefault();
            }



        });

    </script>
    <script type="text/javascript">

        $("#selectedAccount").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("getbalanceAccount", "GLMaster")',
                        type: 'get',
                        data: { AccountId: selectedValue }
                    }).done(function (result) {
                        $("#RealBallance").val(result);
                    });
                });
    </script>
    <script type="text/javascript">

        $("#Account_Child_ID").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("getbalanceAccountChild", "GLMaster")',
                        type: 'get',
                        data: { ChildId: selectedValue }
                    }).done(function (result) {
                        $("#RealBallance").val(result);
                    });
                });
    </script>
}