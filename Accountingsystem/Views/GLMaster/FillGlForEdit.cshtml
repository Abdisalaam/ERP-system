            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }
    <script>
    $(document).ready(function () {
        var depit = @Math.Round(Model.detailForThatMaster.Select(a=>a.GLDetail_Debit).Sum(), 2, MidpointRounding.AwayFromZero);
        var credit = @Math.Round(Model.detailForThatMaster.Select(a => a.GLDetail_Credit).Sum(), 2, MidpointRounding.AwayFromZero);
        $("#totalDebtLable").html(depit);
        $("#totalCreditLable").html(credit);

    });
    </script>
    <script type="text/javascript">
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
            var _ExpensesDate = flatpickr(document.getElementById('GL_Date'), {
                defaultDate: $("#GL_Date").val()
            });
          
            $("#Account_Child_ID").empty();
             var childAccountOption = new Option("@Accountingsystem.Resources.GLMasterFillGlForCreate.SubAccountInformation", 0);
            $("#Account_Child_ID").append(childAccountOption);
            $('#Account_Child_ID').trigger('chosen:updated');

            $("#SubLed_Id").chosen();
            $("#Account_Child_ID").chosen();
            $("#selectedAccount").chosen();

            $("#SubLed_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Account_Child_ID_chosen").addClass("form-control Dropdownlist-select");
            $("#selectedAccount_chosen").addClass("form-control Dropdownlist-select");
            $("#GLDetail_Debit").val("");
            $("#GLDetail_Credit").val("");
        });
    </script>
    <script>
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });
    </script>
    <script>
        $('#GLDetail_Debit').on('input', function () {
            $("#GLDetail_Debit").removeClass("addRequiredFieldToInput");
            $("#GLDetail_Credit").removeClass("addRequiredFieldToInput");
        });
        $('#GLDetail_Credit').on('input', function () {
            $("#GLDetail_Credit").removeClass("addRequiredFieldToInput");
            $("#GLDetail_Debit").removeClass("addRequiredFieldToInput");
        });
        $('#selectedAccount').on('change', function () {
            $("#selectedAccount_chosen").removeClass("addRequiredFieldToInput");
            $('#selectedAccount_chosen span').css('background', '#ffffff');
            $('#selectedAccount_chosen b').css('background', '#ffffff');
        });
    </script>
    <script type="text/javascript">
var Total_Debit = @Math.Round(Model.detailForThatMaster.Select(a=>a.GLDetail_Debit).Sum(), 2, MidpointRounding.AwayFromZero);
        var Total_Credit = @Math.Round(Model.detailForThatMaster.Select(a => a.GLDetail_Credit).Sum(), 2, MidpointRounding.AwayFromZero); 
                   // Add Multiple Order.

        $("#addToList").click(function (e) {
            debugger;
            $("#detailsTable").removeClass("addRequiredFieldToInput");
            if ($("#selectedAccount").val() == "" || $("#selectedAccount").val() < 1 || $("#selectedAccount").val() == null) {
                if ($("#selectedAccount").val() == "" || $("#selectedAccount").val() < 1 || $("#selectedAccount").val() == null) {
                    $("#selectedAccount").addClass("addRequiredFieldToInput");
                    $("#selectedAccount_chosen").addClass("addRequiredFieldToInput");
                    $('#selectedAccount_chosen span').css('background', 'red');
                    $('#selectedAccount_chosen b').css('background', 'red');
                    $('#selectedAccount_chosen').trigger('focus');
                     Snackbar.show({
                    text: "@Accountingsystem.Resources.GLMasterFillGlForCreate.ErorMessage",
                    pos: 'top-center'
                });
                    $('html, body').animate({
                        scrollTop: $("#selectedAccount").offset().top
                    }, 2000);
                }
                return false;
            }
            if ($.trim($("#GLDetail_Debit").val()) == "" && $.trim($("#GLDetail_Credit").val()) == "") {
                Snackbar.show({
