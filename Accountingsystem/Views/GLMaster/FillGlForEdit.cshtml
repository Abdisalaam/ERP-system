</head>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
@Html.HiddenFor(model => model.Company_Id)
@Html.HiddenFor(model => model.Currency_Id)
@Html.HiddenFor(model => model.GLType_Id)
@Html.HiddenFor(model => model.GLMaster_Id)

<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <form id="expensesCreateForm">
        <div class="">
            <h3 class="text-center"><label>@ViewBag.Message</label></h3>
            <h3 class="text-center">@Html.Label(Accountingsystem.Resources.InvoiceMasterIndex.Edit)</h3>
            <hr />
            <div class="row">
                <div class="col-md-11 mx-auto">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                                @Html.EditorFor(model => model.GLCode, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                @Html.ValidationMessageFor(model => model.GLCode, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.DateOfConstraint)
                                <div class="input-group">
                                    @Html.EditorFor(model => model.GL_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    <div class="input-group-append">
                                        <div>
                                            <span class="form-control text-danger">*</span>
                                        </div>
                                    </div>
                                </div>
                                @Html.ValidationMessageFor(model => model.GL_Date, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-group">
                                @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.DescriptionOfConstraint)
                                @Html.TextAreaFor(model => model.GL_Desc, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.Expenses.Description })
                                @Html.ValidationMessageFor(model => model.GL_Desc, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="col-md-12">
                            <div class="form-group">
                                <div class="text-center">
                                    @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreateStartGL.AccountName)
                                </div>
                                <div class="input-group">
                                    @Html.DropDownListFor(model => model.selectedAccount, Model.accountList, Accountingsystem.Resources.GLMasterFillGlForCreate.AccountInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    <div class="input-group-append">
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="input-group">
                                </div>
                                @Html.ValidationMessageFor(model => model.selectedAccount, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                <div class="input-group">
                                    @Html.DropDownListFor(model => model.Account_Child_ID, Model.childList, Accountingsystem.Resources.GLMasterFillGlForCreateStartGL.SubAccountInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.ValueOfDebtor)
                                <div class="input-group">
                                    <input type="number" step="any" id="GLDetail_Debit" name="GLDetail_Debit" class="form-control mb-4" value="0" />
                                    <div class="input-group-append">
                                        <div>
                                            <span class="form-control text-danger">*</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.ValueOfCreditor)
                                <div class="input-group">
                                    <input type="number" step="any" id="GLDetail_Credit" name="GLDetail_Credit" class="form-control mb-4" value="0" />
                                    <div class="input-group-append">
                                        <div>
                                            <span class="form-control text-danger">*</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (package.Number_subLedgger > 0 || package.Number_Branch > 0 || package.Project == true)
                        {
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.CostCenter)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SubLed_Id, Model.SubLedgerList, Accountingsystem.Resources.GLMasterFillGlForCreate.CostCenterInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.MovementDescription)
                                <div class="input-group">
                                    <input type="text" id="Description_Detail" name="Description_Detail" class="form-control mb-4" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <a id="addToList" class="btn btn-block btn-outline-success mb-lg-0" style="text-decoration:none;">
                            @Accountingsystem.Resources.GLMasterFillGlForCreate.AddToList
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                            <span id="addToAccountBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="table-responsive">

            <table id="detailsTable" class="table mb-4">
                <thead>
                    <tr>
                        <th>@Accountingsystem.Resources.GLMasterFillGlForCreate.AccountDebtor</th>
                        <th>@Accountingsystem.Resources.GLMasterFillGlForCreate.AccountCreditor</th>
                        <th>@Accountingsystem.Resources.GLMasterFillGlForCreate.AccountName</th>

                        <th>@Accountingsystem.Resources.GLMasterFillGlForCreate.CostCenter</th>

                        <th>@Accountingsystem.Resources.GLMasterFillGlForCreate.SubAccount</th>
                        <th>@Accountingsystem.Resources.GLMasterFillGlForCreate.MovementDescription</th>


                        <th></th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var detail in Model.detailForThatMaster)
                    {
                        <tr>
                            <td>@Math.Round(detail.GLDetail_Debit, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.GLDetail_Credit, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@detail.Account_Name</td>
                            <td>@detail.Subledger_Name</td>
                            <td>@detail.Account_Child_Name</td>
                            <td>@detail.Description_Detail</td>
                            <td hidden>@detail.Account_Child_ID</td>
                            <td hidden>@detail.Account_Id</td>
                            <td hidden>@detail.SubLedger_Id</td>
                            <td><a href="#" id="deleteItemFromTable" class="bs-tooltip deleteicon" data-itemId="0" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Delete" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a></td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
        <div class=''>
            <div class="row">
                <div class="col-md-4">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.GLMasterFillGlForCreate.TotalValuOfDebtor)
                                    </div>
                                    <div>
                                        <lable id="totalDebtLable"></lable>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.validate.difference)
                                    </div>
                                    <div>
                                        <lable id="difference"></lable>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.GLMasterFillGlForCreate.TotalValuOfCreditor)
                                    </div>
                                    <div>
                                        <lable id="totalCreditLable"></lable>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                <button type="submit" id="saveOrder" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

            </div>
        </div>
        <div class="col-md-12">
            <div class="form-group">
                <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index", "GLMaster")'>
                    @Accountingsystem.Resources.Expenses.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                </a>
            </div>
        </div>
    </form>
</div>

