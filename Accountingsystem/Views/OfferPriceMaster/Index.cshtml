@model IEnumerable<Accountingsystem.Models.OfferPriceMaster>
@{

    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.OfferPriceMasterIndex.List;
    int count = 1;
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }




</head>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">


                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "Index",new {all=1 })"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.validate.ALL</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "CreateOffer")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.OfferPriceMasterIndex.CreateNewOfferPrice</a>



                                        </div>
                                    </li>

                                    <li>
                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "IndexOfTrueState")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg> @Accountingsystem.Resources.OfferPriceMasterIndex.ConvertedOffers</a>

                                        </div>

                                    </li>


                                </ul>

                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.OfferPriceMasterIndex.List
        </div>
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.Number)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.OfferNumber)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.OfferPriceDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.OfferPriceEndDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.TotalAmount)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.CustomerNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.CustomerName)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterIndex.CustomerBalance)
                        </th>

                        <th>

                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @count
                                @{count = count + 1;}
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Serial_Number)
                            </td>

                            <td>
                                @item.Offer_Date.ToString("yyyy/MM/dd ")
                            </td>
                            <td>
                                @item.OfferDeadLine.ToString("yyyy/MM/dd ")
                            </td>
                            <td>
                                @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
                                @Math.Round(item.Total_Amount, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>
                                @{
                                    if (item.Customer_Id != null || item.Customer_Id != 0)
                                    {
                                        var CustomerCodes = Accountingsystem.Models.Customer.GetCustomerById(item.Customer_Id).Customer_Code;
                                        <h>@CustomerCodes</h>
                                    }

                                }
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Customer_Name)
                            </td>

                            <td>
                                @{String custBalance = "";
                                    var CustomerCode = Accountingsystem.Models.Customer.GetCustomerById(item.Customer_Id).Customer_Code;
                                    decimal account = Accountingsystem.Models.Accounts.RefreshTheBallanceOfCustomer(CustomerCode);
                                    if (Math.Round(account, 2, MidpointRounding.AwayFromZero) < 0)
                                    {
                                        custBalance = "(" + (Math.Round(account, 2, MidpointRounding.AwayFromZero) * -1).ToString() + ")";
                                    }
                                    else
                                    {
                                        custBalance = Math.Round(account, 2, MidpointRounding.AwayFromZero).ToString();
                                    }

                                    @custBalance
                                }

                            </td>

                            <td>
                                <div class="btn-group">

                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                        <a href="@Url.Action( "Details", new { id = item.OfferMas_Id})" class="dropdown-item">
                                            @Accountingsystem.Resources.OfferPriceMasterIndex.Details
                                        </a>
                                        @if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("مساعد محاسب") && !User.IsInRole("بائع"))
                                        {
                                            <a class="dropdown-item" href="@Url.Action("Delete", new { id = item.OfferMas_Id })">
                                                @Accountingsystem.Resources.OfferPriceMasterIndex.Delete
                                            </a>
                                        }
                                        @if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("مساعد محاسب") && !User.IsInRole("بائع"))
                                        {
                                            <a class="dropdown-item" href="@Url.Action("EditForOffer", new { id = item.OfferMas_Id, isCopy = 0 })">
                                                @Accountingsystem.Resources.OfferPriceMasterIndex.Edit
                                            </a>

                                        }
                                        <a class="dropdown-item" href="@Url.Action("AddNewInvoice", new { controller = "InvoiceMaster", orderido = item.OfferMas_Id,customerId=0 })">
                                            @Accountingsystem.Resources.OfferPriceMasterIndex.TransferToInvoice
                                        </a>
                                        <a class="dropdown-item" href="@Url.Action("PrintOfferPrice", new { controller = "Reports", id = item.OfferMas_Id })">
                                            @Accountingsystem.Resources.OfferPriceMasterIndex.Print
                                        </a>

                                    </div>
                                </div>

                            </td>







                        </tr>
                    }
                </tbody>
                
            </table>
        </div>
    </div>
</div>



@section Scripts {

    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/dataTables.buttons.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/jszip.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/buttons.html5.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/buttons.print.min.js")"></script>
