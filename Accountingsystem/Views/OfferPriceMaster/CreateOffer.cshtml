    ViewBag.Title = Accountingsystem.Resources.OfferPriceMasterCreateOffer.CreatePriceOffer;
    Model.SelectedCompany_Id = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault().Comp_Id;
