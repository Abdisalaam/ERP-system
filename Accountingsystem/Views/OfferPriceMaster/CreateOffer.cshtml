                    $('#SelectedCustomer_Id_chosen span').css('background', 'red');
                    $('#SelectedCustomer_Id_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#SelectedCustomer_Id").offset().top
                    }, 2000);
                }
                if ($('#RevenueAccount_Id').val() == "" || $('#RevenueAccount_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AccountRevenueIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#RevenueAccount_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#RevenueAccount_Id_chosen span').css('background', 'red');
                    $('#RevenueAccount_Id_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#RevenueAccount_Id").offset().top
                    }, 2000);
                }

                event.preventDefault();
            }
            else {
                $("#createOfferSpinner").show();
            }


        });

    </script>
