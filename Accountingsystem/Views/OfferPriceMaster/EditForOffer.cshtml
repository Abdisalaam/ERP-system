</head>




@using (Html.BeginForm("EditForOffer", "OfferPriceMaster", FormMethod.Post, new { @id = "offerEditMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Serial_Number)
    @Html.HiddenFor(model => model.OfferMas_Id)
    @Html.HiddenFor(model => model.isCopy)
    @Html.HiddenFor(model => model.SelectedCompany_Id)
    @Html.HiddenFor(model => model.SelectedCurrency_Id)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerEditMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                @if (Model.isCopy == 1)
                {
                    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.CreatePriceOffer)</h3>
                }
                else
                {
                    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.EditOfferPrice)</h3>

                }
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.OfferPriceNumber)
                                    @Html.EditorFor(model => model.Serial_Number, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Serial_Number, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.BaptismNumber)
                                    @Html.EditorFor(model => model.Reference, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.RevenueAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.RevenueAccount_Id, Model.AccountList, Accountingsystem.Resources.OfferPriceMasterEditForOffer.RevenueAccountInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.RevenueAccount_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.OfferPriceDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Offer_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Offer_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.DurationOfOffer)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Payment_Policy, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Payment_Policy, "", new { @class = "text-danger", @type = "number" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.EndDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.OfferDeadLine, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.OfferDeadLine, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.EmployeeNumber)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Emp_Id, Model.EmpList, Accountingsystem.Resources.OfferPriceMasterEditForOffer.DropDownListEmployee, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Emp_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.Customer)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedCustomer_Id, Model.CustomerList, Accountingsystem.Resources.OfferPriceMasterEditForOffer.DropDownListCustomer, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                            <button id="addNewCustomerBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#customerModal">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedCustomer_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @if (package.Number_Branch > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.BranchOrDepartment)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BranchSubledger_Id, Model.BranchSubList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListBranchCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.Department)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.DepartSubledger_Id, Model.DepartSubList, Accountingsystem.Resources.OfferPriceMasterEditForOffer.DropDownListBranchCenterOrMainDepartment, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.Activity)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BussinesSubledger_Id, Model.BussinessList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.ActivityInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_subLedgger > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.CostCenter)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Subledger_Id, Model.SubledgerList, Accountingsystem.Resources.OfferPriceMasterEditForOffer.SelectCostCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_store > 1)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.Store)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.SelectedStore_ID, Model.StoreList, Accountingsystem.Resources.OfferPriceMasterEditForOffer.StoreNumberInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.SelectedStore_ID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            }


                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.OfferDescription)
                                    @Html.TextAreaFor(model => model.Description, 1, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterEditForOffer.OfferDescription })
                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.Notes)
                                    @Html.TextAreaFor(model => model.Notes, 1, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterEditForOffer.Notes })
                                    @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="InvoicesDetail" class="col-md-11 mx-auto"></div>
                </div>
                <div id="InvoicesDetailList"></div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPercentage)
                        <div class="input-group mb-4">
                            <input class="form-control mb-4 text-box single-line" data-val="true" data-val-number="The field Master_Discount must be a number." data-val-range="The field Master_Discount must be between 0 and 100." data-val-range-max="100" data-val-range-min="0" data-val-required="The Master_Discount field is required." id="Master_Discount" name="Master_Discount" step="any" type="number" value="@Model.Master_Discount">

                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">%</span>
                                </div>
                                <div>
                                    <span class="form-control text-danger">*</span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.TotalDiscountAmount)
                        <div class="input-group">
                            <input id="masterTotalDiscountAmount" class="form-control mb-4" style="background:#ffffff">
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>


                @if (package.ExtraTaxes == true)
                {
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.Tax)
                            <div class="input-group">
                                @{
                                    if (cookie != null && cookie.Value != null)
                                    {
                                        if (cookie.Value == "en")
                                        {
                                            @Html.ListBoxFor(model => model.Taxes, Model.TaxList, new Dictionary<string, Object> { { "class", "chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.OfferPriceMasterEditForOffer.TaxInformation }, { "multiple", "true" } })
                                            @Html.ValidationMessageFor(model => model.Taxes, "", new { @class = "text-danger" })

                                        }
                                        else
                                        {
                                            @Html.ListBoxFor(model => model.Taxes, Model.TaxList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.OfferPriceMasterEditForOffer.TaxInformation }, { "multiple", "true" } })
                                            @Html.ValidationMessageFor(model => model.Taxes, "", new { @class = "text-danger" })

                                        }
                                    }
                                    else
                                    {
                                        @Html.ListBoxFor(model => model.Taxes, Model.TaxList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.OfferPriceMasterEditForOffer.TaxInformation }, { "multiple", "true" } })
                                        @Html.ValidationMessageFor(model => model.Taxes, "", new { @class = "text-danger" })

                                    }
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.TotalTaxexOfExtraTaxes)
                            <div class="input-group">
                                <h3 id="masterTotalTaxesAmount" class="form-control mb-4" style="background:#ffffff"></h3>
                                <div class="input-group-append">
                                    <div>
                                        <span class="form-control">$</span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
                @*<div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.DiscountAllowedOnBill)
                            <div class="input-group">
                                @Html.EditorFor(model => model.Fixed_Discount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                @Html.ValidationMessageFor(model => model.Fixed_Discount, "", new { @class = "text-danger" })
                                <div class="input-group-append">
                                    <div>
                                        <span class="form-control">$</span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>*@
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterEditForOffer.TotalFinal)
                        <div class="input-group">
                            <input id="masterTotalInvoiceAmount" class="form-control mb-4" style="background:#ffffff">
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="editOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.OfferPriceMasterEditForOffer.BackToList
                        <span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>
    <div id="customerModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.OfferPriceMasterEditForOffer.AddCustomer</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="customerPartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-dark mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterEditForOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>

    <div id="productModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.OfferPriceMasterEditForOffer.AddProduct</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="productPartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-dark mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterEditForOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>





}


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
