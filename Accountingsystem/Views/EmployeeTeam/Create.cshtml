    <script>
        $(function () {
            $("#EmployeesMember").chosen();
            $("#EmployeesMember_chosen").addClass("form-control mb-4");

            $('#EmployeesMember_chosen ul').css('background', '#ffffff');
            $('#EmployeesMember_chosen ul li').css('background', '#ffffff');
            $('#EmployeesMember_chosen ul li span').css('background', '#ffffff');
            $('#EmployeesMember_chosen ul li a').css('background', '#ffffff');
        });


        $("#Team_Leader_ID").chosen();

        $("#Team_Leader_ID_chosen").addClass("form-control Dropdownlist-select");



    </script>
    <script>


        $('#Team_Name').on('input', function () {
            $("#Team_Name").removeClass("addRequiredFieldToInput");
        });
      
        $('#Team_Leader_ID').on('input', function () {
            $("#Team_Leader_ID").removeClass("addRequiredFieldToInput");
        });

        $('#EmployeesMember').on('input', function () {
            $("#EmployeesMember").removeClass("addRequiredFieldToInput");
        });
    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#Team_Name').val() == "" || $('#Team_Name').val() == null ||
                $('#Team_Leader_ID').val() == "" || $('#Team_Leader_ID').val() == null ||
                $('#EmployeesMember').val() == "" || $('#EmployeesMember').val() == null
            ) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#Team_Name').val() == "" || $('#Team_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.EmployeeTeamCreate.CreateMessage",
                        pos: 'top-center'
                    });
                    $("#Team_Name").addClass("addRequiredFieldToInput");
                    $('#Team_Name').trigger('focus');
                }
              
                if ($('#Team_Leader_ID').val() == "" || $('#Team_Leader_ID').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.EmployeeTeamCreate.EnterTeamLeader",
                        pos: 'top-center'
                    });

                    $("#Team_Leader_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#Team_Leader_ID_chosen span').css('background', 'red');
                    $('#Team_Leader_ID_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Team_Leader_ID").offset().top
                    }, 2000);
                }

                if ($('#EmployeesMember').val() == "" || $('#EmployeesMember').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.EmployeeTeamCreate.EnterTeamMembers",
                        pos: 'top-center'
                    });

                    $("#EmployeesMember_chosen").addClass("addRequiredFieldToInput");
                    $('#EmployeesMember_chosen span').css('background', 'red');
                    $('#EmployeesMember_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#EmployeesMember").offset().top
                    }, 2000);
                }
                $("#createOfferSpinner").hide();
                event.preventDefault();
            }


        });

    </script>

