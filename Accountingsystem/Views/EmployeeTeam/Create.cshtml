@using (Html.BeginForm("Create", "EmployeeTeam", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Team_ID)

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.EmployeeTeamCreate.CreateTeam)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.EmployeeTeamCreate.TeamName)
                                    @Html.EditorFor(model => model.Team_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Team_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.EmployeeTeamCreate.TeamLeader)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Team_Leader_ID, Model.EmPloyeeList, htmlAttributes: new { @class = "form-control  mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Team_Leader_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.EmployeeTeamCreate.TeamMembers)
                                    <div class="input-group">
                                        @{
                                            if (cookie != null && cookie.Value != null)
                                            {
                                                if (cookie.Value == "en")
                                                {
                                                    @Html.ListBoxFor(model => model.EmployeesMember, Model.EmPloyeeList, new Dictionary<string, Object> { { "class", "chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.EmployeeTeamCreate.SelectEmployee }, { "multiple", "true" } })
                                                    @Html.ValidationMessageFor(model => model.EmployeesMember, "", new { @class = "text-danger" })

                                                }
                                                else
                                                {
                                                    @Html.ListBoxFor(model => model.EmployeesMember, Model.EmPloyeeList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.EmployeeTeamCreate.SelectEmployee }, { "multiple", "true" } })
                                                    @Html.ValidationMessageFor(model => model.EmployeesMember, "", new { @class = "text-danger" })

                                                }
                                            }
                                            else
                                            {
                                                @Html.ListBoxFor(model => model.EmployeesMember, Model.EmPloyeeList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.EmployeeTeamCreate.SelectEmployee }, { "multiple", "true" } })
                                                @Html.ValidationMessageFor(model => model.EmployeesMember, "", new { @class = "text-danger" })

                                            }
                                        }




                                    </div>
                                </div>
                            </div>



                        </div>
                    </div>
                </div>
            </div>

            <div class="row">




                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
            </div>
        </form>
    </div>






}

