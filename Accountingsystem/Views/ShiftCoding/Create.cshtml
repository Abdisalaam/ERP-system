    <script>
        $(function () {
            $("#WeekHollidays").chosen();
            $("#WeekHollidays_chosen").addClass("form-control mb-4");

            $('#WeekHollidays_chosen ul').css('background', '#ffffff');
            $('#WeekHollidays_chosen ul li').css('background', '#ffffff');
            $('#WeekHollidays_chosen ul li span').css('background', '#ffffff');
            $('#WeekHollidays_chosen ul li a').css('background', '#ffffff');
        });

        var _OfferDate = flatpickr(document.getElementById('From'), {
            defaultDate: $("#From").val()
        });
        var EndDate = flatpickr(document.getElementById('To'), {
            defaultDate: $("#To").val()
        });
        flatpickr("#From", {
            "dateFormat": "H:i",
            "enableTime": true,
            "allowInput": true,
            "noCalendar": true
        });
        flatpickr("#To", {
            "dateFormat": "H:i",
            "enableTime": true,
            "allowInput": true,
            "noCalendar": true
        });
    </script>

    <script>
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });

    </script>

    <script>

        $("#createOfferbtn").click(function (e) {
            debugger
                $('#createOfferbtn').prop('disabled', true);
                $("#createOfferSpinner").show();


                if ($('#Name').val() == "" || $('#Name').val() == null || $('#From').val() == "" || $('#From').val() == null || $('#To').val() == "" || $('#To').val() == null) {
                    $('#createOfferbtn').prop('disabled', false);

                    $("#createOfferSpinner").hide();
                    if ($('#Name').val() == "" || $('#Name').val() == null) {
                        Snackbar.show({
                            text: "@Accountingsystem.Resources.Atttendace.Name",
                            pos: 'top-center'
                        });
                        $("#Name").addClass("addRequiredFieldToInput");
                        $('#Name').trigger('focus');
                    }
                    if ($('#From').val() == "" || $('#From').val() == null) {
                        Snackbar.show({
                            text: "@Accountingsystem.Resources.Atttendace.EnterTimeFrom",
                            pos: 'top-center'
                        });
                        $("#From").addClass("addRequiredFieldToInput");
                        $('#From').trigger('focus');
                    }
                    if ($('#To').val() == "" || $('#To').val() == null) {
                        Snackbar.show({
                            text: "@Accountingsystem.Resources.Atttendace.EnterTimeTo",
                            pos: 'top-center'
                        });
                        $("#To").addClass("addRequiredFieldToInput");
                        $('#To').trigger('focus');
                    }

                    event.preventDefault();
                }
                else {
                    debugger
                    fun();

                }


            });

    </script>
    <script>

        function fun() {


            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);
            var orderArr = [];
            orderArr.length = 0;
            $.each($("#default-ordering tbody tr"), function () {
                orderArr.push({

                    EmployeeId: $(this).find('td:eq(0)').html(),

                    IsActive: $(this).find('td:eq(4)').find('input').prop('checked')
                });

            });

            var data = JSON.stringify({
                Name: $("#Name").val(),
                From: $("#From").val(),
                To: $("#To").val(),
                WeekHollidays: $("#WeekHollidays").val(),
                NumberOfHour: $("#NumberOfHour").val(),
                EmployeeList: orderArr

            });





            console.log(data);
             $.ajax(
                 {

                     url: '@Url.Action("Create", "ShiftCoding")',
                     data: data,
                     contentType: 'application/json; charset=utf-8',
              dataType: 'json',
                     type: 'POST',


            }).done(function (result) {
                  Snackbar.show({
                     text: '@Accountingsystem.Resources.validate.SuccessfullAdd',
                     pos: 'top-center'
                 });
                setTimeout(function () {

                    window.location = result;

                }, 5000);
            });

        };

    </script>
    <script>
        $('#select-all').click(function (event) {
            if (this.checked) {
                // Iterate each checkbox
                $(':checkbox').each(function () {
                    this.checked = true;
                });
            } else {
                $(':checkbox').each(function () {
                    this.checked = false;
                });
            }
        });
    </script>
}