@using (Html.BeginForm("Create", "ShiftCoding", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))


{
    @Html.AntiForgeryToken()

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>

                <h3 class="text-center"><label>@Accountingsystem.Resources.Atttendace.Createshift</label></h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">




                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.Name)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReportsGetDateOfIncome.From)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.From, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.From, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReportsGetDateOfIncome.To)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.To, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.To, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label("عدد ساعات العمل")
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.NumberOfHour, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.WeekHollidays)
                                    <div class="input-group">
                                        @{
                                            if (cookie != null && cookie.Value != null)
                                            {
                                                if (cookie.Value == "en")
                                                {
                                                    @Html.ListBoxFor(model => model.WeekHollidays, Model.WeekHolidayList, new Dictionary<string, Object> { { "class", "chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.Atttendace.WeekHollidays }, { "multiple", "true" } })
                                                    @Html.ValidationMessageFor(model => model.WeekHollidays, "", new { @class = "text-danger" })

                                                }
                                                else
                                                {
                                                    @Html.ListBoxFor(model => model.WeekHollidays, Model.WeekHolidayList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.Atttendace.WeekHollidays }, { "multiple", "true" } })
