                                                }
                                            }
                                            else
                                            {
                                                @Html.ListBoxFor(model => model.WeekHollidays, Model.WeekHolidayList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", Accountingsystem.Resources.Atttendace.WeekHollidays }, { "multiple", "true" } })
