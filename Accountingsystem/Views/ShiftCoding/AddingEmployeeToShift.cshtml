@model Accountingsystem.ViewModel.EmployeeShiftVM

@{
    ViewBag.Title = Accountingsystem.Resources.StoreCreate.EditProductPriceForStore;
    HttpCookie cookie = Request.Cookies["Language"];
}

@{


