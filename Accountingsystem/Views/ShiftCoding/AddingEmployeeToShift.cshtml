    <script>

        function fun() {


            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);
            var orderArr = [];
            orderArr.length = 0;
            debugger
            $.each($("#default-ordering tbody tr"), function () {
                orderArr.push({

                    EmployeeId: $(this).find('td:eq(0)').html(),
                  
                    IsActive: $(this).find('td:eq(3)').find('input').prop('checked')
                });

            });



            var xz = '@Model.shiftCodeing.Id';
            var datao = JSON.stringify(orderArr);

            var data = { 'btachQan': datao, 'hh': xz };
            var data = JSON.stringify(data);

            console.log(data);
             $.ajax(
                 {

                     url: '@Url.Action("AddingEmployeeToShiftPost", "ShiftCoding")',
                     data: data,
                     contentType: 'application/json; charset=utf-8',
              dataType: 'json',
                     type: 'POST',


            }).done(function (result) {

                setTimeout(function () {

                    window.location = result;

                }, 5000);
            });

        };

    </script>
    <script>
        $('#select-all').click(function (event) {
            if (this.checked) {
                // Iterate each checkbox
                $(':checkbox').each(function () {
                    this.checked = true;
                });
            } else {
                $(':checkbox').each(function () {
                    this.checked = false;
                });
            }
        });
    </script>
    <script>
        function OnChangeSalesPrice(obj) {
            debugger
            var Price = $(obj).val();

            var TaxPercentage = $(obj).parents('tr').find('.taxPercentage').val();
            var category = $(obj).parents('tr').find('.Cat').val();
            var priceWithTax = (parseFloat(TaxPercentage) / 100) * parseFloat(Price) + parseFloat(Price);


            $(obj).parents('tr').find('.SalesPriceWithTax').val(priceWithTax);

        }

    </script>
    <script>
        function OnChangeSalesWithTax(obj) {
            debugger
            var PriceWithTax = $(obj).val();
            var TaxPercentage = $(obj).parents('tr').find('.taxPercentage').val();
            var price = parseFloat(PriceWithTax) * (100 / (parseFloat(TaxPercentage) + 100)) ;


            $(obj).parents('tr').find('.SalesPrice').val(price);

        }

    </script>

