@model Accountingsystem.Models.ShiftCoding

@{
    ViewBag.Title = Accountingsystem.Resources.Atttendace.DetailShift;
    HttpCookie cookie = Request.Cookies["Language"];
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

        }
    }


</head>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">

    <div class="statbox widget box box-shadow">

        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    @ViewBag.Message
                </div>
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    @Accountingsystem.Resources.Atttendace.DetailShift
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.Atttendace.Name)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Name)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.ReportsGetDateOfIncome.From)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.From)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.ReportsGetDateOfIncome.To)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.To)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.Atttendace.NumberOfHourPerShift)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Hours)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @if (Model.VacationWeeklies.Any())
            {
                <div class="row inv--product-table-section">
                    <div class="col-6">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="">
                                    <tr>
                                        <th>    @Html.DisplayName(Accountingsystem.Resources.Atttendace.WeekHollidays) </th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var day in Model.VacationWeeklies)
                                    {
                                        <tr>
                                            <td>@day.VacationWeeklyCoding.Name</td>


                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Shifts.Any())
            {
                <div class="table-responsive mb-4 mt-4">
                    <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                        <thead>
                            <tr>

                                <th>
                                    @Accountingsystem.Resources.InvoiceMasterIndex.Number
                                </th>
                                <th>
                                    @Accountingsystem.Resources.EmployeeCreate.EmployeeName

                                </th>

                                <th>
                                    @Accountingsystem.Resources.EmployeeCreate.Branch

                                </th>


                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Shifts)
                            {

                                var branch = "";
                                if (item.Employee.BranchSubledger_Id > 0)
                                {
                                    branch = Accountingsystem.Models.SubLedger.getDetail(item.Employee.BranchSubledger_Id.Value).SubLed_Name;
                                }
                            <tr>

                                <td>@item.Employee.Emp_Code</td>
                                <td>@item.Employee.Emp_Name </td>
                                <td>@branch</td>


                            </tr>
                            }
                        </tbody>
                    </table>

                </div>

            }
            <div class="row layout-top-spacing">
                @if (Request.IsAuthenticated@*&& !User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع") && !User.IsInRole("مساعد محاسب")*@)
{
        <div class="col-md-4">
            <div class="form-group">
                <a id="Createbtn" class="btn btn-block btn-outline-info mb-lg-0" href='@Url.Action("Create")'>
                    @Accountingsystem.Resources.CategoryDetails.New
                    <span id="CreatebtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                </a>



            </div>
        </div>
    }
                <div class="col-md-4">
                    <div class="form-group">
                        @*<a id="printEmailbtn" class="btn btn-block btn-outline-primary mb-lg-0" href="@Url.Action("Edit", new { id = Model.Id })">
            @Accountingsystem.Resources.ReceiptDetails.Edit
            <span id="printEmailbtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
        </a>*@
                        <a id="printEmailbtn" class="btn btn-block btn-outline-primary mb-lg-0" href="@Url.Action("DeleteTrans", new { id = Model.Id })">
                            @if (Model.Active != false)
                            {
                                @Accountingsystem.Resources.ProductDetails.TransferToNotActive
                            }
                            else
                            {
                                @Accountingsystem.Resources.ProductDetails.TransferToActive
                            }
                            <span id="printEmailbtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">

                        <a id="indexbtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.ReceiptDetails.BackToList
                            <span id="indexbtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>


                    </div>
                </div>
       
            </div>
        </div>
    </div>

</div>

@section scripts{
    <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>
    <script>
        $("#deletebtn").click(function (e) {
            $("#deletebtnSpinner").show();
        });
        $("#Editbtn").click(function (e) {
            $("#EditbtnSpinner").show();
        });
        $("#glbtn").click(function (e) {
            $("#glbtnSpinner").show();
        });
        $("#printEmailbtn").click(function (e) {
            $("#printEmailbtnSpinner").show();
        });
        $("#Createbtn").click(function (e) {
            $("#CreatebtnSpinner").show();
        });
        $("#SentCustomerEmail").click(function (e) {
            $("#SentCustomerEmailSpinner").show();
        });

        $("#indexbtn").click(function (e) {
            $("#indexbtnSpinner").show();
        });



    </script>
}