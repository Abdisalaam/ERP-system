@using (Html.BeginForm("CreateOFNotesAndDesc", "SalesSetting", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.SalesSetting.descAndNote)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            @if (package.Number_Branch > 0)
                            {
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Branch)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.BranchSubledger_Id, Model.BranchSubList, Accountingsystem.Resources.InvoiceMasterAddNewInvoice.SelectBranch, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Department)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.DepartSubledger_Id, Model.DepartSubList, Accountingsystem.Resources.InvoiceMasterAddNewInvoice.SelectDepartment, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                    </div>
                                </div>
                            </div>
                            }



                        </div>
                    </div>
                </div>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.SalesSetting.descAndNoteForInvoice)</h3>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription)
                            @Html.TextAreaFor(model => model.InvoiceDescribtion, 1, 1, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription })
                            @Html.ValidationMessageFor(model => model.InvoiceDescribtion, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes)
                            @Html.TextAreaFor(model => model.InvoiceNotes, 1, 1, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                            @Html.ValidationMessageFor(model => model.InvoiceNotes, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.SalesSetting.descAndNoteForOffer)</h3>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription)
                            @Html.TextAreaFor(model => model.OfferDesc, 1, 1, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription })
                            @Html.ValidationMessageFor(model => model.InvoiceDescribtion, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes)
                            @Html.TextAreaFor(model => model.OfferNotes, 1, 1, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                            @Html.ValidationMessageFor(model => model.InvoiceNotes, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.SubLedgerCreate.Create<span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("IndexOFNotesAndDesc")'>
                        @Accountingsystem.Resources.SubLedgerCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>
}

