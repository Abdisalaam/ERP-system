                                    <a id="PrintSimple" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("DetailSimpleReverseWhite", new { controller = "InvoiceQRExternalUseres", serial = Model.Serial_Number })' target="_blank">
                                        @Accountingsystem.Resources.validate.SimplifiedTaxInvoice

                                    </a>
                                }

                                <a id="editOfferBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("DetailReverseTemparure", new { controller = "InvoiceQRExternalUseres", serial = Model.Serial_Number })' target="_blank">
                                    @Accountingsystem.Resources.MasterPOSInvoice.ThermalPrinting
                                    <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                                </a>
                            }
