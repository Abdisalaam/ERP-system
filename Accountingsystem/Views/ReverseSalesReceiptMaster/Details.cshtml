                                @Accountingsystem.Resources.InvoiceMasterDetails.Delete
                                <span id="DeleteSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                            </a>

                        }
                        else
                        {
                            @*<a id="ReceiptConstraint" class="btn btn-block btn-outline-info mb-lg-0" href='@Url.Action("DetailByCode", new { controller = "GLMaster", code = Model.Serial_Number })'>
                        @Accountingsystem.Resources.InvoiceMasterDetails.ReceiptConstraint
                        <span id="ReceiptConstraintSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                    </a>*@

                        }

                        @*}*@




                    </div>
                </div>


                    <div class="col-md-6">
