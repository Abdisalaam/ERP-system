                                            @Model.Invoice_Date.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceCase)
                                        </div>
                                        <div id="Invoice_State">
                                            @Html.DisplayFor(model => model.Invoice_State)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.ReverseSalesReceiptMasterDetails.Store)
                                        </div>
                                        <div>
                                            @Accountingsystem.Models.Store.GetStoreById(Model.Store_ID).Store_Name
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.ReverseSalesReceiptMasterDetails.CashInvoiceNumber)
                                        </div>
                                        <div>
                                            @Accountingsystem.Models.SalesReceiptMaster.GetSalesReceiptMasterById(Model.SalesRecipt_Id.Value).Serial_Number
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Model.Customer_Id != 0 && Model.Customer_Id != null)
                    {

                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.CustomerNumber)
                                            </div>
                                            <div>
                                                @Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id.Value).Customer_Code
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.CustomerName)
                                            </div>
                                            <div>
                                                @Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id.Value).Customer_Name
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (Model.PaymentMethod_Id > 0)
                    {
                        <div class="col-md-6">
