    <script>

        $('#offerCreateMasterForm').submit(function () {
            debugger
            var SelectedCustomerId = $("#Customer_Id").val();
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#Invoice_Date').val() == "" || $('#Invoice_Date').val() == null || $('#salesRecipt_Id').val() == "" || $('#salesRecipt_Id').val() == null ||
                (($('#PaymentMethod_Id').val() == "" || $('#PaymentMethod_Id').val() == null) && ($("#Customer_Id").val() == "" || $("#Customer_Id").val() == null))
                || $('#InvoiceMasterDetailList') == null || $('#InvoiceMasterDetailList tr').length < 3) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#Invoice_Date').val() == "" || $('#Invoice_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.DateMust",
                        pos: 'top-center'
                    });
                    $("#Invoice_Date").addClass("addRequiredFieldToInput");
                    $('#Invoice_Date').trigger('focus');
                }
                if ($('#salesRecipt_Id').val() == "" || $('#salesRecipt_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.invoicemust  ",
                        pos: 'top-center'
                    });
                    $("#salesRecipt_Id").addClass("addRequiredFieldToInput");
                    $('#salesRecipt_Id').trigger('focus');
                }



                if (($('#PaymentMethod_Id').val() == "" || $('#PaymentMethod_Id').val() == null) && ($("#Customer_Id").val() == "" || $("#Customer_Id").val() == null)) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.PaymentMust",
                        pos: 'top-center'
                    });
                    $("#PaymentMethod_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#PaymentMethod_Id_chosen span').css('background', 'red');
                    $('#PaymentMethod_Id_chosen b').css('background', 'red');
                }


                if ($('#InvoiceMasterDetailList tr').length < 3) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.invoiceProductMust",
                        pos: 'top-center'
                    });

                }



                // Eng Mohammed
                $("#createOfferSpinner").hide();


                event.preventDefault();
            }


        });

    </script>
