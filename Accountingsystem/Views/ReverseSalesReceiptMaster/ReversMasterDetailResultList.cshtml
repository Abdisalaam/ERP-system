@model IEnumerable<Accountingsystem.Models.ReverseSalesReceiptDetailsTemp>



    @{decimal tax = 0;
        decimal TotalAmount = 0;
        decimal com = 0;
        decimal quantity = 0;
    }
<div class="statbox widget box box-shadow">
    <div class="table-responsive">

        <table id="InvoiceMasterDetailList" class="table table-hover" style="width:100%">
            <thead>
                <tr>

                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesReceiptMasterDetails.Item)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.ItemNumber)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Quantity)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Price)
                    </th>


                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ReverseSalesReceiptMasterIndex.TotalTax)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Total)
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @Html.HiddenFor(modelItem => item.Details_Id)

                    <tr>
                        @{
                            var product = Accountingsystem.Models.Product.GetProdectById(item.Product_Id);

                        }
                        <td><h>@product.Prod_Name</h></td>
                        <td><h>@product.Prod_Code</h></td>
                        <td>

                            @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>
                            @*@Html.DisplayFor(modelItem => item.Product_Price)*@
                            @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>
                            @*@Html.DisplayFor(modelItem => item.Detail_Total_Tax)*@
                            @Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)
                            @{ tax += item.Detail_Total_Tax;
                                quantity += item.Product_Quantity;

                            }
                        </td>

                        <td>
                            @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
                            @Math.Round(item.Total_Amount, 2, MidpointRounding.AwayFromZero)
                            @{ TotalAmount += item.Total_Amount;

                            }


                        </td>

                        <td>
                            <a href='javascript:;' onclick="@("DeleteTemp('"+item.Details_Id+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.InvoiceMasterDetails.Delete data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                        </td>


                    </tr>

                }
                <tr>

                    <td>@Accountingsystem.Resources.InvoiceMasterDetails.Total</td>
                    <td></td>
                    <td>
                        @Math.Round(quantity, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td></td>
                    <td>

                        @Math.Round(tax, 2, MidpointRounding.AwayFromZero)
                    </td>

                    <td>


                        @Math.Round(TotalAmount, 2, MidpointRounding.AwayFromZero)

                    </td>


                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

