</head>

@using (Html.BeginForm("Create", "CatchReceipt", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.CatchReceipt_Id)
    @Html.HiddenFor(model => model.Company_Id)
    @Html.HiddenFor(model => model.Currency_Id)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.CatchReceiptCreate.CatchReceipt)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.CatchReceiptNumber)
                                    @Html.EditorFor(model => model.CatchReceipt_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.CatchReceipt_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.CatchReceiptDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.CatchReceipt_date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.CatchReceipt_date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.Refrence)
                                    @Html.EditorFor(model => model.Reference, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.Value)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.CatchReceipt_Value, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.CatchReceipt_Value, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.AccountCreditor)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.AccountCredit_Id, Model.AccCreditList, Accountingsystem.Resources.CatchReceiptCreate.SelectAccount, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountCredit_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.SubAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SubChild_AccountCredit_Id, Model.SubChildList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.SubChild_AccountCredit_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.PaymentMethod)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.AccountDebit_Id, Model.AccDebitList, Accountingsystem.Resources.CatchReceiptCreate.SelectpaymentMethod, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.AccountDebit_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input form-control mb-4" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.Expenses.AddFile</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="list-unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CatchReceiptCreate.Description)
                                    @Html.TextAreaFor(model => model.CatchReceipt_Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.CatchReceiptCreate.Description })
                                    @Html.ValidationMessageFor(model => model.CatchReceipt_Description, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.CatchReceiptCreate.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.CatchReceiptCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>
}



@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }

    <script type="text/javascript">
       $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
           var _ExpensesDate = flatpickr(document.getElementById('CatchReceipt_date'), {
                defaultDate: currentDate
           });

           $("#AccountCredit_Id").chosen();
           $("#SubChild_AccountCredit_Id").chosen();
           $("#AccountDebit_Id").chosen();

           $("#AccountCredit_Id_chosen").addClass("form-control Dropdownlist-select");
           $("#SubChild_AccountCredit_Id_chosen").addClass("form-control Dropdownlist-select");
           $("#AccountDebit_Id_chosen").addClass("form-control Dropdownlist-select");


             $('#Files').change(function () {
                 $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
            $('#selectedtFiles').empty();
          
            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                conteLength = this.files[i].size;
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Files').empty();
                    $('#selectedtFiles').empty();
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.TotalSizeOfSelectedFiles : " + totalConteLength + " "+ "@Accountingsystem.Resources.Expenses.Byte" + '</li > ');
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.MaxOfFilesSize" + '.</li > ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Expenses.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileName : " + fileName + '</li> ');
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li> ');
                }
            }
            $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li > ');
        });

        });




     $(function () {

         $("#AccountCredit_Id").change(function (e) {
             var selectedValue = $(this).val();
             if (selectedValue == "") {
                 selectedValue = "0"
             }
            $.ajax({
                url: '@Url.Action("GetSubChildCredit", "CatchReceipt")',
                type: 'get',
                data: { ChildID: selectedValue }
            }).done(function (result) {

                $("#SubChild_AccountCredit_Id").empty();
              
                
                for (var i = 0; i < result.length; i++) {
                    var p = new Option(result[i].Text, result[i].Value);
                    $("#SubChild_AccountCredit_Id").append(p);
                }
                $('#SubChild_AccountCredit_Id').trigger('chosen:updated');
            });
        });
    });

    </script>
  <script>
      $('#CatchReceipt_Value').on('input', function () {
          $("#CatchReceipt_Value").removeClass("addRequiredFieldToInput");
      });


      $('#AccountCredit_Id').on('change', function () {
          $("#AccountCredit_Id_chosen").removeClass("addRequiredFieldToInput");
          $('#AccountCredit_Id_chosen span').css('background', '#ffffff');
          $('#AccountCredit_Id_chosen b').css('background', '#ffffff');
      });
      $('#AccountDebit_Id').on('change', function () {
          $("#AccountDebit_Id_chosen").removeClass("addRequiredFieldToInput");
          $('#AccountDebit_Id_chosen span').css('background', '#ffffff');
          $('#AccountDebit_Id_chosen b').css('background', '#ffffff');
      });
      $("#backToListBtn").click(function (e) {
          $("#backTolistBtnSpinner").show();
      });
    </script>
    <script>
        $('#CatchReceipt_date').on('change', function (e)
        {
            var selectedValue = $(this).val();
             $.ajax({
                        url: '@Url.Action("CheckStartdate", "GLMaster")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                            var currentDate = new Date();

                            var _OfferDate = flatpickr(document.getElementById('CatchReceipt_date'), {
                                defaultDate: currentDate
                            });

                        }
                    }
                    );
            $.ajax({
                url: '@Url.Action("CheckEndDate", "Company")',
                data: { date : selectedValue },
            type: 'get',
            }).done(function (result) {
                if (result == "" || result == null) {

                }
                else {
                    Snackbar.show({
                        text: result,
                        pos: 'top-center'
                    });
                }
            }
            );
        });

    </script>
    <script>
        $('#catchReceiptCreateForm').submit(function () {
            
            $('#subBut').prop('disabled', true);
            if ($('#AccountCredit_Id').val() == "" || $('#AccountCredit_Id').val() == null || $('#AccountCredit_Id').val() < 1 || $('#AccountDebit_Id').val() == null || $('#AccountDebit_Id').val() == "" || $('#AccountDebit_Id').val() < 1 || $('#CatchReceipt_Value').val() == null || $('#CatchReceipt_Value').val() == "" || $('#CatchReceipt_Value').val() <= 0) {
                $('#subBut').prop('disabled', false);
                if ($('#AccountCredit_Id').val() == "" || $('#AccountCredit_Id').val() == null || $('#AccountCredit_Id').val() < 1) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CatchReceiptCreate.AccountCreditorIsRequierdMessage",
                        pos: 'top-center'
                    });
                    $("#AccountCredit_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#AccountCredit_Id_chosen span').css('background', 'red');
                    $('#AccountCredit_Id_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#AccountCredit_Id").offset().top
                    }, 2000);
                }
                if ($('#AccountDebit_Id').val() == "" || $('#AccountDebit_Id').val() == null || $('#AccountDebit_Id').val() < 1) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CatchReceiptCreate.PaymentMethodeIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#AccountDebit_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#AccountDebit_Id_chosen span').css('background', 'red');
                    $('#AccountDebit_Id_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#AccountDebit_Id").offset().top
                    }, 2000);
                } 
                if ($('#CatchReceipt_Value').val() == "" || $('#CatchReceipt_Value').val() == null || $('#CatchReceipt_Value').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CatchReceiptCreate.ValueRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#CatchReceipt_Value").addClass("addRequiredFieldToInput");
                    $('#CatchReceipt_Value').trigger('focus');
                }
               
                $("#createExpensesSpinner").hide();
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }

        });
    </script>

}