            </div>
        </div>

        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.validate.NoticeNo)
                                        </div>
                                        <div>
                                            @if (Model.Number == null)
                                            {
                                                <div>
                                                    @Html.DisplayFor(model => model.Serial_Number)
                                                </div>
                                            }
                                            else
                                            {
                                                <div>
                                                    @Html.DisplayFor(model => model.Number)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Serial_Number)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceDate)
                                        </div>
                                        <div>
                                            @Model.Invoice_Date.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceCase)
                                        </div>
                                        <div id="Invoice_State">
                                            @Html.DisplayFor(model => model.Invoice_State)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.StoreName)
                                        </div>
                                        <div>
                                            @Accountingsystem.Models.Store.GetStoreById(Model.Store_ID).Store_Name
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.FutureInvoiceNumber)
                                        </div>
                                        <div>
                                            @Accountingsystem.Models.InvoiceMaster.GetInvoiceDetailsById(Model.InvoiceMaster_Id.Value).Serial_Number
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.CustomerNumber)
                                        </div>
                                        <div>
                                            @Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id).Customer_Code
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.CustomerName)
                                        </div>
                                        <div>
                                            @Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id).Customer_Name
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>



                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="text-center">
                                @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Description)
                            </div>
                            @Html.TextAreaFor(model => model.Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                        </div>
                    </div>

                </div>

            </div>

        </div>



        <div class="table-responsive">
            <table class="table mb-4">
                <thead>
                    <tr>
                        <th>@Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Item</th>
                        <th>@Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.ItemNumber</th>
                        <th>@Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.Quantity</th>
                        <th>@Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.ItemPrice</th>
                        <th>@Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.TotalTax</th>
                        <th>@Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.TotalValue</th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.ReveInvoiceDetails)
                    {
                        <tr>
                            <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_ID).Prod_Name</td>
                            <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_ID).Prod_Code</td>
                            <td>@Math.Round(detail.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Total_Amount, 2, MidpointRounding.AwayFromZero)</td>

                            @{ TotalAmountbeforeDisc += detail.Product_Quantity * detail.Product_Price;
                                discount += (detail.Product_Quantity * detail.Product_Price) * (Model.Master_Discount.Value / 100);


                            }
                        </tr>
                    }

                </tbody>
            </table>
        </div>



        <div class=''>
            <div class="row layout-top-spacing">
                <div class="col-md-12">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.ReversePOSInvoiceDetails.TotalValue)
                                    </div>
                                    <div>
                                        @Math.Round(TotalAmountbeforeDisc, 2, MidpointRounding.AwayFromZero)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                @if (Model.Master_Discount > 0)
                {
                    <div class="col-md-12">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Accountingsystem.Resources.InvoiceMasterDetails.Discount  @Math.Round(Model.Master_Discount.Value, 2, MidpointRounding.AwayFromZero) %
                                        </div>
                                        <div>
                                            @Math.Round(discount, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
                @if (Model.Total_Tax > 0)
                {
                    <div class="col-md-12">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.ReverseSalesInvoiceMasterDetails.TotalTaxes)
                                        </div>
                                        <div>
                                            @Math.Round(Model.Total_Tax, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }


                <div class="col-md-12">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.ReversePOSInvoiceDetails.Net)
                                    </div>
                                    <div>
                                        @Math.Round(Model.Total_Amount, 2, MidpointRounding.AwayFromZero)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>



        </div>
        @if (Model.ReversSalesFileDetails.Any())
        {
            <div class="row inv--product-table-section">
                <div class="col-12">
                    <div class="table-responsive">
                        <table class="table">
                            <thead class="">

                                <tr>


                                    <th>@Accountingsystem.Resources.ReverseSalesReceiptMasterDetails.FileNumber</th>
                                    <th>@Accountingsystem.Resources.ReverseSalesReceiptMasterDetails.FileName</th>

                                    <th>@Accountingsystem.Resources.ReverseSalesReceiptMasterDetails.ContentLength</th>
                                    <th>@Accountingsystem.Resources.ReverseSalesReceiptMasterDetails.FileExtension</th>
                                    <th>@Accountingsystem.Resources.InvoiceMasterDetails.Download</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{var countfile = 0; }
                                @foreach (var file in Model.ReversSalesFileDetails)
                                {
                                    countfile += 1;
                                    <tr>
                                        <td>@countfile</td>
                                        <td>@file.FileName</td>
                                        <td>@file.ContentLength</td>
                                        <td>@file.FileType</td>

                                        <td>

                                            <a href="@Url.Action( "ReturnrecalltFile", new { fileId = file.Id })" class="bs-tooltip" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Download" data-original-title="Download">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-download"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>

                                            </a>
                                        </td>
                                        <td>
                                            @*@if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع") && !User.IsInRole("مساعد محاسب"))
                                            {*@

                                                <a href='@Url.Action("deleteFile", new { fileId = file.Id })' class="bs-tooltip" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Delete" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                                            @*}*@
                                        </td>

                                    </tr>
                                }



                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        }

        @{

            AfterDiscount = TotalAmountbeforeDisc - discount;
        }
        <div class="row">

            <div class="col-md-6">
                <div class="form-group">
                    <a id="newbtn" class="btn btn-block btn-outline-info mb-lg-0" href=" @Url.Action( "AddNewRevInvoiceDetail")">
                        @Accountingsystem.Resources.InvoiceMasterDetails.Createnew
                        <span id="newbtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                    </a>
                    @*@if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع") && !User.IsInRole("مساعد محاسب"))
                    {*@

                        <input id="changeState" type="button" value="Post" class="btn btn-block btn-outline-info mb-lg-0" />
                        <span id="changeStateSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>

                        @if (Model.Invoice_State == Accountingsystem.Models.TransactionState.Pending)
                        {
                            <a id="Delete" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("Delete", new { id = Model.Master_Id })">
                                @Accountingsystem.Resources.InvoiceMasterDetails.Delete
                                <span id="DeleteSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                            </a>

                        }
                        else
                        {
                            @*<a id="ReceiptConstraint" class="btn btn-block btn-outline-info mb-lg-0" href='@Url.Action("DetailByCode", new { controller = "GLMaster", code = Model.Serial_Number })'>
                                @Accountingsystem.Resources.InvoiceMasterDetails.ReceiptConstraint
                                <span id="ReceiptConstraintSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                            </a>*@

                        }

                    @*}*@



                </div>
            </div>



            <div class="col-md-6">
                <div class="form-group">
                    @if (Accountingsystem.Models.MasterQRInvoice.GetReversQRInvoiceById(Model.Serial_Number) != null)
                    {
                        if (customer != null && customer.Customer_TaxNumber != null)
                        {
