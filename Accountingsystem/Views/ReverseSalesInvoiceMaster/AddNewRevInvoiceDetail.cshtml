            $("#MyListItemssss").load('@(Url.Action("GetAllTempSalesInvoiceDetailsresult", "ReverseSalesInvoiceMaster"))?tempInvoiceMasterId=' + ReverseSalesInv,'delete='+0);


    };
        function AddOrder() {
            var ReverseSalesInv=@Model.Master_Id;
            var invoiceMasterIds =$("#selectedrevInvoiceMasterMaster_Id").val();
            var ProductIDs =  $("#Product_ID").val();
            var ProductQuantity =  $("#Product_Quantity").val();
            var ProductPrice =  $("#Product_Price").val();
            var ProductTax =  $("#Product_Tax").val();
            var DetailsId =  $("#Details_Id").val();
            var invoiceMasterdd=@Model.selectedrevInvoiceMasterMaster_Id;
            var totalAmount= $("#Product_Price").val()*$("#Product_Quantity").val();
            var Detail_Total_Tax = totalAmount * ($("#Product_Tax").val() / 100);
            //alert(invoiceMasterIds);
            var invDetail;
            invDetail = {
                Product_ID:ProductIDs,
                Details_Id:DetailsId,
                Product_Price:ProductPrice,
                Product_Tax:ProductTax,
                Product_Quantity:ProductQuantity,
                InvoiceMaster_Id:ReverseSalesInv,
                invoiceId:invoiceMasterIds,
                Total_Amount: totalAmount,
                invoiceMasterId: invoiceMasterdd,
                Detail_Total_Tax:Detail_Total_Tax
            };

            $.ajax(
                   {
                       url: '@Url.Action("AddInvoiceDetailsToMaster", "ReverseSalesInvoiceMaster")',
                       data: JSON.stringify(invDetail),
                       contentType: 'application/json',
                       dataType: 'json',
                       type: 'POST',
                    success: function (data) {
                        Snackbar.show({
                            text: data,
                            pos: 'top-center'
                        });


                        $("#MyListItemssss").load('@(Url.Action("GetAllTempSalesInvoiceDetailsresult", "ReverseSalesInvoiceMaster"))?tempInvoiceMasterId=' + ReverseSalesInv, 'delete=' + 0);
                       },
                   });



        };
        function SaveRev() {

            var Master_Id=@Model.Master_Id;
            var selectedrevInvoiceMasterMaster_Id =$("#selectedrevInvoiceMasterMaster_Id").val();
            var Serial_Number =  $("#Serial_Number").val();
            var Invoice_Date =  $("#Invoice_Date").val();

            var selectedStoreStore_Id =  $("#selectedStoreStore_Id").val();
            var SelectedCompany_Id =  $("#SelectedCompany_Id").val();
            var SelectedCustomerId= $("#SelectedCustomerId").val();
            var SelectedCurrencyId = $("#SelectedCurrencyId").val();
            var file1 = document.getElementById("file-id").file[0].Path();
            var file2 = document.getElementById("file-id").file[0].Name();


            var masterVM;
            masterVM = {
                Master_Id:Master_Id,
                selectedrevInvoiceMasterMaster_Id:selectedrevInvoiceMasterMaster_Id,
                Serial_Number:Serial_Number,
                Invoice_Date:Invoice_Date,

                selectedStoreStore_Id:selectedStoreStore_Id,
                SelectedCompany_Id:SelectedCompany_Id,
                SelectedCustomerId:SelectedCustomerId,
                SelectedCurrencyId:SelectedCurrencyId,
                Files: file1
            };

            $.ajax(
                   {
                       url: '@Url.Action("AddNewRevInvoiceDetails", "ReverseSalesInvoiceMaster")',
                       data: JSON.stringify(masterVM),
                       contentType: 'application/json',
                       dataType: 'json',
                       type: 'POST',
                       success: function (data) {
                           Snackbar.show({
                               text: data,
                               pos: 'top-center'
                           });
                           window.location = 'Index/'
                    },
                    error: function () {
                        alert("Error!")
                    }
                   });


    };
