            var currentDate = $("#Rec_Date").val();

            var _OfferDate = flatpickr(document.getElementById('Rec_Date'), {
                defaultDate: currentDate
            });
            $("#SelectedChartOfAccountId").chosen();

            $("#SelectedChartOfAccountId_chosen").addClass("form-control Dropdownlist-select");

            $("#SelectedCustomer").chosen();

            $("#SelectedCustomer_chosen").addClass("form-control Dropdownlist-select");

            $("#selectInvoiceID").chosen();

            $("#selectInvoiceID_chosen").addClass("form-control Dropdownlist-select");
            return false;
        });


    </script>
    <script type="text/javascript">

                    $("#SelectedCustomer").change(function (e) {
                        var selectedValue = $(this).val();
                        var data = 0;
                $.ajax({
                    url: '@Url.Action("GetInvoice", "ReceiptPOS")',
                    type: 'get',
                    data: { CustID: selectedValue }
                }).done(function (result) {

                    $("#selectInvoiceID").empty();
                    var placeholder = new Option("@Accountingsystem.Resources.validate.invoicemust", null);
                    $("#selectInvoiceID").append(placeholder);
                    if (result.length == 0) {



                        $("#selectInvoiceID").append(placeholder);
                        $('#selectInvoiceID').trigger('chosen:updated');
                    }
                    else {
                        for (var i = 0; i < result.length; i++) {
                            var item = result[i];
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#selectInvoiceID").append(p);
                            $('#selectInvoiceID').trigger('chosen:updated');
                        }
                    }
                     $("#InvoiceDetails").load('@(Url.Action("getInvoicebyId", "ReceiptPOS", null, Request.Url.Scheme))?id=' + data);
                });

        });



