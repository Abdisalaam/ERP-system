@using (Html.BeginForm("Update", "ReceiptPOS", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))


{
    @Html.AntiForgeryToken()


    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Rec_ID)
    @Html.HiddenFor(model => model.RecComp_ID)
    @Html.HiddenFor(model => model.SelectedCurrencyId)
    @Html.HiddenFor(model => model.Rec_Number)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Accountingsystem.Resources.ReceiptCreate.EditSalesCatchReceipt</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReceiptCreate.ReceiptNumber)
                                    @Html.EditorFor(model => model.Rec_Number, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Rec_Number, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReceiptCreate.ReceiptDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Rec_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Rec_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReceiptCreate.ReceiptAmount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Rec_Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div>
                                                    <span class="form-control text-danger">*</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Rec_Amount, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReceiptCreate.PaymentMethods)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedChartOfAccountId, Model.MyChartOfAccountList, Accountingsystem.Resources.ReceiptCreate.PaymentMethodsInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedChartOfAccountId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Customer)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedCustomer, Model.MyCustomerList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListCustomer, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedCustomer, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReceiptCreate.Invoice)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.selectInvoiceID, Model.InvoiceList, Accountingsystem.Resources.ReceiptCreate.InvoiceInformation, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.CustomerCreate.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.Expenses.AddFile</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="list-unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReceiptCreate.ReceiptDescriptionInformation)
                                    @Html.TextAreaFor(model => model.Rec_Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.ReceiptCreate.ReceiptDescriptionInformation })
                                    @Html.ValidationMessageFor(model => model.Rec_Description, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12" id="InvoiceDetails"></div>
                    <div class="col-md-6" id="InvoiceDetailsRecalls"></div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>

    </div>




}







