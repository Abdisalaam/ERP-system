    <script>

        $('#offerCreateMasterForm').submit(function () {
            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);
            if ($('#Rec_Date').val() == "" || $('#Rec_Date').val() == null || $('#Rec_Amount').val() == "" || $('#Rec_Amount').val() == null || $('#Rec_Amount').val() <= 0 || $('#SelectedChartOfAccountId').val() == "" || $('#SelectedChartOfAccountId').val() == null || $('#SelectedCustomer').val() == "" || $('#SelectedCustomer').val() == null || $('#selectInvoiceID').val() == "" || $('#selectInvoiceID').val() == null || $('#selectInvoiceID').val() == 0 || $('#selectInvoiceID').val() == "null") {

                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#Rec_Date').val() == "" || $('#Rec_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.DateMust",
                        pos: 'top-center'
                    });
                    $("#Rec_Date").addClass("addRequiredFieldToInput");
                    $('#Rec_Date').trigger('focus');
                }

                if ($('#Rec_Amount').val() == "" || $('#Rec_Amount').val() == null || $('#Rec_Amount').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.AmountMust ",
                        pos: 'top-center'
                    });
                    $("#Rec_Amount").addClass("addRequiredFieldToInput");
                    $('#Rec_Amount').trigger('focus');
                }
                if ($('#SelectedChartOfAccountId').val() == "" || $('#SelectedChartOfAccountId').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.PaymentMust",
                        pos: 'top-center'
                    });
                    $("#SelectedChartOfAccountId_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedChartOfAccountId_chosen span').css('background', 'red');
                    $('#SelectedChartOfAccountId_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedChartOfAccountId").offset().top
                    }, 2000);
                }


                if ($('#SelectedCustomer').val() == "" || $('#SelectedCustomer').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.CustomerMust",
                        pos: 'top-center'
                    });

                    $("#SelectedCustomer_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedCustomer_chosen span').css('background', 'red');
                    $('#SelectedCustomer_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedCustomer").offset().top
                    }, 2000);
                }

                if ($('#selectInvoiceID').val() == "" || $('#selectInvoiceID').val() == null || $('#selectInvoiceID').val() == 0 || $('#selectInvoiceID').val() == "null") {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.validate.invoicemust",
                        pos: 'top-center'
                    });
                    $("#selectInvoiceID_chosen").addClass("addRequiredFieldToInput");
                    $('#selectInvoiceID_chosen span').css('background', 'red');
                    $('#selectInvoiceID_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#selectInvoiceID").offset().top
                    }, 2000);
                }


                event.preventDefault();
            }



        });

    </script>

}
