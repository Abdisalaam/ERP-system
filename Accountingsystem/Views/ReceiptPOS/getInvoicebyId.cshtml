@model Accountingsystem.Models.MasterPOSInvoice
@{
    ViewBag.Title = Accountingsystem.Resources.MasterPOSInvoice.SalesCenterInvoiceDetails;


    var revenueAccount = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount(Model.Account_Id.Value);
    decimal total = 0;
    decimal discount = 0;
    decimal TotalAmountbeforeDisc = 0;
    decimal payTotal = 0;

    var incoceDate = Model.Invoice_Date.ToString();
    var _CompanyId = Convert.ToInt32(Model.Company_Id);
    var _Company = Accountingsystem.Models.Company.GetCompanyById(_CompanyId);

}
<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <div class="statbox widget box box-shadow">

        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    @Accountingsystem.Resources.MasterPOSInvoice.SalesCenterInvoiceDetails
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceNumber)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Serial_Number)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.InvoiceDate)
                                        </div>
                                        <div>
                                            @Model.Invoice_Date.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <div class="text-center">
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Description)
                        </div>


                        @Html.TextAreaFor(model => model.Description, 10, 10, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                    </div>
                </div>

            </div>

            @foreach (var detail in Model.DetailPOSInvoices)
            {
                total += detail.Product_Price * detail.Product_Quantity;

                TotalAmountbeforeDisc += detail.Product_Quantity * detail.Product_Price;

            }
            @if (Model.ReversePOSInvoices.Count > 0)
            {
                <div class="widget-header">
                    <div class="row">
                        <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                            فواتير المردود
                        </div>
                        <br />
                        <br />
                    </div>
                </div>
            <div class="table-responsive">
                <table class="table mb-4">
                    <thead>
                        <tr>
                            <th>@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceNumber</th>

                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.TotalAmount</th>
                        </tr>

                    </thead>
                    <tbody>
                        @foreach (var detail in Model.ReversePOSInvoices)
                        {
                            <tr>
                                <td>@detail.Serial_Number</td>


                                <td>@Math.Round(detail.Total_Amount, 2, MidpointRounding.AwayFromZero)</td>

                            </tr>
                        }
                    </tbody>
                </table>

            </div>
            }

            <div class="media  d-md-flex d-block text-sm-left text-center">

                <div class="media-body details-form-control mb-4">
                    <div class="d-xl-flex d-block justify-content-between">
                        <div class="">
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Total)
                        </div>
                        <div>
                            @Math.Round(total, 2, MidpointRounding.AwayFromZero)
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Master_Discount > 0)
            {
                <div class="media  d-md-flex d-block text-sm-left text-center">

                    <div class="media-body details-form-control mb-4">
                        <div class="d-xl-flex d-block justify-content-between">
                            <div class="">
                                @Accountingsystem.Resources.MasterPOSInvoice.DiscountPercentage  @Math.Round(Model.Master_Discount.Value, 2, MidpointRounding.AwayFromZero) %
                            </div>
                            <div>
                                @Math.Round(total * (Model.Master_Discount.Value / 100), 2, MidpointRounding.AwayFromZero)
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (Model.Total_Tax > 0)
            {
                <div class="media  d-md-flex d-block text-sm-left text-center">

                    <div class="media-body details-form-control mb-4">
                        <div class="d-xl-flex d-block justify-content-between">
                            <div class="">
                                @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.TotalTax)
                            </div>
                            <div>
                                @Math.Round(Model.Total_Tax.Value, 2, MidpointRounding.AwayFromZero)
                            </div>
                        </div>
                    </div>
                </div>
            }
            @if (Model.TaxPOSInvoices != null)
            {
                foreach (var taxo in Model.TaxPOSInvoices)
                {
                    var taxinfo = Accountingsystem.Models.Tax.GetTaxesbyId(Convert.ToInt32(taxo.Tax_Id));
                    <div class="media  d-md-flex d-block text-sm-left text-center">

                        <div class="media-body details-form-control mb-4">
                            <div class="d-xl-flex d-block justify-content-between">
                                <div class="">
                                    @taxinfo.Tax_Name @taxinfo.Tax_Percentage %
                                </div>
                                <div>
                                    @Math.Round(taxo.Amount, 2, MidpointRounding.AwayFromZero)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            @if (Model.AllowDiscount != 0 && Model.AllowDiscount != null)
            {
                <div class="media  d-md-flex d-block text-sm-left text-center">

                    <div class="media-body details-form-control mb-4">
                        <div class="d-xl-flex d-block justify-content-between">
                            <div class="">
                                @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.AllowableDiscount)
                            </div>
                            <div>
                                @Math.Round(Model.AllowDiscount.Value, 2, MidpointRounding.AwayFromZero)
                            </div>
                        </div>
                    </div>
                </div>
            }
            <div class="media  d-md-flex d-block text-sm-left text-center">

                <div class="media-body details-form-control mb-4">
                    <div class="d-xl-flex d-block justify-content-between">
                        <div class="">
                            @Html.DisplayName(Accountingsystem.Resources.MasterPOSInvoice.Net)
                        </div>
                        <div>
                            @Math.Round(Model.Total_Amount.Value, 2, MidpointRounding.AwayFromZero)
                        </div>
                    </div>
                </div>
            </div>

            <div class="media  d-md-flex d-block text-sm-left text-center">

                <div class="media-body details-form-control mb-4">
                    <div class="d-xl-flex d-block justify-content-between">
                        <div class="">
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.RemainingValueOfInvoiceValue)
                        </div>
                        <div>
                            @Math.Round(Model.Total_Amount.Value - Model.POSReceipts.Where(a=>a.Rec_state==Accountingsystem.Models.TransactionState.Post).Select(a => a.Rec_Amount).Sum(), 2, MidpointRounding.AwayFromZero)
                        </div>
                    </div>
                </div>
            </div>







        </div>

    </div>

</div>