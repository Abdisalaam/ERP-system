@using (Html.BeginForm("Create", "Vacation_Types", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.VacationTypesCreate.CreateNewVacationType)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationTypesCreate.VacationTypeInformation)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.Vacation_Type, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Vacation_Type, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationTypesCreate.RemainingAvailableVacationCarriedOverInformation)
                                    <div class="input-group mb-4">
                                        @Html.CheckBoxFor(model => model.TransferToNewYear, new { htmlAttributes = new { @class = "form-control mb-4" } })

                                    </div>

                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationTypesCreate.DeductionAvailableVacationPercentageInformation)
                                    @Html.EditorFor(model => model.penalityPercentage, new { htmlAttributes = new { @Value = "0", @class = "form-control mb-4", @type = "number", @step = "any" } })
                                    @Html.ValidationMessageFor(model => model.penalityPercentage, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationTypesCreate.DeductionExceedVacationPercentageInformation)
                                    @Html.EditorFor(model => model.PenalityPercentageAfter, new { htmlAttributes = new { @Value = "0", @class = "form-control mb-4", @type = "number", @step = "any" } })
                                    @Html.ValidationMessageFor(model => model.penalityPercentage, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationTypesCreate.DaysAvailableVacationDeductionInformation)
                                    @Html.EditorFor(model => model.PenalityDay, new { htmlAttributes = new { @Value = "0", @class = "form-control mb-4", @type = "number", @step = "any" } })
                                    @Html.ValidationMessageFor(model => model.penalityPercentage, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationTypesCreate.DaysDeductionExceedVacationInformation)
                                    @Html.EditorFor(model => model.PenalityDayAfter, new { htmlAttributes = new { @Value = "0", @class = "form-control mb-4", @type = "number", @step = "any" } })
                                    @Html.ValidationMessageFor(model => model.PenalityDayAfter, "", new { @class = "text-danger" })
                                </div>
                            </div>







                        </div>
                    </div>
                </div>

            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                    @if (Request.IsAuthenticated && !User.IsInRole("بائع"))
                    {
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    }

                </div>
            </div>
        </form>

    </div>
}



@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }

    <script>
        if ($('.chosen-container').length > 0) {
            $('.chosen-container').on('touchstart', function (e) {
                e.stopPropagation(); e.preventDefault();
                $(this).trigger('mousedown');

            });
        }
        $('#Vacation_Type').on('input', function () {
            $("#Vacation_Type").removeClass("addRequiredFieldToInput");
        });


        $('#penalityPercentage').on('input', function () {
            $("#penalityPercentage").removeClass("addRequiredFieldToInput");
        });
        $('#PenalityPercentageAfter').on('input', function () {
            $("#PenalityPercentageAfter").removeClass("addRequiredFieldToInput");
        });
        $('#PenalityDay').on('input', function () {
            $("#PenalityDay").removeClass("addRequiredFieldToInput");
        });
        $('#PenalityDayAfter').on('input', function () {
            $("#PenalityDay").removeClass("addRequiredFieldToInput");
        });




    </script>

    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#Vacation_Type').val() == "" || $('#Vacation_Type').val() == null || $('#penalityPercentage').val() == "" || $('#penalityPercentage').val() == null || $('#penalityPercentage').val() < 0 || $('#PenalityPercentageAfter').val() == "" || $('#PenalityPercentageAfter').val() == null || $('#PenalityPercentageAfter').val() < 0
                || $('#PenalityDay').val() == "" || $('#PenalityDay').val() == null || $('#PenalityDay').val() < 0
                || $('#PenalityDayAfter').val() == "" || $('#PenalityDayAfter').val() == null || $('#PenalityDayAfter').val() < 0

            ) {
                $('#createOfferbtn').prop('disabled', false);
           
                $("#createOfferSpinner").hide();
                if ($('#Vacation_Type').val() == "" || $('#Vacation_Type').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationTypesCreate.EnterVacationName",
                        pos: 'top-center'
                    });
                    $("#Vacation_Type").addClass("addRequiredFieldToInput");
                    $('#Vacation_Type').trigger('focus');
                }
                debugger
                if ($('#penalityPercentage').val() == "" || $('#penalityPercentage').val() == null || $('#penalityPercentage').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationTypesCreate.EnterVacationPercentage",
                        pos: 'top-center'
                    });
                    $("#penalityPercentage").addClass("addRequiredFieldToInput");
                    $('#penalityPercentage').trigger('focus');
                }





                if ($('#PenalityPercentageAfter').val() == "" || $('#PenalityPercentageAfter').val() == null || $('#PenalityPercentageAfter').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationTypesCreate.EnterNoVacationPercentage",
                        pos: 'top-center'
                    });

                    $("#PenalityPercentageAfter").addClass("addRequiredFieldToInput");
                    $('#PenalityPercentageAfter').trigger('focus');
                }
                if ($('#PenalityDay').val() == "" || $('#PenalityDay').val() == null || $('#PenalityDay').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationTypesCreate.EnterDaysAvailableVacationDeduction",
                        pos: 'top-center'
                    });
                    $("#PenalityDay").addClass("addRequiredFieldToInput");
                    $('#PenalityDay').trigger('focus');
                }
                if ($('#PenalityDayAfter').val() == "" || $('#PenalityDayAfter').val() == null || $('#PenalityDayAfter').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationTypesCreate.EnterDaysDeductionExceed",
                        pos: 'top-center'
                    });
                    $("#PenalityDayAfter").addClass("addRequiredFieldToInput");
                    $('#PenalityDayAfter').trigger('focus');
                }

                $("#createOfferSpinner").hide();
                event.preventDefault();
            }


        });

    </script>
}
