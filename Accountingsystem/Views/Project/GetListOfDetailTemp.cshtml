@model IEnumerable<Accountingsystem.Models.ProjectInvoiceDetailTemp>
@{    
    decimal dicountamount = 0;
    decimal totalsbeforfixed = 0;
    decimal totalsafterfixed = 0;
    decimal tax = 0;
    decimal TotalAmount = 0;
    decimal totalMasterDiscount = 0;
 }

    <div class="statbox widget box box-shadow">
        <div class="table-responsive">
            <table id="creatOfferDetailList" class="table table-hover">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectDetailsofInvoice.Product)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectDetailsofInvoice.Price)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectDetailsofInvoice.TotalTaxes)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectDetailsofInvoice.Quantity)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectDetailsofInvoice.Discount)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectDetailsofInvoice.Total)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        @Html.HiddenFor(modelItem => item.Tax_ID)
                        @Html.HiddenFor(modelItem => item.ProjectInvoiceMasterTempId)
                        @Html.HiddenFor(modelItem => item.Detail_ID)
                        @Html.HiddenFor(modelItem => item.Id)
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Product_Name)
                            </td>
                            <td>
                                @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>
                                @Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Product_Quantity)
                            </td>
                            @{dicountamount = (item.Product_Price * item.Product_Quantity) - (item.Total_Amount - item.Detail_Total_Tax);
                                totalMasterDiscount += dicountamount;

                                }
                            <td>
                                @Math.Round(dicountamount, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>
                                @Math.Round(item.Total_Amount, 2, MidpointRounding.AwayFromZero)
                            </td>
                            @{totalsbeforfixed = totalsbeforfixed + item.Total_Amount; }
                            <td>
                                <div class="col-md-offset-2 col-md-10">
                                    <a href='javascript:;' onclick="@("DeleteTemp('"+item.Id+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Delete" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @{if (Model.ToList().Count > 0)
                {
                    if (Model.FirstOrDefault().fixeddiscount == 0)
                    {
                        totalsafterfixed = totalsbeforfixed;
                    }
                    else
                    {
                        totalsafterfixed = totalsbeforfixed - (decimal)Model.FirstOrDefault().fixeddiscount;
                    }

                }
                else
                {
                    totalsafterfixed = totalsbeforfixed;
                }

            }

        </div>
        @*<div class="row layout-top-spacing">
            <div class="col-md-12">
                <div class=''>
                    <div class="media  d-md-flex d-block text-sm-left text-center">
                        <div class="media-body details-form-control mb-4">
                            <div class="d-xl-flex d-block justify-content-between">
                                <div class="">
                                    @Html.DisplayName(Accountingsystem.Resources.ProjectDetailsofInvoice.Total)
                                </div>
                                <div>
                                    @Math.Round(totalsafterfixed, 2, MidpointRounding.AwayFromZero)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>*@
    </div>
    <script>
    $(document).ready(function () {
        var detailsTotalDiscountAmount = @Math.Round(totalMasterDiscount, 2, MidpointRounding.AwayFromZero);
   
        var detailsTotalInvoiceAmount = @Math.Round((totalsafterfixed), 2, MidpointRounding.AwayFromZero);
        $("#masterTotalDiscountAmount").html(detailsTotalDiscountAmount);
       
        $("#masterTotalInvoiceAmount").html(detailsTotalInvoiceAmount);
    });
    </script>