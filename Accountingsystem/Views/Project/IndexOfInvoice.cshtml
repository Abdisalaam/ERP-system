@model IEnumerable<Accountingsystem.Models.ProjectInvoiceMaster>
@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectsInvoicesList;
    decimal dicount = 0;
    decimal totaldiscounts = 0;
    decimal totalBeforDiscount = 0;
    decimal totalAfterDiscount = 0;
    decimal totalofTax = 0;
    decimal totalafterTax = 0;
    decimal fixedDiscount = 0;
    decimal totalafterfixed = 0;
}

<head>
    @{
        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }
</head>
<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">
                <li class="nav-item theme-text">
                </li>
            </ul>
            <ul class="navbar-item flex-row ml-md-auto">
                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">
                            <div class="dropdown-item">
                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "IndexOfInvoice",new {all=1 })"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.validate.ALL</a>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-item">
                                            <a href='@Url.Action("Index","Project")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.ProjectIndexOfInvoice.BackToProjectsList</a>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-item">
                                            <a href='@Url.Action("Index","ProjectRecipt")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.ProjectIndexOfInvoice.CatchReceiptsProjectsList</a>
                                        </div>
                                    </li>
                                </ul>

                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectsInvoicesList
        </div>
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectInvoiceNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectName)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectInvoiceDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectInvoiceValue)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectIndexOfInvoice.CustomerName)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ProjectIndexOfInvoice.ProjectCase)
                        </th>
                        <th>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        dicount = 0;
                        totaldiscounts = 0;
                        totalBeforDiscount = 0;
                        totalAfterDiscount = 0;
                        totalofTax = 0;
                        totalafterTax = 0;
                        fixedDiscount = 0;
                        totalafterfixed = 0;
                    <tr>
                        @if (item.Number == null)
                        {
                            <td>
                                @Html.DisplayFor(model => item.Serial_Number)
                            </td>
                        }
                        else
                        {
                            <td>
                                @Html.DisplayFor(model => item.Number)
                            </td>
                        }
                        <td>
                            @Html.DisplayFor(modelItem => item.Serial_Number)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Project_Code)
                        </td>
                        <td>
                            @Accountingsystem.Models.Project.getDetail(item.Project_Id).Project_Name
                        </td>
                        @if (item.ProjectInv_Date != null)
                        {
                            <td>

                                @item.ProjectInv_Date.Value.ToString("yyyy/MM/dd ")
                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>

                            @{
                                decimal totalamount = 0;
                                decimal tax = 0;
                                decimal amount = 0;
                                foreach (var detail in item.ProjectInvoiceDetails)
                                {
                                    totalamount += detail.Total_Amount;
                                    tax += detail.Detail_Total_Tax;
                                    amount += detail.Total_Amount - detail.Detail_Total_Tax;
                                    if (item.MasterDiscount > 0)
                                    {
                                        dicount = (detail.Product_Quantity * detail.Product_Price) * ((decimal)item.MasterDiscount / 100);
                                    }
                                    else
                                    {
                                        dicount = 0;
                                    }

                                    totalBeforDiscount = totalBeforDiscount + (detail.Product_Quantity * detail.Product_Price);
                                    totaldiscounts = totaldiscounts + dicount;

                                    totalofTax = totalofTax + detail.Detail_Total_Tax;
                                }
                                totalAfterDiscount = totalBeforDiscount - totaldiscounts;
                                totalafterTax = totalAfterDiscount + totalofTax;
                                if (item.FixedDiscount > 0)
                                {
                                    fixedDiscount = (decimal)item.FixedDiscount;
                                }
                                else
                                {
                                    fixedDiscount = 0;
                                }

                                totalafterfixed = totalafterTax - fixedDiscount;
                            }
                            @Math.Round(totalafterfixed, 2, MidpointRounding.AwayFromZero)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Customer_Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Project_State)
                        </td>
                        <td>
                            <div class="btn-group">

                                <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                    <a href=" @Url.Action( "CreateProjectInvs", new { project_Id = item.Project_Id})" class="dropdown-item">@Accountingsystem.Resources.ProjectIndexOfInvoice.Create</a>


                                    @if (item.Project_State == Accountingsystem.Models.TransactionState.Pending)
                                    {

                                        <a href="@Url.Action( "EditInvoicebeforPost", new { id = item.PInvoiceMaster_ID})" class="dropdown-item">
                                            @Accountingsystem.Resources.ProjectIndexOfInvoice.Edit
                                        </a>
                                    }

                                    <a href="@Url.Action( "DetailsofInvoice", new { id = item.PInvoiceMaster_ID})" class="dropdown-item">
                                        @Accountingsystem.Resources.ProjectIndexOfInvoice.Details
                                    </a>

                                    @*<a href='@Url.Action("ProjectTransferWhite", new { controller = "Reports", id = item.PInvoiceMaster_ID })' target="_blank" class="dropdown-item">
                                        @Accountingsystem.Resources.ProjectIndexOfInvoice.Print
                                    </a>*@
                                </div>
                            </div>

                        </td>
                    </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

