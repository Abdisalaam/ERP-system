    <script type="text/javascript">
        function AddDetailToMaster() {
            if ($('#Description_Detail').val() == "" || $('#Description_Detail').val() == null || $('#Amount').val() == "" || $('#Amount').val() == null || $('#Amount').val() <= 0 ) {
                if ($('#Description_Detail').val() == "" || $('#Description_Detail').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ProjectCreate.PaymentDetailsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Description_Detail").addClass("addRequiredFieldToInput");
                    $('#Description_Detail').trigger('focus');
                }
                if ($('#Amount').val() == "" || $('#Amount').val() == null || $('#Amount').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ProjectCreate.PaymemntFrequenceRequiredMessag",
                        pos: 'top-center'
                    });
                    $("#Amount").addClass("addRequiredFieldToInput");
                    $('#Amount').trigger('focus');
                }
                @*if ($('#Date_Amount').val() == "" || $('#Date_Amount').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ProjectCreate.PaymentDateRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Date_Amount").addClass("addRequiredFieldToInput");
                    $('#Date_Amount').trigger('focus');
                }*@
            }
            else {
                  var Project_Id = @Model.Project_Id;
                var description = $("#Description_Detail").val();
                var Amount = $("#Amount").val();
                var Payed = $("#Payed").prop('checked');
                var date = $("#Date_Amount").val();
                var ProVM;
                ProVM = {
                    Description_Detail: description,
                    Amount: Amount,
                    Payed: Payed,
                    Project_Id: Project_Id,
                    Date_Amount: date
                    };
                $.ajax(
                {
                        url: '@Url.Action("AddToListDetail", "Project")',
                        data: JSON.stringify(ProVM),
                        contentType: 'application/json',
                        dataType: 'json',
                         type: 'POST',
                        success: function (data) {
                            $("#DetailList").load('@(Url.Action("ListTempDetail", "Project"))?master_ID=' + @Model.Project_Id);
                        },
                        error: function () { alert('error'); }
                    });
            }
        };

    </script>

