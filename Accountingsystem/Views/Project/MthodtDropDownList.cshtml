@model Accountingsystem.ViewModel.ProjectVM


@*@Html.AntiForgeryToken()*@



<div class="col-md-5">
    <div class="Dropdownlist">

        @{ Html.EnableClientValidation(false); }
        @Html.DropDownListFor(model => model.Payment_Method, Model.MyPaymentPolicy, "اختر طريقة الدفع", htmlAttributes: new { @class = "form-control Dropdownlist-select" })
        @{ Html.EnableClientValidation(true); }
    </div>
</div>
<span class="required-mark col-md-1"></span>

<div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title="حدد طريقة الدفع">
    <i class="fas fa-question-circle"></i>
</div>
<div class="col-md-5">
    <div class="form-group">
        @Html.LabelFor(model => model.Payment_Method, "طريقه الدفع", htmlAttributes: new { @class = "control-label" })
    </div>
</div>


<script src="~/Scripts/jquery.validate.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.js"></script>