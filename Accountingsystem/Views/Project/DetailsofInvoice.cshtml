        <div class="table-responsive">
            <table class="table mb-4">
                <thead>
                    <tr>
                        <th>@Accountingsystem.Resources.ProjectDetailsofInvoice.Product</th>
                        <th>@Accountingsystem.Resources.ProjectDetailsofInvoice.Quantity</th>
                        <th>@Accountingsystem.Resources.ProjectDetailsofInvoice.UnitPrice</th>
                        <th>@Accountingsystem.Resources.ProjectDetailsofInvoice.Value</th>
                        <th>@Accountingsystem.Resources.ProjectDetailsofInvoice.Discount</th>
                        <th>@Accountingsystem.Resources.ProjectDetailsofInvoice.Tax</th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var detail in Model.ProjectInvoiceDetails)
                    {
                        <tr>
                            <td>@detail.Product_Name</td>

                            <td>@Math.Round(detail.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero)</td>
                            @{
                                dicount = (detail.Product_Quantity * detail.Product_Price) * ((decimal)Model.MasterDiscount / 100);
                                totalBeforDiscount = totalBeforDiscount + (detail.Product_Quantity * detail.Product_Price);
                                totaldiscounts = totaldiscounts + dicount;

                                totalofTax = totalofTax + detail.Detail_Total_Tax;

                            }

                            <td>@Math.Round(detail.Total_Amount, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(dicount, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)</td>

                        </tr>
                    }
                </tbody>
            </table>

        </div>
        @{
            decimal totalamount = 0;
            decimal tax = 0;
            decimal amount = 0;
            foreach (var item in Model.ProjectInvoiceDetails)
            {
                totalamount += item.Total_Amount;
                tax += item.Detail_Total_Tax;
                amount += item.Total_Amount - item.Detail_Total_Tax;
            }
            totalAfterDiscount = totalBeforDiscount - totaldiscounts;
            totalafterTax = totalAfterDiscount + totalofTax;
            fixedDiscount = (decimal)Model.FixedDiscount;
            totalafterfixed = totalafterTax - fixedDiscount;

        }


