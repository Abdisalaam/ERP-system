    decimal dicount = 0;
    decimal totaldiscounts = 0;
    decimal totalBeforDiscount = 0;
    decimal totalAfterDiscount = 0;
    decimal totalofTax = 0;
    decimal totalafterTax = 0;
    decimal fixedDiscount = 0;
    decimal totalafterfixed = 0;
    var customer = new Accountingsystem.Models.Customer();
    if (Model.CustomerCustomer_Id > 0)
    {
        customer = Accountingsystem.Models.Customer.GetCustomerById(Model.CustomerCustomer_Id);
    }
    DateTime? operationDate = new DateTime();
    if (Model.QRNumber > 0)
