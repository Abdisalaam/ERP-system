    <script type="text/javascript">
        $(document).ready(function () {
            debugger
                    updateButtonText();
            hideEditAndDeleteActions();
        });

                    function updateButtonText() {
                        var Invoice_State = '@Model.Project_State';
                        if (Invoice_State == "Void") {
                            $("#changeState").hide();
                            return;
                        }

                        if (Invoice_State == "Pending") {

                            $("#changeState").text('Post');
                        }
                        if (Invoice_State == "Post") {
                            $("#changeState").text('Void');
                        }
                    }


                    function hideEditAndDeleteActions() {
                        /// <summary>Hides the edit and delete actions if the invoice is not pending
                        var Invoice_State = '@Model.Project_State';
                        if (Invoice_State != "Pending")
                            $("#EditAndDelete").hide();
                    }

                    function updateInvoiceState(data) {
                        return $.ajax({
                            contentType: 'application/json; charset=utf-8',
                            dataType: 'json',
                            type: 'POST',
                           url: '@Url.Action("EditInvoice", "Project")',
                            data: data,
                            success: function (result) {
                                Snackbar.show({
                                    text: result,
                                    pos: 'top-center'
                                });
                                setTimeout(function () {

                                    location.reload();

                                }, 5000);

                            },
                            error: function () {
                                alert('@Accountingsystem.Resources.InvoiceMasterDetails.ErrorProductsDontMatch')
                            }
                        });
                    }

        $("#changeState").click(function (e) {
            this.disabled = true;
            e.preventDefault();
                        var data = JSON.stringify({
                            PInvoiceMaster_ID: @Model.PInvoiceMaster_ID,
                            Project_State: $("#changeState").text()
            });
                        $.when(updateInvoiceState(data)).then(function (response) {
                            console.log(response);
                        }).fail(function (err) {
                            console.log(err);
                        });
                        updateButtonText();
                        hideEditAndDeleteActions();

                    })
    </script>
