@model Accountingsystem.ViewModel.ProjectDetailVM
<div class="col-md-12">
    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.validate.Addpreviouspayments)</h3>
    <hr />
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.ProjectCreate.PaymentDescription)
            <div class="input-group">
                @Html.EditorFor(model => model.Description_Detail, new { htmlAttributes = new { @class = "form-control mb-4" } })
                <div class="input-group-append">
                    <div>
                        <span class="form-control text-danger"></span>
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.Description_Detail, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.ProjectCreate.Value)
            <div class="input-group">
                @Html.EditorFor(model => model.Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                @Html.ValidationMessageFor(model => model.Amount, "", new { @class = "text-danger" })
                <div class="input-group-append">
                    <div>
                        <span class="form-control">$</span>
                    </div>
                    <div>
                        <span class="form-control text-danger"></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.ProjectCreate.PaymentDate)
            <div class="input-group">
                @Html.EditorFor(model => model.Date_Amount, new { htmlAttributes = new { @class = "form-control mb-4" } })
                <div class="input-group-append">
                    <div>
                        <span class="form-control text-danger"></span>
                    </div>
                </div>
            </div>
            @Html.ValidationMessageFor(model => model.Date_Amount, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="col-md-12">
        <div class="form-group">
            <a href='javascript:;' onclick='AddDetailToMaster();' class="btn btn-block btn-outline-success mb-lg-0" style="text-decoration:none;">
                @Accountingsystem.Resources.ProjectCreate.AddToRegulation
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                <span id="addToAccountBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
            </a>
        </div>
    </div>

    <script>

        $('#Description_Detail').on('input', function () {
            $("#Description_Detail").removeClass("addRequiredFieldToInput");
        });
        $('#Amount').on('input', function () {
            $("#Amount").removeClass("addRequiredFieldToInput");
        });

        $('#Date_Amount').on('input', function () {
            $("#Date_Amount").removeClass("addRequiredFieldToInput");
        });
    </script>



    <script>

        var amountDate = new Date();
        var _amount_Date = flatpickr(document.getElementById('Date_Amount'), {
            defaultDate: amountDate
        });
    </script>
