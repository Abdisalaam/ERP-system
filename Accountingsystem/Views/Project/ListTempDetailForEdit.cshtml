@model IEnumerable<Accountingsystem.Models.ProjectDetailTemp>

<div class="statbox widget box box-shadow">
    <div class="table-responsive">
        <table id="creatOfferDetailList" class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ProjectCreate.Description)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ProjectCreate.Amount)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ProjectCreate.Paid)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.ProjectCreate.PaymentDate)
                    </th>

                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                <tr>
                    @Html.HiddenFor(modelItem => item.ProjectTempProject_Id)
                    <td>
                        @Html.DisplayFor(modelItem => item.Description_Detail)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Amount)
                    </td>

                    @if (item.Payed == false)
                    {
                        <td> @Accountingsystem.Resources.ProjectDetails.NotPaid</td>

                    }
                    else
                    {
                        <td> @Accountingsystem.Resources.ProjectDetails.Paid</td>

                    }
                    <td>
                        @if (item.Date_Amount != null)
                        {
                            @item.Date_Amount.Value.ToString("yyyy/MM/dd ")
                        }
                    </td>
                    <td>
                        <div class="col-md-offset-2 col-md-10">
                            <a href='javascript:;' onclick="@("DeleteTemp('"+item.Id+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Delete" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>

</div>
