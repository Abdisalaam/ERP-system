@model Accountingsystem.ViewModel.ProjectVM


@Html.AntiForgeryToken()




<div class="col-md-5">
    <div class="textfieldcont">
        @Html.DropDownListFor(model => model.CustomerCustomer_Id, Model.CustomerList, "اختر العميل", htmlAttributes: new { @class = "form-control Dropdownlist-select" })
        @Html.ValidationMessageFor(model => model.CustomerCustomer_Id, "", new { @class = "text-danger" })
    </div>
</div>
<span class="required-mark col-md-1">*</span>

<div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title="حدد العميل">
    <i class="fas fa-question-circle"></i>
</div>
<div class="col-md-5">
    <div class="form-group">
        @Html.LabelFor(model => model.CustomerCustomer_Id, "اختر العميل", htmlAttributes: new { @class = "control-label" })
    </div>
</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <link href="~/Content/css/select2.min.css" rel="stylesheet" />
    <script src="~/Scripts/select2.min.js" type="text/javascript"></script>
    <script src="~/Scripts/UiUtils.js" type="text/javascript"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            fillDropdownWithResponse("@Url.Action("getProductBatchJsondrobDown", "Product")", "#CustomerCustomer_Id");


        })

    </script>
}




