    <script>
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            var selectedValue = $("#PInvoiceMaster_ID").val();
              $("#GetPartialForDetails").load('@(Url.Action("GetPartialForDetail", "Project"))');
            $("#GetListOfDetailTemps").load('@(Url.Action("GetListOfDetailTemp", "Project"))?MasterID=' + selectedValue);




            $("#createSpinner").hide();
