                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Emp_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreate.ProjectDescription)
                                    @Html.TextAreaFor(model => model.Invoice_Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.ProjectCreateProjectInvs.InvoiceDescription })
                                    @Html.ValidationMessageFor(model => model.Invoice_Description, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div id="GetPartialForDetails" class="row"></div>
                        <div id="GetListOfDetailTemps" class="col-md-12"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountPercentage)
                        <div class="input-group">
                            @Html.EditorFor(model => model.MasterDiscount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                            @Html.ValidationMessageFor(model => model.MasterDiscount, "", new { @class = "text-danger" })
                            <div class="input-group-append">

                                <div>
                                    <span class="form-control">%</span>
                                </div>
                                <div>
                                    <span class="form-control text-danger">*</span>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.TotalDiscountAmount)
                        <div class="input-group">
                            <h3 id="masterTotalDiscountAmount" class="form-control mb-4" style="background:#ffffff"></h3>
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @*<div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountAllowedOnBill)
                        <div class="input-group">
                            @Html.EditorFor(model => model.FixedDiscount, new { htmlAttributes = new { @Value = "0", @class = "form-control mb-4", @type = "number", @step = "any" } })
                            @Html.ValidationMessageFor(model => model.FixedDiscount, "", new { @class = "text-danger" })
                            <div class="input-group-append">

                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>*@
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.TotalFinal)
                        <div class="input-group">
                            <h3 id="masterTotalInvoiceAmount" class="form-control mb-4" style="background:#ffffff"></h3>
                            <div class="input-group-append">
                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("IndexOfInvoice")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
            </div>
        </form>
    </div>
}



