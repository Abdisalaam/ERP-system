            var thisdiscountsss = $("#MasterDiscount").val();
                $.ajax({

                url: '@Url.Action("GetPurchInvoiceJson", "Project")',
                data: {proid: selectedValue},
                type: 'get',
                }).done(function (result) {
                    var thisdiscount = $("#MasterDiscount").val();
                    $("#CustomerCustomer_Id").val(result["CustomerCustomer_Id"]);
                    $("#Payment_Method").val(result["Payment_Method"]);
                    $("#Revenu_Id").val(result["Revenu_Id"]);
                    $("#Project_State").val(result["Project_State"]);
                $("#Project_Code").val(result["Project_Code"]);
