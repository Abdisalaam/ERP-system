@using (Html.BeginForm("CreateProjectInvs", "Project", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.PInvoiceMaster_ID)
    @Html.HiddenFor(model => model.CustomerCustomer_Id)
    @Html.HiddenFor(model => model.Payment_Method)
    @Html.HiddenFor(model => model.Revenu_Id)
    @Html.HiddenFor(model => model.Project_State)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ProjectCreateProjectInvs.ProjectInvoice)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                                    @Html.EditorFor(model => model.Serial_Number, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Serial_Number, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreateProjectInvs.InvoiceDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.invoicedate, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.invoicedate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreateProjectInvs.SelectProject)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Project_Id, Model.ProjectList, Accountingsystem.Resources.ProjectCreateProjectInvs.SelectProject, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Project_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreateProjectInvs.ProjectNumber)
                                    @Html.EditorFor(model => model.Project_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Project_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreateProjectInvs.CustomerName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Customer_Name, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Customer_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreateProjectInvs.ProjectValue)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Estimate_Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any", @disabled = "disabled" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Estimate_Amount, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectCreateProjectInvs.SelectEmployee)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Emp_Id, Model.EmpList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
