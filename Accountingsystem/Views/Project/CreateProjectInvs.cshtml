                $("#Project_Description").val(result["Project_Description"]);
                $("#Project_Location").val(result["Project_Location"]);
                $("#DeadLine").val(result["deadline"]);
                $("#StartTime").val(result["starttime"]);
                $("#Estimate_Amount").val(result["Estimate_Amount"]);
                $("#Customer_Name").val(result["Customer_Name"]);
                //$("#Emp_Id").val(result["Emp_Id"]);
                $("#Payment_Method_Name").val(result["Payment_Type"]);

                }
                );



            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });


            return false;
        });
    </script>


