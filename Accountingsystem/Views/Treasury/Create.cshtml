@model Accountingsystem.ViewModel.TreaVM

@{
    ViewBag.Title = Accountingsystem.Resources.TreasuryCreate.CreateNewTreasury;
    HttpCookie cookie = Request.Cookies["Language"];
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";

            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


        }
    }

</head>


@using (Html.BeginForm("Create", "Treasury", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.TreasuryCreate.CreateNewTreasury)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TreasuryCreate.TreasuryName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Trea_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Trea_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TreasuryCreate.TreasuryDescription)
                                    @Html.EditorFor(model => model.Trea_Desc, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TreasuryCreate.TreasuryAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedChartOfAccountId, Model.MyChartOfAccountList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedChartOfAccountId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TreasuryCreate.Employee)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.selectedEmp_Id, Model.EmployeeList, Accountingsystem.Resources.TreasuryCreate.EmployeesListInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.TreasuryCreate.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.TreasuryCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

}


@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>



        }
    }

    <script type="text/javascript">
        $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });
            
            $("#SelectedChartOfAccountId").chosen();
            $("#SelectedChartOfAccountId_chosen").addClass("form-control Dropdownlist-select");

            $("#selectedEmp_Id").chosen();
            $("#selectedEmp_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#balance").val("");
            return false;
        });


    </script>
    <script>
        $('#Trea_Name').on('input', function () {
            $("#Trea_Name").removeClass("addRequiredFieldToInput");
        });      
        $('#SelectedChartOfAccountId').on('change', function () {
            $("#SelectedChartOfAccountId_chosen").removeClass("addRequiredFieldToInput");
            $('#SelectedChartOfAccountId_chosen span').css('background', '#ffffff');
            $('#SelectedChartOfAccountId_chosen b').css('background', '#ffffff');
        });
    </script>
    <script>

            $('#offerCreateMasterForm').submit(function () {
                $('#createOfferbtn').prop('disabled', true);
                if ($('#SelectedChartOfAccountId').val() == "" || $('#SelectedChartOfAccountId').val() == null || $('#SelectedChartOfAccountId ').val() < 1 || $('#Trea_Name').val() == "" || $('#Trea_Name').val() == null ) {
                    $('#createOfferbtn').prop('disabled', false);
                $("#createExpensesSpinner").hide();
                    if ($('#Trea_Name').val() == "" || $('#Trea_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TreasuryCreate.TreasuryNameIsRequiredMessage",
                        pos: 'top-center'
                    });
                        $("#Trea_Name").addClass("addRequiredFieldToInput");
                        $('#Trea_Name').trigger('focus');
                }

                if ($('#SelectedChartOfAccountId').val() == "" || $('#SelectedChartOfAccountId').val() == null || $('#SelectedChartOfAccountId').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TreasuryCreate.TreasuryAccountIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#SelectedChartOfAccountId_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedChartOfAccountId_chosen span').css('background', 'red');
                    $('#SelectedChartOfAccountId_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedChartOfAccountId").offset().top
                    }, 2000);
                }
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }


        });

    </script>

}
