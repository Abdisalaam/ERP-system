@model Accountingsystem.ViewModel.MaintenanceOrderOperationalDetailTempVM
@{decimal tax = 0;
    decimal TotalAmount = 0;
    decimal cost = 0;
    decimal quantity = 0;
    decimal TotalBeforDiscount = 0;
}

<div class="statbox widget box box-shadow">
    <div class="table-responsive">

        <table id="invoiceMasterDetailList" class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Item)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.ItemNumber)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Quantity)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.ItemPrice)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Tax)

                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.TotalTax)

                    </th>


                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.TotalAmount)
                    </th>

                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.TotalCost)
                    </th>





                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.invoiceTemp)
                {

                    @Html.HiddenFor(modelItem => item.Id)
                    @Html.HiddenFor(modelItem => item.MaintenanceOrderOperationalId)



                    <tr>
                        <td hidden>
                            @Html.HiddenFor(modelItem => item.Id, htmlAttributes: new { @class = "Details_Id" })
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Name)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Code)
                        </td>
                        <td>


                            @Html.EditorFor(model => item.Product_Quantity, new { htmlAttributes = new { onchange = "OnChangeEvent(this)", @class = "details-form-control" } })

                        </td>
                        <td>

                            @Html.EditorFor(model => item.Product_Price, new { htmlAttributes = new { onchange = "OnChangeEventPrice(this)", @class = "details-form-control" } })
                        </td>
                        <td>

                            <select class="details-form-control Dropdownlist-select" onchange="OnChangeDrop(this)">
                                <option value=0>بدون ضريبة</option>
                                @foreach (var a in Accountingsystem.Models.Tax.GetAlltaxes().Where(e => e.Tax_Code.StartsWith("02") && e.IsActive != false))
                                {
                                    if (a.Tax_ID == item.Product_Tax)
                                    {
                                        <option value=@a.Tax_ID selected>@a.Tax_Name % @a.Tax_Percentage </option>
                                    }
                                    else
                                    {
                                        <option value=@a.Tax_ID>@a.Tax_Name% @a.Tax_Percentage </option>
                                    }
                                }
                            </select>
                        </td>

                        <td>
                            @Math.Round(item.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)
                            @{ tax += item.Detail_Total_Tax;

                            }
                        </td>
                        <td>

                            @Math.Round(item.Product_Quantity * item.Product_Price, 2, MidpointRounding.AwayFromZero)
                            @{ TotalAmount += item.Total_Amount;
                                quantity += item.Product_Quantity;
                                TotalBeforDiscount += item.Product_Quantity * item.Product_Price;

                            }
                        </td>
                        <td>

                            @Math.Round(item.Detail_Total_Cost, 2, MidpointRounding.AwayFromZero)
                            @{
                                cost += item.Detail_Total_Cost;
                            }
                        </td>
                        <td>
                            <a href='javascript:;' onclick="@("DeleteTemp('"+item.Id+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title="حذف" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                        </td>
                        <td></td>

                    </tr>
                }


                <tr>
                    <td hidden></td>
                    <td>
                        @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Total)
                    </td>
                    <td></td>
                    <td> @Math.Round(quantity, 2, MidpointRounding.AwayFromZero)</td>
                    <td></td>
                    <td></td>
                    <td>
                        @Math.Round(tax, 2, MidpointRounding.AwayFromZero)

                    </td>

                    <td>
                        @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
                        @Math.Round(TotalBeforDiscount, 2, MidpointRounding.AwayFromZero)

                    </td>
                    <td>
                        @*@Html.DisplayFor(modelItem => item.Total_Amount)*@
                        @Math.Round(cost, 2, MidpointRounding.AwayFromZero)

                    </td>


                    <td></td>



                </tr>
            </tbody>
        </table>

    </div>

</div>




<script>
    function OnChangeEvent(obj) {


        var quantity = $(obj).val();

        var detailId = $(obj).parents('tr').find('.Details_Id').val();
        var invoiceMasterId =@Model.invoice_Id;
        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePOSDependOnquantity", "MaintenanceOrderOperational")',
                        data: { detailId: detailId, quantity: quantity, masterDiscount: masterDiscount },
                type: 'get',
            }).done(function (result) {


                $("#InvoicesDetailList").load('@(Url.Action("GetListOfOrderProduct", "MaintenanceOrderOperational"))?master_Id=' + invoiceMasterId);
                if (result == "") {

                }
                else {
                    alert(result);
                }
            }
            );

    }







</script>
<script>
    function OnChangeEventPrice(obj) {

        var price = $(obj).val()
        var detailId = $(obj).parents('tr').find('.Details_Id').val();
        var invoiceMasterId =@Model.invoice_Id;
        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePOSDependOnPrice", "MaintenanceOrderOperational")',
                        data: { detailId: detailId, price: price, masterDiscount: masterDiscount },
                type: 'get',
            }).done(function (result) {

                $("#InvoicesDetailList").load('@(Url.Action("GetListOfOrderProduct", "MaintenanceOrderOperational"))?master_Id=' + invoiceMasterId);

                if (result == "") {

                }
                else {
                    alert(result);
                }
            }
            );

    }







</script>
<script>
    function OnChangeDrop(obj) {


        var Tax = $(obj).val()

        var detailId = $(obj).parents('tr').find('.Details_Id').val();


        var invoiceMasterId =@Model.invoice_Id;

        var masterDiscount = $("#Master_Discount").val();



                    $.ajax({
                        url: '@Url.Action("updatePOSDependTax", "MaintenanceOrderOperational")',
                        data: { detailId: detailId, Tax: Tax, masterDiscount: masterDiscount },
                type: 'get',
            }).done(function (result) {

                $("#InvoicesDetailList").load('@(Url.Action("GetListOfOrderProduct", "MaintenanceOrderOperational"))?master_Id=' + invoiceMasterId);

                if (result == "") {

                }
                else {
                    alert(result);
                }
            }
        );


    }







</script>
<script>
    $(document).ready(function () {

        var detailsTotalDiscountAmount = @Math.Round((TotalBeforDiscount + tax) - TotalAmount, 2, MidpointRounding.AwayFromZero);

        var detailsTotalInvoiceAmount = @Math.Round((TotalAmount ) - Model.AllowDiscount, 2, MidpointRounding.AwayFromZero);
        $("#masterTotalDiscountAmount").html(detailsTotalDiscountAmount);

        $("#masterTotalInvoiceAmount").html(detailsTotalInvoiceAmount);
    });
</script>


