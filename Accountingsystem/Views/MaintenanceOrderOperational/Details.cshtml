                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.MaintenanceOrder.Date)
                                        </div>
                                        <div>
                                            @Model.Date.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.MaintenanceOrder.Status)
                                        </div>
                                        <div>
                                            @Accountingsystem.Models.MaintenanceStatus.getstatusById(Model.Status).Name

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Model.SerialNumber != "" && Model.SerialNumber != null)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.MaintenanceOrder.SerialNumber)
                                            </div>
                                            <div>
                                                @Html.DisplayFor(model => model.SerialNumber)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }


                    @if (Model.guaranteeDuration != null && Model.guaranteeDuration != 0)
                    {
                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.MaintenanceOrder.DateEndOfGuarentee)
                                            </div>
                                            <div>
                                                @Model.EndGuaranteeDate.Value.ToString("dd/MM/yyyy")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }


                    @if (Model.ExpectedAmount != null && Model.ExpectedAmount != 0)
                    {


                        <div class="col-md-6">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.MaintenanceOrder.ExpectedCost)
                                            </div>
                                            <div>
                                                @Math.Round( Model.ExpectedAmount.Value,2,MidpointRounding.AwayFromZero)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>


                    }
















                </div>
                <div class="row">
