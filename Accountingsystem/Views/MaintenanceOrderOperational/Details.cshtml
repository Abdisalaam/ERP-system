                                            @{
                                                var employee = Accountingsystem.Models.Employee.getEmpById(Model.Emplyee_id);
                                                @employee.Emp_Name
                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
