                            @Html.TextAreaFor(model => model.Describtion, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="text-center">
                                @Html.DisplayName(Accountingsystem.Resources.MaintenanceOrder.DeviceMalfunctionDescribtion)
                            </div>

                            @Html.TextAreaFor(model => model.RequiredDescribtion, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })

                        </div>
                    </div>


                </div>

            </div>

        </div>
        @if (!User.IsInRole("فني"))
        {

            <div class="table-responsive">
                <table class="table mb-4">
                    <thead>
                        <tr>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.Item</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.ItemNumber</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.Quantity</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.ItemPrice</th>

                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.TotalTax</th>
                            <th>@Accountingsystem.Resources.InvoiceMasterDetails.TotalAmount</th>
                            <th></th>
                        </tr>

                    </thead>
                    <tbody>
                        @foreach (var detail in Model.MaintenanceOrderOperationalDetails)
                        {
                            <tr>
                                <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_Id).Prod_Name</td>
                                <td> @Accountingsystem.Models.Product.GetProdectById(detail.Product_Id).Prod_Code</td>

                                <td>@Math.Round(detail.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>
                                <td>@Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero)</td>

                                <td>@Math.Round(detail.Detail_Total_Tax, 2, MidpointRounding.AwayFromZero)</td>
                                <td>@Math.Round(detail.Total_Amount, 2, MidpointRounding.AwayFromZero)</td>
                                @{ TotalAmountbeforeDisc += detail.Product_Quantity * detail.Product_Price;
                                    discount += (detail.Product_Quantity * detail.Product_Price) * (Model.Master_Discount.Value / 100);


                                }
                                <td>
                                    <a href="@Url.Action("Details", "Product", new { id = detail.Product_Id })" class="btn btn-block btn-outline-primary mb-lg-0">
                                        @Accountingsystem.Resources.ProductDetails.ItemDetails
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
            {

                AfterDiscount = TotalAmountbeforeDisc - discount;

            }


            <div class=''>
                <div class="row layout-top-spacing">
                    <div class="col-md-12">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Total)
                                        </div>
                                        <div>
                                            @Math.Round(TotalAmountbeforeDisc, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    @if (Model.Master_Discount > 0)
                    {
                        <div class="col-md-12">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Accountingsystem.Resources.InvoiceMasterDetails.Discount   @Math.Round(Model.Master_Discount.Value, 2, MidpointRounding.AwayFromZero) %
                                            </div>
                                            <div>
                                                @Math.Round(discount, 2, MidpointRounding.AwayFromZero)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                    @if (Model.Total_Tax > 0)
                    {
                        <div class="col-md-12">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.TotalTax)
                                            </div>
                                            <div>
                                                @Math.Round(Model.Total_Tax.Value, 2, MidpointRounding.AwayFromZero)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }

                    @if (Model.AllowDiscount != 0 && Model.AllowDiscount != null)
                    {
                        <div class="col-md-12">
                            <div class=''>
                                <div class="media  d-md-flex d-block text-sm-left text-center">
                                    <div class="media-body details-form-control mb-4">
                                        <div class="d-xl-flex d-block justify-content-between">
                                            <div class="">
                                                @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.AllouwdDiscount)
                                            </div>
                                            <div>
                                                @Math.Round(Model.AllowDiscount.Value, 2, MidpointRounding.AwayFromZero)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    }
                    <div class="col-md-12">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.FinalTotal)
                                        </div>
                                        <div>
                                            @Math.Round(Model.Total_Amount.Value, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>


            </div>

            if (Model.MaintenanceOrderOperationalStatus.Any())
            {
                <div class="row inv--product-table-section">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="">
                                    <tr>
                                        <th>@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Employee</th>
                                        <th>@Accountingsystem.Resources.MaintenanceOrder.Date</th>
                                        <th>@Accountingsystem.Resources.MaintenanceOrder.Status</th>


                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var stat in Model.MaintenanceOrderOperationalStatus)
                                    {
                                        <tr>
                                            <td>
                                                @{
                                                    var employeee = Accountingsystem.Models.Employee.getEmpById(stat.EmployeeId);
                                                    @employeee.Emp_Name
                                                }
                                            </td>
                                            <td>@stat.DateOfState.ToString("dd/MM/yyyy")</td>

                                            <td>
                                                @Accountingsystem.Models.MaintenanceStatus.getstatusById(stat.Status).Name
                                            </td>


                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
        <div class="row layout-top-spacing">
            <div class="col-md-4">
                <div class="form-group">

                  
                        @*<input id="changeState" type="button" value="Post" class="btn btn-block btn-outline-info mb-lg-2" />*@

                        <a id="newbtn" class="btn btn-block btn-outline-info mb-lg-0" href=" @Url.Action("Create")">
                            @Accountingsystem.Resources.InvoiceMasterDetails.Createnew
                            <span id="newbtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                        @if (Model.Status == 1)
                        {
                            <a id="Edit" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("Edit", new { id = Model.Id, status = 2 })">
                                @Accountingsystem.Resources.MaintenanceOrder.Technicalpreview
                                <span id="EditSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                            </a>
                        }
                        @if (Model.Status < 3)
                        {
                        <a id="Edit" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("Edit", new { id = Model.Id, status = 3 })">
                            @Accountingsystem.Resources.MaintenanceOrder.Estimatetheamountofrepair
                            <span id="EditSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                        }
                        @if (Model.Status < 4)
                        {
                        <a id="Edit" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("DeliverToCustomer", new { id = Model.Id,status =4 })">
                            @Accountingsystem.Resources.MaintenanceOrder.ReadyToDeliver
                            <span id="EditSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                        }
                        @if (Model.Status < 5)
                        {
                        <a id="Edit" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("DeliverToCustomer", new { id = Model.Id,status =5 })">
                            @Accountingsystem.Resources.MaintenanceOrder.DeliverDevice
                            <span id="EditSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                        }
                    

                   

                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <a id="PrintWhite" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("PrintMaintenanceOrderWhite", new { controller = "Reports", id = Model.Id })' target="_blank">
                        @Accountingsystem.Resources.InvoiceMasterDetails.Print
                        <span id="PrintWhiteSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>

                    </a>
                    <a id="PrintMail" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("PrintMaintenanceOrder", new { controller = "Reports", id = Model.Id })' target="_blank">
                        @Accountingsystem.Resources.InvoiceMasterDetails.PrintEmail
                        <span id="PrintMailSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                    </a>
                    <button id="PrintT" class="btn btn-block btn-outline-primary mb-lg-0 hidden-print" onclick="PrintElem()">
                        @Accountingsystem.Resources.MasterPOSInvoice.ThermalPrinting
                        <span id="PrintTSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>


                    </button>
                    <button id="PrintB" class="btn btn-block btn-outline-primary mb-lg-0 hidden-print layout-top-spacing" onclick="PrintBar()">
                        @Accountingsystem.Resources.ProductDetails.PrintTempBarcode
                        <span id="PrintBSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>

                    </button>

                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    @*<a id="RecieptSupplyOrReceiveGoods" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("PrintSalesDelivery", new { controller = "Reports", id = Model.Master_Id })'>
                            @Accountingsystem.Resources.InvoiceMasterDetails.RecieptSupplyOrReceiveGoods
                            <span id="RecieptSupplyOrReceiveGoodsSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>*@
                    <a class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("CreateForMain","MasterPOSInvoice", new { Main_Id = Model.Id})">
                        @Accountingsystem.Resources.OfferPriceMasterDetails.TransferToInvoice
                    </a>
                    @if (Request.IsAuthenticated @*&& !User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع") && !User.IsInRole("فني")*@)
                    {
                        <a id="CustomerReport" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("getListofLedgerChild", new { controller = "ReportsNew", code = Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id).Customer_Code })'>
                            @Accountingsystem.Resources.InvoiceMasterDetails.CustomerReport
                            <span id="CustomerReportSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                        <a id="CustomerDetail" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Details", new { controller = "Customer", id = Model.Customer_Id })'>
                            @Accountingsystem.Resources.InvoiceMasterDetails.CustomerDetail
                            <span id="CustomerDetailSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    }
                    <a id="BackToList" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index")">
                        @Accountingsystem.Resources.InvoiceMasterDetails.BackToList
                        <span id="BackToListSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>

                </div>
            </div>


        </div>

    </div>
</div>
