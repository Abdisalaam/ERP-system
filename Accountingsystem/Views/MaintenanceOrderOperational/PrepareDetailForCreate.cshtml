@model Accountingsystem.ViewModel.MaintenanceOrderDetailVM


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()



    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })


    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                @Html.Label(Accountingsystem.Resources.InvoiceMasterDetails.ProductOrService)
                @{ Html.EnableClientValidation(false); }

                <div class="input-group mb-4">
                    @Html.DropDownListFor(model => model.Product_Id, Model.ProductList, Accountingsystem.Resources.InvoiceMasterDetails.SelectProduct, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger"></label>
                        </div>
                        <button id="addProductBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#productModal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>



}

    <script>
        $("#Product_Id").chosen();


        $("#Product_Id_chosen").addClass("form-control Dropdownlist-select");
        $("#Product_Id").change(function (e) {
   
            AddOrder();
        });

        </script>
       