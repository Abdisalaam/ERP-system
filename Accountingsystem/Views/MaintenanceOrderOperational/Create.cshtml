                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Customer_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.MaintenanceOrder.SerialNumber)
