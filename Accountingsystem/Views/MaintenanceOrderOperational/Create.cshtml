@using (Html.BeginForm("Create", "MaintenanceOrderOperational", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        @Html.HiddenFor(model => model.Id)
