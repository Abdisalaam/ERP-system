            $("#AllowDiscount").removeClass("addRequiredFieldToInput");
        });
        $('#RequiredDescribtion').on('input', function () {
            $("#RequiredDescribtion").removeClass("addRequiredFieldToInput");
        });
       
        $('#Customer_Id').on('change', function () {
            $("#Customer_Id_chosen").removeClass("addRequiredFieldToInput");
