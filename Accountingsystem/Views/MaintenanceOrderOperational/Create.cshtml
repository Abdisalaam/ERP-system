                </div>

                @*<div class="col-md-6">
                    <div class="form-group">
                        @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.DiscountAllowedOnBill)
                        <div class="input-group">
                            @Html.EditorFor(model => model.AllowDiscount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                            @Html.ValidationMessageFor(model => model.AllowDiscount, "", new { @class = "text-danger" })
                            <div class="input-group-append">

                                <div>
                                    <span class="form-control">$</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>*@
                <div class="col-md-6">
