    </script>
    <script>
        debugger


            $("#customerPartialDialogDiv").load('@(Url.Action("PartialDialog", "MaintenanceOrderOperational"))');
            $("#productPartialDialogDiv").load('@(Url.Action("GetProductPartialDialogNoModel", "MaintenanceOrderOperational"))');
             $("#createOfferSpinner").hide();
             $("#Customer_Id").chosen();


        $("#Customer_Id_chosen").addClass("form-control Dropdownlist-select");
        $("#Emplyee_id").chosen();


        $("#Emplyee_id_chosen").addClass("form-control Dropdownlist-select");

    </script>
    <script>
         function AddOrder() {

             var Product_Id = $("#Product_Id").val();
        var Id =  $("#Id").val();
             var Customer_Id = $("#Customer_Id").val();

             var detail;
             detail = {
                 Product_Id: Product_Id,
                 Master_Id : Id,
                 CustomerID: Customer_Id
        };

        $.ajax(
         {
             url: '@Url.Action("AddInvoiceDetailsToMaster", "MaintenanceOrderOperational")',
                data: JSON.stringify(detail),
             contentType: 'application/json',
             dataType: 'json',
             type: 'POST',
                success: function (data) {
                    Snackbar.show({
                        text: data,
                        pos: 'top-center'
                    });


                    $("#InvoicesDetail").load('@(Url.Action("PrepareDetailForCreate", "MaintenanceOrderOperational"))');
                    $("#InvoicesDetailList").load('@(Url.Action("GetListOfOrderProduct", "MaintenanceOrderOperational"))?master_Id=' + Id);

             },
             error: function () { alert('error'); }
         });
        clearItem();
        updateTotals(Products_Total_Amount, Products_total_Tax);

    };
    </script>
    <script>
                $("#Master_Discount").change(function (e) {
                    var serialId = @Model.Id;
                    var selectedValue = $(this).val();

                    $.ajax({
                        url: '@Url.Action("updateDataDebendOnDiscount", "MaintenanceOrderOperational")',
                        data: { discount: selectedValue, id: serialId },
                        type: 'get',
                    }).done(function (result) {
                        $("#InvoicesDetailList").load('@(Url.Action("GetListOfOrderProduct", "MaintenanceOrderOperational"))?master_Id=' + serialId);
                    }
                    );
                });
    </script>
    <script>
        $("#AllowDiscount").change(function (e) {
                    var serialId = @Model.Id;
                var selectedValue = $(this).val();

                    $.ajax({
                        url: '@Url.Action("updateDataDebendOnAlowDiscount", "MaintenanceOrderOperational")',
                        data: { discount: selectedValue, id: serialId },
                        type: 'get',
                    }).done(function (result) {

                        $("#InvoicesDetailList").load('@(Url.Action("GetListOfOrderProduct", "MaintenanceOrderOperational"))?master_Id=' + serialId);
                    }
                    );
                });

    </script>
    <script>
        function DeleteTemp(e) {
            var ids = e;
                     var serialId = @Model.Id;
            $.ajax({
                url: '@Url.Action("DeleteTempDetail", "MaintenanceOrderOperational")',
                type: 'get',
                data: { iD:ids}
            }).done(function (result) {
                Snackbar.show({
                    text: '@Accountingsystem.Resources.validate.DeleteSuccessful',
                    pos: 'top-center'
                });
                $("#InvoicesDetailList").load('@(Url.Action("GetListOfOrderProduct", "MaintenanceOrderOperational"))?master_Id=' + serialId);


            });
        }
    </script>

    <script>

