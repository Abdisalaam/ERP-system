@model Accountingsystem.ViewModel.CurrencyVM

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()



    <div class="col-md-5">
        <div class="Dropdownlist">
            @Html.DropDownListFor(model => model.Comp_Currency_Id, Model.MyCurrencyList, Accountingsystem.Resources.CompanyEdit.SelectCurrency, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
            @Html.ValidationMessageFor(model => model.Comp_Currency_Id, "", new { @class = "text-danger" })
        </div>
    </div>
    <span class="required-mark col-md-1">*</span>
    <div class="btn Hint col-md-1" data-toggle="tooltip" data-placement="top" title=@Accountingsystem.Resources.CompanyEdit.SelectCurrency>
        <i class="fas fa-question-circle"></i>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.PrintReports.Currency)

        </div>
    </div>


}


