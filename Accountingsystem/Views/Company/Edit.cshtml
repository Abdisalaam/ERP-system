    <script>
    function addCurrency() {

        var Currency_Type = $("#Currency_Type").val();
        var Currency_Country = $("#Currency_Country").val();
        var Currency_ISO = $("#Currency_ISO").val();

        var currencyVM;
        currencyVM = {
            Currency_Type: Currency_Type,
            Currency_Country: Currency_Country,
            Currency_ISO: Currency_ISO
        };
        $.ajax(
         {
            url: "@Url.Action("AddNewCurrency", "Company")",
                data: JSON.stringify(currencyVM),
             contentType: 'application/json',
             dataType: 'json',
             type: 'POST',
             success: function (data) {
                 alert(data);
                    $("#partialDialogDiv").dialog("close");
                    $("#GetCurrencyDropdownList").load('@(Url.Action("GetCurrencyDropdownList", "Company"))');

             },
             error: function () { alert('error'); }
         });
    };


    </script>

    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            //var a = $.datepicker.parseDate('dd-mm-yy',('#StartFinancialDate').val());
            var c = $('#EndFinancialDate').val();
            var enddate = new Date($('#EndFinancialDate').val().replace(/(\d{2})-(\d{2})-(\d{4})/, "$2/$1/$3"))
            var startdate = new Date($('#StartFinancialDate').val().replace(/(\d{2})-(\d{2})-(\d{4})/, "$2/$1/$3"))

            if ($('#Comp_Name').val() == "" || $('#Comp_Name').val() == null /*|| $('#Comp_Name').val().length > 45*/
                || $('#StartFinancialDate').val() == "" || $('#StartFinancialDate').val() == null || $('#EndFinancialDate').val() == "" || $('#EndFinancialDate').val() == null || enddate <= startdate) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($('#Comp_Name').val() == "" || $('#Comp_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CompanyEdit.EnterCompanyName",
                        pos: 'top-center'
                    });
                    $("#Comp_Name").addClass("addRequiredFieldToInput");
                    $('#Comp_Name').trigger('focus');
                }
                 @*if ($('#Comp_Name').val().length > 45) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CompanyEdit.NameisLong",
                        pos: 'top-center'
                    });
                    $("#Comp_Name").addClass("addRequiredFieldToInput");
                    $('#Comp_Name').trigger('focus');
                }*@

                if ($('#StartFinancialDate').val() == "" || $('#StartFinancialDate').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CompanyEdit.EnterFinancialPeriodStartDate",
                        pos: 'top-center'
                    });
                    $("#StartFinancialDate").addClass("addRequiredFieldToInput");
                    $('#StartFinancialDate').trigger('focus');
                }
                if ($('#EndFinancialDate').val() == "" || $('#EndFinancialDate').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CompanyEdit.EnterFinancialPeriodEndDate",
                        pos: 'top-center'
                    });
                    $("#EndFinancialDate").addClass("addRequiredFieldToInput");
                    $('#EndFinancialDate').trigger('focus');
                }

                if (enddate <= startdate) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.CompanyEdit.ErrorValidation",
                        pos: 'top-center'
                    });
                    $("#EndFinancialDate").addClass("addRequiredFieldToInput");
                    $('#EndFinancialDate').trigger('focus');

                }





                event.preventDefault();
            }



        });

    </script>

