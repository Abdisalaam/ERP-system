@model Accountingsystem.ViewModel.CompDeptVM

@{
    ViewBag.Title = Accountingsystem.Resources.CompanyDepartmentsCreate.CreateNewDepartment;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@Accountingsystem.Resources.CompanyDepartmentsCreate.CreateNewDepartment</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @*<h4>CompDeptVM</h4>*@
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.CompanyDepartmentsIndex.CompanyName)
            <div class="col-md-10">
                @Html.EditorFor(model => model.Company_Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Company_Name, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.CompanyDepartmentsIndex.DepartmentNumber)
            <div class="col-md-10">
                @Html.EditorFor(model => model.CompDept_Code, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CompDept_Code, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.CompanyDepartmentsCreate.CompanyDepartmentName)
            <div class="col-md-10">
                @Html.EditorFor(model => model.CompDept_Name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CompDept_Name, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.CompanyDepartmentsCreate.CompanyDepartmentPhone)
            <div class="col-md-10">
                @Html.EditorFor(model => model.CompDept_Phone, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CompDept_Phone, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label(Accountingsystem.Resources.CompanyDepartmentsCreate.CompanyDepartmentDescription)
            <div class="col-md-10">
                @Html.EditorFor(model => model.CompDept_Description, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.CompDept_Description, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value=@Accountingsystem.Resources.CompanyDepartmentsCreate.CreateDepartment class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink(Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList, "Index")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
