@Html.AntiForgeryToken()

@Html.ValidationSummary(true, "", new { @class = "text-danger" })


@using (Html.BeginForm("ApprovfoVacation", "Vacations", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(model => model.Employee_Id)
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Vacation_Id)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.VacationsCreate.ApproveVacation)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationsCreate.VacationStartDate)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.Start_Date_Vacations, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Start_Date_Vacations, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationsCreate.VacationEndDate)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.End_Date_Vacations, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.End_Date_Vacations, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationsCreate.VacationType)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Vacation_Type_Id, Model.VacationTypeList, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Vacation_Type_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            

                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationsCreate.VacationReason)
                                    @Html.TextAreaFor(model => model.Reason, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = "السبب" })
                                    @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.VacationsCreate.Notes)
                                    @Html.TextAreaFor(model => model.MangerDescription, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = "السبب" })
                                    @Html.ValidationMessageFor(model => model.MangerDescription, "", new { @class = "text-danger" })
                                </div>
                            </div>





                        </div>
                    </div>
                </div>

            </div>

            <div class="col-md-12">
                <div class="form-group">

                    @if (Model.AttachmentByte != null)
                    {
                        <a href="@Url.Action("ReturnVacationFile", new { id = Model.Vacation_Id })" class="btn btn-block btn-outline-secondary mb-lg-0">
                            @Accountingsystem.Resources.VacationsCreate.Attachments
                        </a>
                    }
                    @using (Html.BeginForm("ApprovfoVacation", "Vacations", FormMethod.Post))
                    {
                        // Html code here
                        <input type="submit" id="aprove" formaction="ApprovfoVacation" name="submitbutton1" value=@Accountingsystem.Resources.VacationsCreate.Approval class="btn btn-block btn-outline-primary mb-lg-0" />
                        <input type="submit"id="refuse" formaction="RefusefoVacation" name="submitbutton2" value=@Accountingsystem.Resources.VacationsCreate.Refusal class="btn btn-block btn-outline-secondary mb-lg-0" />

                    }
                    <a id="backToListBtn" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("IndexOfPenddingVac")">
                       @Accountingsystem.Resources.VacationsCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>


                </div>
            </div>
        </form>

    </div>

}
