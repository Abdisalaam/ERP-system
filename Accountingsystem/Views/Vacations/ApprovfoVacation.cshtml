    <script>


        $('#Start_Date_Vacations').on('input', function () {
            $("#Start_Date_Vacations").removeClass("addRequiredFieldToInput");
        });
        $('#End_Date_Vacations').on('input', function () {
            $("#End_Date_Vacations").removeClass("addRequiredFieldToInput");
        });
        $('#Vacation_Type_Id').on('input', function () {
            $("#Vacation_Type_Id").removeClass("addRequiredFieldToInput");
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#aprove').prop('disabled', true);
            $('#refuse').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#Start_Date_Vacations').val() == "" || $('#Start_Date_Vacations').val() == null ||
                $('#End_Date_Vacations').val() == "" || $('#End_Date_Vacations').val() == null ||
                $('#Vacation_Type_Id').val() == "" || $('#Vacation_Type_Id').val() == null
            ) {
                $('#aprove').prop('disabled', false);
                $('#refuse').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#Start_Date_Vacations').val() == "" || $('#Start_Date_Vacations').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationsCreate.EnterVacationStartDate",
                        pos: 'top-center'
                    });
                    $("#Start_Date_Vacations").addClass("addRequiredFieldToInput");
                    $('#Start_Date_Vacations').trigger('focus');
                }
                if ($('#End_Date_Vacations').val() == "" || $('#End_Date_Vacations').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationsCreate.EnterVacationEndDate",
                        pos: 'top-center'
                    });
                    $("#End_Date_Vacations").addClass("addRequiredFieldToInput");
                    $('#End_Date_Vacations').trigger('focus');
                }
                if ($('#Vacation_Type_Id').val() == "" || $('#Vacation_Type_Id').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.VacationsCreate.VacationTypeValidation",
                        pos: 'top-center'
                    });

                    $("#Vacation_Type_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Vacation_Type_Id_chosen span').css('background', 'red');
                    $('#Vacation_Type_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Vacation_Type_Id").offset().top
                    }, 2000);
                }

                $("#createOfferSpinner").hide();
                event.preventDefault();
            }


        });

    </script>

