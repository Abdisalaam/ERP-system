@model IEnumerable<Accountingsystem.Models.Currency>
@{
    ViewBag.Title = Accountingsystem.Resources.CurrencyIndex.CurrencyList;
    HttpCookie cookie = Request.Cookies["Language"];
    var msg = ViewBag.Message;
    var count = 1;

}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }




</head>
<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
   
    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div class="text-center">
            @Accountingsystem.Resources.CurrencyIndex.CurrencyList
        </div>

        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.CurrencyIndex.Number)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.CurrencyIndex.CurrencyArabic)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.CurrencyIndex.CurrencyEnglish)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.CurrencyIndex.CountryCurrency)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.CurrencyIndex.ShortcutArabic)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.CurrencyIndex.ShortcutEnglish)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @count
                                @{count = count + 1;}
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Currency_Type)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Currency_Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Currency_Country)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Currency_ISO)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Currency_Iso2)
                            </td>
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                        <a class="dropdown-item" href="@Url.Action("Edit", new { id = item.Currency_Id })">
                                            @Accountingsystem.Resources.CurrencyIndex.Edit
                                        </a>
                                        <a class="dropdown-item" href="@Url.Action("Details", new { id = item.Currency_Id })">
                                            @Accountingsystem.Resources.CurrencyIndex.Details
                                        </a>                                       
                                    </div>
                                </div>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>


@section Scripts {

    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/dataTables.buttons.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/jszip.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/buttons.html5.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/buttons.print.min.js")"></script>
                <script>
                    $('#default-ordering').DataTable({
                        "oLanguage": {
                            "oPaginate": { "sPrevious": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-right"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>', "sNext": '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-left"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>' },
