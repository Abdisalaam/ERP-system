@model Accountingsystem.ViewModel.Emp_EvaluationVM

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>تقييم الموظف</h2>


@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
     
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
     

        <div class="container">
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Evaluation_Days, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Evaluation_Days, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(model => model.Evaluation_Days,"عدد الايام", htmlAttributes: new { @class = "control-label" })

                        </div>
                    </div>

                </div>
                <div class="col-md-5">
                    <div class="col-md-5">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Evaluation_Date, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Evaluation_Date, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-5">

                        <div class="form-group">
                            @Html.LabelFor(model => model.Evaluation_Date, "التاريخ", htmlAttributes: new { @class = "control-label" })

                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.DropDownListFor(model => model.Employee_Id, Model.EmpList, "اختر الموظف", htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.Employee_Id, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            @Html.LabelFor(model => model.Employee_Id,"اختر الموظف" ,htmlAttributes: new { @class = "control-label" })

                        </div>
                    </div>

                </div>
                <div class="col-md-5">
                    <div class="col-md-5">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.Reference, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            @Html.LabelFor(model => model.Reference, "المرجع", htmlAttributes: new { @class = "control-label" })

                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="Dropdownlist">
                            @Html.EnumDropDownListFor(model => model.Evaluation_State, "مكافئة ام خصم", htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.Evaluation_State, "", new { @class = "text-danger" })
                        </div>

                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            @Html.LabelFor(model => model.Evaluation_State, "مكافئة ام خصم", htmlAttributes: new { @class = "control-label" })

                        </div>
                    </div>

                </div>
            </div>
            </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="انشاء" class="btn btn-primary" />
            </div>
        </div>
      
    </div>
}

@*<div>
    @Html.ActionLink("Back to List", "Index")
</div>*@
<div class="container">
    <div class="row">
        <div class="form-group">
            <div class="col-md-12">
                <div class="col-md-6">
                    <a class="btn btn-primary" href='@Url.Action("Index")'>
                        العودة
                    </a>
                </div>            

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
