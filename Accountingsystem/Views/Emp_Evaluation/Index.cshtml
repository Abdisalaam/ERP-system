@model IEnumerable<Accountingsystem.Models.Emp_Evaluation>

<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/v/dt/dt-1.10.18/datatables.min.css" />

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>قائمة التقييم</h2>

<p>
    @Html.ActionLink("انشاء تقييم", "Create")
</p>
<div class="widget">
    <div class="table-responsive">
        <table data-sortable="" class="table" data-sortable-initialized="true"id="sasa">
            
                <thead>
                    <tr>

                        <th class="col-md-1">
                            @Html.DisplayName("عدد الايام")
                        </th>
                        <th class="col-md-1">
                            @Html.DisplayName("حالة التقييم")
                        </th>
                        <th class="col-md-1">
                            @Html.DisplayName("قيمة التقييم")
                        </th>
                        <th class="col-md-1">
                            @Html.DisplayName("اسم الموظف")
                        </th>
                        <th class="col-md-1">
                            @Html.DisplayName("تاريخ التقييم")
                        </th>
                        <th class="col-md-1">
                            @Html.DisplayName("مرجع")
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td class="col-md-1">
                                @Html.DisplayFor(modelItem => item.Evaluation_Days)
                            </td>
                            <td class="col-md-1">
                                @Html.DisplayFor(modelItem => item.Evaluation_State)
                            </td>
                            <td class="col-md-1">
                                @Html.DisplayFor(modelItem => item.Evaluation_Amount)
                            </td>
                            <td class="col-md-1">
                                @Html.DisplayFor(modelItem => item.Employee.Emp_Name)
                            </td>
                            <td class="col-md-1">
                                @Html.DisplayFor(modelItem => item.Evaluation_Date)
                            </td>
                            <td class="col-md-1">
                                @Html.DisplayFor(modelItem => item.Reference)
                            </td>
                            <td class="col-md-1">
                                <div class="container">
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-md-12">
                                                <div class="col-md-6">
                                                    <a class="btn btn-primary" href='@Url.Action("Edit", new { id=item.Evaluation_Id})'>
                                                        تعديل
                                                    </a>
                                                </div>
                                                <div class="col-md-6">
                                                    <a class="btn btn-primary" href='@Url.Action("Details" , new { id=item.Evaluation_Id})'>
                                                        الفاصيل
                                                    </a>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

            @section Scripts {

                @Scripts.Render("~/bundles/jqueryval")


                <script type="text/javascript" src="https://cdn.datatables.net/v/dt/dt-1.10.18/datatables.min.js"></script>
                <script>

                    $(document).ready(function () {
                        $('#sasa').DataTable();
                    });
                </script>
            }
