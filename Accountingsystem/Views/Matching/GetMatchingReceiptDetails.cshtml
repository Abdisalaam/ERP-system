@model Accountingsystem.ViewModel.MatchingReceiptDetailsVM



<h2>تفاصيل الايصال</h2>

<div class="widget">
    <div class="table-responsive">
        <table data-sortable="" class="table" data-sortable-initialized="true">

            <tr>
                <td class="col-md-2">
                    @Html.DisplayFor(model => model.Rec_Number)
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("كود السند")
                </th>


                <td class="col-md-2">
                    @{var company = Accountingsystem.Models.Company.GetCompanyById(Model.RecComp_ID).Comp_Name;
                        <h>@company</h> }
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("اسم الشركة")
                </th>

            </tr>

            <tr>

                <td class="col-md-2">
                    @Html.DisplayFor(model => model.Rec_Amount)
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("قيمة الايصال")
                </th>

                <td class="col-md-2">
                    @Html.DisplayFor(model => model.Rec_Date)
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("تاريخ الايصال")
                </th>
            </tr>

            <tr>
                <td id="Rec_state">
                    @Html.DisplayFor(model => model.Rec_state)
                </td>

                <th class="col-md-2">
                    @Html.DisplayName("حالة الايصال")
                </th>

                <td class="col-md-2">
                    @Html.DisplayFor(model => model.RecCurrency_ID)
                </td>

                <th class="col-md-2">
                    @Html.DisplayName("العملة")
                </th>
            </tr>

            <tr>

                <td class="col-md-2">
                    @Html.DisplayFor(model => model.TotalAmountAfMat)
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("قيمة الايصال بعد خصمه من الفاتورة")
                </th>




                <td class="col-md-2">
                    @{var account = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount(Model.RecBank_Account).Account_Name;
                        <h>@account</h> }
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("اسم الحساب")
                </th>
            </tr>

            <tr>
                <td class="col-md-2">
                    @{var customer = Accountingsystem.Models.Customer.GetCustomerById(Model.Customer_Id).Customer_Name;
                        <h>@customer</h> }
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("اسم العميل")
                </th>

                <td class="col-md-2">
                    @Html.DisplayFor(model => model.Rec_Description)
                </td>
                <th class="col-md-2">
                    @Html.DisplayName("وصف الايصال ")
                </th>
            </tr>


        </table>
    </div>
</div>


