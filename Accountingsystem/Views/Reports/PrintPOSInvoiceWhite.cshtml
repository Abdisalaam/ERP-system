@model Accountingsystem.ViewModel.PrintVM.PrintMasterPOSInvoiceVM

@{
    Layout = null;

    decimal totals = 0;
    decimal totalbeforTax = 0;
    decimal totalaftertax = 0;
    decimal totaltaxes = 0;
    decimal totalafterFixed = 0;
    var branch = Accountingsystem.Models.Branch.getAddressForInvoice(Model.branchId);
    Layout = null;
    int counter = 1;

}
<!DOCTYPE html>


<html>



<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
    <!-- Bootstrap CSS -->
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }

        .column {
            float: left;
            width: 50%;
            padding: 5px;
        }



        .tho {
            text-align: left;
            padding: 16px;
        }

        * {
            box-sizing: border-box;
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>

    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <title> فاتورة ضريبية </title>
</head>
<body>

    <div class="container">
        
        <div style="text-align: center;">

            <text style="text-align: center;  font-size:30px;">فاتورة ضريبية  | Tax Invoice  </text>

        </div>

        <br />
        <div class="row">
            <div id="header" style="height:15%;width:100%;">

                <div style='float:left'>
                    <table width="500" border="1" @*style="margin-left:10%;"*@>
                        <tr>
                            <th style="text-align:center; padding-top:0px">
                                Invoice NO
                            </th>
                            <td style="text-align:center; padding-top:0px">
                                @Model.Serial_Number     - 0 @Model.POSId
                            </td>
                            <th style="text-align:center; padding-top:0px">
                                رقم الفاتورة
                            </th>



                        </tr>

                        <tr>
                            <th style="text-align:center; padding-top:0px">
                                Currency
                            </th>
                            <td style="text-align:center; padding-top:0px">
                                ريال سعودي
                            </td>
                            <th style="text-align:center; padding-top:0px">
                                العملة
                            </th>



                        </tr>



                    </table>
                    <br />
                    <table width="500" border="1" @*style="margin-left:10%;"*@>
                        <tr>
                            <th style="text-align:center; padding-top:0px">
                                Invoice Date
                            </th>
                            <td style="text-align:center; padding-top:0px">
                                @Convert.ToDateTime(Model.Invoice_Date).ToString("dd-MM-yyyy")
                            </td>
                            <th style="text-align:center; padding-top:0px">
                                تاريخ الفاتورة
                            </th>



                        </tr>






                    </table>
                </div>
                @if (Model.barcode != 0 && Model.barcode != null)
                {
                    <div style=' text-align:center; '>
                        <img src="data:image/bmp;base64,@Convert.ToBase64String(@Accountingsystem.Models.TLVCls.GenerateInvoiceQR(Model.barcode)))" alt="Image" style="width:200px" />
                        @*<img src="data:image/bmp;base64,@Accountingsystem.Models.TLVCls.GenerateInvoiceQR(Model.barcode))" alt="Image"  />*@
                    </div>
                }
            </div>
        </div>
    </div>

    <br />


    <table width="1100" border="1" style="text-align:right;">
        <tr>

            <th style="text-align:center;border-right:hidden; padding-top:0px">
                Seller
            </th>

            <td style="text-align:center;border-right:hidden;width:200px; padding-top:0px"></td>
            <th style="text-align:center;border-right:hidden; padding-top:0px">
                المورد
            </th>
            <th style="text-align:center;border-right:hidden;padding-top:0px">
                Buyer
            </th>

            <td style="text-align:center;border-right:hidden;width:200px; padding-top:0px"></td>
            <th style="text-align:center; padding-top:0px">
                العميل
            </th>
        </tr>
        <tr>

            <th style="text-align:center; padding-top:0px">
                Seller Name
            </th>

            <td style="text-align:center;  padding-top:0px">
                @Model.EmployeeName
            </td>
            <th style="text-align:center; padding-top:0px">
                اسم البائع
            </th>
            <th style="text-align:center; padding-top:0px">
                Name
            </th>

            <td style="text-align:center; padding-top:0px">
                @Model.customer_Name
            </td>
            <th style="text-align:center; padding-top:0px">
                الاسم
            </th>
        </tr>
        <tr>

            <th style="text-align:center; padding-top:0px">
                VAT Number
            </th>

            <td style="text-align:center; padding-top:0px">
                @Model.company.Tax_Number
            </td>
            <th style="text-align:center; padding-top:0px">
                رقم تسجيل ضريبة القيمة المضافة

            </th>
            <th style="text-align:center; padding-top:0px">
                VAT Number
            </th>

            <td style="text-align:center;  padding-top:0px">
                @Model.customer_Tax
            </td>
            <th style="text-align:center; padding-top:0px">
                رقم تسجيل ضريبة القيمة المضافة
            </th>
        </tr>
        <tr>

            <th style="text-align:center; padding-top:0px">
                Phone
            </th>

            <td style="text-align:center; padding-top:0px">
                @branch.Branch_Phone
            </td>
            <th style="text-align:center; padding-top:0px">
                الهاتف
            </th>
            <th style="text-align:center; padding-top:0px">
                Phone
            </th>

            <td style="text-align:center;  padding-top:0px">
                @Model.customerPhone
            </td>
            <th style="text-align:center; padding-top:0px">
                الهاتف
            </th>
        </tr>
        <tr>

            <th style="text-align:center; padding-top:0px">
                Address
            </th>

            <td style="text-align:center; padding-top:0px">
                @branch.Branch_Address
            </td>
            <th style="text-align:center; padding-top:0px">
                العنوان
            </th>
            <th style="text-align:center; padding-top:0px">
                Address
            </th>
            @if (Model.customerId > 0)
            {
                <td style="text-align:center;  padding-top:0px">

                    @Accountingsystem.Models.Customer.GetCustomerById(Model.customerId).Customer_Address
                </td>
            }
            else
            {
                <td style="text-align:center;  padding-top:0px"></td>

            }
            <th style="text-align:center; padding-top:0px">
                العنوان
            </th>
        </tr>

        @*<tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.customerPhone
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    جوال
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @branch.Branch_Phone
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    جوال
                </th>

            </tr>


            <tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.CustomerTax
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    رقم الضريبى للعميل
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.company.Tax_Number
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    رقم الضريبى للشركة
                </th>


            </tr>
            <tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.customerEmail
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    البريد الالكترونى
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.company.Comp_Email
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                 البريد الالكتروني
                </th>
            </tr>
            <tr>
                <td style="text-align:right;border-bottom:hidden; padding-top:0px">
                    @Model.customerTel
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    هاتف
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.EmployeeName
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    الموظف
                </th>



            </tr>*@



    </table>
    <br />


    @if (Accountingsystem.Utilites.PackageRecognize.checkLanguage(Model.Description) == true)
    {

        <div style="text-align: right;">
            <span style="white-space: pre-line" dir="rtl" ;>@Model.Description</span>
        </div>
    }
    else
    {
        <div style="text-align: left;">
            <span style="white-space: pre-line" dir="ltr" ;>@Model.Description</span>
        </div>
    }

    <div>
        <table class="table" style="text-align:right; direction:rtl">
            <thead>
                <tr style="text-align:right;">

                    <th style="text-align:right">NatureOfGoodsOrServices<br />تفاصيل السلع و الخدمات</th>
                    @if (Model.POSInvoiceDetail.Where(a => a.MeasureUnit != null && a.MeasureUnit != "").Count() > 0)
                    {
                        <th style="text-align:right">MeasureUnit<br />وحدة القياس</th>
                    }
                    @if (Model.POSInvoiceDetail.Where(a => a.Product_Model != null && a.Product_Model != "").Count() > 0)
                    {
                        <th style="text-align:right">Model No<br />رقم الموديل</th>
                    }
                    <th style="text-align:right">Unit Price<br />سعر الوحدة</th>
                    <th style="text-align:right">Quantity <br />الكمية</th>
                    <th style="text-align:right">Taxable Amount <br />المبلغ الخاضع للضريبة</th>
                    @if (Model.Master_Discount > 0)
                    {
                        <th style="text-align:right">Discount Rate <br />نسبة الخصم</th>
                        <th style="text-align:right">Discount Amount <br />مبلغ الخصم</th>
                    }
                    <th style="text-align:right">Tax Rate <br />نسبة الضريبة</th>
                    <th style="text-align:right">Tax Amount <br />مبلغ الضريبة</th>
                    <th style="text-align:right">Item SubTotal(Including VAT) <br />المجموع شامل الضريبة</th>

                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model.POSInvoiceDetail)
                {
                    <tr>
                        <td>

                            @item.Product_Code @item.Product_Name

                        </td>
                        @if (Model.POSInvoiceDetail.Where(a => a.MeasureUnit != null && a.MeasureUnit != "").Count() > 0)
                        {
                            <td>
                                @item.MeasureUnit
                            </td>
                        }
                        @if (Model.POSInvoiceDetail.Where(a => a.Product_Model != null && a.Product_Model != "").Count() > 0)
                        {
                            <td>
                                @item.Product_Model
                            </td>
                        }
                        <td>
                            @String.Format("{0:n}", Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero))
                        </td>
                        <td>

                            @String.Format("{0:n}", Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero))
                        </td>

                        <td>
                            @String.Format("{0:n}", Math.Round(item.Total_Amount_Detail - item.Total_Tax, 2, MidpointRounding.AwayFromZero))
                        </td>
                        @if (Model.Master_Discount > 0)
                        {
                            if (item.Detail_Discount != null)
                            {
                                <td>
                                    @String.Format("{0:n}", Math.Round(item.Detail_Discount.Value, 2, MidpointRounding.AwayFromZero))
                                </td>
                                <td>
                                    @String.Format("{0:n}", Math.Round(item.Detail_Discount_Amount.Value, 2, MidpointRounding.AwayFromZero))
                                </td>
                            }
                            else
                            {
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                            }
                        }
                        @if (item.tax != null)
                        {
                            <td>

                                @item.tax.Tax_Percentage%

                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>

                            @String.Format("{0:n}", Math.Round(item.Total_Tax, 2, MidpointRounding.AwayFromZero))
                        </td>
                        <td>

                            @String.Format("{0:n}", Math.Round(item.Total_Amount_Detail, 2, MidpointRounding.AwayFromZero))
                        </td>


                    </tr>
                    if (string.IsNullOrEmpty(item.Product_Description))
                    {





                    }
                    else
                    {
                        <tr dir="rtl">
                            <td style="border-top-style:hidden" colspan="7"> <span style="white-space: pre-line" dir="ltr" ;>@item.Product_Description</span></td>
                        </tr>
                    }
                    counter++;
                    totals = totals + (item.Product_Quantity * item.Product_Price);
                    totalbeforTax = totalbeforTax + item.amountBeforeTax;
                    totalaftertax = totalaftertax + item.Total_Amount_Detail;
                    totaltaxes = totaltaxes + item.Total_Tax;
                }

            </tbody>
        </table>
    </div>

    <div>
        <table width="1100" style="text-align:right;">
            @{
                var totalstr = "الاجمالي(غير شامل ضريبة القيمة المضافة";
                var taxable = "الاجمالي الخاضع للضريبة(غير شامل ضريبة القيمة المضافة";
            }
            <thead>
                <tr style="text-align:right;">


                    <td style="text-align:center;width:300px"> @String.Format("{0:n}", Math.Round(totals, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right" width="400px">Total(Excluding VAT)</td>
                    <td style="text-align:right" width="400px">(@totalstr </td>

                </tr>
                @if (Model.Master_Discount > 0)
                {
                    <tr style="text-align:right;">


                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(Model.Master_Discount, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right"> @Math.Round(Model.PercentgeMasterDiscount, 2, MidpointRounding.AwayFromZero)%Discount</td>
                        <td style="text-align:right">  @Math.Round(Model.PercentgeMasterDiscount, 2, MidpointRounding.AwayFromZero)%مجموع الخصومات</td>

                    </tr>
                }
                <tr style="text-align:right;">


                    <td style="text-align:center">@String.Format("{0:n}", Math.Round(Model.POSInvoiceDetail.Where(a => a.tax != null).Select(a => a.amountBeforeTax).Sum() - Model.POSInvoiceDetail.Where(a => a.tax != null).Select(a => a.discount).Sum(), 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right">Total Taxable Amount(Excluding VAT)</td>
                    <td style="text-align:right"> (@taxable</td>

                </tr>

                @foreach (var detailTax in Model.POSInvoiceDetail.Where(a => a.tax != null).Select(a => a.tax).Distinct())
                {
                <tr style="text-align:right;">


                    <td style="text-align:center">@String.Format("{0:n}", Math.Round(Model.POSInvoiceDetail.Where(a => a.tax == detailTax).Select(a => a.Total_Tax).Sum(), 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right">Total VAT @detailTax.Tax_Percentage %</td>
                    <td style="text-align:right">@detailTax.Tax_Percentage %   @detailTax.Tax_Name  مجموع </td>

                </tr>
                }

                @foreach (var tax in Model.Taxes)
                {
                    <tr style="text-align:right;">
                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(tax.Amount, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total VAT</td>
                        <td style="text-align:right">@tax.TaxName</td>
                    </tr>
                }
                @if (Model.AllowDiscount > 0)
                {
                    <tr style="text-align:right;">
                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(Model.AllowDiscount, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Additional Discount</td>
                        <td style="text-align:right">خصم مسموح به</td>
                    </tr>
                }
                <tr style="text-align:right;">


                    <td style="text-align:center;font-weight:900"> @String.Format("{0:n}", Math.Round(((totalaftertax + Model.NewTaxTotal) - Model.AllowDiscount), 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right;font-weight:900">Net inclusive of VAT</td>
                    <td style="text-align:right;font-weight:900">الصافي شامل ضريبة القيمة المضافة</td>

                </tr>
                @if (Model.ReceiptList != null)
                {
                    if (Model.ReceiptList.ToList().Count() > 0)
                    {

                        var recieptAmount = Model.ReceiptList.Select(a => a.Rec_Amount).Sum();
                        <tr style="text-align:right;">


                            <td style="text-align:center"> @String.Format("{0:n}", Math.Round(recieptAmount, 2, MidpointRounding.AwayFromZero))</td>
                            <td style="text-align:right">Total Amount Paid </td>
                            <td style="text-align:right">المبلغ المدفوع</td>

                        </tr>
                        <tr style="text-align:right;">


                            <th style="text-align:center">@String.Format("{0:n}", Math.Round((((totalaftertax + Model.NewTaxTotal) - Model.AllowDiscount)) - recieptAmount, 2, MidpointRounding.AwayFromZero))</th>
                            <th style="text-align:right">Total Remaining Amount </th>
                            <th style="text-align:right">المبلغ المتبقي</th>

                        </tr>
                    }
                }
                @if (Model.POSPaymentDetail.Count() > 0)
                {
                    <tr style="text-align:right;">


                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(((totalaftertax + Model.NewTaxTotal) - Model.AllowDiscount), 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total Amount Paid </td>
                        <td style="text-align:right">المبلغ المدفوع</td>

                    </tr>
                    foreach (var item in Model.POSPaymentDetail)
                    {
                        <tr>

                            <td style="text-align:center">@String.Format("{0:n}", Math.Round(item.Amount, 2, MidpointRounding.AwayFromZero))</td>
                            <td style="text-align:right">paymentMethod</td>
                            <td style="text-align:right">@item.Payment_Name طريقة الدفع</td>



                        </tr>

                    }
                    <tr style="text-align:right;">


                        <th style="text-align:center">0</th>
                        <th style="text-align:right">Total Remaining Amount </th>
                        <th style="text-align:right">المبلغ المتبقي</th>

                    </tr>

                }
            </thead>

        </table>
    </div>

    <br />

    @if (Accountingsystem.Utilites.PackageRecognize.checkLanguage(Model.Notes) == true)
    {

        <div style="text-align: right;">
            <span style="white-space: pre-line" dir="rtl" ;>@Model.Notes</span>
        </div>
    }
    else
    {
        <div style="text-align: left;">
            <span style="white-space: pre-line" dir="ltr" ;>@Model.Notes</span>
        </div>
    }
    <footer style="margin-top:0%;"></footer>

</body>







</html>

