@model Accountingsystem.ViewModel.ReportsVM.IncomeStatementVM






@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.ReportsGetAllReportfinancial.LossesAndProfit;
    var dateto = "الي" + Convert.ToDateTime(Model.To_Date).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.From_Date).ToString("yyyy/MM/dd ");
}


<head>
    @{
        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }
</head>





<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">
                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "GetDateOfIncomePdf")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>PDF</a>
                                        </div>
                                    </li>

                                    <li>
                                        <div class="dropdown-item">
                                            <a href='@Url.Action("GetDateOfIncomeExcel")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>Excel</a>
                                        </div>
                                    </li>
                                </ul>

                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.ReportsGetAllReportfinancial.LossesAndProfit
        </div>
        <div class="text-center">
            @datefrom      @dateto

        </div>

        <div class="text-center">
            الايرادات | Revenue
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table class="table" style="text-align:center;direction:ltr;">
                <tr>
                    <th style="color:#e6840f">
                        القيمة<br /> Value
                    </th>
                   <th style="color:#e6840f">
                        الحساب<br /> Account
                    </th>

                </tr>

                @foreach (var item in Model.Account_Revenue)
                {
                    <tr>
                        @if (@Math.Round(item.difference, 2, MidpointRounding.AwayFromZero) == 0)
                        {

                        }
                        else
                        {
                            if (@Math.Round(item.difference, 2, MidpointRounding.AwayFromZero) >= 0)
                            {
                                <td>
                                    @Math.Round(item.difference, 2, MidpointRounding.AwayFromZero)

                                </td>
                            }
                            else
                            {
                                var dif = item.difference * -1;
                                <td>
                                    (@Math.Round(dif, 2, MidpointRounding.AwayFromZero))

                                </td>
                            }
                            <td>
                                @item.Account_Name
                            </td>
                        }

                    </tr>



                }
                <tr>
                    @if (@Math.Round(Model.Total_Revenue, 2, MidpointRounding.AwayFromZero) >= 0)
                    {
                          <th style="color:#e6840f">
                            @Math.Round(Model.Total_Revenue, 2, MidpointRounding.AwayFromZero)
                        </th>
                    }
                    else
                    {
                          <th style="color:#e6840f">
                            (@Math.Round(Model.Total_Revenue * -1, 2, MidpointRounding.AwayFromZero))
                        </th>
                    }
                      <th style="color:#e6840f">
                        الاجمالي | Total
                    </th>


                </tr>
            </table>
        </div>


        <div class="text-center">
            تكلفة المبيعات | Cost Of Sales
        </div>

        <div class="table-responsive mb-4 mt-4">
            <table class="table" style="text-align:center;direction:ltr;">
                <tr>
                      <th style="color:#e6840f">
                        القيمة<br /> Value
                    </th>
                      <th style="color:#e6840f">
                        الحساب<br /> Account
                    </th>


                </tr>
                @foreach (var item in Model.ExpenseSubLedger)
                {
                    <tr>

                        @if (@Math.Round(item.difference, 2, MidpointRounding.AwayFromZero) == 0)
                        {

                        }
                        else
                        {
                            if (@Math.Round(item.difference, 2, MidpointRounding.AwayFromZero) >= 0)
                            {
                                <td>
                                    @Math.Round(item.difference, 2, MidpointRounding.AwayFromZero)
                                    @*@item.difference  &nbsp&nbsp&nbsp&nbsp*@
                                </td>
                            }
                            else
                            {
                                var dif = item.difference * -1;
                                <td>
                                    (@Math.Round(dif, 2, MidpointRounding.AwayFromZero)
                                    @*( @dif)  &nbsp&nbsp&nbsp&nbsp*@
                                </td>
                            }
                            <td>
                                @item.Account_Name
                            </td>
                        }


                    </tr>

                }
                <tr>
                    @if (@Math.Round(Model.salesCost, 2, MidpointRounding.AwayFromZero) >= 0)
                    {
                          <th style="color:#e6840f">
                            @Math.Round(Model.salesCost, 2, MidpointRounding.AwayFromZero)
                        </th>
                    }
                    else
                    {
                          <th style="color:#e6840f">
                            (@Math.Round(Model.salesCost * -1, 2, MidpointRounding.AwayFromZero))
                        </th>
                    }
                      <th style="color:#e6840f">
                        الاجمالي | Total
                    </th>


                </tr>
                <tr>
                    @if (@Math.Round(Model.collectofRevenue, 2, MidpointRounding.AwayFromZero) >= 0)
                    {
                          <th style="color:#e6840f">
                            @Math.Round(Model.collectofRevenue, 2, MidpointRounding.AwayFromZero)
                        </th>
                    }
                    else
                    {
                          <th style="color:#e6840f">
                            (@Math.Round(Model.collectofRevenue * -1, 2, MidpointRounding.AwayFromZero))
                        </th>
                    }
                      <th style="color:#e6840f">
                        مجمل الربح والخسارة | Gross profit and loss
                    </th>


                </tr>
            </table>
        </div>


            <div class="text-center">
                المصروفات | Expences
            </div>
            <div class="table-responsive mb-4 mt-4">
                <table class="table" style="text-align:center;direction:ltr;">
                    <tr>
                          <th style="color:#e6840f">
                            القيمة<br /> Value
                        </th>
                          <th style="color:#e6840f">
                            الحساب<br /> Account
                        </th>



                    </tr>

                    @foreach (var item in Model.Account_Expense.Where(a => a.difference > 0))
                    {
                        <tr>

                            @if (Math.Round(item.difference, 2, MidpointRounding.AwayFromZero) >= 0)
                            {
                                <td>
                                    @Math.Round(item.difference, 2, MidpointRounding.AwayFromZero)
                                </td>
                            }
                            else
                            {
                                var dif = item.difference * -1;
                                <td>
                                    (@Math.Round(dif, 2, MidpointRounding.AwayFromZero))
                                </td>
                            }
                            <td style="width:auto">
                                @item.Account_Name
                            </td>




                        </tr>


                    }

                    <tr>
                        @if (@Math.Round(Model.Total_Expense, 2, MidpointRounding.AwayFromZero) >= 0)
                        {
                              <th style="color:#e6840f">
                                @Math.Round(Model.Total_Expense, 2, MidpointRounding.AwayFromZero)
                            </th>
                        }
                        else
                        {
                              <th style="color:#e6840f">
                                (@Math.Round(Model.Total_Expense * -1, 2, MidpointRounding.AwayFromZero))
                            </th>
                        }
                          <th style="color:#e6840f">
                            الاجمالي | Total
                        </th>

                    </tr>
                    <tr>
                        @if (@Math.Round(Model.Difference, 2, MidpointRounding.AwayFromZero) >= 0)
                        {
                              <th style="color:#e6840f">
                                @Math.Round(Model.Difference, 2, MidpointRounding.AwayFromZero)
                            </th>
                        }
                        else
                        {
                              <th style="color:#e6840f">
                                (@Math.Round(Model.Difference * -1, 2, MidpointRounding.AwayFromZero))
                            </th>
                        }
                          <th style="color:#e6840f">
                            صافي الربح والخسارة | net profit and loss
                        </th>


                    </tr>
                </table>
            </div>



            <div class="text-center">
                الملخص | Summary
            </div>
            <div class="table-responsive mb-4 mt-4">
                <table class="table" style="text-align:center;direction:rtl;">
                    <tr>
                          <th style="color:#e6840f">
                            الايرادات<br /> Revenue
                        </th>
                        @if (@Math.Round(Model.Total_Revenue, 2, MidpointRounding.AwayFromZero) >= 0)
                        {
                              <th style="color:#e6840f">
                                @Math.Round(Model.Total_Revenue, 2, MidpointRounding.AwayFromZero)
                            </th>
                        }
                        else
                        {
                              <th style="color:#e6840f">
                                (@Math.Round(Model.Total_Revenue * -1, 2, MidpointRounding.AwayFromZero))
                            </th>
                        }



                    </tr>

                    <tr>
                          <th style="color:#e6840f">
                            تكلقة المبيعات<br /> Cost Of Sales
                        </th>
                        @if (@Math.Round(Model.salesCost, 2, MidpointRounding.AwayFromZero) >= 0)
                        {
                              <th style="color:#e6840f">
                                @Math.Round(Model.salesCost, 2, MidpointRounding.AwayFromZero)
                            </th>
                        }
                        else
                        {
                              <th style="color:#e6840f">
                                (@Math.Round(Model.salesCost * -1, 2, MidpointRounding.AwayFromZero))
                            </th>
                        }


                    </tr>
                    <tr>
                          <th style="color:#e6840f">
                            المصروفات<br /> Expenses
                        </th>
                        @if (@Math.Round(Model.Total_Expense, 2, MidpointRounding.AwayFromZero) >= 0)
                        {
                              <th style="color:#e6840f">
                                @Math.Round(Model.Total_Expense, 2, MidpointRounding.AwayFromZero)
                            </th>
                        }
                        else
                        {
                              <th style="color:#e6840f">
                                (@Math.Round(Model.Total_Expense * -1, 2, MidpointRounding.AwayFromZero))
                            </th>
                        }



                    </tr>
                    <tr>
                          <th style="color:#e6840f">
                            صافي الربح والخسارة <br /> net profit and loss
                        </th>
                        @if (@Math.Round(Model.Difference, 2, MidpointRounding.AwayFromZero) >= 0)
                        {
                              <th style="color:#e6840f">
                                @Math.Round(Model.Difference, 2, MidpointRounding.AwayFromZero)
                            </th>
                        }
                        else
                        {
                              <th style="color:#e6840f">
                                (@Math.Round(Model.Difference * -1, 2, MidpointRounding.AwayFromZero))
                            </th>
                        }


                    </tr>

                </table>
            </div>

















    </div>
    </div>



