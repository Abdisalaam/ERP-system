                </th>
            </tr>

            <tr>

                <td>
                    @Math.Round(Model.Amount, 2, MidpointRounding.AwayFromZero)
                </td>





                <td>
                    @Model.supp.Supp_Name
                </td>
                <td>
                    @Model.supp.Supp_Code
                </td>
            </tr>


        </table>
        <br />
        <div style="text-align:right;color:black;font-size:x-large;margin-bottom:50px;">


        </div>
        <br />
