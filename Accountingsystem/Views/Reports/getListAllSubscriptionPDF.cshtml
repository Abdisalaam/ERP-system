@model Accountingsystem.ViewModel.ReportsVM.SubscriptionReportVM.AllSubscriptionVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
    decimal total = 0;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقارير جميع الاشتراكات</title>
    @*<link href="~/Template/assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/Template/assets/css/style.css" rel="stylesheet" />*@
</head>
<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
    <div class="container">
        <div class="row">
            <div class="col-md-6">


                @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
                {
                    <div>
                        <h style="padding-top:100px">
                            <br /><br />
                        </h>
                    </div>
                }
                else
                {
                    foreach (var item2 in Model.company.CompanyPhotoDetails)
                    {
                        <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                    }
                }
            </div>
            <div class="col-md-6" style="margin-top:-70px">
                <table style="text-align:right;" data-sortable="" width="900">


                    <tr>
                        <td style="text-align:right;">@Model.company.Comp_Name</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>


                    @*<tr>
                            <td style="text-align:right; padding-top:20px">
                                @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                                &nbsp&nbsp  : تاريخ عرض السعر
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                            <td></td>
                            <td></td>
                            <td> </td>
                        </tr>*@


                </table>
            </div>
        </div>
        <br />
        <br />
        <br />
        <br />
        <br />
        <br />

        <div class="container">

            <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
                تقرير كل الاشتراكات / All Subscribtion Report

            </div>
          


        </div>

    </div>
    <hr />
    <div class="row">

        <div class="col-md-12">
            <div class="col-lg-6">
                <table class="table" style="text-align:right;direction:rtl;">
                    <tr>
                        <th style="text-align:center;  ">

                            رقم الاشتراك
                            <br />
                            Sub NO
                        </th>
                        <th style="text-align:center; ">
                            العميل
                            <br />
                            Customer
                        </th>
                        <th style="text-align:center; ">
                            جوال العميل
                            <br />
                            Phone
                        </th>
                        <th style="text-align:center;width:200px; ">
                            اسم الاشتراك
                            <br />
                            Sub Name
                        </th>

                        <th style="text-align:center; ">
                            بدايه الاشتراك
                            <br />
                            Start Date
                        </th>
                        <th style="text-align:center; ">
                            انتهاء  الاشتراك
                            <br />
                            End Sub
                        </th>

                        <th style="text-align:center; ">
                            حالة
                            <br />
                            Status
                        </th>
                        <th style="text-align:center; ">
                            الفريق
                            <br />
                            Team
                        </th>
                        <th style="text-align:center; ">
                            الصافي
                            <br />
                            Net
                        </th>

                    </tr>
                    @foreach (var item in Model.AllSUb)
                    {
                        total += item.AMountAFterTax.Value;
                        <tr>
                            <td style="text-align:center;">
                                @item.Subscrip_Code
                            </td>
                            <td style="text-align:center;">
                                @item.Customer_Name
                            </td>
                            <td style="text-align:center;">
                                @item.tel_customer
                            </td>
                            <td style="text-align:center; width:200px;">

                                @Accountingsystem.Models.Subscription_Type.GetallSubscription_TypeById(item.Sub_Type_ID).Subscrip_Name
                            </td>

                            <td style="text-align:center;">

                                @Convert.ToDateTime(item.StartTime).ToString("yyyy/MM/dd ")
                            </td>
                            <td class="col-md-4" style="text-align:center;">

                                @Convert.ToDateTime(item.DeadLine).ToString("yyyy/MM/dd ")
                            </td>

                            <td style="text-align:center;">

                                @item.SubType_State
                            </td>
                            @{
                                var thisteam = "";
                                if (item.SelectEmp_Team == 0)
                                { }
                                else
                                { thisteam = Accountingsystem.Models.EmployeeTeam.getEmployeeBYID((int)item.SelectEmp_Team).Team_Name; } }
                            <td class="col-md-4" style="text-align:center;">

                                <h>@thisteam</h>
                            </td>

                            <td style="text-align:center;">

                                @Math.Round((double)item.AMountAFterTax, 2, MidpointRounding.AwayFromZero)
                            </td>

                        </tr>

                    }
                    <tr>
                        <th style="text-align:center;  ">

                          الاجمالي
                            <br />
                          Total
                        </th>
                        <th style="text-align:center; ">
                          
                        </th>
                        <th style="text-align:center; ">
                           
                        </th>
                        <th style="text-align:center;width:200px; ">
                           
                        </th>

                        <th style="text-align:center; ">
                          
                        </th>
                        <th style="text-align:center; ">
                          
                        </th>

                        <th style="text-align:center; ">
                           
                        </th>
                        <th style="text-align:center; ">
                          
                        </th>
                        <th style="text-align:center; ">
                            @Math.Round((double)total, 2, MidpointRounding.AwayFromZero)
                        </th>

                    </tr>
                </table>
            </div>


        </div>

    </div>

    <footer style="margin-top:50%;"></footer>
</body>
</html>
