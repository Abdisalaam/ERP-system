@model Accountingsystem.ViewModel.ReportsVM.SubLedgerReportVM

<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />
@{
    Layout = null;
 
    ViewBag.Title = "تقرير مركز التكلفة الاجمالي";



    var dateto = "الي" + Convert.ToDateTime(Model.To_Date).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.From_Date).ToString("yyyy/MM/dd ");
}
<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>مراكز التكلفة</title>

</head>
<body>
    
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />

    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير مركز التكلفة الاجمالي / Total Subledger Report

        </div>

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @Model.SubName

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>

    <table class="table" style="text-align:right;direction:ltr;">
        <thead>
            <tr style="text-align:right;">

                <th style="text-align:center;font-size:xx-small"> الرصيد<br />balance</th>

                <th style="text-align:center;font-size:xx-small"> الدائن<br />Credit</th>
                <th style="text-align:center;font-size:xx-small"> المدين<br />Debit</th>

                <th style="text-align:center;font-size:xx-small"> مركز التكلفة<br />Subledger</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Account_Sudledger)
            {
            <tr>
                @if (item.GLDetail_Credit > item.GLDetail_Debit)
                {
                    <td style="text-align:center;">
                        ( @Math.Round((item.GLDetail_Debit - item.GLDetail_Credit)*-1 , 2, MidpointRounding.AwayFromZero) )  &nbsp&nbsp&nbsp&nbsp
                    </td>
                }
                else
                {
                    <td style="text-align:center;">
                        @Math.Round(item.GLDetail_Debit - item.GLDetail_Credit, 2, MidpointRounding.AwayFromZero)   &nbsp&nbsp&nbsp&nbsp
                    </td>
                }
                <td style="text-align:center;">
                    @Math.Round(item.GLDetail_Credit, 2, MidpointRounding.AwayFromZero)  &nbsp&nbsp&nbsp&nbsp
                </td>

                <td style="text-align:center;">
                    @Math.Round(item.GLDetail_Debit, 2, MidpointRounding.AwayFromZero)  &nbsp&nbsp&nbsp&nbsp
                </td>

                <td style="text-align:center;">
                    @item.Subledger_Name &nbsp&nbsp&nbsp&nbsp
                </td>
            </tr>

            }
        </tbody>

      <tr>
          <th style="text-align:center;font-size:xx-small">
              @if (Math.Round(Model.Difference, 2, MidpointRounding.AwayFromZero) >= 0)
              {

                  <div style="text-align:right;color:black;font-size:x-large;">  @Math.Round(Model.Difference, 2, MidpointRounding.AwayFromZero)</div>

              }
              else
              {
                  var dif_cost = Model.Difference * -1;
                  <div style="text-align:right;color:black;font-size:x-large;"> (@Math.Round(dif_cost, 2, MidpointRounding.AwayFromZero))</div>
              }
          </th>
          <th style="text-align:center;font-size:xx-small">@Math.Round(Model.TotalCredit, 2, MidpointRounding.AwayFromZero)</th>
          <th style="text-align:center;font-size:xx-small">@Math.Round(Model.TotalDepit, 2, MidpointRounding.AwayFromZero)</th>

        <th style="text-align:center;font-size:xx-small"> الاجمالي<br />Total</th>
          </tr>
    </table>
    <hr />
   

    <footer style="margin-top:35%;">
        <hr />

    </footer>

</body>
</html>



