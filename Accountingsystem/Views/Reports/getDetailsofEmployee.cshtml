@model Accountingsystem.ViewModel.ReportsVM.CustomerTransactionGettingDateVM

@{
    ViewBag.Title = Accountingsystem.Resources.ReportsgetDetailsofEmployee.EmployeeReport;
    HttpCookie cookie = Request.Cookies["Language"];
}
<head>
    @{

