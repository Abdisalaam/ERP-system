        <caption></caption>
        <tr>
            <th class="col-md-4" style="text-align:center">
                اسم العميل
            </th>
            <th class="col-md-4" style="text-align:center">
                تاريخ الفاتورة
            </th>
            <th class="col-md-4" style="text-align:center">
                تاريخ الاستحقاق
            </th>
            <th class="col-md-4" style="text-align:center">
                كود الفاتورة
            </th>
            <th class="col-md-4" style="text-align:center">
                اجمالى الفاتورة
            </th>
        </tr>
        @foreach (var item in Model.InvoiceList)
        {

            <tr>
                <td class="col-md-4" style="text-align:center">
                    @item.Customer.Customer_Name
                </td>
                <td class="col-md-4" style="text-align:center">
                    @item.Invoice_Date
                </td>
                <td class="col-md-4" style="text-align:center">
                    @item.Due_Date
                </td>
                <td class="col-md-4" style="text-align:center">
                    @item.Serial_Number
                </td>
                <td class="col-md-4" style="text-align:center">
                    @item.Total_Amount
                </td>


            </tr>

        }
