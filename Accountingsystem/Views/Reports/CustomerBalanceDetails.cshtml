@model Accountingsystem.ViewModel.ReportsVM.CustomerBalanceDetailsVM
<style type="text/css">
    table {
        page-break-inside: auto
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
