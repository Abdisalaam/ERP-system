                @{var customername = Accountingsystem.Models.Customer.GetCustomerById(Convert.ToInt32(item.Customer_Id)).Customer_Name;
                    <h>@customername</h> }
            </td>
            <td class="col-md-4" style="text-align:center">
                @item.Invoice_Date
            </td>
            <td class="col-md-4" style="text-align:center">
                @item.Due_Date
            </td>
            <td class="col-md-4" style="text-align:center">
                @item.Serial_Number
            </td>
            <td class="col-md-4" style="text-align:center">
                @item.Total_Amount
            </td>

        </tr>

        }
