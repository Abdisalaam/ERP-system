                    <th style="text-align:right">Tax Amount <br />مبلغ الضريبة</th>
                    <th style="text-align:right">Item SubTotal(Including VAT) <br />المجموع شامل الضريبة</th>

                </tr>

            </thead>
            <tbody>

                <tr>
                    <td style="text-align:center;">
                        @Model.Sub_Code

                        <br />

                        @Model.description
                    </td>
                    <td style="text-align:center;">
                        @Model.starttime
                    </td>

                    <td style="text-align:center;">
                        @Model.deadline
                    </td>


                    @if (Model.totalAfterdiscount > 0)
                    {
                        <td>@String.Format("{0:n}", Math.Round(Model.totalAfterdiscount.Value, 2, MidpointRounding.AwayFromZero))</td>
                    }
                    else
                    {
                        <td> @String.Format("{0:n}", Math.Round(Model.EstimatedAmount, 2, MidpointRounding.AwayFromZero))</td>
                    }




                    @if (Model.TaxPercentage > 0)
                    {
                        <td>

                            @Model.TaxPercentage %

                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                    <td>

                        @String.Format("{0:n}", Math.Round(Model.totaltax, 2, MidpointRounding.AwayFromZero))
                    </td>
                    <td>

                        @String.Format("{0:n}", Math.Round(Model.TotalAMountAFterTax, 2, MidpointRounding.AwayFromZero))
                    </td>


                </tr>


            </tbody>
