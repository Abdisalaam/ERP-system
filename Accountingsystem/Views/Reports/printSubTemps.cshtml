                    @if (Model.totalAfterdiscount > 0)
                    {
                        <td style="text-align:center">@String.Format("{0:n}", Math.Round(Model.totalAfterdiscount.Value, 2, MidpointRounding.AwayFromZero))</td>
                    }
                    else
                    {
                        <td style="text-align:center">@String.Format("{0:n}", Math.Round(Model.EstimatedAmount, 2, MidpointRounding.AwayFromZero))</td>
                    }
                    <td style="text-align:right">Total Taxable Amount(Excluding VAT)</td>
                    <td style="text-align:right"> (@taxable</td>

                </tr>

                @if (Model.totaltax > 0)
                {
                    <tr style="text-align:right;">
                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(Model.totaltax, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total VAT</td>
                        <td style="text-align:right">@Model.taxName</td>
                    </tr>
                }
                @if (Model.fixed_Discount > 0)
                {
                    <tr style="text-align:right;">
                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(Model.fixed_Discount.Value, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Additional Discount</td>
                        <td style="text-align:right">خصم مسموح به</td>
                    </tr>
                    <tr style="text-align:right;">


                        <td style="text-align:center;font-weight:900"> @String.Format("{0:n}", Math.Round(((Model.TotalAMountAFterTax) - Model.fixed_Discount.Value), 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right;font-weight:900">Total Amount Due</td>
                        <td style="text-align:right;font-weight:900">صافي المبلغ المستحق</td>

                    </tr>
                }
                else
                {

                    <tr style="text-align:right;">


                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(Model.TotalAMountAFterTax, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total Amount Due</td>
                        <td style="text-align:right">صافي المبلغ المستحق</td>

                    </tr>


                }
                @*<tr style="text-align:right;">


                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(payemntvalue, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total Amount Paid </td>
                        <td style="text-align:right">المبلغ المدفوع</td>

                    </tr>*@
                @*@if (Model.fixed_Discount > 0)
                    {
                        <tr style="text-align:right;">


                            <th style="text-align:center"> @String.Format("{0:n}", Math.Round((Model.TotalAMountAFterTax - Model.fixed_Discount.Value) - payemntvalue, 2, MidpointRounding.AwayFromZero))</th>
