@model Accountingsystem.ViewModel.ReportsVM.AllSalseInvoicesWithOutTaxVM

@{
    ViewBag.Title = Accountingsystem.Resources.SalesReports.SalesInvoicesForBranchReport;
}


<h2 class="HEADTITLE-STYLE">@Accountingsystem.Resources.SalesReports.SalesInvoicesForBranchReport </h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="margin-bottom:20%">

        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="container">

            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.startDate, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.startDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.SalesReports.StartFrom)
                        </div>
                    </div>
                </div>

                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.EditorFor(model => model.EndDate, new { htmlAttributes = new { @class = "textfield" } })
                            @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.SalesReports.To)
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-5">
                    <div class="col-md-6">
                        <div class="textfieldcont">
                            @Html.DropDownListFor(model => model.branchId, Model.branchList, Accountingsystem.Resources.SalesReports.SelectBranch, htmlAttributes: new { @class = "Dropdownlist-select" })
                            @Html.ValidationMessageFor(model => model.branchId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.Label(Accountingsystem.Resources.SalesReports.SelectBranch)
                        </div>
                    </div>
                </div>

 

            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">

                <a href="@Url.Action("GetAllReportsInvoiceSales")" class="btn BTN-style final-BTN">
                    @Accountingsystem.Resources.SalesReports.BackToList
                </a>
                <input type="submit" value=@Accountingsystem.Resources.SalesReports.ToReport class="btn BTN-style final-BTN" />
            </div>
        </div>
    </div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $('#startDate').datetimepicker({ format: 'DD/MM/YYYY' });
        $('#EndDate').datetimepicker({ format: 'DD/MM/YYYY' });

    </script>
}


