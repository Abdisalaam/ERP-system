                var taxable = "الاجمالي الخاضع للضريبة(غير شامل ضريبة القيمة المضافة";
            }
            <thead>
                <tr style="text-align:right;">


                    <td style="text-align:center;width:300px">
                        @String.Format("{0:n}", Math.Round(totals, 2, MidpointRounding.AwayFromZero))
