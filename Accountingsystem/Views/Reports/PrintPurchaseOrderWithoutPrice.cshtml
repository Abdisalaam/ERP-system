    <div>
        <table class="table" style="text-align:right; direction:rtl">
            <thead>
                <tr style="text-align:right;">

                    <th style="text-align:right">NatureOfGoodsOrServices<br />تفاصيل السلع و الخدمات</th>
                    @if (Model.MyDetails.Where(a => a.MeasureUnit != null && a.MeasureUnit != "").Count() > 0)
                    {

                        <th style="text-align:right">MeasureUnit<br />وحدة القياس</th>
                    }
                    @if (Model.MyDetails.Where(a => a.Product_Model != null && a.Product_Model != "").Count() > 0)
                    {

                        <th style="text-align:right">Model No<br />رقم الموديل</th>
                    }
              
                    <th style="text-align:right">Quantity <br />الكمية</th>
                  

                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model.MyDetails)
                {
                    <tr>
                        <td>

                            @item.productcode @item.Product_Name

                        </td>
                        @if (Model.MyDetails.Where(a => a.MeasureUnit != null && a.MeasureUnit != "").Count() > 0)
                        {
                            <td>
                                @item.MeasureUnit
                            </td>
                        }
                        @if (Model.MyDetails.Where(a => a.Product_Model != null && a.Product_Model != "").Count() > 0)
                        {
                            <td>
                                @item.Product_Model
                            </td>
                        }

                        <td>

                            @String.Format("{0:n}", Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero))
                        </td>



                    </tr>
                    if (string.IsNullOrEmpty(item.Product_Description))
                    {





                    }
                    else
                    {
                        <tr dir="rtl">
                            <td style="border-top-style:hidden" colspan="7"> <span style="white-space: pre-line" dir="ltr" ;>@item.Product_Description</span></td>
                        </tr>
                    }
                    counter++;
                    totals = totals + (item.Product_Quantity * item.Product_Price);
                    totalbeforTax = totalbeforTax + item.amountBeforeTax;
                    totalaftertax = totalaftertax + (item.amountBeforeTax + item.Total_Tax);
                    totaltaxes = totaltaxes + item.Total_Tax;
                }

            </tbody>
        </table>
    </div>

    <div>
        @*<table width="1100" style="text-align:right;">
            @{
