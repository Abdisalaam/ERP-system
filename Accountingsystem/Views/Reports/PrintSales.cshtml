    <br />

    @if (Accountingsystem.Utilites.PackageRecognize.checkLanguage(Model.Describtion) == true)
    {

        <div style="text-align: right;">
            <span style="white-space: pre-line" dir="rtl" ;>@Model.Describtion</span>
        </div>
    }
    else
    {
        <div style="text-align: left;">
            <span style="white-space: pre-line" dir="ltr" ;>@Model.Describtion</span>
        </div>
    }


    <div>
        <table class="table" style="text-align:right; direction:rtl">
            <thead>
                <tr style="text-align:right;">

                    <th style="text-align:right">NatureOfGoodsOrServices<br />تفاصيل السلع و الخدمات</th>
                    @if (Model.MyDetails.Where(a => a.MeasureUnit != null && a.MeasureUnit != "").Count() > 0)
                    {

                        <th style="text-align:right">MeasureUnit<br />وحدة القياس</th>
                    }
                    @if (Model.MyDetails.Where(a => a.Product_Model != null && a.Product_Model != "").Count() > 0)
                    {

                        <th style="text-align:right">Model No<br />رقم الموديل</th>
                    }
                    <th style="text-align:right">Unit Price<br />سعر الوحدة</th>
                    <th style="text-align:right">Quantity <br />الكمية</th>
                    <th style="text-align:right">Taxable Amount <br />المبلغ الخاضع للضريبة</th>
                    @if (Model.Master_Discount > 0)
                    {
                        <th style="text-align:right">Discount Rate <br />نسبة الخصم</th>
                        <th style="text-align:right">Discount Amount <br />مبلغ الخصم</th>

                    }
                        <th style="text-align:right">Tax Rate <br />نسبة الضريبة</th>
                        <th style="text-align:right">Tax Amount <br />مبلغ الضريبة</th>
                        <th style="text-align:right">Item SubTotal(Including VAT) <br />المجموع شامل الضريبة</th>

                    </tr>

            </thead>
            <tbody>
                @foreach (var item in Model.MyDetails)
                {
                    <tr>
                        <td>

                            @item.productcode @item.Product_Name

                        </td>
                        @if (Model.MyDetails.Where(a => a.MeasureUnit != null && a.MeasureUnit != "").Count() > 0)
                        {
                            <td>
                                @item.MeasureUnit
                            </td>
                        }
                        @if (Model.MyDetails.Where(a => a.Product_Model != null && a.Product_Model != "").Count() > 0)
                        {
                            <td>
                                @item.Product_Model
                            </td>
                        }
                        <td>
                            @String.Format("{0:n}", Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero))

                        </td>
                        <td>

                            @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
                        </td>

                        <td>
                            @String.Format("{0:n}", Math.Round(item.Total_Amount_Detail - item.Total_Tax, 2, MidpointRounding.AwayFromZero))


                        </td>
                        @if (Model.Master_Discount > 0)
                        {
                            if (item.Detail_Discount != null)
                            {
                                <td>

                                    @String.Format("{0:n}", Math.Round(item.Detail_Discount, 2, MidpointRounding.AwayFromZero))
                                </td>
                                <td>
                                    @String.Format("{0:n}", Math.Round(item.Detail_Discount_Amount, 2, MidpointRounding.AwayFromZero))
                                </td>
                            }
                            else
                            {
                                <td>
                                    0
                                </td>
                                <td>
                                    0
                                </td>
                            }
                        }

                        @if (item.tax != null)
                        {
                            <td>

                                @item.tax.Tax_Percentage%

                            </td>
                        }
                        else
                        {
                            <td></td>
                        }
                        <td>
                            @String.Format("{0:n}", Math.Round(item.Total_Tax, 2, MidpointRounding.AwayFromZero))



                        </td>
                        <td>
                            @String.Format("{0:n}", Math.Round(item.Total_Amount_Detail, 2, MidpointRounding.AwayFromZero))
                        </td>


                    </tr>
                    if (string.IsNullOrEmpty(item.Product_Description))
                    {





                    }
                    else
                    {
                        <tr dir="rtl">
                            <td style="border-top-style:hidden" colspan="7"> <span style="white-space: pre-line" dir="ltr" ;>@item.Product_Description</span></td>
                        </tr>
                    }
                    counter++;
                    totals = totals + (item.Product_Quantity * item.Product_Price);
                    totalbeforTax = totalbeforTax + item.amountBeforeTax;
                    totalaftertax = totalaftertax + item.Total_Amount_Detail;
                    totaltaxes = totaltaxes + item.Total_Tax;
                }

            </tbody>
        </table>
    </div>

    <div>
        <table width="1100" style="text-align:right;">
            @{
                var totalstr = "الاجمالي(غير شامل ضريبة القيمة المضافة";
                var taxable = "الاجمالي الخاضع للضريبة(غير شامل ضريبة القيمة المضافة";
            }
            <thead>
                <tr style="text-align:right;">


                    <td style="text-align:center;width:300px">
                        @String.Format("{0:n}", Math.Round(totals, 2, MidpointRounding.AwayFromZero))
                    </td>
                    <td style="text-align:right" width="400px">Total(Excluding VAT)</td>
                    <td style="text-align:right" width="400px">(@totalstr </td>

                </tr>
                @if (Model.Masterdiscount > 0)
                {
                    <tr style="text-align:right;">


                        <td style="text-align:center">@String.Format("{0:n}", Math.Round(Model.Masterdiscount, 2, MidpointRounding.AwayFromZero)) </td>
                        <td style="text-align:right"> @Math.Round(Model.Master_Discount, 2, MidpointRounding.AwayFromZero)%Discount</td>
                        <td style="text-align:right">  @Math.Round(Model.Master_Discount, 2, MidpointRounding.AwayFromZero)%مجموع الخصومات</td>

                    </tr>
                }
                <tr style="text-align:right;">
                    @{
                        var totalTaxableAmount = Model.MyDetails.Where(a => a.tax != null).Select(a => a.amountBeforeTax).Sum() - Model.MyDetails.Where(a => a.tax != null).Select(a => a.discount).Sum();
                    }

                    <td style="text-align:center"> @String.Format("{0:n}", Math.Round(totalTaxableAmount, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right">Total Taxable Amount(Excluding VAT)</td>
                    <td style="text-align:right"> (@taxable</td>

                </tr>

                @foreach (var detailTax in Model.MyDetails.Where(a => a.tax != null).Select(a => a.tax).Distinct())
                {

                    var totalDetailTaxAmount = Model.MyDetails.Where(a => a.tax == detailTax).Select(a => a.Total_Tax).Sum();

                    <tr style="text-align:right;">
                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(totalDetailTaxAmount, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total VAT @detailTax.Tax_Percentage %</td>
                        <td style="text-align:right">@detailTax.Tax_Percentage %   @detailTax.Tax_Name  مجموع </td>

                    </tr>
                }

                @foreach (var tax in Model.Taxes)
                {
                    <tr style="text-align:right;">
                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(tax.Amount, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Total VAT</td>
                        <td style="text-align:right">@tax.TaxName</td>
                    </tr>
                }
                @if (Model.fixed_Discount > 0)
                {
                    <tr style="text-align:right;">
                        <td style="text-align:center"> @String.Format("{0:n}", Math.Round(Model.fixed_Discount, 2, MidpointRounding.AwayFromZero))</td>
                        <td style="text-align:right">Additional Discount</td>
                        <td style="text-align:right">خصم مسموح به</td>
                    </tr>
                }
                <tr style="text-align:right;">

                    <td style="text-align:center;font-weight:900"> @String.Format("{0:n}", Math.Round(((totalaftertax + Model.NewTaxTotal) - Model.fixed_Discount), 2, MidpointRounding.AwayFromZero))</td>

                    <td style="text-align:right;font-weight:900">Total Amount Due</td>
                    <td style="text-align:right;font-weight:900">صافي المبلغ المستحق</td>

                </tr>
                <tr style="text-align:right;">

                    <td style="text-align:center;"> @String.Format("{0:n}", Math.Round(payemntvalue, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:right;">Total Amount Paid </td>
                    <td style="text-align:right;">المبلغ المدفوع</td>

                </tr>
                <tr style="text-align:right;">

                    <th style="text-align:center"> @String.Format("{0:n}", Math.Round(((totalaftertax + Model.NewTaxTotal) - Model.fixed_Discount) - payemntvalue, 2, MidpointRounding.AwayFromZero))</th>

                    <th style="text-align:right">Total Remaining Amount </th>
                    <th style="text-align:right">المبلغ المتبقي</th>

                </tr>

            </thead>

        </table>
    </div>
    <br />
