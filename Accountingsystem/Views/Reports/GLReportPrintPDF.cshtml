@model Accountingsystem.ViewModel.ReportsVM.GlMasterAndDetailListVM
    @{ 

        var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    }
<style type="text/css">
    table {
        page-break-inside: auto
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <title> قيد اليومية </title>
</head>
<body>
    <div class="container">

        <div class="row">
            <div class="col-md-6">


                @if (company.CompanyPhotoDetails.FirstOrDefault() == null)
                {
                    <div>
                        <h style="padding-top:100px">

                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                        </h>
                    </div>
                }
                else
                {

                    <img src="data:image/jpg;base64,@Convert.ToBase64String(company.CompanyPhotoDetails.FirstOrDefault().ProImg)" alt="Image" style="width:150px " height="100" />


                }
            </div>
            <div class="col-md-6" style="margin-top:-120px">
                <br />
                <table style="text-align:right;" data-sortable="" width="1100">


                    <tr>
                        <td style="text-align:right;font-weight:900">@company.Comp_Name</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>
                  
                    @if (company.Comp_Field != null && company.Comp_Field != "")
                    {
                        <tr>
                            <td style="text-align:right;">@company.Comp_Field</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                    }
                    <tr>
                        <td style="text-align:right;"> @company.Comp_Address  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    @if (company.CRN != null && company.CRN != "")
                    {
                        <tr>
                            <td style="text-align:right;">@company.CRN</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                    }
                    <tr>
                        <td style="text-align:right;">@company.Comp_phone  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td style="text-align:right;">@company.Comp_Email  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>

                    @*<tr>
                        <td style="text-align:right; padding-top:20px">
                            @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                            &nbsp&nbsp  : تاريخ عرض السعر
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>*@


                </table>
            </div>
        </div>


        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            قيد اليومية/  Journal entry

        </div>

  

       
    
        <div class="row">

            <table width="1100" border="1" style="text-align:right;">
          
                <tr>
                    <th style="text-align:center; padding-top:0px">
                        Date
                    </th>

                    <td style="text-align:center; padding-top:0px">
                        @Model.GlDate
                    </td>
                    <th style="text-align:center; padding-top:0px">
                        التاريخ

                    </th>
                    <th style="text-align:center; padding-top:0px">
                        GL No
                    </th>

                    <td style="text-align:center;  padding-top:0px">
                        @Model.GlCode
                    </td>
                    <th style="text-align:center; padding-top:0px">
                        رقم القيد
                    </th>

                </tr>
             
             




            </table>
            <br />
            @if (Accountingsystem.Utilites.PackageRecognize.checkLanguage(Model.GLDescr) == true)
            {

                <div style="text-align: right;">
                    <span style="white-space: pre-line" dir="rtl" ;>@Model.GLDescr</span>
                </div>
            }
            else
            {
                <div style="text-align: left;">
                    <span style="white-space: pre-line" dir="ltr" ;>@Model.GLDescr</span>
                </div>
            }

            <br />


            <table class="table" style="text-align:right; direction:ltr">
                <tr>
                    <th style="text-align:right;width:300px">CostCenter<br /> ﻣﺮﻛﺰ ﺗﻜﻠﻔﺔ</th>
                    <th style="text-align:center;">Credit<br /> دائن</th>
                    <th style="text-align:center;">Debit<br /> مدين</th>
                    <th style="text-align:center;width:300px">SubAccount<br />   الحساب المساعد</th>
                    <th style="text-align:center;width:300px">Account<br />   الحساب </th>
                    <th style="text-align:center;">AccountCode<br />  كود الحساب</th>


                    <th style="text-align:center;width:10px">


                    </th>
                </tr>
                @foreach (var item in Model.GLDetailList)
                {

                    <tr>

                        <td style="text-align:center;width:150px">
                            @item.subledgerName
                        </td>

                        <td style="text-align:center;">
                            @item.credit
                        </td>
                        <td style="text-align:center;">
                            @item.Debit
                        </td>
                        <td style="text-align:center;width:150px">
                            @item.childName
                        </td>
                        <td style="text-align:center;width:150px">
                            @item.AccountName
                        </td>
                        <td style="text-align:center;width:150px">
                            @item.AccountCode
                        </td>
                        <td style="text-align:center;">
                            @item.detailcounter
                        </td>








                    </tr>
                    if (item.decribtion != "" && item.decribtion != null)
                    {
                    <tr dir="rtl">
                        <td style="border-top-style:hidden" colspan="7" ><p style="text-align:justify">@item.decribtion</p></td>
                    </tr>

                        }


                    }
                <tr>
                    <th></th>
                    <th style="text-align:center;">
                        @Math.Round(Model.CreditTotal, 2, MidpointRounding.AwayFromZero)
                    </th>
                    <th style="text-align:center;">
                        @Math.Round(Model.DebitTotal, 2, MidpointRounding.AwayFromZero)
                    </th>
                    <th>
                    </th>
                    <th>
                    </th>
                    <th>
                    </th>
                    <th> Total |  الاجمالي</th>
                </tr>
            </table>
        </div>


        
 
    </div>

 
       
   
</body>
</html>
