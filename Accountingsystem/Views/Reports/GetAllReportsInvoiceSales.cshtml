
@{
    ViewBag.Title = Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.SalesReports;
    HttpCookie cookie = Request.Cookies["Language"];
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";

        }
    }


</head>
<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    <div class="text-center">
                        @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.SalesReports
                    </div>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <a id="salesReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("ClassifySales","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.SalesReport
                            <span id="salesReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <a id="salesReturnReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("getdateofRecallSales","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.SalesReturnReport
                            <span id="salesReturnReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
                @*<div class="col-md-6">
                    <div class="form-group">
                        <a id="salesClassificationReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("ClassifySales","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.SalesReportCategory
                            <span id="salesClassificationReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>*@
                @*<div class="col-md-6">
                    <div class="form-group">
                        <a id="salesEmployeeReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("SalesByEmployee","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.EmployeeSalesReport
                            <span id="salesEmployeeReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>*@

                <div class="col-md-6">
                    <div class="form-group">
                        <a id="salesProductAndServicesReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("makeSalesProductReportForAllSales","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.ProductsAndServicesSalesReports
                            <span id="salesProductAndServicesReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <a id="salesCustomerReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("makeSalesProductForCustomer","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.CustomerSalesReport
                            <span id="salesCustomerReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <a id="salesOfferPriceReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("OfferPriceReport","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsInvoiceSales.PricesOffersReport
                            <span id="salesOfferPriceReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <a id="salesOfferPriceReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("SalesByEmployeeInvoiceRecipt","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReports.salesForEmployee
                            <span id="salesOfferPriceReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>


</div>


@section Scripts {


    <script type="text/javascript">

        $("#salesReportBtn").click(function (e) {
            $("#salesReportBtnSpinner").show();
        });
        $("#salesReturnReportBtn").click(function (e) {
            $("#salesReturnReportBtnSpinner").show();
        });
        $("#salesClassificationReportBtn").click(function (e) {
            $("#salesClassificationReportBtnSpinner").show();
        });       

        $("#salesEmployeeReportBtn").click(function (e) {
            $("#salesEmployeeReportBtnSpinner").show();
        });

        $("#salesProductAndServicesReportBtn").click(function (e) {
            $("#salesProductAndServicesReportBtnSpinner").show();
        });
        $("#salesCustomerReportBtn").click(function (e) {
            $("#salesCustomerReportBtnSpinner").show();
        });
        $("#salesOfferPriceReportBtn").click(function (e) {
            $("#salesOfferPriceReportBtnSpinner").show();
        });
    </script>
}

