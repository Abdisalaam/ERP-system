@model Accountingsystem.ViewModel.PrintVM.PrintExpensesVM

@{
    Layout = null;
    decimal totaldeb = 0;
    decimal totalcred = 0;
}

<!DOCTYPE html>

<html>
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>
    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <title> سند صرف</title>
</head>


<body>
    <div class="container">
        <div class="row">
            <div class="row">
                <div class="col-md-6">


                    @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
                    {
                        <div>
                            <h style="padding-top:100px">
                                <br /><br />
                            </h>
                        </div>
                    }
                    else
                    {
                        foreach (var item2 in Model.company.CompanyPhotoDetails)
                        {
                            <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:150px" />

                        }
                    }
                </div>
                <div class="col-md-6" style="margin-top:-120px">
                    <table style="text-align:right;" data-sortable="" width="900">


                        <tr>
                            <td style="text-align:right;">@Model.company.Comp_Name</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                        <tr>
                            <td style="text-align:right;">العنوان: &nbsp&nbsp @Model.company.Comp_Address  </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td style="text-align:right;">@Model.company.Comp_phone &nbsp&nbsp  :  هاتف الشركة</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td style="text-align:right;">@Model.company.Comp_Email &nbsp&nbsp  : البريد الالكتروني للشركة</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                            <td></td>
                            <td></td>
                            <td> </td>
                        </tr>

                        @*<tr>
                            <td style="text-align:right; padding-top:20px">
                                @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                                &nbsp&nbsp  : تاريخ عرض السعر
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                            <td></td>
                            <td></td>
                            <td> </td>
                        </tr>*@


                    </table>
                </div>
            </div>
            <br />
            <br />
        </div>
        <div style="text-align: center;">

            <text style="text-align: center;  font-size:30px;">سند صرف | Expence </text>

        </div>
        <br />
        <br />
        <table class="table" style="text-align:right;">

            <tr>
                <td style="text-align:right;border-bottom:hidden;  padding-top:0px">
                    @Model.Expense_Code
                </td>
                <th style="text-align:right;border-bottom:hidden; padding-top:0px">
                    رقم المصروف
                </th>

                <td style="text-align:right;border-bottom:hidden; padding-top:0px">
                    @Convert.ToDateTime(Model.expensesDate).Day-@Convert.ToDateTime(Model.expensesDate).Month-@Convert.ToDateTime(Model.expensesDate).Year
                </td>
                <th style="text-align:right;border-bottom:hidden; padding-top:0px">
                    التاريخ
                </th>

            </tr>





        </table>

        <div>
            <table class="table" style="text-align:right;">
                <thead>
                    <tr>
                        <th style="text-align:center;">
                            الوصف
                        </th>
                        <th style="text-align:center;">
                            ﻣﺮﻛﺰ ﺗﻜﻠﻔﺔ
                        </th>
                        <th style="text-align:center;">
                            دائن
                        </th>
                        <th style="text-align:center;">
                            مدين
                        </th>

                        <th style="text-align:center;">
                            اسم الحساب
                        </th>

                        <th style="text-align:center;">


                        </th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var item in Model.ExpDetails)
                    {

                        totalcred = item.total_Credit;
                        totaldeb = item.total_Debit;


                        <tr>
                            <td style="text-align:center;">
                                @item.ExpDesc
                            </td>
                            <td style="text-align:center;">
                                @item.subledgerName
                            </td>
                            <td style="text-align:center;">

                                @Math.Round(item.AccountTreat_Credit, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td style="text-align:center;">
                                @Math.Round(item.AccountExp_Debit, 2, MidpointRounding.AwayFromZero)

                            </td>
                            @if (item.expid > 0)
                            {
                                <td style="text-align:center;">

                                    @item.AccountExpName

                                </td>
                            }
                            else
                            {
                                <td style="text-align:center;">
                                    @item.AccountTreasuryName


                                </td>
                            }



                            <td style="text-align:center;">
                                @item.counter
                            </td>








                        </tr>

                    }
                </tbody>
            </table>
        </div>
        <table class="table" style="float:right; width:100%" border="0">
            <tr>
                <td style="text-align:center;">@Math.Round(totalcred, 2, MidpointRounding.AwayFromZero)</td>

                <td style="text-align:center;">  اجمالي الدائن</td>
            </tr>
            <tr>
                <td style="text-align:center;">@Math.Round(totaldeb, 2, MidpointRounding.AwayFromZero)</td>
                <td style="text-align:center;">  اجمالي المدين</td>
            </tr>


        </table>
        <div style="text-align: right;">
            <span style="white-space: pre-line" dir="rtl" ;>@Model.Description</span>
        </div>

    </div>



</body>
</html>
