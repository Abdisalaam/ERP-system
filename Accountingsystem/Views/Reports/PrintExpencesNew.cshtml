@model Accountingsystem.Models.GLMaster

@{
    Layout = null;
    decimal totaldeb = 0;
    decimal totalcred = 0;
    var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    int count = 0;
}

<!DOCTYPE html>

<html>
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>
    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <title> سند صرف</title>
</head>


<body>
    <div class="container">
        <div class="row">
            <div class="row">
                <div class="col-md-6">


                    @if (company.CompanyPhotoDetails.FirstOrDefault() == null)
                    {
                        <div>
                            <h style="padding-top:100px">
                                <br /><br />
                            </h>
                        </div>
                    }
                    else
                    {
                        foreach (var item2 in company.CompanyPhotoDetails)
                        {
                            <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:150px" />

                        }
                    }
                </div>
                <div class="col-md-6" style="margin-top:-120px">
                    <table style="text-align:right;" data-sortable="" width="900">


                        <tr>
                            <td style="text-align:right;">@company.Comp_Name</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                        <tr>
                            <td style="text-align:right;">العنوان: &nbsp&nbsp @company.Comp_Address  </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td style="text-align:right;">@company.Comp_phone &nbsp&nbsp  :  هاتف الشركة</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td style="text-align:right;">@company.Comp_Email &nbsp&nbsp  : البريد الالكتروني للشركة</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                            <td></td>
                            <td></td>
                            <td> </td>
                        </tr>

                        @*<tr>
                                <td style="text-align:right; padding-top:20px">
                                    @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                                    &nbsp&nbsp  : تاريخ عرض السعر
                                </td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>

                                <td></td>
                                <td></td>
                                <td> </td>
                            </tr>*@


                    </table>
                </div>
            </div>
            <br />
            <br />
        </div>
        <div style="text-align: center;">

            <text style="text-align: center;  font-size:30px;">سند صرف | Expence </text>

        </div>
        <br />
        <br />
        <table class="table" style="text-align:right;">

            <tr>
                <td style="text-align:right;border-bottom:hidden;  padding-top:0px">
                    @Model.GLCode
                </td>
                <th style="text-align:right;border-bottom:hidden; padding-top:0px">
                    رقم المصروف
                </th>

                <td style="text-align:right;border-bottom:hidden; padding-top:0px">
                    @Convert.ToDateTime(Model.GL_Date).Day-@Convert.ToDateTime(Model.GL_Date).Month-@Convert.ToDateTime(Model.GL_Date).Year
                </td>
                <th style="text-align:right;border-bottom:hidden; padding-top:0px">
                    التاريخ
                </th>

            </tr>





        </table>

        <div>
            <table class="table" style="text-align:right;">
                <thead>
                    <tr>
                        <th style="text-align:center;">
                            الوصف
                        </th>
                        <th style="text-align:center;">
                            ﻣﺮﻛﺰ ﺗﻜﻠﻔﺔ
                        </th>
                        <th style="text-align:center;">
                            دائن
                        </th>
                        <th style="text-align:center;">
                            مدين
                        </th>
                        <th style="text-align:center;">
                            الحساب المساعد
                        </th>
                        <th style="text-align:center;">
                            اسم الحساب
                        </th>

                        <th style="text-align:center;">


                        </th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var item in Model.GLDetails)
                    {
                        count++;




                    <tr>
                        <td style="text-align:center;">
                            @item.Description_Detail
                        </td>
                        @if (item.SubLedger_Id > 0)
                        {
                            var subName = Accountingsystem.Models.SubLedger.getDetail((int)item.SubLedger_Id);
                            <td style="text-align:center;">


                                <h>@subName.SubLed_Name</h>
                                <h>@subName.SubLed_Code</h>
                            </td>
                        }
                        else
                        {
                            <td style="text-align:center;"></td>
                        }
                        <td style="text-align:center;">

                            @Math.Round(item.GLDetail_Credit, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td style="text-align:center;">
                            @Math.Round(item.GLDetail_Debit, 2, MidpointRounding.AwayFromZero)

                        </td>
                        @{
                            var Account = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount(item.Account_Id);
                        }
                        <td style="text-align:center;">
                            @item.Account_CHild_Name


                        </td>
                        <td style="text-align:center;">
                            @Account.Account_Name


                        </td>




                        <td style="text-align:center;">
                            @count
                        </td>








                    </tr>

                    }
                </tbody>
            </table>
        </div>
        <table class="table" style="float:right; width:100%" border="0">
            <tr>
                <td style="text-align:center;">@Math.Round(Model.GLDetails.Select(a => a.GLDetail_Credit).Sum(), 2, MidpointRounding.AwayFromZero)</td>

                <td style="text-align:center;">  اجمالي الدائن</td>
            </tr>
            <tr>
                <td style="text-align:center;">@Math.Round(Model.GLDetails.Select(a=>a.GLDetail_Debit).Sum(), 2, MidpointRounding.AwayFromZero)</td>
                <td style="text-align:center;">  اجمالي المدين</td>
            </tr>


        </table>
        <div style="text-align: right;">
            <span style="white-space: pre-line" dir="rtl" ;>@Model.GL_Desc</span>
        </div>

    </div>



</body>
</html>
