    </a>

    <a class="btn BTN-style" href='@Url.Action("getDetailOfStore","ReportsNew")'>
        تقرير كميات المخزن بالتكلفة
    </a>

    <a class="btn BTN-style" href='@Url.Action("CardOfProductQuanity","ReportsNew")'>
