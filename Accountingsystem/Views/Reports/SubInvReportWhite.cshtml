@model Accountingsystem.ViewModel.ReportsVM.SubInvoiceReportVM
@{
    Layout = null;
    var branch = Accountingsystem.Models.Branch.getAddressForInvoice(Model.branchId);
    var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
}




<!DOCTYPE html>
<html>
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />
    @*<link href="~/Content/css/Report.css" rel="stylesheet" />*@
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>
    <title>سند قبض </title>
</head>

<body>

    <div class="container">
        
     
        <div style="text-align:center; font-size:x-large">
            <h2> سند قبض | Receipt Voucher </h2>
        </div>

        <br />
        <br />
        <table style="text-align:right;" align="right" width="500" border="1">
            <tr>
                <td>
                    @Model.InvoiceCode
                </td>
                <th>
                    رقم سند القبض
                </th>
            </tr>

            <tr>
                <td>
                    سند قبض اشتراكات
                </td>
                <th>
                    نوع سند القبض
                </th>
            </tr>
            <tr>
                <td>
                    @Convert.ToDateTime(Model.InvoiceDate).ToString("yyyy/MM/dd ")
                </td>
                <th>
                    تاريخ السند
                </th>
            </tr>

        </table>
        <br /> <br /> <br /> <br /> <br /> <br /> <br />

        <table align="right" width="500" height="90" border="1">
            <tr style="background-color:gray;">
                <td style="text-align:right; ">
                    &nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp المبلغ المستلم
                    <br />
                    <h1 style="margin-left:100px">
                        @String.Format("{0:n}", Math.Round(Model.PayedAmount, 2, MidpointRounding.AwayFromZero))
                    </h1>
                    <div style="margin-left:100px">
                        @Accountingsystem.Models.Currency.GetCurrencyById(1).Currency_Type

                    </div>
                </td>

            </tr>
        </table>
        <br /><br /> <br /><br />
        <table class="table table-bordered" style="text-align:center;" data-sortable="" width="900" border="1">
            <tr style="background-color:gray;">

                @*<th style="text-align:center; ">
                        المتبقى &nbsp&nbsp&nbsp&nbsp
                    </th>*@
                <th style="text-align:center; ">
                    المبلغ المستلم &nbsp&nbsp&nbsp&nbsp
                </th>



                <th style="text-align:center; ">
                    اسم العميل &nbsp&nbsp&nbsp&nbsp
                </th>
                <th style="text-align:center; ">
                    رقم العميل &nbsp&nbsp&nbsp&nbsp
                </th>
            </tr>

            <tr>
                @*<td>
                        @Math.Round(Model.AmountStill, 2, MidpointRounding.AwayFromZero)
                    </td>*@
                <td>
                    @Math.Round(Model.PayedAmount, 2, MidpointRounding.AwayFromZero)
                </td>


                <td>
                    @Model.CustomerName
                </td>
                <td>
                    @Model.CustomerCode
                </td>
            </tr>


        </table>
        <br />
        <div style="text-align:right;color:black;font-size:x-large;margin-bottom:50px;">


        </div>
        <br />

        <table style="text-align:right;" align="right" width="500" border="1">
            <tr>
                <td>
                    @Model.SubscriptionCode
                </td>
                <th>
                    رقم الاشتراك
                </th>
            </tr>

            <tr>
                <td>
                    @Math.Round(Model.SubscriptionAmount, 2, MidpointRounding.AwayFromZero)
                </td>
                <th>
                    قيمة الاشتراك
                </th>
            </tr>
            <tr>
                <td>
                    @Model.SubScription_Type
                </td>
                <th>
                    نوع الاشتراك
                </th>
            </tr>
            <tr>
                <td>
                    @Model.startSub.ToShortDateString()
                </td>
                <th>
                    تاريخ بداية الاشتراك
                </th>
            </tr>
            <tr>
                <td>
                    @Model.EndSub.Value.ToShortDateString()
                </td>
                <th>
                    تاريخ نهاية الاشتراك
                </th>
            </tr>
            <tr>
                <td>
                    @Model.PaymentMethod
                </td>
                <th>
                    طريقة الدفع
                </th>
            </tr>
            <tr>
                <td>
                    @Model.description
                </td>
                <th>
                    الوصف
                </th>
            </tr>
        </table>


    </div>
    <br />

    <table class="table table-bordered" style="text-align:center;" data-sortable="" width="900" border="1">
        <tr style="background-color:gray;">

            @*<th style="text-align:center; ">
                    المتبقى &nbsp&nbsp&nbsp&nbsp
                </th>*@
            <th style="text-align:center; ">
                المدير &nbsp&nbsp&nbsp&nbsp
            </th>



            <th style="text-align:center; ">
                المحاسب  &nbsp&nbsp&nbsp&nbsp
            </th>
            <th style="text-align:center; ">
                توقيع المستلم &nbsp&nbsp&nbsp&nbsp
            </th>
        </tr>

        <tr>

            <td>
                -------------------------------
            </td>
            <td>
                ---------------------------------
            </td>
            <td>
                ---------------------------------
            </td>
        </tr>


    </table>


    <footer style="margin-top:85%;"></footer>
</body>
</html>
