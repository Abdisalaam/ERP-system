@model Accountingsystem.ViewModel.PrintVM.MaintenanceOrderPrintVM



@{
    Layout = null;
    int counter = 1;
    decimal totals = 0;
    decimal totalbeforTax = 0;
    decimal totalaftertax = 0;
    decimal totaltaxes = 0;
    decimal totalafterFixed = 0;
}

<!DOCTYPE html>

<html>



<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>
    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <title> سند استلام</title>
</head>
<body>

    <div class="container">
        <div class="row">
            <div class="row">
                <div class="col-md-6">


                    @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
                    {
                        <div>
                            <h style="padding-top:100px">
                                <br /><br />
                            </h>
                        </div>
                    }
                    else
                    {
                        foreach (var item2 in Model.company.CompanyPhotoDetails)
                        {
                            <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                        }
                    }
                </div>
                <div class="col-md-6" style="margin-top:-70px">
                    <table style="text-align:right;" data-sortable="" width="900">

                        <thead>
                            <tr>
                                <td style="text-align:right;">@Model.company.Comp_Name</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>

                            </tr>
                            <tr>
                                <td style="text-align:right;">العنوان: &nbsp&nbsp @Model.company.Comp_Address  </td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="text-align:right;">@Model.company.Comp_phone &nbsp&nbsp  :  هاتف الشركة</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td style="text-align:right;">@Model.company.Comp_Email &nbsp&nbsp  : البريد الالكتروني للشركة</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>

                                <td></td>
                                <td></td>
                                <td> </td>
                            </tr>

                            @*<tr>
                                    <td style="text-align:right; padding-top:20px">
                                        @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                                        &nbsp&nbsp  : تاريخ الفاتورة
                                    </td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>

                                    <td></td>
                                    <td></td>
                                    <td> </td>
                                </tr>*@

                        </thead>
                    </table>
                </div>
            </div>
            <br />
            <br />
        </div>
        <div style="text-align: center;">

            <text style="text-align: center;  font-size:30px;">سند استلام |Receipt </text>

        </div>
        <br />
        <br />

        <table class="table" style="text-align:right;">

            <tr>
                <td style="text-align:right;border-bottom:hidden;width:200px;  padding-top:0px">
                    @Model.customer.Customer_Name
                </td>
                <th style="text-align:right;border-bottom:hidden;width:200px; padding-top:0px">
                    العميل
                </th>

                <td style="text-align:right;border-bottom:hidden; padding-top:0px">
                    @Model.Order_Code
                </td>
                <th style="text-align:right;border-bottom:hidden; padding-top:0px">
                    رقم التسلم
                </th>

            </tr>

            <tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.customer.Customer_Phone
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    جوال
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Convert.ToDateTime(Model.Date).Day-@Convert.ToDateTime(Model.Date).Month-@Convert.ToDateTime(Model.Date).Year
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    تاريخ التسلم
                </th>
            </tr>

            <tr>
                <td style="text-align:right;border-bottom:hidden; padding-top:0px">
                    @Model.customer.Customer_Mobile
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    هاتف
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.Model
                </td>

                <th style="text-align:right; border-bottom:hidden;padding-top:0px">
                    مودل الجهاز
                </th>

            </tr>
            <tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.customer.Customer_TaxNumber
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    رقم الضريبى للعميل
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.SerialNumber
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    رقم التسلسل للجهاز
                </th>

            </tr>
            <tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.customer.Customer_Mail
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    البريد الالكترونى
                </th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.company.Tax_Number
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    الرقم الضريبي للشركة
                </th>
            </tr>
            <tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px"></td>
                <th></th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    @Model.employee.Emp_Name
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    الموظف
                </th>

            </tr>

            <tr>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    <span style="white-space: pre-line">@Model.Describtion</span>
                </td>
                <th>حالة الجهاز</th>
                <td style="text-align:right;border-bottom:hidden;padding-top:0px">
                    <span style="white-space: pre-line">@Model.RequiredDescribtion</span>
                </td>
                <th style="text-align:right;border-bottom:hidden;padding-top:0px">
                    المطلوب
                </th>

            </tr>

        </table>

        @if (Model.MyDetails.Count() > 0)
        {

            <div>
                <table class="table" style="text-align:right;">
                    <thead>
                        <tr style="text-align:right;">


                            <th style="text-align:right">المجموع<br />Total</th>
                            <th style="text-align:right">سعر الوحدة<br />U.P.</th>
                            <th style="text-align:right">الكمية<br />(Qty)</th>
                            <th style="text-align:right">وحدة القياس<br />MeasureUnit</th>
                            <th style="text-align:right">البيان<br />Description</th>
                            <th style="text-align:right">رقم الموديل<br />Model No</th>
                            <th style="text-align:right">رقم المنتج<br />Code</th>
                            <th style="text-align:right">م<br />S</th>
                        </tr>

                    </thead>
                    <tbody>
                        @foreach (var item in Model.MyDetails)
                        {
                            <tr>
                                <td>
                                    @Math.Round(item.amountBeforeTax, 2, MidpointRounding.AwayFromZero)
                                </td>
                                <td>
                                    @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
                                </td>
                                <td>

                                    @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
                                </td>
                                <td>
                                    @item.MeasureUnit
                                </td>
                                <td>
                                    @{
                                        if (string.IsNullOrEmpty(item.Product_Description))
                                        {
                                            @item.Product_Name
                                        }
                                        else
                                        {
                                            @item.Product_Name<br />
                                            <div style="font-size:xx-small">
                                                @item.Product_Description
                                            </div>
                                        }
                                    }


                                </td>
                                <td>
                                    @item.Product_Model

                                </td>
                                <td>
                                    @item.productcode
                                </td>
                                <td>
                                    @counter
                                </td>
                                @*
                                    <td>
                                        @item.tax.Tax_Name  @Math.Round(item.tax.Tax_Percentage, 2, MidpointRounding.AwayFromZero) %
                                    </td>
                                    <td>
                                        @Math.Round(item.Total_Tax, 2, MidpointRounding.AwayFromZero)
                                    </td>
                                    <td>
                                        @Math.Round(item.Total_Amount_Detail, 2, MidpointRounding.AwayFromZero)
                                    </td>*@
                            </tr>
                            counter++;
                            totals = totals + (item.Product_Quantity * item.Product_Price);
                            totalbeforTax = totalbeforTax + item.amountBeforeTax;
                            totalaftertax = totalaftertax + item.Total_Amount_Detail;
                            totaltaxes = totaltaxes + item.Total_Tax;
                        }
                    </tbody>
                </table>
            </div>
            <br />
            <div class="row">
                <div style="width: 50%; float:left;">
                    <table class="table" style="text-align:center">


                        <tr>
                            <td>
                                @Math.Round(totals, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>الاجمالي</td>
                        </tr>
                        @*<tr>
                                <td>@Math.Round(Model.Master_Discount, 2, MidpointRounding.AwayFromZero)</td>
                                <td> الخصم</td>
                            </tr>*@
                        @*<tr>
                                <td> @Math.Round(Model.totalAfterdiscount, 2, MidpointRounding.AwayFromZero)</td>
                                <td> القيمة الاجمالية بعد الخصم</td>
                            </tr>*@ @if (Model.Masterdiscount > 0)
                        {
                            <tr>

                                <td>

                                    @Math.Round(Model.Masterdiscount, 2, MidpointRounding.AwayFromZero)

                                </td>
                                <td> الخصم @Math.Round(Model.Masterdiscount, 2, MidpointRounding.AwayFromZero)% </td>
                            </tr>
                        }
                            @if (Model.totalTax > 0)
                            {
                                <tr>
                                    <td> @Math.Round(Model.totalTax, 2, MidpointRounding.AwayFromZero)</td>
                                    <td> @Model.MyDetails.FirstOrDefault().tax.Tax_Name</td>
                                </tr>
                            }



                            <tr>


                                <td>
                                    <h5>
                                        <strong>
                                            @Math.Round((totalaftertax - Model.fixed_Discount), 2, MidpointRounding.AwayFromZero)
                                        </strong>
                                    </h5>
                                </td>
                                <td>
                                    <h5>
                                        <strong>
                                            الصافي
                                        </strong>
                                    </h5>
                                </td>

                            </tr>


                        </table>
                    </div>

                </div>
            }


        @*<div class="row" style="width: 100%; clear:both; text-align:right; font-size:20px; padding-top: 20px;">
            <div style="width: 50%; height: 50%; float:left;">
                <text> :محرر التسلم</text>
            </div>
            <div style="width: 50%; float:right;">
                <div>
                    <text> :اسم المستلم</text>
                </div>
                <div>
                    <text> :التوقيع</text>
                </div>
                <div>
                    <text> :التاريخ</text>
                </div>
            </div>
        </div>*@

    </div>


    <footer style="margin-top:0%;"></footer>

</body>







</html>



