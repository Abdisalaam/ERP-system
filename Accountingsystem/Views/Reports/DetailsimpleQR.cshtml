                        <td style="text-align:right;font-weight:900">صافي المبلغ المستحق</td>

                    </tr>
                    if (Model.Serial_Number != null && Model.Serial_Number.StartsWith("SAL-"))
                    {
                        var payemntvalue = Accountingsystem.Models.Receipt.getAllPayForthatInvoicebyCode(Model.Serial_Number);
                        <tr style="text-align:right;">


                            <td style="text-align:center"> @Math.Round(payemntvalue, 2, MidpointRounding.AwayFromZero)</td>
                            <td style="text-align:right">Total Amount Paid </td>
                            <td style="text-align:right">المبلغ المدفوع</td>

                        </tr>
                        <tr style="text-align:right;">


                            <th style="text-align:center"> @Math.Round(((Model.Total_Amount + Model.TotalNewTaxs) - Model.AllowDiscount) - payemntvalue, 2, MidpointRounding.AwayFromZero)</th>
                            <th style="text-align:right">Total Remaining Amount </th>
                            <th style="text-align:right">المبلغ المتبقي</th>

                        </tr>

                    }
                    else if (Model.Serial_Number != null && Model.Serial_Number.StartsWith("POS-"))
                    {
                        var payemntvalue = Accountingsystem.Models.POSReceipt.getAllPayForthatInvoicebyCode(Model.Serial_Number);
                        <tr style="text-align:right;">


                            <td style="text-align:center"> @Math.Round(payemntvalue, 2, MidpointRounding.AwayFromZero)</td>
                            <td style="text-align:right">Total Amount Paid </td>
                            <td style="text-align:right">المبلغ المدفوع</td>

                        </tr>
                        <tr style="text-align:right;">


                            <th style="text-align:center"> @Math.Round(((Model.Total_Amount + Model.TotalNewTaxs) - Model.AllowDiscount) - payemntvalue, 2, MidpointRounding.AwayFromZero)</th>
                            <th style="text-align:right">Total Remaining Amount </th>
                            <th style="text-align:right">المبلغ المتبقي</th>

                        </tr>

                    }
                    else if (Model.Serial_Number.StartsWith("PINV-"))
                    {


                    }

                    else
                    {
                        <tr style="text-align:right;">




                            <td style="text-align:center"> @Math.Round(((Model.Total_Amount + Model.TotalNewTaxs) - Model.AllowDiscount), 2, MidpointRounding.AwayFromZero) </td>


                            <td style="text-align:right"> Total Amount Paid</td>


                            <td style="text-align:right"> المبلغ المدفوع </td>



                        </tr>


                        foreach (var item in Model.QRPaymentMethods)
                        {
