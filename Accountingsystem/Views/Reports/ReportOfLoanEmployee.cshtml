@model Accountingsystem.ViewModel.ReportsVM.EmpLoyeeLoanVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />

@*<link href="~/Content/css/Report.css" rel="stylesheet" />*@
<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>


@{
    Layout = null;
    decimal totalBalance = 0;
}
<style type="text/css">
    table {
        page-break-inside: auto
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title> حساب موظفين</title>

</head>
<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>




            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير ارصدة الموظفيين / Balance Of Employees Report

        </div>




    </div>
    <hr />

    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr style="text-align:right;">
                <th style="text-align:center">الرقم<br />NO</th>
                <th style="text-align:center">الموظف<br />Employee</th>
                <th style="text-align:center">الرصيد<br />Balance</th>




            </tr>
        </thead>

        @foreach (var item in Model.Accounts)
        {
            var ballance = Accountingsystem.Models.Accounts.RefreshTheBallanceOfCustomer(item.Account_Code);
            totalBalance += ballance;
            <tr>

                <td style="text-align:center">
                    @item.Account_Code  
                </td>
                <td style="text-align:center">
                    @item.Account_Name 
                </td>
                @if (@Math.Round(ballance, 2, MidpointRounding.AwayFromZero) >= 0)
                {
                    <td style="text-align:center">
                        @Math.Round(ballance, 2, MidpointRounding.AwayFromZero)  
                    </td>
                }
                else
                {
                    var dif = ballance * -1;
                    <td style="text-align:center">
                        ( @Math.Round(dif, 2, MidpointRounding.AwayFromZero))  
                    </td>
                }


            </tr>


        }
        <tr style="text-align:right;">
            <th style="text-align:center">الاجمالي<br />Total</th>
            <th style="text-align:center"></th>
            @if (@Math.Round(totalBalance, 2, MidpointRounding.AwayFromZero) >= 0)
            {
                <th style="text-align:center">
                    @Math.Round(totalBalance, 2, MidpointRounding.AwayFromZero)  &nbsp&nbsp&nbsp&nbsp
                </th>
            }
            else
            {
                var dif = totalBalance * -1;
                <th style="text-align:center">
                    ( @Math.Round(dif, 2, MidpointRounding.AwayFromZero))  &nbsp&nbsp&nbsp&nbsp
                </th>
            }




        </tr>
    </table>

    <hr />

    <footer style="margin-top:90%;"></footer>


</body>
</html>


