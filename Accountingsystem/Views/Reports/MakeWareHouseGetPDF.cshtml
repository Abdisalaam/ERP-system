@model Accountingsystem.ViewModel.ReportsVM.WarehousesReportVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />
@{
    Layout = null;
    var Store = "المخازن";
    var dateto = "الي" + Convert.ToDateTime(Model.EndDate).ToString("yyyy/MM/dd ");
    decimal total = 0;
    var datefrom = "من" + Convert.ToDateTime(Model.StartDate).ToString("yyyy/MM/dd ");
}
<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
<!DOCTYPE html>

<html>

<head>
    <meta name="viewport" />
    <title>تقرير تكاليف المخازن</title>


</head>

<body>
    
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@

    <div class="container">
        <div class="container">
            <div class="row">
                <div class="col-md-6">


                    @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
                    {
                        <div>
                            <h style="padding-top:100px">
                                <br /><br />
                            </h>
                        </div>
                    }
                    else
                    {
                        foreach (var item2 in Model.company.CompanyPhotoDetails)
                        {
                            <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                        }
                    }
                </div>
                <div class="col-md-6" style="margin-top:-70px">
                    <table style="text-align:right;" data-sortable="" width="900">


                        <tr>
                            <td style="text-align:right;">@Model.company.Comp_Name</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>


                        @*<tr>
                                <td style="text-align:right; padding-top:20px">
                                    @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                                    &nbsp&nbsp  : تاريخ عرض السعر
                                </td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>

                                <td></td>
                                <td></td>
                                <td> </td>
                            </tr>*@


                    </table>
                </div>
            </div>
        </div>
        <br />
        <br />
        <br />
        <br />
        <br />
        <br />
        <div class="container">

            <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
                تقرير تكاليف المخازن / Cost Of Stores Report

            </div>


            <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
                @datefrom      @dateto

            </div>


        </div>

    </div>
    <hr />
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr style="text-align:right;">


                <th style="text-align:center;font-size:xx-small">المخزن<br />store</th>
                <th style="text-align:center;font-size:xx-small">الاجمالي<br />total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Stores)
            {
                total += item.BalanceSheetValue.Value;
                <tr>

                    <td style="text-align:center;">
                        @if (@item.Account_Name == "المخزون")
                        {
                            @Store

                        }
                        else
                        {
                            @item.Account_Name
                        }

                    </td>

                    <td style="text-align:center;">
                        @Math.Round(item.BalanceSheetValue.Value, 2, MidpointRounding.AwayFromZero)  &nbsp&nbsp&nbsp&nbsp
                    </td>

                </tr>




            }

        <thead>
            <tr style="text-align:right;">

                <th style="text-align:center;font-size:xx-small">الاجمالي<br />total</th>
                <th style="text-align:center;font-size:xx-small"> @Math.Round(total, 2, MidpointRounding.AwayFromZero)</th>

            </tr>
        </thead>

    </table>
    </html>
