    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.ReportsGetAllReportfinancial.BalanceSheet
        </div>
        <div class="text-center">
            @datefrom      @dateto

        </div>
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div style="text-align:Center;font-size:large;margin-bottom:25px;">
            <h> الاصول| Assets</h>

        </div>

        <div class="table-responsive mb-4 mt-4">
            <table class="table" style="direction:rtl;">

                <tr>
                    <th></th>
                    <th style="text-align:right;color:#e6840f"> الرقم <br /> NO</th>
                    <th style="text-align:right;color:#e6840f">
                        الحساب<br />Account
                    </th>

                    <th style="text-align:right;color:#e6840f ">
                        القيمة <br /> Value
                    </th>


                </tr>
                @foreach (var item in Model.AssetList)
                {

                    <tr>
                        <td></td>
                        @if (item.Account_Level == 1)
                        {
                            <td style="text-align:right"><h4>@item.Account_Code</h4> </td>
                            <td style="text-align:right"><h4>@item.Account_Name</h4> </td>
                        }
                        else
                        {
                            <td style="text-align:right"> @item.Account_Code</td>
                            <td style="text-align:right">
                                @item.Account_Name
                            </td>
                        }
                        @if (Math.Round(item.Account_Balance, 2, MidpointRounding.AwayFromZero) >= 0)
                        {

                            <td style="text-align:right">
                                @Math.Round(item.Account_Balance, 2, MidpointRounding.AwayFromZero)
                                @*@item.Account_Balance  &nbsp&nbsp&nbsp&nbsp*@
                            </td>

                        }
                        else
                        {

                            <td style="text-align:right">
                                (@Math.Round(item.Account_Balance * -1, 2, MidpointRounding.AwayFromZero))

                            </td>
                        }


                    </tr>



                }
            </table>
        </div>

        <p CLASS="breakhere">


        </p>

        <div style="text-align:Center;font-size:large;margin-bottom:25px;">
            <h> الخصوم | liabilities</h>

        </div>
        <div class="table-responsive mb-4 mt-4">
            <table class="table" style="direction:rtl;">

                <tr>
                    <th></th>
                    <th style="text-align:right;color:#e6840f"> الرقم <br /> NO</th>
                    <th style="text-align:right;color:#e6840f">
                        الحساب<br />Account
                    </th>

                    <th style="text-align:right;color:#e6840f ">
                        القيمة <br /> Value
                    </th>


                </tr>
                @foreach (var item in Model.Libality)
                {

                    <tr>
                        <td></td>
                        @if (item.Account_Level == 1)
                        {
                            <td style="text-align:right"><h4>@item.Account_Code</h4> </td>
                            <td style="text-align:right"><h4>@item.Account_Name</h4> </td>
                        }
                        else
                        {
                            <td style="text-align:right"> @item.Account_Code</td>
                            <td style="text-align:right">
                                @item.Account_Name
                            </td>
                        }
                        @if (Math.Round(item.Account_Balance, 2, MidpointRounding.AwayFromZero) >= 0)
                        {

                            <td style="text-align:right">
                                @Math.Round(item.Account_Balance, 2, MidpointRounding.AwayFromZero)
                                @*@item.Account_Balance  &nbsp&nbsp&nbsp&nbsp*@
                            </td>

                        }
                        else
                        {

                            <td style="text-align:right">
                                (@Math.Round(item.Account_Balance * -1, 2, MidpointRounding.AwayFromZero))

                            </td>
                        }


                    </tr>



                }
            </table>
        </div>
        <p CLASS="breakhere">


        </p>
        <div style="text-align:Center;font-size:large;margin-bottom:25px;">
            <h>  حقوق الملكية | owner equity</h>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table class="table" style="direction:rtl;">

                <tr>
                    <th></th>
                    <th style="text-align:right;color:#e6840f"> الرقم <br /> NO</th>
                    <th style="text-align:right;color:#e6840f">
                        الحساب<br />Account
                    </th>

                    <th style="text-align:right;color:#e6840f ">
                        القيمة <br /> Value
                    </th>

                </tr>
                @foreach (var item in Model.PropertyRights)
                {

                    <tr>
                        <td></td>
                        @if (item.Account_Level == 1)
                        {
                            <td style="text-align:right"><h4>@item.Account_Code</h4> </td>
                            <td style="text-align:right"><h4>@item.Account_Name</h4> </td>
                        }
                        else
                        {
                            <td style="text-align:right"> @item.Account_Code</td>
                            <td style="text-align:right">
                                @item.Account_Name
                            </td>
                        }
                        @if (Math.Round(item.Account_Balance, 2, MidpointRounding.AwayFromZero) >= 0)
                        {

                            <td style="text-align:right">
                                @Math.Round(item.Account_Balance, 2, MidpointRounding.AwayFromZero)
                                @*@item.Account_Balance  &nbsp&nbsp&nbsp&nbsp*@
                            </td>

                        }
                        else
                        {

                            <td style="text-align:right">
                                (@Math.Round(item.Account_Balance * -1, 2, MidpointRounding.AwayFromZero))

                            </td>
                        }


                    </tr>



                }
            </table>
        </div>
    </div>


    <br />
    <div style="text-align:center; font-weight:bolder; font-size:large;"> الملخص  | Summary </div>
    <div class="table-responsive mb-4 mt-4">
      
        <table class="table" style="direction:rtl;">
            @{
                decimal asset = 0;
                decimal propertie = 0;
                decimal libality = 0;
                if (Model.AssetList.Where(a => a.Account_Level == 1).FirstOrDefault()!=null)
                {
                    asset = Model.AssetList.Where(a => a.Account_Level == 1).FirstOrDefault().Account_Balance;
                }
                if(Model.PropertyRights.Where(a => a.Account_Level == 1).FirstOrDefault() != null)
                {
                    propertie = Model.PropertyRights.Where(a => a.Account_Level == 1).FirstOrDefault().Account_Balance;
                }
                if (Model.Libality.Where(a => a.Account_Level == 1).FirstOrDefault() != null)
                {
                    libality = Model.Libality.Where(a => a.Account_Level == 1).FirstOrDefault().Account_Balance;
                }
                var totalplus =asset;
                var totalmunis = Model.Profit + propertie + libality;
            }
            <tr>

                <td style="text-align:right; color:#e6840f">
                    الاصول| Assets
                </td>
                @if (asset > 0)
                {
                    <td style="text-align:right; color:#e6840f">
                        @Math.Round(asset, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td style="text-align:right; color:#e6840f">
                        (@Math.Round(asset * -1, 2, MidpointRounding.AwayFromZero))
                    </td>
                }
                <td style="text-align:right; color:#e6840f">
                    الخصوم | liabilities
                </td>
                @if (libality > 0)
                {
                    <td style="text-align:right; color:#e6840f">
                        @Math.Round(libality, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td style="text-align:right; color:#e6840f">
                        (@Math.Round(libality * -1, 2, MidpointRounding.AwayFromZero))
                    </td>
                }


            </tr>


            <tr>
                <td></td>
                <td></td>
                <td style="text-align:right; color:#e6840f">
                    حقوق الملكية | owner equity
                </td>

                @if (propertie > 0)
                {
                    <td style="text-align:right; color:#e6840f">
                        @Math.Round(propertie, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td style="text-align:right; color:#e6840f">
                        (@Math.Round(propertie * -1, 2, MidpointRounding.AwayFromZero))
                    </td>
                }

            </tr>
            <tr>
                <td></td>
                <td></td>
                <td style="text-align:right; color:#e6840f">
                    صافي الربح والخسارة | net profit and loss
                </td>
                @if (Math.Round(Model.Profit, 2, MidpointRounding.AwayFromZero) > 0)
                {
                    <td style="text-align:right; color:#e6840f">
                        @Math.Round(Model.Profit, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td style="text-align:right; color:#e6840f">
                        (@Math.Round(Model.Profit * -1, 2, MidpointRounding.AwayFromZero))
                    </td>
                }
            </tr>
            <tr>

                <td style="text-align:right; font-weight:900;color:#e6840f">
                    الاجمالي | Total
                </td>
                @if (Math.Round(totalplus, 2, MidpointRounding.AwayFromZero) > 0)
                {
                    <td style="text-align:right; font-weight:900;color:#e6840f">
                        @Math.Round(totalplus, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td style="text-align:right; font-weight:900;color:#e6840f">
                        (@Math.Round(totalplus * -1, 2, MidpointRounding.AwayFromZero))
                    </td>
                }
                <td style="text-align:right;"></td>

                @if (Math.Round(totalmunis, 2, MidpointRounding.AwayFromZero) > 0)
                {
                    <td style="text-align:right; font-weight:900;color:#e6840f">
                        @Math.Round(totalmunis, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td style="text-align:right; font-weight:900;color:#e6840f">
                        (@Math.Round(totalmunis * -1, 2, MidpointRounding.AwayFromZero))
                    </td>
                }

            </tr>
        </table>
               
    </div>


</div>




