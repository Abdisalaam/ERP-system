@model Accountingsystem.ViewModel.PrintVM.InventoryTransferToInventoryVm
    @{ 
        var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    }
<style type="text/css">
    table {
        page-break-inside: auto
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
    <!-- Bootstrap CSS -->
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }

        .column {
            float: left;
            width: 50%;
            padding: 5px;
        }



        .tho {
            text-align: left;
            padding: 16px;
        }

        * {
            box-sizing: border-box;
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>

    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <title>تحويل مخزني </title>
</head>

<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@

    <div class="container">
        <div class="row">
            <div class="col-md-6">


                @if (company.CompanyPhotoDetails.FirstOrDefault() == null)
                {
                    <div>
                        <h style="padding-top:100px">

                            <br />
                            <br />
                            <br />
                            <br />
                            <br />
                        </h>
                    </div>
                }
                else
                {

                    <img src="data:image/jpg;base64,@Convert.ToBase64String(company.CompanyPhotoDetails.FirstOrDefault().ProImg )" alt="Image" style="width:300px " height="100" />


                }
            </div>
            <div class="col-md-6" style="margin-top:-120px">
                <br />
                <table style="text-align:right;" data-sortable="" width="1100">


                    <tr>
                        <td style="text-align:right;font-weight:900">@Model.company.Comp_Name</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>

                    @if (Model.company.Comp_Field != null && Model.company.Comp_Field != "")
                    {
                        <tr>
                            <td style="text-align:right;">@Model.company.Comp_Field</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                    }
                    <tr>
                        <td style="text-align:right;"> @company.Comp_Address  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    @if (Model.company.CRN != null && Model.company.CRN != "")
                    {
                        <tr>
                            <td style="text-align:right;">@Model.company.CRN</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                        </tr>
                    }
                    <tr>
                        <td style="text-align:right;">@company.Comp_phone  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td style="text-align:right;">@company.Comp_Email  </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>

                    @*<tr>
                        <td style="text-align:right; padding-top:20px">
                            @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                            &nbsp&nbsp  : تاريخ عرض السعر
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>*@


                </table>
            </div>
        </div>
        <br />
        <br />
        <div style="text-align: center;">

            <text style="text-align: center;  font-size:30px;">تحويل مخزني  | Inventory Transfer  </text>

        </div>

        <br />
        <table class="table" style="text-align:right;" dir="rtl">
            <tr>
                <th style="text-align:center;">
                    رقم السند &nbsp&nbsp&nbsp&nbsp
                </th>
                <th style="text-align:center;">
                    وصف السند &nbsp&nbsp&nbsp&nbsp
                </th>
                <th style="text-align:center;">
                    المخزن المحول منه &nbsp&nbsp&nbsp&nbsp
                </th>
                <th style="text-align:center;">
                    المخزن المحول اليه &nbsp&nbsp&nbsp&nbsp
                </th>

                <th style="text-align:center;">
                    تاريخ السند &nbsp&nbsp&nbsp&nbsp
                </th>

            </tr>

            <tr>
                <td style="text-align:center;">
                    @Model.Inv_Code
                </td>
                <td style="text-align:center;">
                    @Model.Decribtion
                </td>

                <td style="text-align:center;">
                    @Model.store_Id
                </td>

                <td style="text-align:center;">
                    @Model.StoreTo
                </td>

                <td style="text-align:center;">

                    @Convert.ToDateTime(Model.Date).ToString("yyyy/MM/dd ")
                </td>
            </tr>


        </table>
        <hr />
        <br />
        <table class="table" style="text-align:right; direction:rtl;width:1100px">
            <thead>
                <tr>
                    <th style="text-align:right">NatureOfGoodsOrServices<br />تفاصيل السلع و الخدمات</th>


                    <th style="text-align:right">MeasureUnit<br />وحدة القياس</th>


                    <th style="text-align:right">Model No<br />رقم الموديل</th>


                    <th style="text-align:center">Quantity <br />الكمية</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.MyDetails)
                {
                    <tr>
                        @{
                            var pro = Accountingsystem.Models.Product.GetProdectById(item.Product_ID);
                            var measure = "";
                        }


                        <td>
                            @{
                                if (string.IsNullOrEmpty(pro.Prod_Descrip))
                                {
                                    @pro.Prod_Name
                                }
                                else
                                {
                                    @pro.Prod_Descrip
                                }
                            }


                        </td>
                        <td>
                            @{ if (pro.MeasuringUnit_ID != null && pro.MeasuringUnit_ID != 0)
                                {

                                    measure = Accountingsystem.Models.MeasuringUnit.GetMeasruingUnitById(pro.MeasuringUnit_ID.Value).MUnit_Descrip;
                                }
                            }
                            @measure
                        </td>
                        <td>
                            @pro.Prod_Mark

                        </td>

                        <td style="text-align:center">
                            @Math.Round(item.Product_Qty, 2, MidpointRounding.AwayFromZero)
                        </td>

                    </tr>

                }
            </tbody>
        </table>
        <br />
        <br />
        <br />
        <br />


        <div>
            <table class="table" style="text-align:right; direction:ltr">

                <thead>
                    <tr style="text-align:right;">


                        <td style="text-align:center;width:300px">
                            @String.Format("{0:n}", Math.Round(Model.MyDetails.Select(a => a.Product_Qty).Sum(), 2, MidpointRounding.AwayFromZero))
                        </td>
                        <td style="text-align:right" width="400px">Total QTY</td>
                        <td style="text-align:right" width="400px">اجمالى الكميات </td>

                    </tr>



                </thead>

            </table>
        </div>

        
    </div>
</body>
</html>