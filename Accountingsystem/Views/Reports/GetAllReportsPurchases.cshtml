
@{
    ViewBag.Title = Accountingsystem.Resources.ReportsGetAllReportsPurchases.ProcurementReports;
    HttpCookie cookie = Request.Cookies["Language"];
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";

        }
    }


</head>

<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    <div class="text-center">
                        @Accountingsystem.Resources.ReportsGetAllReportsPurchases.ProcurementReports
                    </div>
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class="row col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">

                <div class="col-md-12">
                    <div class="form-group">
                        <a id="salesReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("getdateofPurchase","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsPurchases.ProcurementReport
                            <span id="salesReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <a id="salesReturnReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("getdateofPurchaseclassification","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsPurchases.PurchaseClassificationReport
                            <span id="salesReturnReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <a id="salesClassificationReportBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("getdateofRecall","ReportsNew")'>
                            @Accountingsystem.Resources.ReportsGetAllReportsPurchases.ProcurementReturnReport
                            <span id="salesClassificationReportBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>



            </div>
        </div>

    </div>

</div>





@*<a  class="btn BTN-style" href='@Url.Action("GetAllPurchaseWithTax")'>
        تقرير المشتريات بالضريبة
    </a>

    <a  class="btn BTN-style" href='@Url.Action("GetAllPurchaseWithOutTax")'>
        تقرير المشتريات من غير الضريبة
    </a>*@

@section Scripts {


    <script type="text/javascript">

        $("#salesReportBtn").click(function (e) {
            $("#salesReportBtnSpinner").show();
        });
        $("#salesReturnReportBtn").click(function (e) {
            $("#salesReturnReportBtnSpinner").show();
        });
        $("#salesClassificationReportBtn").click(function (e) {
            $("#salesClassificationReportBtnSpinner").show();
        });
    </script>
}
