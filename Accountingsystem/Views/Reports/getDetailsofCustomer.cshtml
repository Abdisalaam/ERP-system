@model Accountingsystem.ViewModel.ReportsVM.CustomerTransactionGettingDateVM

@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.ReportsGetDetailsofCustomer.CustomerReport;
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
        }
    }


</head>

@using (Html.BeginForm("getDetailsofCustomer", "Reports", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.CustomerID)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ReportsGetDetailsofCustomer.CustomerReport)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReportsGetDetailsofCustomer.StartDateOfReport)
                                    @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.ReportsGetDetailsofCustomer.CreateReport <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index", "Customer", null)'>
                        @Accountingsystem.Resources.ReportsGetDetailsofCustomer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>

}
    @section Scripts {
        @{

            if (cookie != null && cookie.Value != null)
            {
                if (cookie.Value == "en")
                {
                    <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                }
                else
                {
                    <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                }
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>

            }
        }

        <script type="text/javascript">
            var currentDate = new Date();
            var _StartDate = flatpickr(document.getElementById('Date'), {
                defaultDate: currentDate
            });            
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });
            $('#catchReceiptCreateForm').submit(function () {
                $("#createExpensesSpinner").show();
            });
        </script>
    }
