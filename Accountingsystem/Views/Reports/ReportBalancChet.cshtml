@model Accountingsystem.ViewModel.ReportsVM.ReportMasterGeneralBudgetVM
@{
    var dateto = "الي" + Convert.ToDateTime(Model.EndDate).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.StartDate).ToString("yyyy/MM/dd ");
    if (Convert.ToDateTime(Model.StartDate).Year == 1995)
    {
        datefrom = "";
    }

    if (Convert.ToDateTime(Model.EndDate).Year == 2200)
    {
        dateto = "";
    }
    Layout = null;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير قائمة المركز المالي  </title>

    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />

    <STYLE TYPE="text/css">
        .breakhere {
            page-break-after: always;
            display: block;
            content: "\A0";
        }
    </STYLE>
    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        td {
            font-size: 10px;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>


</head>


<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
