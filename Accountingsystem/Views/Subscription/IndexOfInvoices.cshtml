@model IEnumerable<Accountingsystem.Models.SubscriptionInvoice>
@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.SubscriptionIndexOfInvoices.SubscriptionsCatchReceiptList;
    int count = 1;
}
<head>
    @{
        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }
</head>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">
                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "IndexOfInvoices",new {all=1 })"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.validate.ALL</a>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-item">
                                            <a href='@Url.Action("Index")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.SubscriptionIndexOfInvoices.BackToSubscriptionsList</a>

                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.SubscriptionIndexOfInvoices.SubscriptionsCatchReceiptList
        </div>
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.Number)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.CatchReceiptNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.SubscriptionNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.DescriptionOfSubscription)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.ExpiryDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.StartingDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.SubscriptionValue)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.CustomerName)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.CustomerNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.PaidValue)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.CatchReceiptDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndexOfInvoices.SubscriptionCase)
                        </th>
                        <th>

                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        @Html.HiddenFor(modelItem => item.Inv_ID)
                        <tr>
                            <td>
                                @count
                                @{count = count + 1;}
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Serial_Number)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Subscrip_Code)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Subscrip_Description)
                            </td>
                            <td>
                                @item.DeadLine.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @item.StartTime.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @Math.Round(item.Estimate_Amount, 2, MidpointRounding.AwayFromZero)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Customer_Name)
                            </td>
                            <td>
                                @{
                                    if (item.Customer_Id != null || item.Customer_Id != 0)
                                    {
                                        var CustomerCode = Accountingsystem.Models.Customer.GetCustomerById(item.Customer_Id.Value).Customer_Code;
                                        <h>@CustomerCode</h>
                                    }

                                }
                            </td>

                            <td>
                                @Math.Round(item.Pay_Amount, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>
                                @item.InvoiceDate.Value.ToShortDateString()
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Transaction_State)
                            </td>

                            <td>
                                <div class="btn-group">

                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                        <a href='@Url.Action("SubInvReportWhite", new { controller = "Reports", id = item.Inv_ID })' class="dropdown-item" target="_blank">
                                            @Accountingsystem.Resources.SubscriptionIndexOfInvoices.Print
                                        </a>
                                        <a href='@Url.Action("DetailOFSubInv","Subscription",new { ID = item.Inv_ID })' class="dropdown-item">
                                            @Accountingsystem.Resources.SubscriptionIndexOfInvoices.Details
                                        </a>

                                    </div>
                                </div>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>


@section Scripts {

    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/dataTables.buttons.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/button-ext/jszip.min.js")"></script>
