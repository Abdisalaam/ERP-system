@model IEnumerable<Accountingsystem.Models.Subscription>

@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.SubscriptionIndex.SubscriptionsList;
    var thiscustomercode = "";
    var thiscustomerName = "";
    decimal balanceCustomrer = 0;
    int count = 1;
}

<head>
    @{
        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }
</head>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">
                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    @if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات"))
                                    {
                                            <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "Index",new {all=1 })"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.validate.ALL</a>
                                        </div>
                                    </li>
                                        <li>
                                            <div class="dropdown-item">
                                                <a href=" @Url.Action( "Create")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.SubscriptionIndex.CreateNew</a>

                                            </div>
                                        </li>
                                        <li>
                                            <div class="dropdown-item">
                                                <a href='@Url.Action("IndexOfInvoices", "Subscription")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.SubscriptionIndex.CatchReceiptOfSubscription</a>

                                            </div>

                                        </li>
                                        <li>
                                            <div class="dropdown-item">
                                                <a href='@Url.Action("IndexStopedSup", "Subscription")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.SubscriptionIndex.DiscontinuedSubscriptions</a>

                                            </div>

                                        </li>
                                        <li>
                                            <div class="dropdown-item">
                                                <a href='@Url.Action("IndexFinshedSub", "Subscription")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.SubscriptionIndex.ExpiredSubscriptions</a>

                                            </div>
                                        </li>
                                        <li>
                                            <div class="dropdown-item">
                                                <a href='@Url.Action("IndexSubPending", "Subscription")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.SubscriptionIndex.UnsupportedSubscriptions</a>

                                            </div>

                                        </li>
                                        <li>
                                            <div class="dropdown-item">
                                                <a href='@Url.Action("IndexNonPaidSubs", "Subscription")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.SubscriptionIndex.NoticeOfSubscriptionsForPayment</a>

                                            </div>

                                        </li>

                                        <li>
                                            <div class="dropdown-item">
                                                <a href='@Url.Action("IndexIsCanceld", "Subscription")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.SubscriptionIndex.Void</a>

                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.SubscriptionIndex.SubscriptionsList
        </div>
        <div class="text-center">
            <label>@ViewBag.msg</label>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.Number)
                        </th>
                        <th>

                            @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.InvoiceNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.SubscriptionsNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.CustomerNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.CustomerName)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.CustomerBalance)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.PaymentCase)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.NetAfterTax)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.AmountPaid)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.StartingDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.ExpiryDate)
                        </th>



                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.DateOfSuspension)
                        </th>
                        <th>

                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        @Html.HiddenFor(modelItem => item.Payment_Method)
                    <tr>
                        <td>
                            @count
                            @{count = count + 1;}
                        </td>
                        @if (item.Number == null)
                        {
                            <td>
                                @Html.DisplayFor(model => item.Subscrip_Code)
                            </td>
                        }
                        else
                        {
                            <td>
                                @Html.DisplayFor(model => item.Number)
                            </td>
                        }
                        <td>
                            @Html.DisplayFor(modelItem => item.Subscrip_Code)
                        </td>
                        @{
                            if (item.Customer_Id.Value > 0)
                            {
                                var customer = Accountingsystem.Models.Customer.GetCustomerById(item.Customer_Id.Value);


                                thiscustomercode = customer.Customer_Code;
                                thiscustomerName = customer.Customer_Name;
                                balanceCustomrer = Accountingsystem.Models.Accounts.RefreshTheBallanceOfCustomer(thiscustomercode);
                            }
                        }

                        <td>
                            @thiscustomercode
                        </td>
                        <td>
                            @thiscustomerName
                        </td>

                        <td>
                            @Math.Round(balanceCustomrer, 2, MidpointRounding.AwayFromZero)
                        </td>
                        @if (item.AmountAfterTax == 0)
                        {
                            <td>
                                @Html.DisplayName(Accountingsystem.Resources.SubscriptionIndex.Free)
                            </td>
                        }
                        else
                        {
                            <td>
                                @Html.DisplayFor(modelItem => item.Sub_Pay_State)
                            </td>
                        }
                        <td>
                            @Math.Round(item.AmountAfterTax, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>
                            @Math.Round(item.Payed_Amount.Value, 2, MidpointRounding.AwayFromZero)

                        </td>
                        <td>
                            @item.StartTime.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            @item.DeadLine.ToString("dd/MM/yyyy")
                        </td>







                        <td>
                            @if (item.Subscrip_DateEnd != null)
                            {
                                @item.Subscrip_DateEnd.Value.ToString("dd/MM/yyyy")
                            }

                        </td>

                        <td>
                            <div class="btn-group">

                                <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                </button>
                                <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                    @if (item.Payed_Amount == 0 || item.Payed_Amount < item.AmountAfterTax)

                                    {
                                        if (item.AmountAfterTax == 0)

                                        {

                                        }
                                        else
                                        {
                                            if (Math.Round(item.Payed_Amount.Value, 2, MidpointRounding.AwayFromZero) == Math.Round(item.AmountAfterTax, 2, MidpointRounding.AwayFromZero))
                                            {

                                            }
                                            else
                                            {
                                                if (Request.IsAuthenticated && (!User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع")))
                                                {
                                                    <a href='@Url.Action("CreateSubInv", "Subscription", new { id = item.Subscrip_Id })' class="dropdown-item">
                                                        @Accountingsystem.Resources.SubscriptionIndex.PayNow
                                                    </a>
                                                }
                                            }

                                        }
                                    }
                                    else
                                    {

                                    }

                                    @if (item.SubType_State == Accountingsystem.Models.SubType_State.على_وشك_الانتهاء || item.SubType_State == Accountingsystem.Models.SubType_State.منتهى)
                                    {
                                        if (Request.IsAuthenticated && (!User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع")))

                                        {
                                            <a href='@Url.Action("CreateNew", "Subscription", new { id = item.Subscrip_Id })' class="dropdown-item">
                                                @Accountingsystem.Resources.SubscriptionIndex.SubscriptionRenewal
                                            </a>
                                        }
                                    }
                                    @if (Request.IsAuthenticated && (!User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع")))
                                    {
                                        <a href='@Url.Action("StopSupscription", "Subscription", new { id = item.Subscrip_Id })' class="dropdown-item">
                                            @Accountingsystem.Resources.SubscriptionIndex.StopSubscription
                                        </a>
                                    }

                                    @if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("مساعد محاسب"))
                                    {
                                        <a href='@Url.Action("MakeSubscriptionCanceled","Subscription",new { id = item.Subscrip_Id })' class="dropdown-item">
                                            @Accountingsystem.Resources.SubscriptionIndex.Cancel
                                        </a>
                                    }

                                    @*<a href='@Url.Action("Printsub","Reports",new { subIDid = item.Subscrip_Id })' class="dropdown-item" target="_blank">
            @Accountingsystem.Resources.SubscriptionIndex.PrintSubscription
        </a>*@
                                    <a href='@Url.Action("DetailofSubscription","Subscription",new { id = item.Subscrip_Id })' class="dropdown-item">
                                        @Accountingsystem.Resources.SubscriptionIndex.Details
                                    </a>
                                    <a href='@Url.Action("FillGlForCreateSettelment", new { controller = "GLMaster", code = thiscustomercode})' class="dropdown-item">
                                        @Accountingsystem.Resources.validate.SettlementGL
                                    </a>
                                </div>
                            </div>

                        </td>
                    </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>



