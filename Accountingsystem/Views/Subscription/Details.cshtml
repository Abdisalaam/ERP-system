    <a class="btn BTN-style final-BTNs" href='@Url.Action("SubscripInvoice", new { controller = "Reports", id = Model.Subscrip_Id })'>
        طباعة
    </a>
</div>

    @section scripts{
        <script type="text/javascript">
            updateButtonText();


            function updateButtonText() {
                var Subscrip_State = $.trim($("#Subscrip_State").text());
                if (Subscrip_State == "Void") {
                    $("#changeState").hide();
                    return;
                }

                else if (Subscrip_State == "Pending")
                    $("#changeState").val("Post");
                else if (Subscrip_State == "Post")
                    $("#changeState").val("Void");
            }

            function UpdateSubscriptionStateText() {
                var Subscrip_State = $.trim($("#Subscrip_State").text());
                if (Subscrip_State == "Pending")
                    $("#Subscrip_State").text("Post");
                else if (Subscrip_State == "Post")
                    $("#Subscrip_State").text("Void");
            }




            function UpdateSubscriptionState(data) {
                return $.ajax({
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    type: 'POST',
                
                     url: '@Url.Action("Update", "Subscription")',
                    data: data,
                    success: function (result) {
                        alert(result);
                        location.reload();
                    },
                    error: function () {
                        alert("ssssssssssssss!");
                    }
                });
            }


            $("#changeState").click(function (e) {

                e.preventDefault();
                alert("hii!");
                var data = JSON.stringify({
                    Subscrip_Id: $.trim($("#Subscrip_Id").text()),
                    Subscrip_State: $("#changeState").val()
                });

                $.when(UpdateSubscriptionState(data)).then(function (response) {
                    console.log(response);
                }).fail(function (err) {
                    console.log(err);
                });
                updateButtonText();
                UpdateMatchingStateText();
            })

        </script>
