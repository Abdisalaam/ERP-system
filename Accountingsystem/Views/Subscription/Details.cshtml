@model Accountingsystem.Models.Subscription

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="HEADTITLE-STYLE">التفاصيل</h2>

<div>
   
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayName("رقم الاشتراك")
        </dt>

        <dd id="Subscrip_Id">
            @Html.DisplayFor(model => model.Subscrip_Id)
        </dd>

        <dt>
            @Html.DisplayName("رقم الاشتراك")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Subscrip_Code)
        </dd>
        <dt>
            @Html.DisplayName("نوع الاشتراك")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Subscrip_Type)
        </dd>


        <dt>
            @Html.DisplayName("وصف الاشتراك")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Subscrip_Description)
        </dd>
        @if (Model.Sub_Date==null) {
        <dt>
            @Html.DisplayName("تاريخ الاشتراك")
        </dt>

        <dd>
            @Model.Sub_Date.Value.ToString("yyyy/MM/dd ")
        </dd>
        }
        <dt>
            @Html.DisplayName("تاريخ الانتهاء")
        </dt>

        <dd>
            @Model.DeadLine.ToString("yyyy/MM/dd ")
        </dd>

        <dt>
            @Html.DisplayName("تاريخ البدء")
        </dt>

        <dd>
            @Model.StartTime.ToString("yyyy/MM/dd ")
        </dd>
        <dt>
            @Html.DisplayName("تاريخ الايقاف")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Subscrip_DateEnd)
        </dd>
        <dt>
            @Html.DisplayName("قيمه الاشتراك")
        </dt>

        <dd>
            @*@Html.DisplayFor(model => model.Estimate_Amount)*@
            @Math.Round(Model.Estimate_Amount, 2, MidpointRounding.AwayFromZero)
        </dd>

        <dt>
            @Html.DisplayName("اسم العميل")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Customer_Id)
        </dd>

        <dd>
            @Html.Display("حاله العميل")
        </dd>
        <dd>
            @Html.DisplayFor(model => model.SubType_State)
        </dd>
        <dt>
            @Html.DisplayName("حاله الاشتراك")
        </dt>

        <dd id="Subscrip_State">
            @Html.DisplayFor(model => model.Subscrip_State)
        </dd>

        <dt>
            @Html.DisplayName("اسم الشركه")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Subscrip_Comp)
        </dd>

        <dt>
            @Html.DisplayName("نشاط الشركه")
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Subscrip_BU)
        </dd>


        <dt>
            @Html.DisplayName("فرق الموظفين")
        </dt>

        <dd>
            @{
                if (Model.Emp_Team == 0 || Model.Emp_Team == null)
                {

                }
                else
                {
                    var employeeTeam = Accountingsystem.Models.EmployeeTeam.getEmployeeBYID(Model.Emp_Team.Value).Team_Name;
                    <h>@employeeTeam</h>
                }
            }
        </dd>
    </dl>
</div>
