                            @*<div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.SubscriptionCreateSubInv.SubscriptionNumber)
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.Subscrip_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
