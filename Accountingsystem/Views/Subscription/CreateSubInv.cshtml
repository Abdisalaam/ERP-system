    <script type="text/javascript">
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
            var _InvoiceDate = flatpickr(document.getElementById('InvoiceDate'), {
                defaultDate: currentDate
            });

            $("#Payment_Method").chosen();


            $("#Payment_Method_chosen").addClass("form-control Dropdownlist-select");

            $("#backToListBtn").click(function (e) {
                $("#backToListBtnSpinner").show();
            });
            return false;
        });
    </script>
    <script>
        $('#InvoiceDate').on('change', function (e)
        {
            var selectedValue = $(this).val();
             $.ajax({
                        url: '@Url.Action("CheckStartdate", "GLMaster")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                            var currentDate = new Date();

                            var _OfferDate = flatpickr(document.getElementById('InvoiceDate'), {
                                defaultDate: currentDate
                            });

                        }
                    }
                    );
            $.ajax({
                url: '@Url.Action("CheckEndDate", "Company")',
                data: { date : selectedValue },
            type: 'get',
            }).done(function (result) {
                if (result == "" || result == null) {

                }
                else {
                    Snackbar.show({
                        text: result,
                        pos: 'top-center'
                    });
                }
            }
            );
        });
    </script>

    <script>
        $('#InvoiceDate').on('input', function () {
            $("#InvoiceDate").removeClass("addRequiredFieldToInput");
        });
        $('#Pay_Amount').on('input', function () {
            $("#Pay_Amount").removeClass("addRequiredFieldToInput");
        });
        $('#Payment_Method').on('change', function () {
            $("#Payment_Method_chosen").removeClass("addRequiredFieldToInput");
            $('#Payment_Method_chosen span').css('background', '#ffffff');
            $('#Payment_Method_chosen b').css('background', '#ffffff');
        });

    </script>
    <script>
        $('#catchReceiptCreateForm').submit(function () {
            debugger
            $('#subBut').prop('disabled', true);
            if ($('#Payment_Method').val() == "" || $('#Payment_Method').val() == null || $('#Payment_Method').val() < 1 || $('#Pay_Amount').val() == null || $('#Pay_Amount').val() == "" || $('#Pay_Amount').val() <= 0 || $('#InvoiceDate').val() == null || $('#InvoiceDate').val() == "") {
                $('#subBut').prop('disabled', false);
                if ($('#Payment_Method').val() == "" || $('#Payment_Method').val() == null || $('#Payment_Method').val() < 1) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SubscriptionCreateSubInv.PaymentMethodValidation",
                        pos: 'top-center'
                    });
                    $("#Payment_Method_chosen").addClass("addRequiredFieldToInput");
                    $('#Payment_Method_chosen span').css('background', 'red');
                    $('#Payment_Method_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#Payment_Method").offset().top
                    }, 2000);
                }

                if ($('#Pay_Amount').val() == "" || $('#Pay_Amount').val() == null || $('#Pay_Amount').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SubscriptionCreateSubInv.PaidValueValidation",
                        pos: 'top-center'
                    });
                    $("#Pay_Amount").addClass("addRequiredFieldToInput");
                    $('#Pay_Amount').trigger('focus');
                }

                if ($('#InvoiceDate').val() == "" || $('#InvoiceDate').val() == null ) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SubscriptionCreateSubInv.CatchReceiptDateInformation",
                        pos: 'top-center'
                    });
                    $("#InvoiceDate").addClass("addRequiredFieldToInput");
                    $('#InvoiceDate').trigger('focus');
                }

                $("#createExpensesSpinner").hide();
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }

        });
    </script>

    <script>
        $('#Files').change(function () {
            $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
            $('#selectedtFiles').empty();
            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Files').empty();
                    $('#selectedtFiles').empty();
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.TotalSizeOfSelectedFiles : " + totalConteLength + " " + " @Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Byte " +'</li> ');
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.MaxOfFilesSize" + '.</li> ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                    text: "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileName : " + fileName + '</li> ');
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Byte" +'</li> ');

                }
            }
            $('#selectedtFiles').append('<li>' +"@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Byte" +'</li > ');
        });
    </script>

}
