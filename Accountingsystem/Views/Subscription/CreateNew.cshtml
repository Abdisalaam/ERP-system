@model Accountingsystem.ViewModel.SubscriptionVM
@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.SubscriptionCreate.CreateNewSubscription;
    Model.Comp_Id = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault().Comp_Id;
    var package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/assets/css/scrollspyNav.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/components/custom-modal.css")" rel="stylesheet" type="text/css" />

                <link href="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

                <link href="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.css")" rel="stylesheet" type="text/css" />


                <link href="@Url.Content("~/ContentLTR/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-slider.css")" rel="stylesheet" type="text/css" />


                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />


                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/assets/css/scrollspyNav.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/components/custom-modal.css")" rel="stylesheet" type="text/css" />

                <link href="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

                <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.css")" rel="stylesheet" type="text/css" />


                <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-slider.css")" rel="stylesheet" type="text/css" />


                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />


                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/assets/css/scrollspyNav.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/components/custom-modal.css")" rel="stylesheet" type="text/css" />

            <link href="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.css")" rel="stylesheet" type="text/css" />


            <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-slider.css")" rel="stylesheet" type="text/css" />


            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />


            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />


        }
    }


</head>

@using (Html.BeginForm("CreateNew", "Subscription", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Comp_Id)
    @Html.HiddenFor(model => model.Subscrip_Id)

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.SubscriptionCreateNew.CreateNewSubscription)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SubscriptionNumber)
                                    @Html.EditorFor(model => model.Subscrip_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Subscrip_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SubscriptionInvoiceDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Sub_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Sub_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SelectTypeInformation)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedSubscrip_Type, Model.MySubTypeList, Accountingsystem.Resources.SubscriptionCreate.SelectType, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.Customer)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Customer_Id, Model.MyCusromerList, Accountingsystem.Resources.SubscriptionCreate.CustomerInformation, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                            <button id="addNewCustomerBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#customerModal">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Customer_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.CustomerNumber)
                                    @Html.EditorFor(model => model.tel_customer, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.tel_customer, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.EmployeeName)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Emp_Id, Model.EmpList, Accountingsystem.Resources.SubscriptionCreate.EmployeeNameInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        @Html.ValidationMessageFor(model => model.Emp_Id, "", new { @class = "text-danger" })
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.TeamName)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectEmp_Team, Model.MyEmpTeam, Accountingsystem.Resources.SubscriptionCreate.TeamNameInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectEmp_Team, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @if (package.Number_Branch > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SelectBranch)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Subscrip_Pranch, Model.MySubscripPranch, Accountingsystem.Resources.SubscriptionCreate.SelectBranchInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SelectDepartment)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Department_Id, Model.MyDepartmentList, Accountingsystem.Resources.SubscriptionCreate.SelectDepartmentInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SelectCompanyActivity)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Subscrip_BU, Model.MyBuList, Accountingsystem.Resources.SubscriptionCreate.SelectCompanyActivityInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_subLedgger > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.SubscriptionCreate.CostCenter)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Subledger_ID, Model.MySubList, Accountingsystem.Resources.SubscriptionCreate.CostCenterInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.StartingDateOfSubscription)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.StartTime, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.StartTime, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SubscriptionExpirationDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.DeadLine, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.DeadLine, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.SubscriptionValue)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Estimate_Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Estimate_Amount, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.Tax)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Taxe_ID, Model.tax_List, Accountingsystem.Resources.SubscriptionCreate.TaxInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.Taxe_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.AllowableDiscountValue)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.AllowDiscount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        @Html.ValidationMessageFor(model => model.AllowDiscount, "", new { @class = "text-danger" })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control">$</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.Discount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Discount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        @Html.ValidationMessageFor(model => model.Discount, "", new { @class = "text-danger" })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control">%</span>
                                            </div>
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubscriptionCreate.Total)
                                    @Html.EditorFor(model => model.totalinPageonly, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.totalinPageonly, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes)
                                    @Html.TextAreaFor(model => model.Subscrip_Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes })
                                    @Html.ValidationMessageFor(model => model.Subscrip_Description, "", new { @class = "text-danger" })
                                </div>
                            </div>


                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.SubscriptionCreate.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.SubscriptionCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div id="customerModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.SubscriptionCreate.AddCustomer</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="customerPartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-outline-secondary mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }

    <script type="text/javascript">
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
            var _ExpensesDate = flatpickr(document.getElementById('Sub_Date'), {
                defaultDate: currentDate
            });
            var currentDate1 = new Date();
            var _ExpensesDate = flatpickr(document.getElementById('StartTime'), {
                defaultDate: $("#StartTime").val()
            });
            var currentDate2 = new Date();
            var _ExpensesDate = flatpickr(document.getElementById('DeadLine'), {
                defaultDate: $("#DeadLine").val()
            });
            $("#SelectedSubscrip_Type").chosen();
            $("#Customer_Id").chosen();
            $("#Emp_Id").chosen();
            $("#SelectEmp_Team").chosen();

