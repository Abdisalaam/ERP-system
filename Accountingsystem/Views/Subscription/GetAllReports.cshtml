@section Scripts {


    <script type="text/javascript">
        $("#salesReportBtn").click(function (e) {
            $("#salesReportBtnSpinner").show();
        });
        $("#CustomerSubscribtionReportBtn").click(function (e) {
            $("#CustomerSubscribtionReportpinner").show();
        });
        
        $("#salesReturnReportBtn").click(function (e) {
            $("#salesReturnReportBtnSpinner").show();
        });
        $("#salesClassificationReportBtn").click(function (e) {
            $("#salesClassificationReportBtnSpinner").show();
        });
        $("#salesClassificationoReportBtn1").click(function (e) {
            $("#salesClassificationoReportBtn1Spinner").show();
        });
        $("#salesClassificationoReportBtn2").click(function (e) {
            $("#salesClassificationoReportBtn2Spinner").show();
        });
        $("#salesClassificationoReportBtn3").click(function (e) {
            $("#salesClassificationoReportBtn3Spinner").show();
        });
        $("#salesClassificationoReportBtn4").click(function (e) {
            $("#salesClassificationoReportBtn4Spinner").show();
        });
        $("#salesClassificationoReportBtn5").click(function (e) {
            $("#salesClassificationoReportBtn5Spinner").show();
        });
    </script>
}


