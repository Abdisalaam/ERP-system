    <script>

        function fun() {


            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);
            var orderArr = [];
            orderArr.length = 0;
            debugger
            $.each($("#default-ordering tbody tr"), function () {
                orderArr.push({

                    Id: $(this).find('td:eq(0)').html(),
                    NumberOfHour: $(this).find('td:eq(3)').find('input').val(),
                    Description: $(this).find('td:eq(4)').find('input').val(),
                  
                });

            });



            var empId = '@Model.employee_Id';
            var datao = JSON.stringify(orderArr);

            var data = { 'Penalities': datao, 'EmpId': empId };
            var data = JSON.stringify(data);

            console.log(data);
             $.ajax(
                 {

                     url: '@Url.Action("RenewPenalityHours", "AttendingAndLeaving")',
                     data: data,
                     contentType: 'application/json; charset=utf-8',
              dataType: 'json',
                     type: 'POST',


            }).done(function (result) {

