@using (Html.BeginForm("Create", "ShiftCoding", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))

{
    @Html.AntiForgeryToken()

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>

                <h3 class="text-center"><label>@Accountingsystem.Resources.Atttendace.Createshift</label></h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">


                            @Html.HiddenFor(model => model.DateOfMounth)

                            @{
                                var date = Convert.ToDateTime(Model.DateOfMounth);
                            }




                        
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.Mounth)
                                    <div class="input-group">
                                        @*@Html.Editor(date, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })*@
                                        <input value="@date.Month-@date.Year" disabled class="form-control mb-4" />
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.Name)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.employee.Emp_Name, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                        <div>
                                            <span class="form-control text-danger">*</span>
                                        </div>
                                    </div>
                                </div>

                            </div>



                    

                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-4 mt-4">
                    <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th hidden></th>
                                <th>
                                   @Accountingsystem.Resources.GLMasterDetail.GL_Date

                                </th>
                                <th>
                                    @Accountingsystem.Resources.Atttendace.RewardsOrPenalties
                                </th>



                                <th>
                                 @Accountingsystem.Resources.Atttendace.Hour
                                </th>
                                <th>
                                    @Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDescription
                                </th>



                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PenaltiesList)

                            {



                            <tr>

                                <td hidden>@item.reward.Id</td>
                                <td> @item.reward.AttendingAndLeaving.Date.Value.ToString("dd/MM/yyyy")</td>
                                <td>@item.reward.RewardsAndPenaltiesCoding.Name</td>

                                @if (item.reward.EmployeeSalaryMonthId > 0)
                                {
                                    <td>
                                        @item.reward.NumberOfHour
                                    </td>

                                }
                                else
                                {
                                    <td>@Html.EditorFor(model => item.reward.NumberOfHour)</td>
                                }
                                @if (item.reward.EmployeeSalaryMonthId > 0)
                                {
                                    <td>
                                        @item.reward.Description
                                    </td>

                                }
                                else
                                {
                                    <td>@Html.EditorFor(model => item.Description)</td>
                                }

                            </tr>
                            }
                        </tbody>
                    </table>

                </div>

                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" onclick="fun()" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>

                    </div>
                </div>
            </div>

        </form>
    </div>
}

