@using (Html.BeginForm("Create", "ShiftCoding", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))


{
    @Html.AntiForgeryToken()

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>

                <h3 class="text-center"><label>@Accountingsystem.Resources.Atttendace.AttendingAndLeaving</label></h3>
                <hr />

                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.Atttendace.ShiftCoding)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.shiftCoding.Name, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                        <div class="input-group-append">

                                        </div>
                                    </div>

                                </div>
                            </div>
                            @if (Model.BranchId > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Branch)
                                        <div class="input-group">
                                            @Html.EditorFor(model => model.BranchName, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                            <div class="input-group-append">

                                            </div>
                                        </div>

                                    </div>
                                </div>

                            }
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SpentReceiptCreate.SpentReceiptDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                        <div class="input-group-append">

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReportsGetDateOfIncome.From)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.shiftCoding.From, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                        <div class="input-group-append">

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ReportsGetDateOfIncome.To)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.shiftCoding.To, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                                        <div class="input-group-append">

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-4 mt-4">
                    <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                        <thead>
                            <tr>

                                <th>
                                    @Accountingsystem.Resources.InvoiceMasterIndex.Number
                                </th>
                                <th>
                                    @Accountingsystem.Resources.EmployeeCreate.EmployeeName

                                </th>



                                <th>
                                    @Accountingsystem.Resources.ReportsGetDateOfIncome.From
                                </th>
                                <th>
                                    @Accountingsystem.Resources.Atttendace.fromOldDate
                                </th>
                                <th>
                                    @Accountingsystem.Resources.ReportsGetDateOfIncome.To
                                </th>
                                <th>
                                    @Accountingsystem.Resources.Atttendace.ToOldDate
                                </th>
                                <th>
                                  حضور الكل  <input type="checkbox" name="select-all" id="select-all" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.AttendingAndLeavingDetailsList)
                            {
                                <tr>

                                    <td hidden>@item.Id</td>
                                    <td>@item.Employee.Emp_Code</td>
                                    <td>@item.Employee.Emp_Name</td>


                                    <td><input id="From" class="datepick" type="text" /></td>

                                    <td>@item.From</td>

                                    <td><input id="To" class="datepick" type="text" /></td>

                                    <td>@item.To</td>
                                    <td>@Html.EditorFor(model => item.Active)</td>
                                </tr>

                            }
                        </tbody>
                    </table>

                </div>

                <div class="form-group">
                    <button type="submit" id="createOfferbtn" onclick="fun()" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
        </form>
    </div>
}
