<script type="text/javascript">

            $(function () {

                $("#SelectedCountryId").change(function (e) {

                    var selectedText = $(this).find("option:selected").text();

                    var selectedValue = $(this).val();

                    $.ajax({

                        url: '@Url.Action("GetProvinces", "Customer")',
                        type: 'get',
                        data: { countryId: selectedValue }
                    }).done(function (result) {

                        $("#SelectedProvinceId").empty();



                        for (var i = 0; i < result.length; i++) {
                            var item = result[i];
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#SelectedProvinceId").append(p)

                        }
                        GetAllcity();

                    });
                });

                function GetAllcity() {

                    var selectedValue = $("#SelectedProvinceId").val();

                    $.ajax({

                        url: '@Url.Action("GetCities", "Customer")',
                        type: 'get',
                        data: { provinceId: selectedValue }
                    }).done(function (result) {

                        $("#SelectedCityId").empty();

                        for (var i = 0; i < result.length; i++) {
                            var item = result[i];
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#SelectedCityId").append(p)

                        }

                    });
                }

                $("#SelectedProvinceId").change(function (e) {

                    var selectedText = $(this).find("option:selected").text();

                    var selectedValue = $(this).val();

                    $.ajax({

                        url: '@Url.Action("GetCities", "Customer")',
                        type: 'get',
                        data: { provinceId: selectedValue }
                    }).done(function (result) {

                        $("#SelectedCityId").empty();

                        for (var i = 0; i < result.length; i++) {
                            var item = result[i];
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#SelectedCityId").append(p)

                        }

                    });


                });
            });


</script>
