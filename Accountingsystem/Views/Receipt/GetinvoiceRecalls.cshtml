@model Accountingsystem.ViewModel.ReceiptInvoiceSalesRecallVM
<div>
    <h4 class="HEADTITLE-STYLE">@Accountingsystem.Resources.PrintReports.SalesReturnes</h4>
    <hr />
    <div class="statbox widget box box-shadow">
        <div class="table-responsive">

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@Accountingsystem.Resources.PrintReports.ReturnesInvoiceNumber</th>
                        <th>@Accountingsystem.Resources.PrintReports.Quantity</th>
                        <th>@Accountingsystem.Resources.PrintReports.Cost</th>
                    </tr>
                    </thead>
                <tbody>
                    <tr>
                        <td>
                            @foreach (var code in Model.Recall_Code)
                            {
                                @code
                                <br>
                                <br>
                            }
                        </td>
                        <td>
                            @foreach (var quantity in Model.RecallQuantity)
                            {
                                @quantity
                                <br>
                                <br>
                            }
                        </td>
                        <td>
                            @foreach (var cost in Model.RecallTotalCost)
                            {
                                @Math.Round(cost, 2, MidpointRounding.AwayFromZero)
                                @*@cost*@
                                <br>
                                <br>
                            }
                        </td>
                    </tr>
                    </tbody>
            </table>
        </div>
    </div>
</div>
