    <script>
        $("#SubID").hide();
        $("#SubSubID").hide();
        $("#ClaID").hide();
        $("#Project_Id").change(function (e) {
            var selectedValue = $(this).val();
            $.ajax({
                url: '@Url.Action("GetSubledger", "ProjectPayment")',
                type: 'get',
                data: { projectId: selectedValue }
            }).done(function (result) {
                if (result.length > 0) {
                    $("#SubID").show();
                    $("#ProjectSub_Id").empty();

                    var d = new Option("@Accountingsystem.Resources.ProjectAdvanced.ChooseMainCostCenter", 0);
                    $("#ProjectSub_Id").append(d);
                    for (var i = 0; i < result.length; i++) {
                        var p = new Option(result[i].Text, result[i].Value);
                        $("#ProjectSub_Id").append(p);
                    }
                    $('#ProjectSub_Id').trigger('chosen:updated');
                }
                else {
                    $("#ProjectClause_Id").empty();
                    $("#ProjectSubSub_Id").empty();
                    $("#ProjectSub_Id").empty();
                    $("#SubID").hide();
                    $("#SubSubID").hide();
                    $("#ClaID").hide();


                }
                    });
                });
    </script>
    <script>
        $("#Project_Id").change(function (e) {
            var selectedValue = $(this).val();
            $.ajax({
                url: '@Url.Action("GetClause", "ProjectPayment")',
                type: 'get',
                data: { projectId: selectedValue }
            }).done(function (result) {
                if (result.length > 0 && selectedValue != 0 && selectedValue != "0") {
                    $("#ClaID").show();
                    $("#ProjectClause_Id").empty();

                    var d = new Option('@Accountingsystem.Resources.ProjectAdvanced.ChooseClause',0);
                    $("#ProjectClause_Id").append(d);
                    for (var i = 0; i < result.length; i++) {
                        var p = new Option(result[i].Text, result[i].Value);
                        $("#ProjectClause_Id").append(p);
                    }
                    $('#ProjectClause_Id').trigger('chosen:updated');
                }
                else {
                    $("#ProjectClause_Id").empty();
                    $("#ProjectSubSub_Id").empty();
                    $("#ProjectSub_Id").empty();
                    $("#SubID").hide();
                    $("#SubSubID").hide();
                    $("#ClaID").hide();

                }
                    });
                });
    </script>
