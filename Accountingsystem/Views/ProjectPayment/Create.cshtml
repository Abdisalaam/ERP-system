@using (Html.BeginForm("Create", "ProjectPayment", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.ProjectPaymentId)
    @Html.HiddenFor(model => model.ProjectPay_State)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.ProjectSpentReceipt)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.ReceiptNumber)
                                    @Html.EditorFor(model => model.ProjectPay_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.ProjectPay_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.Date)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.Project)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Project_Id, Model.MyProjectList, Accountingsystem.Resources.ProjectPaymentCreate.ProjectInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Project_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6" id="SubID">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectAdvanced.MainCostCenter)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ProjectSub_Id, Model.ProjectSubList, Accountingsystem.Resources.ProjectAdvanced.ChooseMainCostCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="col-md-6" id="SubSubID">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectAdvanced.SubCostcenter)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ProjectSubSub_Id, Model.ProjectSubSubList, Accountingsystem.Resources.ProjectAdvanced.ChooseSubCostCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6" id="ClaID">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectAdvanced.ClauseOfProject)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ProjectClause_Id, Model.ProjectClauseList, Accountingsystem.Resources.ProjectAdvanced.ChooseClause, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.ExpenseAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Expense_Id, Model.MyExpenseList, Accountingsystem.Resources.ProjectPaymentCreate.ExpenseAccountInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Expense_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.Amount)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Pay_Amount, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Pay_Amount, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6" id="Revenue">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.BankAccountOrTreasury)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Revenue_Id, Model.MyRevenueList, Accountingsystem.Resources.ProjectPaymentCreate.BankAccountOrTreasuryInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Revenue_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6" id="Supp">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.Supplier)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SupplierID, Model.SupplierList, Accountingsystem.Resources.ProjectPaymentCreate.SupplierInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                                <button id="addNewSuppBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#SuppModal">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SupplierID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.SelectTax)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Selected_Tax_Id, Model.taxList, Accountingsystem.Resources.ProjectPaymentCreate.SelectTaxInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Selected_Tax_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input form-control mb-4" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.ProjectPaymentCreate.SelectFile</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="list-unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ProjectPaymentCreate.Description)
                                    @Html.TextAreaFor(model => model.Description, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.ProjectPaymentCreate.DescriptionInformation })
                                    @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.ProjectPaymentCreate.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.ProjectPaymentCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>
    <div id="SuppModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
        <div class="modal-dialog modal-lg">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Accountingsystem.Resources.PurchaseInvoiceEditForPending.Supplier</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
                <div class="modal-body">
                    <div id="SuppPartialDialogDiv"></div>
                </div>
                <div class="md-button">
                    <button class="btn btn-block btn-outline-secondary mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

                </div>
            </div>
        </div>
    </div>
}


