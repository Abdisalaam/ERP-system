@model Accountingsystem.ViewModel.DepartmentBussinesUnitVM


@{
    ViewBag.Title = Accountingsystem.Resources.DepartmentBussinesUnitEdit.EditDepartmentActivity;
    HttpCookie cookie = Request.Cookies["Language"];
}


<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";

            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


        }
    }

</head>


@using (Html.BeginForm("Edit", "DepartmentBussinesUnit", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.BussinessUnit_Id)
    @Html.HiddenFor(model => model.BranchDepartmentDept_Id)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.DepartmentBussinesUnitEdit.EditDepartmentActivity)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.DepartmentBussinesUnitEdit.ActivityName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.BussinesUnit_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.BussinesUnit_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.DepartmentBussinesUnitEdit.ActivityDescription)
                                    @Html.EditorFor(model => model.BussinesUnit_Description, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.DepartmentBussinesUnitEdit.Save<span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index","DepartmentBussinesUnit", new { depId =  Model.BranchDepartmentDept_Id })'>
                            @Accountingsystem.Resources.DepartmentBussinesUnitEdit.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
}

@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {

                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

            }
            else
            {

                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

        }
    }

    <script type="text/javascript">
        $(document).ready(function () {


            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });
        });
        $('#BussinesUnit_Name').on('input', function () {
            $("#BussinesUnit_Name").removeClass("addRequiredFieldToInput");

        });

    </script>

    <script>

            $('#offerCreateMasterForm').submit(function () {
                $('#createOfferbtn').prop('disabled', true);
                if ($('#BussinesUnit_Name').val() == null || $('#BussinesUnit_Name').val() == "" ) {
                    $('#createOfferbtn').prop('disabled', false);
                $("#createExpensesSpinner").hide();
                    if ($('#BussinesUnit_Name').val() == "" || $('#BussinesUnit_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.DepartmentBussinesUnitEdit.ActivtyNameIsRequiredMessage",
                        pos: 'top-center'
                    });
                        $("#BussinesUnit_Name").addClass("addRequiredFieldToInput");
                        $('#BussinesUnit_Name').trigger('focus');
                    }

                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }


        });

    </script>


}
