@model Accountingsystem.ViewModel.AssetDepDaysVM

@{
    ViewBag.Title = Accountingsystem.Resources.FixedAssetIndex.DepreciationStart;
    HttpCookie cookie = Request.Cookies["Language"];
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/flatpickr/custom-flatpickr.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />


        }
    }


</head>



@using (Html.BeginForm("StartAllDepNew", "FixedAsset", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">

                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.FixedAssetIndex.DepreciationStart)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreateOpenBalance.dateOfDepration)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.StartDate, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.ReportsNewdailyPOSReport.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.ReportsNewgetdateofSales.Back<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>

}



@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>



        }
    }

    <script type="text/javascript">
        $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }
            var currentStartDate = new Date();
            var _StartDate = flatpickr(document.getElementById('StartDate'), {
                defaultDate: currentStartDate
            });

            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });






            return false;
        });


    </script>
    <script>
        $('#StartDate').on('change', function (e)
                {
            $("#StartDate").removeClass("addRequiredFieldToInput");
                var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("CheckEndDate", "Company")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                        }
                    }
                    );
                     $.ajax({
                        url: '@Url.Action("CheckStartdate", "GLMaster")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                            var currentDate = new Date();

                            var _OfferDate = flatpickr(document.getElementById('StartDate'), {
                                defaultDate: currentDate
                            });
                        }
                    }
                    );
                });

    </script>
    <script>
        $('#catchReceiptCreateForm').submit(function () {

            $('#subBut').prop('disabled', true);
            if ($('#StartDate').val() == "" || $('#StartDate').val() == null ) {
               
                if ($('#StartDate').val() == "" || $('#StartDate').val() == null ) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetCreateOpenBalance.dateOfDepration",
                        pos: 'top-center'
                    });
                    $("#StartDate").addClass("addRequiredFieldToInput");
                    $('#StartDate').trigger('focus');
                }
                

                $("#createExpensesSpinner").hide();
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }

        });
    </script>
}
