@using (Html.BeginForm("Create", "FixedAsset", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Currency)
    @Html.HiddenFor(model => model.selectedCompany_Id)

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.FixedAssetCreate.CreateFixedAsset)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.AssetNumber)
                                    @Html.EditorFor(model => model.FAsset_Codes, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.FAsset_Codes, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.AssetName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.FAsset_Descriptions, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_Descriptions, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.OperatingDateOfAsset)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.FAsset_WorkingDates, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_WorkingDates, "", new { @class = "text-danger" })
                                </div>
                            </div>                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.AgeOfAssetInMonth)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.FAsset_AgeMonths, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_AgeMonths, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.ScrapValue)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.JunckValue, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.JunckValue, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.AssetType)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedFixedAsset_TypeId, Model.MyFAssetType, Accountingsystem.Resources.FixedAssetCreate.SelectType, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedFixedAsset_TypeId, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.Employee)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.selectedFAsset_Employees_ID, Model.myEmployee, Accountingsystem.Resources.FixedAssetCreate.SelectEmployee, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.selectedFAsset_Employees_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @if (package.Number_Branch > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.FixedAssetCreate.Branch)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.BranchID, Model.BranshList, Accountingsystem.Resources.FixedAssetCreate.SelectBranch, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                        @Html.ValidationMessageFor(model => model.BranchID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.FixedAssetCreate.Department)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.DepartmentID, Model.DepListList, Accountingsystem.Resources.FixedAssetCreate.SelectDepartment, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                        @Html.ValidationMessageFor(model => model.DepartmentID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.FixedAssetCreate.Activity)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.FAsset_BUs, Model.myBUnit, Accountingsystem.Resources.FixedAssetCreate.SelectActivity, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                        @Html.ValidationMessageFor(model => model.FAsset_BUs, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            }

                            @if (package.Number_subLedgger > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.FixedAssetCreate.CostCenter)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.SubLedger_ID, Model.SubledgerList, Accountingsystem.Resources.FixedAssetCreate.SelectCostCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                        @Html.ValidationMessageFor(model => model.SubLedger_ID, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            }

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetCreate.Attachments)
                                    <label class="custom-file-container__custom-file form-control mb-4">
                                        @Html.TextBoxFor(model => model.Files, new { type = "file", @multiple = "multiple", @class = "custom-file-container__custom-file__custom-file-input form-control mb-4" })
                                        <span class="custom-file-container__custom-file__custom-file-control">@Accountingsystem.Resources.FixedAssetCreate.File</span>
                                    </label>
                                    <div class="input-group mb-4">
                                        <ul id="selectedtFiles" class="list-unstyled"></ul>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Files, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.FixedAssetCreate.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="assetInformationListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("FixedInfoList")'>
                        @Accountingsystem.Resources.FixedAssetCreate.AssetInformationList<span id="assetInformationListBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.FixedAssetCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>

}




@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentLTR/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentLTR/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }

    <script type="text/javascript">
       $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
           var _ExpensesDate = flatpickr(document.getElementById('FAsset_WorkingDates'), {
                defaultDate: currentDate
           });
                 
           $("#SelectedFixedAsset_TypeId").chosen();
           $("#selectedFAsset_Employees_ID").chosen();
           $("#BranchID").chosen();
           $("#DepartmentID").chosen();
           $("#FAsset_BUs").chosen();
           $("#SubLedger_ID").chosen();

           $("#SelectedFixedAsset_TypeId_chosen").addClass("form-control Dropdownlist-select");
           $("#selectedFAsset_Employees_ID_chosen").addClass("form-control Dropdownlist-select");
           $("#BranchID_chosen").addClass("form-control Dropdownlist-select");
           $("#DepartmentID_chosen").addClass("form-control Dropdownlist-select");
           $("#FAsset_BUs_chosen").addClass("form-control Dropdownlist-select");
           $("#SubLedger_ID_chosen").addClass("form-control Dropdownlist-select");


             $('#Files').change(function () {
                 $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
            $('#selectedtFiles').empty();

            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                conteLength = this.files[i].size;
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Files').empty();
                    $('#selectedtFiles').empty();
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.TotalSizeOfSelectedFiles : " + totalConteLength + " "+ "@Accountingsystem.Resources.Expenses.Byte" + '</li > ');
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.MaxOfFilesSize" + '.</li > ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Expenses.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileName : " + fileName + '</li> ');
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li> ');
                }
            }
            $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li > ');
        });

        });
    </script>
    <script type="text/javascript">

        $("#DepartmentID").empty();
        var departmentsOptions = new Option("@Accountingsystem.Resources.FixedAssetCreate.SelectDepartment", 0);
        $("#DepartmentID").append(departmentsOptions);
        $('#DepartmentID').trigger('chosen:updated');

        $("#FAsset_BUs").empty();
        var bussinesSubledgerOptions = new Option("@Accountingsystem.Resources.FixedAssetCreate.SelectActivity", 0);
        $("#FAsset_BUs").append(bussinesSubledgerOptions);
        $('#FAsset_BUs').trigger('chosen:updated');
        $("#BranchID").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("GetProvinces", "Expense")',
                        type: 'get',
                        data: { countryId: selectedValue }
                    }).done(function (result) {
                        $("#DepartmentID").empty();
                        var d = new Option("@Accountingsystem.Resources.FixedAssetCreate.SelectDepartment", 0);
                        $("#DepartmentID").append(d);
                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#DepartmentID").append(p);
                        }
                        $('#DepartmentID').trigger('chosen:updated');
                    });
                });
                $("#DepartmentID").change(function (e) {
                    var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("GetCities", "Expense")',
                        type: 'get',
                        data: { provinceId: selectedValue }
                    }).done(function (result) {

                        $("#FAsset_BUs").empty();
                         var bussinesSubledgerOptions = new Option("@Accountingsystem.Resources.FixedAssetCreate.SelectActivity", 0);
                        $("#FAsset_BUs").append(bussinesSubledgerOptions);
                        for (var i = 0; i < result.length; i++) {
                            var p = new Option(result[i].Text, result[i].Value);
                            $("#FAsset_BUs").append(p);

                        }
                        $('#FAsset_BUs').trigger('chosen:updated');
                    });


                });

    </script>

    <script>
            
        $('#FAsset_Descriptions').on('input', function () {
            $("#FAsset_Descriptions").removeClass("addRequiredFieldToInput");
        });
        $('#FAsset_AgeMonths').on('input', function () {
            $("#FAsset_AgeMonths").removeClass("addRequiredFieldToInput");
        });
        $('#JunckValue').on('input', function () {
            $("#JunckValue").removeClass("addRequiredFieldToInput");
        });

      

        $('#SelectedFixedAsset_TypeId').on('change', function () {
            $("#SelectedFixedAsset_TypeId_chosen").removeClass("addRequiredFieldToInput");
            $('#SelectedFixedAsset_TypeId_chosen span').css('background', '#ffffff');
            $('#SelectedFixedAsset_TypeId_chosen b').css('background', '#ffffff');
        });

        $("#assetInformationListBtn").click(function (e) {
            $("#assetInformationListBtnSpinner").show();
        });

        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });
    </script>
    <script>
        $('#catchReceiptCreateForm').submit(function () {
            
            $('#assetInformationListBtn').prop('disabled', true);
            if ($('#SelectedFixedAsset_TypeId').val() == "" || $('#SelectedFixedAsset_TypeId').val() == null || $('#SelectedFixedAsset_TypeId').val() < 1 || $('#FAsset_Descriptions').val() == "" || $('#FAsset_Descriptions').val() == null || $('#FAsset_AgeMonths').val() == null || $('#FAsset_AgeMonths').val() == "" || $('#FAsset_AgeMonths').val() < 0 || $('#JunckValue').val() == null || $('#JunckValue').val() == "" || $('#JunckValue').val() < 0) {
                if ($('#SelectedFixedAsset_TypeId').val() == "" || $('#SelectedFixedAsset_TypeId').val() == null || $('#SelectedFixedAsset_TypeId').val() < 1) {
                    $('#assetInformationListBtn').prop('disabled', false);
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetCreate.AssetTypeRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#SelectedFixedAsset_TypeId_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedFixedAsset_TypeId_chosen span').css('background', 'red');
                    $('#SelectedFixedAsset_TypeId_chosen b').css('background', 'red');

                    $('html, body').animate({
                        scrollTop: $("#SelectedFixedAsset_TypeId").offset().top
                    }, 2000);
                }
               
                if ($('#FAsset_AgeMonths').val() == "" || $('#FAsset_AgeMonths').val() == null || $('#FAsset_AgeMonths').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetCreate.AssetAgeMonthRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#FAsset_AgeMonths").addClass("addRequiredFieldToInput");
                    $('#FAsset_AgeMonths').trigger('focus');
                }
                if ($('#JunckValue').val() == "" || $('#JunckValue').val() == null || $('#JunckValue').val() < 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetCreate.ScrapValueIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#JunckValue").addClass("addRequiredFieldToInput");
                    $('#JunckValue').trigger('focus');
                }
                if ($('#FAsset_Descriptions').val() == "" || $('#FAsset_Descriptions').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetCreate.AssetNameIsRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#FAsset_Descriptions").addClass("addRequiredFieldToInput");
                    $('#FAsset_Descriptions').trigger('focus');
                }

                $("#createExpensesSpinner").hide();
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }

        });
    </script>

}
