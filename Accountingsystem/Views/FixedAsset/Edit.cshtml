@using (Html.BeginForm("Edit", "FixedAsset", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Fasset_IDs)

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.FixedAssetEdit.EditFixedAsset)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetEdit.OperatingDateOfAsset)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.FAsset_WorkingDates, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_WorkingDates, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetEdit.Employee)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.selectedFAsset_Employees_ID, Model.myEmployee, Accountingsystem.Resources.FixedAssetCreate.SelectEmployee, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                    </div>
                                    @Html.ValidationMessageFor(model => model.selectedFAsset_Employees_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.FixedAssetEdit.Create <span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.FixedAssetEdit.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>

}

@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {

                <script src="@Url.Content("~/ContentLTR/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
            }
            else
            {

                <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }

    <script type="text/javascript">
        $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createExpensesSpinner").hide();
            var currentDate = new Date();
            var _ExpensesDate = flatpickr(document.getElementById('FAsset_WorkingDates'), {
                defaultDate: currentDate
            });

            $("#selectedFAsset_Employees_ID").chosen();
            $("#selectedFAsset_Employees_ID_chosen").addClass("form-control Dropdownlist-select");

            return false;

        });
    </script>

    <script>
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });
    </script>
    @*<script>
        $("#subBut").click(function (e) {
            $("#createExpensesSpinner").show();
            $('#subBut').prop('disabled', true);
        });
    </script>*@

}
