@model IEnumerable<Accountingsystem.Models.FixedAsset>
@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.FixedAssetIndexdispose.ExcludedAssetsList;
    int count = 1;
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }




</head>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">


                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "Index")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>@Accountingsystem.Resources.FixedAssetIndexdispose.BackToList</a>

                                        </div>
                                    </li>
                                </ul>

                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.FixedAssetIndexdispose.ExcludedAssetsList
        </div>
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.Number)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.AssetDescription)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.AssetLife)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.AssetPrice)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.BookBalance)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.DepreciationComplex)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.LastDepreciationDate)
                        </th>

                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.NumberOfTimesDepreciation)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.FixedAssetIndex.AttachedFilesWithAssets)
                        </th>
                        <th>

                        </th>

                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var dep = item.FixedAssetDetails.Select(a => a.DestructionValue).ToList().Sum();
                        <tr>
                            <td>
                                @count
                                @{count = count + 1;}
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FAsset_Description)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.FAsset_AgeMonth)
                            </td>
                            <td>
                                @Math.Round(item.FAsset_PurchasePrice.Value, 2, MidpointRounding.AwayFromZero)
                            </td>
                            @if (item.BookValue > 0)
                            {
                                <td>
                                    @Math.Round(Convert.ToDecimal(item.BookValue.Value) - dep, 2, MidpointRounding.AwayFromZero)
                                </td>
                            }
                            else
                            {
                                <td>
                                    0
                                </td>
                            }
                            <td>
                                @Math.Round(dep, 2, MidpointRounding.AwayFromZero)
                            </td>


                            <td>
                                @if (dep > 0)
                                {
                                    <h>@item.FixedAssetDetails.OrderByDescending(a => a.Date).FirstOrDefault().Date.ToString("yyyy/MM/dd ")</h>
                                }
                            </td>
                            <td>
                                @item.FixedAssetDetails.Count()
                            </td>

                            <td>

                                @foreach (var item2 in item.FixedAssetFileDetails)
                                {
                                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width: 100px" />
                                }

                            </td>




                            <td>
                                <div class="btn-group">

                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                        @*@if (Math.Round(item.Complex.Value, 2, MidpointRounding.AwayFromZero) > 0)
                                        {

                                        }
                                        else
                                        {
                                            <a href="@Url.Action( "Edit", new { id = item.Fasset_ID })" class="dropdown-item">
                                                @Accountingsystem.Resources.FixedAssetIndex.EditAssets
                                            </a>

                                        }*@
                                        <a href="@Url.Action( "Details", new { id = item.Fasset_ID })" class="dropdown-item">
                                            @Accountingsystem.Resources.FixedAssetIndex.AssetsDetails
                                        </a>
                                        @*@if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات"))
                                        {
                                            <a href="@Url.Action( "disposeAsset", new { id = item.Fasset_ID })" class="dropdown-item">
                                                @Accountingsystem.Resources.FixedAssetIndex.ExclusionOfAssets
                                            </a>

                                        }*@

                                    </div>
                                </div>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>



