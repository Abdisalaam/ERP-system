@using (Html.BeginForm("disposeAsset", "FixedAsset", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Fasset_IDs)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.AssetExclusion)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.AssetName)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.FAsset_Descriptions, new { htmlAttributes = new { @class = "form-control mb-4", @readonly = "readonly" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_Descriptions, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.DiscontinuedDateOfAsset)
                                    <div class="input-group mb-4">
                                        @Html.EditorFor(model => model.FAsset_SellDates, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_SellDates, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @*<div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.Account)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.SelectedAccountID, Model.MyAccountList, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                            <div class="input-group-append">
                                                <div class="form-control">
                                                    <label class="text-danger">*</label>
                                                </div>

                                            </div>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.SelectedAccountID, "", new { @class = "text-danger" })
                                    </div>
                                </div>*@

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.SellingPriceOfAsset)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.sellingPrice, new { htmlAttributes = new { @class = "form-control mb-4", @type = "number", @step = "any" } })
                                        @Html.ValidationMessageFor(model => model.sellingPrice, "", new { @class = "text-danger" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.AccountUsedWhenSelling)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedBankAccountID, Model.MyAccountBankList, Accountingsystem.Resources.FixedAssetdisposeAsset.AccountInformation, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>

                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedBankAccountID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.DepreciationComplex)
                                    <div class="input-group mb-4">
                                        <h3 class="form-control mb-4" style="background:#ffffff">

                                            <h>@Math.Round(fixedd.FixedAssetDetails.Select(q => q.DestructionValue).Sum(), 2, MidpointRounding.AwayFromZero) </h>
                                        </h3>
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_Descriptions, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.PurchasingPrice)
                                    <div class="input-group mb-4">
                                        <h3 class="form-control mb-4" style="background:#ffffff">
                                            @{decimal purchaseprice = 0;
                                                if (fixedd.FAsset_PurchasePrice == 0 || fixedd.FAsset_PurchasePrice == null)
                                                {
                                                    purchaseprice = 0;
                                                    <h>@purchaseprice</h>
                                                }
                                                else
                                                {
                                                    purchaseprice = (decimal)fixedd.FAsset_PurchasePrice;
                                                    <h>@purchaseprice</h>
                                                }
                                            }
                                        </h3>
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_Descriptions, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.BookBalance)
                                    <div class="input-group mb-4">
                                        <h3 class="form-control mb-4" style="background:#ffffff">
                                            @{decimal book = Convert.ToDecimal(fixedd.BookValue.Value) - fixedd.FixedAssetDetails.Select(g => g.DestructionValue).Sum();}


                                            <h>@Math.Round(book, 2, MidpointRounding.AwayFromZero)</h>



                                        </h3>
                                        <div class="input-group-append">
                                            <label class="form-control text-danger">*</label>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.FAsset_Descriptions, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.FixedAssetdisposeAsset.ReasonForExclusion)
                                    @Html.TextAreaFor(model => model.WhyDispose, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.FixedAssetdisposeAsset.ReasonForExclusion })
                                    @Html.ValidationMessageFor(model => model.WhyDispose, "", new { @class = "text-danger" })
                                </div>
                            </div>





                        </div>
                    </div>
                </div>

            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.VacationsCreate.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index")">
                        @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>


                </div>
            </div>
        </form>

    </div>
}
