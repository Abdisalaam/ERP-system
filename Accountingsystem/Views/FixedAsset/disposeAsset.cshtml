            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }
    <script>
        $(function () {
            $("#sellingPrice").change(function () {
                debugger
                var FixedID = $("#Fasset_IDs").val();

                $("#BankAccount").show();

            });
        });


    </script>
    <script>

        //$('#End_Date_Vacations').datetimepicker({ format: 'DD/MM/YYYY' });
        //$('#Start_Date_Vacations').datetimepicker({ format: 'DD/MM/YYYY' });
        var currentDate = new Date();
        var _OfferDate = flatpickr(document.getElementById('FAsset_SellDates'), {
            defaultDate: currentDate
        });

    </script>
    <script>
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }


            $("#SelectedAccountID").chosen();

            $("#SelectedAccountID_chosen").addClass("form-control Dropdownlist-select");
            $("#SelectedBankAccountID").chosen();

            $("#SelectedBankAccountID_chosen").addClass("form-control Dropdownlist-select");



        });

    </script>

    <script>


        $('#FAsset_SellDates').on('input', function () {
            $("#FAsset_SellDates").removeClass("addRequiredFieldToInput");
        });
        $('#SelectedAccountID').on('input', function () {
            $("#SelectedAccountID").removeClass("addRequiredFieldToInput");
        });


    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $('#createOfferbtn').prop('disabled', true);
            $("#createOfferSpinner").show();
            if ($('#FAsset_SellDates').val() == "" || $('#FAsset_SellDates').val() == null||
                $('#SelectedBankAccountID').val() == "" || $('#SelectedBankAccountID').val() == null
                || $('#sellingPrice').val() == "" || $('#sellingPrice').val() == null
            ) {
                $('#createOfferbtn').prop('disabled', false);
                $("#createOfferSpinner").hide();
                if ($('#FAsset_SellDates').val() == "" || $('#FAsset_SellDates').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetdisposeAsset.DiscontinuedDateOfAsset",
                        pos: 'top-center'
                    });
                    $("#FAsset_SellDates").addClass("addRequiredFieldToInput");
                    $('#FAsset_SellDates').trigger('focus');
                }

                if ($('#SelectedBankAccountID').val() == "" || $('#SelectedBankAccountID').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetdisposeAsset.AccountInformation",
                        pos: 'top-center'
                    });

                    $("#SelectedBankAccountID_chosen").addClass("addRequiredFieldToInput");
                    $('#SelectedBankAccountID_chosen span').css('background', 'red');
                    $('#SelectedBankAccountID_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#SelectedBankAccountID").offset().top
                    }, 2000);
                }
                if ($('#sellingPrice').val() == "" || $('#sellingPrice').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.FixedAssetdisposeAsset.SellingPriceOfAsset",
                        pos: 'top-center'
                    });
                    $("#sellingPrice").addClass("addRequiredFieldToInput");
                    $('#sellingPrice').trigger('focus');
                }

                $("#createOfferSpinner").hide();
                event.preventDefault();
            }


        });

    </script>
    <script>
        $('#SelectedAccountID').on('change', function () {
            $("#SelectedAccountID_chosen").removeClass("addRequiredFieldToInput");
            $('#SelectedAccountID_chosen span').css('background', '#ffffff');
            $('#SelectedAccountID_chosen b').css('background', '#ffffff');
        });
    </script>
    <script>
        $('#FAsset_SellDates').on('change', function (e)
                {
            $("#FAsset_SellDates").removeClass("addRequiredFieldToInput");
                var selectedValue = $(this).val();
                    $.ajax({
                        url: '@Url.Action("CheckEndDate", "Company")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                        }
                    }
                    );
                     $.ajax({
                        url: '@Url.Action("CheckStartdate", "GLMaster")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                            var currentDate = new Date();

                            var _OfferDate = flatpickr(document.getElementById('FAsset_SellDates'), {
                                defaultDate: currentDate
                            });
                        }
                    }
                    );
                });

    </script>

}




