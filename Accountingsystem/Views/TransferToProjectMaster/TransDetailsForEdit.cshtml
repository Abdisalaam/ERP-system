@model IEnumerable<Accountingsystem.Models.TransferToProjectDetail>

<table class="table table-bordered table-striped" data-sortable-initialized="true">
    <tr>
        <th>
            @Html.DisplayName("اسم الصنف")
        </th>
        <th>
            @Html.DisplayName("رقم الصنف")
        </th>
        <th>
            @Html.DisplayName("الكميه")
        </th>

        <th>
            @Html.DisplayName("اجمالي التكلفه")
        </th>

        <th></th>
    </tr>

    @foreach (var item in Model)
    {
    <tr>
        @Html.HiddenFor(modelItem => item.Product_ID)
        <td>

            @{ var prodName = Accountingsystem.Models.Product.GetProdectById(item.Product_ID).Prod_Name;
                <h>@prodName</h>
            }
        </td>

        <td>

            @{ var prodCode = Accountingsystem.Models.Product.GetProdectById(item.Product_ID).Prod_Code;
                <h>@prodCode</h>
            }
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Product_Quantity)
        </td>



        <td>
            @*@Html.DisplayFor(modelItem => item.Detail_Total_Cost)*@
            @Math.Round(item.Detail_Total_Cost, 2, MidpointRounding.AwayFromZero)
        </td>



        <td>
            <a href='javascript:;' onclick="@("AddDetailToMasterss('"+item.Details_Id+"')")" class="btn BTN-style final-BTN">تعديل</a>
        </td>
    </tr>
    }

</table>
