@model Accountingsystem.ViewModel.TransferToProjectDetailVM

@using (Html.BeginForm()) 
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="row">

            <div class="col-md-5">
                <div class="col-md-6">
                    <div class="textfieldcont">
                        @Html.EditorFor(model => model.Product_Quantity, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Product_Quantity, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        @Html.LabelFor(model => model.Product_Quantity,"الكميه", htmlAttributes: new { @class = "control-label col-md-2" })
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="col-md-6">

                    <div class="Dropdownlist">
                        @Html.EditorFor(model => model.Product_ID, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.Product_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        @Html.LabelFor(model => model.Product_ID, "رقم المنتج", htmlAttributes: new { @class = "control-label col-md-2" })
                    </div>
                </div>
            </div>
        </div>






                @Html.HiddenFor(model => model.Product_Price)
                @Html.HiddenFor(model => model.Details_Id, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Details_Id, "", new { @class = "text-danger" })
      

       

                @Html.HiddenFor(model => model.Total_Amount, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Total_Amount, "", new { @class = "text-danger" })
          
                @Html.HiddenFor(model => model.Detail_Total_Cost, new { htmlAttributes = new { @class = "form-control" } })
         
                @Html.HiddenFor(model => model.Batch_ID, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Batch_ID, "", new { @class = "text-danger" })
         
                @Html.HiddenFor(model => model.Master_ID, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Master_ID, "", new { @class = "text-danger" })
         

     
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <a href='javascript:;' onclick="@("trans('"+Model.Master_ID+"')")" class="btn btn-primary" style="text-decoration:none;">تعديل</a>
            </div>
        </div>
    </div>
}


