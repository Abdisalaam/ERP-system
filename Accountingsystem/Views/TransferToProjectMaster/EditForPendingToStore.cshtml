        var DetailID = e;
        $("#PrepareTheQuantityOFProductss").load('@(Url.Action("PrepareTransDetailsToStore", "TransferToProjectMaster"))?DetailID=' + DetailID);
    };
    </script>

    <script type="text/javascript">
        function trans(e) {
