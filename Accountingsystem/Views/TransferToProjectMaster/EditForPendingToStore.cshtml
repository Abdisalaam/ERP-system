                                        @Html.DropDownListFor(model => model.Project_Id, Model.ProjList, Accountingsystem.Resources.TransferToProjectMasterEditForPendingToStore.ProjectInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
