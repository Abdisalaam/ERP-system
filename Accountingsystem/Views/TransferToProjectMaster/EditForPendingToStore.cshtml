    <script type="text/javascript">
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createSpinner").hide();
            var currentDate = new Date();
            var _Trans_Date = flatpickr(document.getElementById('Trans_Date'), {
                defaultDate: currentDate
            });
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });
            $("#Store_Id").chosen();
            $("#Project_Id").chosen();
            $("#Account_Id").chosen();
            $("#Store_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Project_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Account_Id_chosen").addClass("form-control Dropdownlist-select");          
            return false;
        });
    </script>

    <script type="text/javascript">
        $('#Trans_Date').on('input', function () {
            $("#Trans_Date").removeClass("addRequiredFieldToInput");

        });
        $('#Store_Id').on('change', function () {
            $("#Store_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Store_Id_chosen span').css('background', '#ffffff');
            $('#Store_Id_chosen b').css('background', '#ffffff');
        });
        $('#Project_Id').on('change', function () {
            $("#Project_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Project_Id_chosen span').css('background', '#ffffff');
            $('#Project_Id_chosen b').css('background', '#ffffff');
        });
        $('#Account_Id').on('change', function () {
            $("#Account_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Account_Id_chosen span').css('background', '#ffffff');
            $('#Account_Id_chosen b').css('background', '#ffffff');
        });
    </script>

    <script type="text/javascript">
        $('#catchReceiptCreateForm').submit(function () {
            $('#subBut').prop('disabled', true);
            if ($('#Store_Id').val() == "" || $('#Store_Id').val() == null || $('#Store_Id').val() <= 0 || $('#Project_Id').val() == "" || $('#Project_Id').val() == null || $('#Project_Id').val() <= 0 || $('#Account_Id').val() == "" || $('#Account_Id').val() == null || $('#Account_Id').val() <= 0 || $('#Trans_Date').val() == "" || $('#Trans_Date').val() == null || $('#transferProductsDetailList tr').length < 2) {
                $('#subBut').prop('disabled', false);
                $("#createSpinner").hide();
                if ($('#Store_Id').val() == "" || $('#Store_Id').val() == null || $('#Store_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.StoreMandatory",
                        pos: 'top-center'
                    });
                    $("#Store_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Store_Id_chosen span').css('background', 'red');
                    $('#Store_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Store_Id").offset().top
                    }, 2000);
                }
                if ($('#Project_Id').val() == "" || $('#Project_Id').val() == null || $('#Project_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.ProjectMandatory",
                        pos: 'top-center'
                    });
                    $("#Project_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Project_Id_chosen span').css('background', 'red');
                    $('#Project_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Project_Id").offset().top
                    }, 2000);
                }
                if ($('#Account_Id').val() == "" || $('#Account_Id').val() == null || $('#Account_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ProjectCreate.CreditAccountRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Account_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Account_Id_chosen span').css('background', 'red');
                    $('#Account_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Account_Id").offset().top
                    }, 2000);
                }
                if ($('#Trans_Date').val() == "" || $('#Trans_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.TransferDateIsRequired",
                        pos: 'top-center'
                    });
                    $("#Trans_Date").addClass("addRequiredFieldToInput");
                    $('#Trans_Date').trigger('focus');
                }
                if ($('#transferProductsDetailList tr').length < 2) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.AddProductTolist",
                        pos: 'top-center'
                    });
                    $("#transferProductsDetailList").addClass("addRequiredFieldToInput");
                     $("#Product_Quantity").addClass("addRequiredFieldToInput");
                    $('#Product_Quantity').trigger('focus');
                }
                event.preventDefault();
            }
            else {
                $("#createSpinner").show();
            }
        });
    </script>

    <script type="text/javascript">
             $('#Files').change(function () {
                 $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
            $('#selectedtFiles').empty();

            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                conteLength = this.files[i].size;
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Files').empty();
                    $('#selectedtFiles').empty();
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.TotalSizeOfSelectedFiles : " + totalConteLength + " "+ "@Accountingsystem.Resources.Expenses.Byte" + '</li > ');
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.MaxOfFilesSize" + '.</li > ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Expenses.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileName : " + fileName + '</li> ');
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li> ');
                }
            }
            $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li > ');
        });
    </script>
    <script type="text/javascript">
        $('#Trans_Date').on('change', function (e)
       {
        var selectedValue = $(this).val();
             $.ajax({
                        url: '@Url.Action("CheckEndDate", "Company")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                        }
                    }
                    );
        });

    </script>

