@model IEnumerable<Accountingsystem.Models.TransferToProjectDetail>

<div class="statbox widget box box-shadow">
    <div class="table-responsive">
        <table id="creatOfferDetailList" class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToProjectMasterCreateForTFPS.ProductName)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToProjectMasterCreateForTFPS.ProductNumber)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToProjectMasterCreateForTFPS.Quantity)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToProjectMasterCreateForTFPS.Price)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToProjectMasterCreateForTFPS.TotalCost)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @Html.HiddenFor(modelItem => item.Master_ID)
                <tr>
                    <td>
                        @{var Prod = Accountingsystem.Models.Product.GetProdectById(item.Product_ID).Prod_Name;
                            <h>@Prod</h> }
                    </td>
                    <td>
                        @{var code = Accountingsystem.Models.Product.GetProdectById(item.Product_ID).Prod_Code;
                            <h>@code</h> }
                    </td>
                    <td>
                        @Math.Round(item.Reverse_quantity.Value, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>
                        @Math.Round(item.Product_Price, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>
                        @Math.Round(item.Reverse_Total.Value, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>
                        <div class="col-md-offset-2 col-md-10">
                            <a href='javascript:;' onclick="@("EditItem('"+item.Details_Id+"')")" class="bs-tooltip" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.TransferToProjectMasterCreateForTFPS.TransferProduct" data-original-title="Edit"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-edit"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg></a>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>
