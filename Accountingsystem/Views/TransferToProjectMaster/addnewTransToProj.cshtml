                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

                <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

                <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>


                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/plugins/jquery-ui/jquery-ui.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }

    <script>
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });
            }
            $("#createSpinner").hide();
            var currentDate = new Date();
            var _Trans_Date = flatpickr(document.getElementById('Trans_Date'), {
                defaultDate: currentDate
            });
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });              
            $("#Store_Id").chosen();
            $("#Project_Id").chosen();
            $("#Account_Id").chosen();            
            $("#Store_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Project_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Account_Id_chosen").addClass("form-control Dropdownlist-select");
         
            return false;
        });
    </script>
    <script type="text/javascript">
         $(function () {
            $("#Store_Id").change(function (e) {

                var storeId = $("#Store_Id").val();
                var invoiceMasterId = @Model.Master_Id;
                $("#InvoicesDetailList").load('@(Url.Action("GetAllTempInvoiceDetails", "TransferToProjectMaster"))?tempInvoiceMasterId=' + invoiceMasterId);
                $("#InvoicesDetail").load('@(Url.Action("PrepareInvoiceDetails", "TransferToProjectMaster"))?storeId=' + storeId);

            });
        });
    </script>
    <script type="text/javascript">
        function AddDetailToMaster() {
            if ($('#Batch_ID').val() == "" || $('#Batch_ID').val() == null || $('#Batch_ID').val() < 0 || $('#Product_Quantity').val() == null || $('#Product_Quantity').val() <= 0 || $('#Product_Quantity').val() == "") {
                
                if ($('#Batch_ID').val() == "" || $('#Batch_ID').val() == null || $('#Batch_ID').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.ProductIsRequired",
                        pos: 'top-center'
                    });
                    $("#Batch_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#Batch_ID_chosen span').css('background', 'red');
                    $('#Batch_ID_chosen b').css('background', 'red');
                    $('#Batch_ID_chosen').trigger('focus');
                }
                if ($('#Product_Quantity').val() == "" || $('#Product_Quantity').val() == null || $('#Product_Quantity').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.QuantityIsRequired",
                        pos: 'top-center'
                    });
                    $("#Product_Quantity").addClass("addRequiredFieldToInput");
                    $('#Product_Quantity').trigger('focus');
                }
            }
            else {
                   var invoiceMasterId = @Model.Master_Id;
            var batchId =  $("#Batch_ID").val();
            var qty =  $("#Product_Quantity").val();
            var productPrice =  $("#Product_Price").val();
            var productTax = $("#Product_Tax").val();

            var invoiceMasterDetail;
            invoiceMasterDetail = {
                Master_Id:invoiceMasterId,
                Batch_ID:batchId,
                Product_Price:productPrice,
                Product_Tax:productTax,
                Product_Quantity:qty
            };
            $.ajax(
           {
               url: '@Url.Action("AddInvoiceDetailsToMaster", "TransferToProjectMaster")',
               data: JSON.stringify(invoiceMasterDetail),
               contentType: 'application/json',
               dataType: 'json',
               type: 'POST',
               success: function (data) {
                   $("#InvoicesDetailList").load('@(Url.Action("GetAllTempInvoiceDetails", "TransferToProjectMaster"))?tempInvoiceMasterId=' + invoiceMasterId);               },
               error: function () { alert('error'); }
           });
            }
        };
    </script>
    <script>
        $('#Trans_Date').on('input', function () {
            $("#Trans_Date").removeClass("addRequiredFieldToInput");

        });
        $('#Store_Id').on('change', function () {
            $("#Store_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Store_Id_chosen span').css('background', '#ffffff');
            $('#Store_Id_chosen b').css('background', '#ffffff');
        });
        $('#Project_Id').on('change', function () {
            $("#Project_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Project_Id_chosen span').css('background', '#ffffff');
            $('#Project_Id_chosen b').css('background', '#ffffff');
        });
        $('#Account_Id').on('change', function () {
            $("#Account_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Account_Id_chosen span').css('background', '#ffffff');
            $('#Account_Id_chosen b').css('background', '#ffffff');
        });
    </script>
    <script>
        $('#catchReceiptCreateForm').submit(function () {
            $('#subBut').prop('disabled', true);
            if ($('#Store_Id').val() == "" || $('#Store_Id').val() == null || $('#Store_Id').val() <= 0 || $('#Project_Id').val() == "" || $('#Project_Id').val() == null || $('#Project_Id').val() <= 0 || $('#Account_Id').val() == "" || $('#Account_Id').val() == null || $('#Account_Id').val() <= 0 || $('#Trans_Date').val() == "" || $('#Trans_Date').val() == null || $('#creatOfferDetailList tr').length < 2) {
                $('#subBut').prop('disabled', false);
                $("#createSpinner").hide();
                if ($('#Store_Id').val() == "" || $('#Store_Id').val() == null || $('#Store_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.StoreMandatory",
                        pos: 'top-center'
                    });
                    $("#Store_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Store_Id_chosen span').css('background', 'red');
                    $('#Store_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Store_Id").offset().top
                    }, 2000);
                }
                if ($('#Project_Id').val() == "" || $('#Project_Id').val() == null || $('#Project_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.ProjectMandatory",
                        pos: 'top-center'
                    });
                    $("#Project_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Project_Id_chosen span').css('background', 'red');
                    $('#Project_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Project_Id").offset().top
                    }, 2000);
                }
                if ($('#Account_Id').val() == "" || $('#Account_Id').val() == null || $('#Account_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.CreditAccountRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Account_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Account_Id_chosen span').css('background', 'red');
                    $('#Account_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Account_Id").offset().top
                    }, 2000);
                }
                if ($('#Trans_Date').val() == "" || $('#Trans_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.TransferDateIsRequired",
                        pos: 'top-center'
                    });
                    $("#Trans_Date").addClass("addRequiredFieldToInput");
                    $('#Trans_Date').trigger('focus');
                } 
                 if ($('#creatOfferDetailList tr').length < 2) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToProjectMasteraddnewTransToProj.AddProductTolist",
                        pos: 'top-center'
                    });
                     $("#creatOfferDetailList").addClass("addRequiredFieldToInput");
                     $("#Batch_ID_chosen").addClass("addRequiredFieldToInput");
                     $('#Batch_ID_chosen span').css('background', 'red');
                     $('#Batch_ID_chosen b').css('background', 'red');
                     $("#Product_Quantity").addClass("addRequiredFieldToInput");                    
                     $('#Batch_ID_chosen').trigger('focus');
                }
                event.preventDefault();
            }
            else {
                $("#createSpinner").show();
            }
        });
    </script>
    <script>
             $('#Files').change(function () {
                 $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");
            $('#selectedtFiles').empty();

            var totalConteLength = 0;
            for (var i = 0; i < this.files.length; i++) {
                conteLength = this.files[i].size;
                totalConteLength += this.files[i].size;
                if (totalConteLength > 4000000) {
                    $('#Files').empty();
                    $('#selectedtFiles').empty();
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.TotalSizeOfSelectedFiles : " + totalConteLength + " "+ "@Accountingsystem.Resources.Expenses.Byte" + '</li > ');
                    $('#selectedtFiles').append('<li class="addRequiredFieldToInput">' + "@Accountingsystem.Resources.Expenses.MaxOfFilesSize" + '.</li > ');
                    $(".custom-file-container__custom-file__custom-file-control").css("background-color", "red");
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.Expenses.FileSizePopupMessage",
                        pos: 'bottom-center'
                    });
                    return false;
                }
                else {
                    var fileName = this.files[i].name;
                    if (fileName.length > 8) fileName = fileName.substring(0, 8);
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileName : " + fileName + '</li> ');
                    $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.FileLength :  " + this.files[i].size + " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li> ');
                }
            }
            $('#selectedtFiles').append('<li>' + "@Accountingsystem.Resources.Expenses.TotalSizeOfFiles : " + totalConteLength +  " "+ "@Accountingsystem.Resources.Expenses.Byte" +'</li > ');
        });
    </script>
