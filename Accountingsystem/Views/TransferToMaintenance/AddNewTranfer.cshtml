            <script src="@Url.Content("~/ContentRTL/plugins/blockui/jquery.blockUI.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/highlight/highlight.pack.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/custom.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/scrollspyNav.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/flatpickr/flatpickr.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/nouislider.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/noUiSlider/custom-nouiSlider.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/bootstrap-range-Slider/bootstrap-rangeSlider.js")"></script>

            <script src="@Url.Content("~/ContentRTL/plugins/file-upload/file-upload-with-preview.min.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>

            <script src="@Url.Content("~/ContentRTL/assets/js/components/notification/custom-snackbar.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.js")"></script>
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>

        }
    }
    <script>
        $(document).ready(function () {
            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');
                });            }
            $("#createSpinner").hide();
            var currentDate = new Date();
            var _trans_Date = flatpickr(document.getElementById('Trans_Date'), {
                defaultDate: currentDate
            });
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });

                 
            $("#Store_ID").chosen();
            $("#Branch_Id").chosen();
            $("#Department_ID").chosen();
            $("#Transfer_BU").chosen();
            $("#Subledger_ID").chosen();
            $("#Account_Id").chosen();

           
            $("#Store_ID_chosen").addClass("form-control Dropdownlist-select");
            $("#Branch_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Department_ID_chosen").addClass("form-control Dropdownlist-select");
            $("#Transfer_BU_chosen").addClass("form-control Dropdownlist-select");
            $("#Subledger_ID_chosen").addClass("form-control Dropdownlist-select");
            $("#Account_Id_chosen").addClass("form-control Dropdownlist-select");                   
            return false;
        });
    </script>

    <script type="text/javascript">
        function AddDetailToMaster() {
            if ($('#Batch_ID').val() == "" || $('#Batch_ID').val() == null || $('#Batch_ID').val() <= 0 || $('#Product_Quantity').val() == null || $('#Product_Quantity').val() <= 0 || $('#Product_Quantity').val() == "") {
                if ($('#Batch_ID').val() == "" || $('#Batch_ID').val() == null || $('#Batch_ID').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.SelectProductRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Batch_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#Batch_ID_chosen span').css('background', 'red');
                    $('#Batch_ID_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Batch_ID").offset().top
                    }, 2000);
                }
                if ($('#Product_Quantity').val() == "" || $('#Product_Quantity').val() == null || $('#Product_Quantity').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.QuantityRequired",
                        pos: 'top-center'
                    });
                    $("#Product_Quantity").addClass("addRequiredFieldToInput");
                    $('#Product_Quantity').trigger('focus');
                }                
            }
            else {
                var invoiceMasterIds = @Model.Master_Id;
                var batchId = $("#Batch_ID").val();
                var qty = $("#Product_Quantity").val();
                var productPrice = $("#Product_Price").val();
                var productTax = $("#Product_Tax").val();
                var invoiceMasterDetail;
             invoiceMasterDetail = {
                 TransferToMaintenanceMaster_Id:invoiceMasterIds,
                 Batch_ID:batchId,
                 Product_Price:productPrice,
                 Product_Tax:productTax,
                 Product_Quantity:qty
             };
             $.ajax(
        {
            url: '@Url.Action("AddInvoiceDetailToMaster", "TransferToMaintenance")',
            data: JSON.stringify(invoiceMasterDetail),
            contentType: 'application/json',
            dataType: 'json',
            type: 'POST',
            success: function (data) {  
                $("#InvoicesDetailList").load('@(Url.Action("GetAllTempInvoiceDetails", "TransferToMaintenance"))?tempInvoiceMasterId=' + invoiceMasterIds);          
            },
            error: function () { alert('error '); }
        });
            }
        };

    </script>

    <script>

        $('#Trans_Date').on('input', function () {
            $("#Trans_Date").removeClass("addRequiredFieldToInput");
        });
     
        $('#Store_ID').on('change', function () {
            $("#Store_ID_chosen").removeClass("addRequiredFieldToInput");
            $('#Store_ID_chosen span').css('background', '#ffffff');
            $('#Store_ID_chosen b').css('background', '#ffffff');
        });
        $('#Account_Id').on('change', function () {
            $("#Account_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#Account_Id_chosen span').css('background', '#ffffff');
            $('#Account_Id_chosen b').css('background', '#ffffff');
        });

    </script>
    <script>
        $('#catchReceiptCreateForm').submit(function () {
            $('#subBut').prop('disabled', true);
            if ($('#Store_ID').val() == "" || $('#Store_ID').val() == null || $('#Store_ID').val() <= 0 || $('#Account_Id').val() == null || $('#Account_Id').val() == "" || $('#Account_Id').val() == "" || $('#Trans_Date').val() == "" || $('#Trans_Date').val() == null || $('#creatOfferDetailList tr').length < 2) {
                $('#subBut').prop('disabled', false);
                $("#createSpinner").hide();

                if ($('#Store_ID').val() == "" || $('#Store_ID').val() == null || $('#Store_ID').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.StoreNameMandatory",
                        pos: 'top-center'
                    });
                    $("#Store_ID_chosen").addClass("addRequiredFieldToInput");
                    $('#Store_ID_chosen span').css('background', 'red');
                    $('#Store_ID_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Store_ID").offset().top
                    }, 2000);
                }
                if ($('#Account_Id').val() == "" || $('#Account_Id').val() == null || $('#Account_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.ExpenseValidation",
                        pos: 'top-center'
                    });
                    $("#Account_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#Account_Id_chosen span').css('background', 'red');
                    $('#Account_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#Account_Id").offset().top
                    }, 2000);
                }              
                if ($('#Trans_Date').val() == "" || $('#Trans_Date').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.TransferDateMandatory",
                        pos: 'top-center'
                    });
                    $("#Trans_Date").addClass("addRequiredFieldToInput");
                    $('#Trans_Date').trigger('focus');
                }
                 if ($('#creatOfferDetailList tr').length < 2) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.OfferPriceMasterCreateOffer.AddProductsToTheListMessage",
                        pos: 'top-center'
                    });
                    $("#creatOfferDetailList").addClass("addRequiredFieldToInput");
                     $("#Batch_ID_chosen").addClass("addRequiredFieldToInput");
                     $('#Batch_ID_chosen span').css('background', 'red');
                     $('#Batch_ID_chosen b').css('background', 'red');
                     $('#Batch_ID_chosen').trigger('focus');
                }
                event.preventDefault();
            }
            else {
                $("#createSpinner").show();
            }


        });

    </script>


    <script>
        $('#Trans_Date').on('change', function (e)
       {

        var selectedValue = $(this).val();

             $.ajax({
                        url: '@Url.Action("CheckEndDate", "Company")',
                        data: { date : selectedValue },
                    type: 'get',
                    }).done(function (result) {
                        if (result == "" || result == null) {

                        }
                        else {
                            Snackbar.show({
                                text: result,
                                pos: 'top-center'
                            });
                        }
                    }
                    );
        });

    </script>

    <script>
    function DeleteTemp(e) {
        var ids =e;
        var  purchaseInvoiceMasterId=@Model.Master_Id;
        var invoiceMasterId = @Model.Master_Id;
        $.ajax({
            url: '@Url.Action("DeleteTemp", "TransferToMaintenance")',
            type: 'get',
            data: { id: ids }
        }).done(function (result) {

            $("#InvoicesDetailList").load('@(Url.Action("GetAllTempInvoiceDetails", "TransferToMaintenance"))?tempInvoiceMasterId=' + invoiceMasterId);

        });
