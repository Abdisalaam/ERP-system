@using (Html.BeginForm("AddTransferTOmain", "TransferToMaintenance", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Master_Id)
    @Html.HiddenFor(model => model.Company_Id)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.CreateNew)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.TransferNumber)
                                    @Html.EditorFor(model => model.Trans_Code, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.Trans_Code, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.TransferDate)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Trans_Date, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Trans_Date, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.StoreName)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Store_ID, Model.MyStoresList, Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.StoreNameInformation, htmlAttributes: new { @class = "Dropdownlist-select form-control mb-4" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Store_ID, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.Description)
                                    @Html.EditorFor(model => model.Describtion, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Describtion, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @if (package.Number_Branch > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.BranchName)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Branch_Id, Model.BranchList, Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.BranchNameInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.Department)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Department_ID, Model.MyDepartList, Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.DepartmentInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.Activity)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Transfer_BU, Model.BUList, Accountingsystem.Resources.ProjectCreate.ActivityInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (package.Number_subLedgger > 0)
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.CostCenter)
                                        <div class="input-group">
                                            @Html.DropDownListFor(model => model.Subledger_ID, Model.supList, Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.CostCenterInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.Expense)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Account_Id, Model.AccountList, Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.ExpenseInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.ReferenceInformation)
                                    @Html.EditorFor(model => model.Reference, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                    @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div id="InvoicesDetailsssss" class="row"></div>
                        <div id="InvoicesDetailList" class="col-md-12"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.Create<span id="createSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>
}

