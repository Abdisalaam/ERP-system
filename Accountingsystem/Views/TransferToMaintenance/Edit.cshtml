@section scripts{
    <script type="text/javascript">
        updateButtonText();


        function updateButtonText() {
            var Invoice_State = $.trim($("#Invoice_State").text());
            if (Invoice_State == "Void") {
                $("#changeState").hide();
                return;
            }
            else if (Invoice_State == "Pending")
                $("#changeState").val("Post");
            else if (Invoice_State == "Post")
                $("#changeState").val("Void");
        }
        function updateReceiptStateText() {
            var Invoice_State = $.trim($("#Invoice_State").text());
            if (Invoice_State == "Pending")
                $("#Invoice_State").text("Post");
            else if (Invoice_State == "Post")
                $("#Invoice_State").text("Void");
        }



        function UpdateTransferToMaintenance(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
  
                 url: '@Url.Action("Edit", "TransferToMaintenance")',
                data: data,
                success: function (result) {
                    alert(result);
                    location.reload();
                },
                error: function () {
                    alert("Error!")

                }
            });
        }

        $("#changeState").click(function (e) {

            e.preventDefault();

            var data = JSON.stringify({
                Master_Id: $.trim($("#Master_Id").text()),
                Invoice_State: $("#changeState").val()
            });

            $.when(UpdateTransferToMaintenance(data)).then(function (response) {
                console.log(response);
            }).fail(function (err) {
                console.log(err);
            });

            updateButtonText();
            UpdateTransferToMaintenancetateText();

        })


    </script>
}
