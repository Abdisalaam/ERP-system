@model IEnumerable<Accountingsystem.Models.TransferToMaintenanceDetailsTemp>
<div class="statbox widget box box-shadow">
    <div class="table-responsive">
        <table id="creatOfferDetailList" class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.Quantity)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.TotalCost)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.Product)
                    </th>
                    <th>
                        @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceAddNewTranfer.ProductCode)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    @Html.HiddenFor(modelItem => item.Details_Id)
                    @Html.HiddenFor(modelItem => item.TransferToMaintenanceTempMaster_Id)
                <tr>
                    <td>
                        @Math.Round(item.Product_Quantity, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>
                        @Math.Round(item.Detail_Total_Cost, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>
                        @{var Pro = Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Name;
                            @Pro}
                    </td>
                    <td>
                        @{var ProCode = Accountingsystem.Models.Product.GetProdectById(item.Product_Id).Prod_Code;
                            @ProCode }
                    </td>
                    <td>
                        <div class="col-md-offset-2 col-md-10">
                            <a href='javascript:;' onclick="@("DeleteTemp('"+item.Details_Id+"')")" class="bs-tooltip deleteicon" data-toggle="tooltip" data-placement="top" title="@Accountingsystem.Resources.InvoiceMasterDetails.Delete" data-original-title="Delete"><svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trash p-1 br-6 mb-1"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></a>
                        </div>
                    </td>
                </tr>
                }
            </tbody>
        </table>  
    </div>   
</div>
