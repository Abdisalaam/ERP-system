@model Accountingsystem.Models.TransferToMaintenance

@{
    ViewBag.Title = Accountingsystem.Resources.TransferToMaintenanceDetails.Details;
    HttpCookie cookie = Request.Cookies["Language"];
    var Chart = Accountingsystem.Models.ChartOfAccounting.getDataForThatAccount(Model.Account_Id).Account_Name;
    var sto = Accountingsystem.Models.Store.GetStoreById(Model.Store_ID).Store_Name;
    var package = Accountingsystem.Models.Package.getAllPackage().FirstOrDefault();
    decimal total = 0;
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
        }
    }


</head>

<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    <h3 class="text-center"></h3>
    <div class="statbox widget box box-shadow">
        <div class="widget-header">
            <div class="row">
                <div class="col-xl-12 col-md-12 col-sm-12 col-12 text-center layout-top-spacing">
                    <lable class="text-center">@ViewBag.Message</lable>
                    <div>
                        @Html.Label(@Accountingsystem.Resources.TransferToMaintenanceDetails.Details)
                    </div>
                    <hr />
                </div>
            </div>
        </div>
        <div class="widget-content widget-content-area">
            <div class=''>
                <div class="row">
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.TransferNumber)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Trans_Code)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.Account)
                                        </div>
                                        <div>
                                            @Chart
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.TotalAmount)
                                        </div>
                                        <div>
                                            @Math.Round(Model.Total_Amount, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.Cost)

                                        </div>
                                        <div>
                                            @Math.Round(Model.Total_Cost, 2, MidpointRounding.AwayFromZero)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.Date)
                                        </div>
                                        <div>
                                            @Model.Trans_Date.ToString("dd/MM/yyyy")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.Store)

                                        </div>
                                        <div>
                                            @sto
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (package.Number_Branch > 0)
                    {
                        if (Model.Branch_Id != null && Model.Branch_Id > 0)
                        {
                            var branch = Accountingsystem.Models.SubLedger.getDetail(Model.Branch_Id.Value);
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.BranchName)
                                                </div>
                                                <div>
                                                    @branch.SubLed_Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        if (Model.Department_ID != null && Model.Department_ID > 0)
                        {
                            var branch = Accountingsystem.Models.SubLedger.getDetail(Model.Department_ID.Value);
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Department)
                                                </div>
                                                <div>
                                                    @branch.SubLed_Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }

                        if (Model.Transfer_BU != null && Model.Transfer_BU != 0)
                        {
                            var branch = Accountingsystem.Models.SubLedger.getDetail(Model.Transfer_BU.Value);
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Activity)
                                                </div>
                                                <div>
                                                    @branch.SubLed_Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        if (Model.Subledger_ID != null && Model.Subledger_ID != 0)
                        {
                            var branch = Accountingsystem.Models.SubLedger.getDetail(Model.Subledger_ID.Value);
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.Activity)
                                                </div>
                                                <div>
                                                    @branch.SubLed_Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                    }

                    @{if (Model.Reference != null)
                        {
                            <div class="col-md-6">
                                <div class=''>
                                    <div class="media  d-md-flex d-block text-sm-left text-center">
                                        <div class="media-body details-form-control mb-4">
                                            <div class="d-xl-flex d-block justify-content-between">
                                                <div class="">
                                                    @Html.DisplayName(Accountingsystem.Resources.OfferPriceMasterDetails.BaptismNumber)
                                                </div>
                                                <div>
                                                    @Html.DisplayFor(model => model.Reference)
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        } }
                    <div class="col-md-6">
                        <div class=''>
                            <div class="media  d-md-flex d-block text-sm-left text-center">
                                <div class="media-body details-form-control mb-4">
                                    <div class="d-xl-flex d-block justify-content-between">
                                        <div class="">
                                            @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.Case)
                                        </div>
                                        <div>
                                            @Html.DisplayFor(model => model.Invoice_State)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="text-center">
                                @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.Description)
                            </div>
                            @Html.TextAreaFor(model => model.Describtion, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled" })
                        </div>
                    </div>
                </div>
            </div>

        </div>


        <div class="table-responsive">
            <table class="table mb-4">
                <thead>
                    <tr>
                        <th>@Accountingsystem.Resources.TransferToMaintenanceDetails.Item</th>
                        <th>@Accountingsystem.Resources.TransferToMaintenanceDetails.ItemNumber</th>
                        <th>@Accountingsystem.Resources.TransferToMaintenanceDetails.Quantity</th>
                        <th>@Accountingsystem.Resources.TransferToMaintenanceDetails.ItemPrice</th>
                        <th>@Accountingsystem.Resources.TransferToMaintenanceDetails.TotalAmount</th>
                        <th></th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var detail in Model.TransferToMaintenanceDetails)
                    {
                    <tr>
                        @{var Product = Accountingsystem.Models.Product.GetProdectById(detail.Product_Id); }
                        <td>@Product.Prod_Name</td>
                        <td>@Product.Prod_Code</td>
                        <td>@Math.Round(detail.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>
                        <td>@Math.Round(detail.Product_Price, 2, MidpointRounding.AwayFromZero)</td>
                        <td>@Math.Round(detail.Detail_Total_Cost, 2, MidpointRounding.AwayFromZero)</td>
                        @{total += detail.Detail_Total_Cost;}
                        <td>
                            <a href="@Url.Action("Details", "Product", new { id = detail.Product_Id })" class="btn btn-block btn-outline-primary mb-lg-0">
                                @Accountingsystem.Resources.ProductDetails.ItemDetails
                            </a>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>

        </div>
        <div class=''>
            <div class="row layout-top-spacing">
                <div class="col-md-12">
                    <div class=''>
                        <div class="media  d-md-flex d-block text-sm-left text-center">
                            <div class="media-body details-form-control mb-4">
                                <div class="d-xl-flex d-block justify-content-between">
                                    <div class="">
                                        @Html.DisplayName(Accountingsystem.Resources.TransferToMaintenanceDetails.Total)
                                    </div>
                                    <div>
                                        @Math.Round(total, 2, MidpointRounding.AwayFromZero)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row layout-top-spacing">
            <div class="col-md-6">
                <div class="form-group">
                    
                    <a id="newBtn" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("AddNewTranfer")">
                        @Accountingsystem.Resources.OfferPriceMasterDetails.CreateNewOfferPrice
                        <span id="newBtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                    </a>

                    @if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("مساعد محاسب"))
                    {
                        <input id="changeState" type="button" value="Post" class="btn btn-block btn-outline-info mb-lg-0" />
                        if (Model.Invoice_State == Accountingsystem.Models.TransactionState.Pending)
                        {
                            <a id="deleteBtn" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action("Delete", new { id = Model.Master_Id })">
                                @Accountingsystem.Resources.OfferPriceMasterDetails.Delete
                                <span id="deleteBtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                            </a>
                            <a id="editBtn" class="btn btn-block btn-outline-info mb-lg-0" href="@Url.Action( "EditForPending", new { id = Model.Master_Id })">
                                @Accountingsystem.Resources.OfferPriceMasterDetails.Edit
                                <span id="editBtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                            </a>

                        }
                        else
                        {
                            <a id="contraintBtn" class="btn btn-block btn-outline-info mb-lg-0" href='@Url.Action("DetailByCode", new { controller = "GLMaster", code = Model.Trans_Code })'>
                                @Accountingsystem.Resources.TransferToMaintenanceDetails.ReceiptConstraint
                                <span id="contraintBtnSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
                            </a>
                        }

                    }
                </div>
            </div>


            <div class="col-md-6">
                <div class="form-group">

                    <a class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Transfertomentainas", new { controller = "Reports", id = Model.Master_Id })' target="_blank">
                        @Accountingsystem.Resources.TransferToMaintenanceDetails.Print
                    </a>


                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index")">
                        @Accountingsystem.Resources.InvoiceMasterDetails.BackToList
                        <span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>
    <script>
        $("#deleteBtn").click(function (e) {
            $("#deleteBtnSpinner").show();
        });
        $("#editBtn").click(function (e) {
            $("#editBtnSpinner").show();
        });
        $("#contraintBtn").click(function (e) {
            $("#contraintBtnSpinner").show();
        });
        $("#backToListBtn").click(function (e) {
            $("#backTolistBtnSpinner").show();
        });
        $("#newBtn").click(function (e) {
            $("#newBtnSpinner").show();
        });
        


    </script>

    <script type="text/javascript">
        updateButtonText();


        function updateButtonText() {
            var Invoice_State = '@Model.Invoice_State';
            if (Invoice_State == "Void") {
                $("#changeState").hide();
                return;
            }
            else if (Invoice_State == "Pending")
                $("#changeState").val("Post");
            else if (Invoice_State == "Post")
                $("#changeState").val("Void");
        }
        function updateReceiptStateText() {
            var Invoice_State = '@Model.Invoice_State';
            if (Invoice_State == "Pending")
                $("#Invoice_State").text("Post");
            else if (Invoice_State == "Post")
                $("#Invoice_State").text("Void");
        }



        function UpdateTransferToMaintenance(data) {
            return $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',

                url: '@Url.Action("Edit", "TransferToMaintenance")',
                data: data,
                success: function (result) {
                    Snackbar.show({
                        text: result,
                        pos: 'top-center'
                    });
                    setTimeout(function () {

                        location.reload();

                    }, 5000);
                },
                error: function () {
                    alert("Error!")

                }
            });
        }

        $("#changeState").click(function (e) {
            this.disabled = true;
            e.preventDefault();

            var data = JSON.stringify({
                Master_Id: @Model.Master_Id,
                Invoice_State: $("#changeState").val()
            });

            $.when(UpdateTransferToMaintenance(data)).then(function (response) {
                console.log(response);
            }).fail(function (err) {
                console.log(err);
            });

            updateButtonText();
            UpdateTransferToMaintenancetateText();


        })


    </script>
}


