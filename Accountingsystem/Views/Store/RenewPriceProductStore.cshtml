    <div class="table-responsive mb-4 mt-4">
        <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
            <thead>
                <tr>

                    <th>
                        @Accountingsystem.Resources.InvoiceMasterIndex.Number
                    </th>
                    <th>
                        @Accountingsystem.Resources.ProductDetails.Barcode

                    </th>
                    <th>
                        @Accountingsystem.Resources.ProductDetails.Item

                    </th>

                    <th>
                        @Accountingsystem.Resources.ProductDetails.Category

                    </th>
                    <th>@Accountingsystem.Resources.SettlementOfStoresDetails.Quantity</th>
                    <th>@Accountingsystem.Resources.ProductCreate.AverageItemCost</th>
                    <th>@Accountingsystem.Resources.ProductCreate.lastpurchaseprice </th>
                    <th>@Accountingsystem.Resources.ProductCreate.lastSaleprice </th>
                    <th>@Accountingsystem.Resources.ProductCreate.EstimatedCost</th>

                    <th>
                        @Accountingsystem.Resources.ProductDetails.SellingPrice

                    </th>

                    <th>
                        @Accountingsystem.Resources.StoreCreate.NewPrice

                    </th>
                    <th>
                        @Accountingsystem.Resources.TaxCreate.TaxPercentage

                    </th>
                    <th>
                        @Accountingsystem.Resources.validate.PriceWithTax

                    </th>

                    <th>
                        <input type="checkbox" name="select-all" id="select-all" />
                    </th>
                    <th hidden>

                    </th>
                    <th hidden>

                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ListProduct)
                {
                <tr>
                    <td hidden>@item.batchId</td>
                    <td>@item.count</td>
                    <td hidden>
                        @Html.HiddenFor(modelItem => item.taxPercentage, htmlAttributes: new { @class = "taxPercentage" })
                    </td>


                    <td>@Html.EditorFor(model => item.ProductCode)</td>
                    <td>@item.ProductName</td>
                    <td>
                        @*@Html.DropDownListFor(model => item.CategoryId, Model.CatList, Accountingsystem.Resources.ProductCreate.SelectClassification)*@
                        <select class="Cat">
                            <option value=0>@Accountingsystem.Resources.ProductCreate.SelectClassification</option>
                            @foreach (var a in Model.CatList)
                            {
                                if (a.Cat_ID == item.CategoryId)
                                {
                                    <option value=@a.Cat_ID selected>@a.Cat_Descrip </option>
                                }
                                else
                                {
                                    <option value=@a.Cat_ID> @a.Cat_Descrip </option>
                                }
                            }
                        </select>

                        @*@Html.DropDownListFor(model => item.CategoryId, new SelectList(item.CatList, "Cat_ID", "Cat_Descrip", item.CategoryId), "Please select an order template")*@
                    </td>
                    <td>@Math.Round(item.batch.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>

                    @if (item.batch.Product_Quantity > 0)
                    {
                        <td>@Math.Round(item.batch.Batch_Cost / item.batch.Product_Quantity, 2, MidpointRounding.AwayFromZero)</td>
                    }
                    else
                    {
                        <td>0</td>
                    }
                    <td>@Math.Round(Accountingsystem.Models.Store.LastPricePurchase(item.batch.Store_ID.Value, item.batch.Product_ID), 2, MidpointRounding.AwayFromZero)</td>
                    <td>@Math.Round(Accountingsystem.Models.Store.LastPriceSale(item.batch.Store_ID.Value, item.batch.Product_ID), 2, MidpointRounding.AwayFromZero)</td>
                    <td>@Math.Round(item.batch.Product.Prod_Cost_Price.Value, 2, MidpointRounding.AwayFromZero)</td>
                    <td>@Math.Round(item.SalesPriceCommon, 2, MidpointRounding.AwayFromZero)</td>
                    <td>@Html.EditorFor(model => item.SalesPrice, new { htmlAttributes = new { onchange = "OnChangeSalesPrice(this)", @class = "SalesPrice" } }) </td>
                    <td id="taxPercentage">@item.taxPercentage</td>
                    <td>@Html.EditorFor(model => item.SalesPriceWithTax, new { htmlAttributes = new { onchange = "OnChangeSalesWithTax(this)", @class = "SalesPriceWithTax" } }) </td>
                    <td>@Html.EditorFor(model => item.IsActive)</td>
                </tr>
                }
            </tbody>
        </table>
        <div class="col-md-12">
            <div class="form-group">
                <button type="submit" id="createOfferbtn" onclick="fun()" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.InvoiceMasterIndex.Edit <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

            </div>
        </div>
    </div>
</div>


