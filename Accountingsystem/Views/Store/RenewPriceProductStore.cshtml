    <script>

        function fun() {


            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);
            var orderArr = [];
            orderArr.length = 0;
            debugger
            $.each($("#default-ordering tbody tr"), function () {
                orderArr.push({

                    batchId: $(this).find('td:eq(0)').html(),
                    ProductCode: $(this).find('td:eq(3)').find('input').val(),
                    Cat_ID: $(this).find('td:eq(5)').find('.Cat').val(),
                    SalesPrice: $(this).find('td:eq(12)').find('input').val(),
                    IsActive: $(this).find('td:eq(15)').find('input').prop('checked')
                });

            });



            var xz = 22;
            var datao = JSON.stringify(orderArr);

            var data = { 'btachQan': datao, 'hh': xz };
            var data = JSON.stringify(data);

            console.log(data);
             $.ajax(
                 {

                     url: '@Url.Action("RenewPriceProductStoreqtg", "Store")',
                     data: data,
                     contentType: 'application/json; charset=utf-8',
              dataType: 'json',
                     type: 'POST',


