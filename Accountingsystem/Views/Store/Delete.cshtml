                            {

                            }
                            else
                            {
                                var Emp = Accountingsystem.Models.Employee.getEmpById(Model.Emp_Id.Value).Emp_Name;
                                <h>@Emp</h>
                            }

                        }
                    </td>*@

                    <th class="col-md-2">
                        @Html.DisplayName(Accountingsystem.Resources.StoreDelete.StoreAddress)
                    </th>
                    <td class="col-md-2">
                        @Html.DisplayFor(model => model.Store_Address)
                    </td>

                </tr>
            </table>
        </div>
