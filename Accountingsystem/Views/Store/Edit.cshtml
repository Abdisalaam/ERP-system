@using (Html.BeginForm("Edit", "Store", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))


{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Store_ID)
    @Html.HiddenFor(model => model.SelectedChartOfAccountId)
    @Html.HiddenFor(model => model.Store_Code)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">

        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.StoreEdit.EditStore)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">




                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.StoreEdit.StoreName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Store_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.StoreEdit.StoreAddress)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Store_Address, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>


                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.StoreEdit.SelectBranch)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedBranshId, Model.BranchList, Accountingsystem.Resources.StoreEdit.SelectBranchInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger"></label>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            @*<div class="col-md-6">
            <div class="form-group">
                @Html.Label("اسم الحساب")
                <div class="input-group">
                    @Html.DropDownListFor(model => model.SelectedChartOfAccountId, Model.MyChartOfAccountList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                    <div class="input-group-append">
                        <div class="form-control">
                            <label class="text-danger">*</label>
                        </div>
                    </div>
                </div>

            </div>
        </div>*@
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.StoreDetails.EmployeeInCharge)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedEmployeeId, Model.EmployeeList, Accountingsystem.Resources.StoreEdit.SelectEmployeeInformation, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger"></label>
                                            </div>

                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.StoreDetails.Employees)
                                    <div class="input-group">
                                        @{
                                            if (cookie != null && cookie.Value != null)
                                            {
                                                if (cookie.Value == "en")
                                                {
                                                    @Html.ListBoxFor(model => model.EmployeesMember, Model.EmPloyeeMemberList, new Dictionary<string, Object> { { "class", "chosen-select form-control mb-4" }, { "data-placeholder", "اضف موظف" }, { "multiple", "true" } })
                                                    @Html.ValidationMessageFor(model => model.EmployeesMember, "", new { @class = "text-danger" })

                                                }
                                                else
                                                {
                                                    @Html.ListBoxFor(model => model.EmployeesMember, Model.EmPloyeeMemberList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", "اضف موظف" }, { "multiple", "true" } })
                                                    @Html.ValidationMessageFor(model => model.EmployeesMember, "", new { @class = "text-danger" })

                                                }
                                            }
                                            else
                                            {
                                                @Html.ListBoxFor(model => model.EmployeesMember, Model.EmPloyeeMemberList, new Dictionary<string, Object> { { "class", "chosen-rtl chosen-select form-control mb-4" }, { "data-placeholder", "اضف موظف" }, { "multiple", "true" } })
                                                @Html.ValidationMessageFor(model => model.EmployeesMember, "", new { @class = "text-danger" })

                                            }
                                        }




                                    </div>
                                </div>
                            </div>




                        </div>
                    </div>
                </div>


                <div class="col-md-12">
                    <div class="form-group">
                        <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                        <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                            @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>



}

