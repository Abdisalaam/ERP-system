    <script>


        $('#Store_Name').on('input', function () {
            $("#Store_Name").removeClass("addRequiredFieldToInput");
        });

    </script>
    <script>

        $('#offerCreateMasterForm').submit(function () {
            $("#createOfferSpinner").show();
            $('#createOfferbtn').prop('disabled', true);
            if ($('#Store_Name').val() == "" || $('#Store_Name').val() == null) {
                $('#createOfferbtn').prop('disabled', false);

                $("#createOfferSpinner").hide();
                if ($('#Store_Name').val() == "" || $('#Store_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.StoreEdit.StoreNameValidation",
                        pos: 'top-center'
                    });
                    $("#Store_Name").addClass("addRequiredFieldToInput");
                    $('#Store_Name').trigger('focus');
                }




                event.preventDefault();
            }



        });

    </script>
