</script>
<script>

    @*$("#totalQTYForCart").text(@totalQuantity);
    $("#OrderCartCountId").text(@totalQuantity);
    $("#OrderCartCountSmall").text(totalQuantity);*@



    $("#TotalExtraTaxAmount").val(@Math.Round(totalExtraTax, 2, MidpointRounding.AwayFromZero));
    $("#totalOfAllDetilas").val(@Math.Round(totalNet, 2, MidpointRounding.AwayFromZero));
</script>