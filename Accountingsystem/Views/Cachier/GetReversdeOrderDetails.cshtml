@section Scripts {

    <script type="text/javascript">

        function PrintElem() {
            var divContents = document.getElementById("contentToPrint").innerHTML;
            var height = $("#contentToPrint").height();
            document.body.style.height = height;
            var myWindow = window.open('', 'contentToPrint', 'height=400,width=600');
            myWindow.document.write('<html><head>');
            myWindow.document.write('</head><body>');
            myWindow.document.write(divContents);
            myWindow.document.write('</body></html>');
            myWindow.document.close(); // necessary for IE >= 10

            myWindow.onload = function () { // necessary if the div contain images

                myWindow.focus(); // necessary for IE >= 10
                myWindow.print();
                myWindow.close();
            };
        }

    </script>
    <script>
        $(document).ready(function () {
            $("#posToPrint").load('@(Url.Action("GetAllReversdOrderDetailsToPrint", "Cachier"))?reversdeOrderId=' + @Model.Id);
        });
        $("#sendOfferByMailBtn").click(function (e) {
            $("#sendOfferByMailBtnSpinner").show();
        });
        $("#transferToSalesReceiptBtn").click(function (e) {
            $("#transferToSalesReceiptBtnSpinner").show();
        });
        $("#createNewOfferBtn").click(function (e) {
            $("#createNewOfferBtnSpinner").show();
        });
        $("#transferOfferToInvoiceBtn").click(function (e) {
            $("#transferOfferToInvoiceBtnSpinner").show();
        });
        $("#editOfferBtn").click(function (e) {
