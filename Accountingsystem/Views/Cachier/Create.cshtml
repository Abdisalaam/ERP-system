    <script>
        $("#totalOfAllDetilas").change(function (e) {

                    var serialId = @Model.Id;
                    var selectedValue = $(this).val();

                    $.ajax({
                        url: '@Url.Action("updateDiscountDebendOnNet", "Cachier")',
                        data: { net: selectedValue, id: serialId },
                        type: 'get',
                    }).done(function (result) {
                        $("#DicountPrecentage").val(result);
                        updateTaxes();
                    }
                    );
        });
        $("#totalOfPaiedAmount").keyup(function (e) {
            var paiedAmount = $('#totalOfPaiedAmount').val();
            var total = $('#totalOfAllDetilas').val();
            if (paiedAmount < total) {
                Snackbar.show({
                    text: "@Accountingsystem.Resources.CachierCreate.PaiedAmountIsLessThanTotal",
                    pos: 'top-center'
                });
                $("#totalOfPaiedAmount").addClass("addRequiredFieldToInput");
                $('#totalOfPaiedAmount').trigger('focus');
            }
            var changeAmount = $('#totalOfPaiedAmount').val() - $('#totalOfAllDetilas').val();
            $('#totalOfRemainingAmount').val(changeAmount.toFixed(2))

        });

    </script>
    <script>
         function updateTaxes() {
              var orderId = @Model.Id;
             var discountPrecentageValue = $("#DicountPrecentage").val();
