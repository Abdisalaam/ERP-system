                formData.append("CustomerSelectSlice_Id", DataForCustomer.CustomerSelectSlice_Id);
                formData.append("customerFiles", DataForCustomer.customerFiles);
                for (i = 0; i < file.files.length; i++) {
                    //Appending each file to FormData object
                    formData.append(file.files[i].name, file.files[i]);
                }

            $.ajax(
             {
                    url: "@Url.Action("AddNewCustomerPartial", "OfferPriceMaster")",
                    data: formData,
                    type: "post",
                    contentType: false,
                    processData: false,
                    cache: false,
                    success: function (data) {

                        Snackbar.show({
                            text: "@Accountingsystem.Resources.CustomerCreate.CustomerHasBeenAdded" + "  " + data,
                            pos: 'top-center'
                        });
                        $("#customerPartialDialogDiv").load('@(Url.Action("PartialDialog", "OfferPriceMaster"))');
                        $("#customerPartialSpinner").hide();
                        $.ajax({

                            url: '@Url.Action("GetCustomerDropdownList", "OfferPriceMaster")',
                            type: 'get'
                        }).done(function (result) {

                            $("#SelectedCustomer_Id").empty();
                            for (var i = 0; i < result.length; i++) {
                                var p = new Option(result[i].Text, result[i].Value);
                                $("#SelectedCustomer_Id").append(p);
                                $("#SelectedCustomer_Id option:last").attr("selected", "selected");
                            }
                            $('#SelectedCustomer_Id').trigger('chosen:updated');
                            $("#SelectedCustomer_Id_chosen").removeClass("addRequiredFieldToInput");
                            $('#SelectedCustomer_Id_chosen span').css('background', '#ffffff');
                            $('#SelectedCustomer_Id_chosen b').css('background', '#ffffff');
                            $(".custom-file-container__custom-file__custom-file-control").css("background-color", "#ffffff");

                        });
                 },
                    error: function () {

                        Snackbar.show({
                        text: "@Accountingsystem.Resources.CustomerCreate.ErrorMessage",
                            pos: 'top-center'
                        });
                        $("#customerPartialSpinner").hide();
                    }
             });
            };
        };
        </script>*@

