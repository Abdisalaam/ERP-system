                                    <input class="form-control mb-4" type="text" value="@ViewBag.ModelOrderId" id="orderIdToPrint" />
                                </div>
                            </div>
                        </div>

                        <div class="row">

                            <div id="myCategoeryList" class="col-xl-12 col-lg-12 col-md-12 col-sm-12" style="display:none;">
                                <div class="">
                                    <div class="row layout-spacing layout-top-spacing">

                                        @{
                                            if (Model.OrderProducts.Any())
                                            {
                                                foreach (var item in Model.OrderCategoery)
                                                {

                                                    if (item.Cat_Img != null)
                                                    {
                                                        <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                                                            <a href="JavaScript:void(0)" data-id="@item.Cat_ID" class="categoeryClassClieck">
                                                                <img src="data:image/jpg;base64,@Convert.ToBase64String(item.Cat_Img)" alt="@item.Cat_Descrip" class="rounded" width="150px" height="150px" />

                                                            </a>

                                                        </div>

                                                    }
                                                    else
                                                    {
                                                        <div class="col-xl-4 col-lg-4 col-md-4 mb-2">

                                                            <a href="JavaScript:void(0)" data-id="@item.Cat_ID" class="categoeryClassClieck">
                                                                <h6 style="width:150px; height:150px" class="details-form-control">@item.Cat_Descrip</h6>
                                                            </a>
                                                        </div>


                                                    }

                                                }
                                            }
                                        }

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-6 col-lg-12 col-md-12 col-sm-12">
                                <div id="customerSectionID" class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Customer)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.SelectedCustomer_Id, Model.MyCustomerList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.DropDownListCustomer, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <button id="innerAddNewCustomerBTN" class="btn btn-success" type="button" data-toggle="modal" data-target="#customerModal">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="2" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-plus-square"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                                            </button>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SelectedCustomer_Id, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group">
                                    @{
                                        _orderId = ViewBag.ModelOrderId;
                                        if (_orderId > 0)
                                        {
                                            <a id="editOfferBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("GetAllOrderDetailsToPrintNewWindow" , new { orderId = _orderId })' target="_blank">
                                                @Accountingsystem.Resources.MasterPOSInvoice.ThermalPrinting
                                                <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                                            </a>
                                        }
                                    }
                                </div>
                                @*<div id="customerSectionID" class="form-group">
                                        <input type="text" class="form-control" id="inputScannerSearch" placeholder="@Accountingsystem.Resources.CachierCreate.ScanProduct"  onkeypress="return (event.key!='Enter')">
                                    </div>*@
                                <div class="search-bar">
                                    <input type="text" class="form-control product-search" id="input-search" placeholder="@Accountingsystem.Resources.CachierCreate.SearchProduct">
                                </div>
                                <div id="myProductList">
                                    <div class="layout-px-spacing">
                                        <div class="layout-spacing layout-top-spacing">
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <div class="widget-content searchable-container list">
                                                    <br />
                                                    <div class="searchable-items list">
                                                        @{
                                                            if (Model.OrderProducts.Any())
                                                            {
                                                                foreach (var item in Model.OrderProducts)
                                                                {
                                                                    <div class="items">

                                                                        <div class="item-content">

                                                                            <a href="JavaScript:void(0)" data-id="@item.PatchID" class="productClassClieck">

                                                                                <div class="item-content">
                                                                                    <div class="user-profile" style="vertical-align: middle;">

                                                                                        @if (item.ProductImage != null)
                                                                                        {
                                                                                            <img src="data:image/jpg;base64,@Convert.ToBase64String(item.ProductImage)" alt="Image" />

                                                                                        }
                                                                                        <div class="user-meta-info" style="vertical-align: middle;">

                                                                                            <p class="user-name" style="vertical-align: middle; color:black;"><span><b>@item.ProductCode</b></span>  <b>@item.ProductName</b></p>
                                                                                            <p class="user-name" style="vertical-align: middle; color:black;">
                                                                                                <b>@Math.Round(item.AvailableQuantity, 2, MidpointRounding.AwayFromZero)</b>
                                                                                            </p>
                                                                                        </div>
                                                                                    </div>
                                                                                </div>
                                                                            </a>
                                                                            <div class="user-email">
                                                                                <input id="@item.PatchID" type="text" class="details-form-control" style="color:black;" placeholder="@Math.Round(item.ProductPrice, 2, MidpointRounding.AwayFromZero)">
                                                                                @*<p id="@item.PatchID" class="details-form-control" style="vertical-align: middle; color:black;"><span><b>@Math.Round(item.ProductPrice, 2, MidpointRounding.AwayFromZero)</b></span></p>*@

                                                                            </div>
                                                                        </div>

                                                                    </div>
                                                                }


                                                            }


