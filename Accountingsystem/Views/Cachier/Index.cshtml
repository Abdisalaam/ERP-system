@model IEnumerable<Accountingsystem.Models.Order>

@{

    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.CachierCreate.ListOrder;
    int count = 1;
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }




</head>

<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">


                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "Index",new {all=1 })"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.validate.ALL</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "GetAllOrdersIndex")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.validate.ALL</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "ReverseOrdersIndex")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.CachierCreate.ListOrderReverse</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "Create")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.OfferPriceMasterIndex.CreateNewOfferPrice</a>

                                        </div>
                                    </li>
                                    @if (Request.IsAuthenticated && !User.IsInRole("مدخل بيانات") && !User.IsInRole("بائع") && !User.IsInRole("مساعد محاسب"))
                                    {
                                        <li>

                                            <div class="dropdown-item">
                                                <a href=" @Url.Action("dailyCashierReport", "ReportsNew")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>  @Accountingsystem.Resources.MasterPOSInvoice.SellerShiftReport</a>
                                            </div>
                                        </li>
                                    }
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action("dailyCashierReportForSaller", "ReportsNew")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>  @Accountingsystem.Resources.MasterPOSInvoice.InventorySalesReport ( PDF )</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action("DailyCashierReportForSallerThermalPrinting", "ReportsNew")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>  @Accountingsystem.Resources.MasterPOSInvoice.InventorySalesReport  ( @Accountingsystem.Resources.MasterPOSInvoice.ThermalPrinting )</a>
                                        </div>
                                    </li>
                                </ul>

                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.CachierCreate.ListOrder
        </div>
        <div class="text-center">
            <label>@ViewBag.Message</label>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr>
                        <th>

                            @Html.DisplayName(Accountingsystem.Resources.validate.Number)
                        </th>

                        <th>

                            @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.InvoiceNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.InvoiceDate)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Net)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.BranchName)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Store)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.PaymentMethod)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.EmployeeName)
                        </th>



                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <td>
                                @count
                            </td>
                            @if (item.Number == null)
                            {
                                <td>
                                    @Html.DisplayFor(model => item.OrderNumber)
                                </td>
                            }
                            else
                            {
                                <td>
                                    @Html.DisplayFor(model => item.Number)
                                </td>
                            }
                            <td>
                                @Html.DisplayFor(modelItem => item.OrderNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.OrderDate)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Total_Amount)
                            </td>
                            <td>
                                @{
                                    var branch = "";
                                    var emp = Accountingsystem.Models.Employee.getEmpById(item.EmployeeID);
                                    if (emp != null && emp.BranchSubledger_Id != null && emp.BranchSubledger_Id != 0)
                                    {
                                        branch = Accountingsystem.Models.SubLedger.getDetail(emp.BranchSubledger_Id.Value).SubLed_Name;
                                    }
                                    var Store = "";

                                    if (item.StoreId != null && item.StoreId != 0)
                                    {
                                        Store = Accountingsystem.Models.Store.GetStoreById(item.StoreId.Value).Store_Name;
                                    }

                                }
                                @branch
                            </td>
                            <td>
                                @Store
                            </td>
                            <td>
                                @Accountingsystem.Models.PaymentMethod.GetPaymentMethodById(item.PaymentMethodeID).Payment_Type
                            </td>
                            <td>
                                @if (emp != null)
                                {
                                    @emp.Emp_Name
                                }
                            </td>


                            <td>
                                <div class="btn-group">

                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">
                                        <a href="@Url.Action( "Details", new { id = item.Id})" class="dropdown-item">
                                            @Accountingsystem.Resources.OfferPriceMasterIndex.Details
                                        </a>
                                        @if (item.Invoice_State == Accountingsystem.Models.TransactionState.Post && Request.IsAuthenticated)
                                        {
                                            <a href="@Url.Action("Edit", new { id = item.Id })" class="dropdown-item">
                                                @Accountingsystem.Resources.CachierCreate.CreateReverse
                                            </a>
                                        }
                                        @*<a class="dropdown-item" href="@Url.Action("PrintOrderWhite", new { controller = "Reports", id = item.Id })">
                                            @Accountingsystem.Resources.OfferPriceMasterIndex.Print
                                        </a>
                                        <a class="dropdown-item" href="@Url.Action("PrintOrder", new { controller = "Reports", id = item.Id })">
                                            @Accountingsystem.Resources.OfferPriceMasterDetails.PrintEmail
                                        </a>*@

                                    </div>
                                </div>

                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>



