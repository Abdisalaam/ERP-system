@using (Html.BeginForm("UpdateOrderTypeAndComment", "Cachier", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)
   

    @*@Html.HiddenFor(model => model.EmployeeID)*@
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
       
        <form id="offerCreateMasterForm">
            <div class="">

                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                <h4 class="text-center">@ViewBag.Message</h4>
                                <h4 class="text-center">@Model.OrderNumber</h4>

                            </div>
                        </div>                      
                        <div class="row">
                          
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                <div>
                                    <div class="layout-px-spacing">
                                        <div class="layout-spacing layout-top-spacing">
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <div id="posInvoice" class="invoiceCashierFixedAtTop">
                                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                                        <div class="form-group">
                                                            @Html.Label(Accountingsystem.Resources.CachierCreate.OrderType)
                                                            <div class="input-group">
                                                                @Html.DropDownListFor(model => model.SelectedTypeOrderId, Model.OrderTypeList, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                                                                <div class="input-group-append">
                                                                    <div class="form-control">
                                                                        <label class="text-danger">*</label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            @Html.ValidationMessageFor(model => model.SelectedTypeOrderId, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>
                                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                                        <div class="form-group">
                                                            @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes)
                                                            @Html.TextAreaFor(model => model.Comment, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription })
                                                            @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                                        </div>
                                                    </div>

                                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                                        <div class="form-group">
                                                          
                                                            <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.BankEdit.Save <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>

    </div>
 


}

