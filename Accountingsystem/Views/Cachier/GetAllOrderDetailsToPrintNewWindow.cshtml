@model IEnumerable<Accountingsystem.ViewModel.OrderDetailsVM>
@{
    var order = Accountingsystem.Models.Order.GetOrderVMById(Model.FirstOrDefault().OrderId);
    var _Company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    var employee = Accountingsystem.Models.Employee.getEmpById(order.EmployeeID);

    decimal paiedAmount = 0;
    decimal subTotalBeforeTax = 0;



    Layout = null;
}
<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link href="~/Content/PrintPOS.css" rel="stylesheet" />
    <title>Receipt Cashier</title>
</head>
<body>
    <center>
        <div class="ticket" style="font-size:smaller;">
            @if (Model.FirstOrDefault().CompanyLogo != null)
            {
                <img src="data:image/jpg;base64,@Convert.ToBase64String(Model.FirstOrDefault().CompanyLogo)" alt="Byanaty" style="width:300px; height:250px;" />
            }
                <p class="centered" style="border-bottom:dotted;">
                    <span style="font-size:16px;"><strong>رابغ - حي الجود - بجوار حاشي باشا</strong></span>
                    <br />
                    <span style="font-size:16px"><strong>مقابل مستشفى رابغ العام</strong></span>
                    <br />
                    <span style="font-size:16px"><strong>Tel: 0545917202 </strong></span> <span style="font-size:16px"><strong>Tel: 0545917201 </strong></span>
                    <br />

                    <span style="font-size:14px">@_Company.Tax_Number / </span>  <span style="font-size:10px"> الرقم الضريبي </span>

                    <br />
                    <span style="font-size:14px">@employee.Emp_Name</span>
                    <br />
                    @if (!string.IsNullOrEmpty(Model.FirstOrDefault().CompanyPhone))
                    {
                        <span style="font-size:14px">Tel:  @Model.FirstOrDefault().CompanyPhone</span>
                    }
                </p>

            <p class="centered" style="border-bottom:dotted;">
                <span style="font-size:16px;"><strong>فاتورة ضريبية مبسطة</strong></span>
                <br />
                <span style="font-size:16px"><strong>Simplified Tax Invoice</strong></span>
            </p>
            <p class="centered" style="border-bottom:dotted;">
                <span style="font-size:26px;"><strong>@order.OrderType</strong></span>
            </p>

            @if (!string.IsNullOrEmpty(order.Comment))
            {
                <p class="centered" style="border-bottom:dotted;">
                    <span style="font-size:26px;"><strong>@order.Comment</strong></span>
                </p>
            }
            @if (order.Invoice_State == Accountingsystem.Models.TransactionState.Void)
            {
                <p class="centered" style="border-bottom:dotted;">
                    <span style="font-size:26px;"><strong>Cancelled</strong></span>
                </p>
            }
            @*<table>

            <tr style="border-top:hidden; border-bottom:dotted">


                <th style="font-size:14px; width:200px">
                    <span style="font-size:14px"> @Model.FirstOrDefault().CompanyName</span>
                    <br />

                    <span style="font-size:14px">@Model.FirstOrDefault().CompanyAdress</span>
                    <br />
                    <span style="font-size:14px">@_Company.Tax_Number / </span>  <span style="font-size:10px"> الرقم الضريبي </span>

                    <br />
                    <span style="font-size:14px">@employee.Emp_Name</span>
                    <br />
                    <span style="font-size:14px">Tel:  @Model.FirstOrDefault().CompanyPhone</span>

                </th>

            </tr>

        </table>*@

            <table>

                <tr style="border-top:hidden; text-align:center;">
                    <th class="description" style="font-size:12px; text-align:left; padding-left:5px">Order NR</th>

                    <th class="description" style="font-size:24px;">@order.OrderNumberCount</th>
                    <th class="quantity" style="font-size:12px; text-align:right; padding-right:5px">رقم الطلب</th>

                </tr>
                <tr style="border-top:hidden">

                    <th class="description" style="font-size:12px; text-align:left; padding-left:5px">Invoice Number</th>
                    @if (order.Number == null)
                    {
                        <th class="description" style="font-size:24px;"> @order.OrderNumber</th>
                    }
                    else
                    {
                        <th class="description" style="font-size:24px;"> @order.Number</th>
                    }

                    <th class="quantity" style="font-size:12px; text-align:right; padding-right:5px">رقم الفاتورة</th>

                </tr>
                <tr style="border-top:hidden; text-align:center;">
                    <th class="description" style="font-size:12px; text-align:left; padding-left:5px">Invoice Date</th>

                    <th class="description" style="font-size:14px;">@order.OrderDate</th>
                    <th class="quantity" style="font-size:12px; text-align:right; padding-right:5px">تاريخ الفاتورة</th>

                </tr>

            </table>
            @if (order.CustomeId > 0)
            {
                var customer = Accountingsystem.Models.Customer.GetCustomerById(order.CustomeId);
                <table>

                    <tr>
                        <th class="description" style="font-size:14px;  text-align:left; padding-left:5px"> Customer</th>

                        <th class="description" style="font-size:14px">@customer.Customer_Name</th>
                        <th class="quantity" style="font-size:14px; text-align:right; padding-right:5px">العميل</th>

                    </tr>
                    <tr style="border-top:hidden">
                        <th class="description" style="font-size:14px; text-align:left; padding-left:5px">Phone</th>

                        <th class="description" style="font-size:14px">@customer.Customer_Phone</th>
                        <th class="quantity" style="font-size:14px; text-align:right; padding-right:5px">الهاتف</th>

                    </tr>
                    @if (customer.Customer_TaxNumber != null)
                    {
                        <tr style="border-top:hidden">
                            <th class="description" style="font-size:14px">Tax No</th>

                            <th class="description" style="font-size:14px">@customer.Customer_TaxNumber</th>
                            <th class="quantity" style="font-size:14px">الرقم الضريبي</th>

                        </tr>


                    }
                </table>

            }
            <br />
            <table>
                <thead>
                    <tr>
                        <th class="description" style="font-size:10px;"> Total | المجموع</th>

                        <th class="description" style="font-size:10px;"> Price | السعر</th>

                        <th class="quantity" style="font-size:9px">QTY | الكمية </th>

                        <th class="description" style="font-size:10px; text-align:right; padding-right:2px">Item | الصنف</th>
                    </tr>

                </thead>
                <tbody>
                    @foreach (var detail in order.OrderDetailsVM)
                    {
                        var priceIncludeTax = Math.Round(detail.ProductPrice + detail.ProductTaxAmount, 2, MidpointRounding.AwayFromZero);

                        //var product = Accountingsystem.Models.Product.GetProdectById(detail.ProductID);

                        <tr style="border-top:hidden; text-align:center">
                            @*<th class="description" style="font-size:14px">  @Math.Round(detail.ProductPrice + detail.ProductTaxAmount, 2, MidpointRounding.AwayFromZero)</th>*@
                            <th class="description" style="font-size:14px"> @Math.Round(detail.ProductPrice * detail.Quantity, 2, MidpointRounding.AwayFromZero)</th>

                            <th class="description" style="font-size:14px"> @Math.Round(detail.ProductPrice, 2, MidpointRounding.AwayFromZero)</th>
                            <th class="quantity" style="font-size:14px">  @Math.Round(detail.Quantity, 0, MidpointRounding.AwayFromZero)</th>

                            <th class="description" style="font-size:14px; text-align:right; padding-right:2px">@detail.ProductName <span>@detail.AdditionalDetail</span></th>
                        </tr>
                        subTotalBeforeTax += detail.Quantity * detail.ProductPrice;
                    }

                    <tr></tr>
                </tbody>
            </table>
            <br />
            <p class="centered">
                <table style="width:250px">
                    <tr>
                        <th class="description" style="font-size:12px;">Total</th>
                        <th class="quantity" style="font-size:14px;">@Math.Round(subTotalBeforeTax, 2, MidpointRounding.AwayFromZero)</th>
                        <th class="description" style="font-size:12px;">المجموع</th>

                    </tr>
                    @if (order.DicountPrecentage > 0)
                    {
                        <tr>
                            <th class="description" style="font-size:12px">Discount</th>
                            <th class="quantity" style="font-size:14px">@Math.Round(subTotalBeforeTax * (order.DicountPrecentage / 100), 2, MidpointRounding.AwayFromZero)</th>
                            <th class="description" style="font-size:12px">الخصم % @Math.Round(order.DicountPrecentage, 2, MidpointRounding.AwayFromZero) </th>

                        </tr>

                    }

                    <tr>
                        <th class="description" style="font-size:12px">VAT</th>
                        <th class="quantity" style="font-size:14px">

                            @Math.Round(order.OrderDetailsVM.Select(a => a.ProductTaxAmount).Sum(), 2, MidpointRounding.AwayFromZero)

                        </th>
                        <th class="description" style="font-size:12px">الضريبة</th>

                    </tr>
                    @if (order.TotalExtraTaxAmount > 0)
                    {
                        <tr>
                            <th class="description" style="font-size:12px">Extra Tax</th>
                            <th class="quantity" style="font-size:14px">
                                @Math.Round(order.TotalExtraTaxAmount, 2, MidpointRounding.AwayFromZero)
                            </th>
                            <th class="description" style="font-size:12px">@order.ExtraTaxName</th>

                        </tr>
                    }

                    <tr>
                        <th class="description" style="font-size:12px">Total</th>
                        <th class="quantity" style="font-size:14px">@Math.Round(order.TotalNet, 2, MidpointRounding.AwayFromZero)</th>
                        <th class="description" style="font-size:12px">المبلغ المستحق</th>

                    </tr>




                    <tr>
                        <th class="description" style="font-size:12px">Payment</th>
                        <th class="quantity" style="font-size:14px">@order.PaymentMethodeName</th>
                        <th class="description" style="font-size:12px">طريقة الدفع  </th>

                    </tr>

                    <tr>
                        <th class="description" style="font-size:12px">Paied</th>
                        <th class="quantity" style="font-size:14px">@Math.Round(order.TotalNet, 2, MidpointRounding.AwayFromZero)</th>
                        <th class="description" style="font-size:12px">المدفوع</th>

                    </tr>


                </table>
            </p>



            <div style=' text-align:center; '>
                @if (order.QRNumber > 0)
                {

                    <br />
                    <img src="data:image/jpg;base64,@Accountingsystem.Models.TLVCls.GenerateInvoiceQRbase(order.QRNumber)" alt="Image" width="200px" height="200px" />
                    <br />
                }

            </div>

        </div>

    </center>

    <script type="text/javascript">
        window.onload = function () {
            window.print(); window.onfocus = function () { window.close(); }

        }
    </script>
</body>
</html>
