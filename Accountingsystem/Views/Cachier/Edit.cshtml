@using (Html.BeginForm("Edit", "Cachier", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()


    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    @Html.HiddenFor(model => model.OrderId)
    @Html.HiddenFor(model => model.TempOrderId)
    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="offerCreateMasterForm">
            <div class="">
                <h3 class="text-center"><label>@ViewBag.Message</label></h3>
                <h3 class="text-center">@Accountingsystem.Resources.validate.CreateCrediteNoticePOS</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.GLMasterFillGlForCreate.DailyConstraintNumber)
                                    @Html.EditorFor(model => model.OrderNumber, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.OrderNumber, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.InvoiceDate)
                                    @Html.EditorFor(model => model.OrderDate, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.OrderDate, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            @if (!String.IsNullOrEmpty(Model.CustomerName))
                            {
                                <div class="col-md-6">
                                    <div class="form-group">
                                        @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.CustomerName)
                                        @Html.EditorFor(model => model.CustomerName, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                        @Html.ValidationMessageFor(model => model.CustomerName, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            }
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterAddNewInvoice.Employee)
                                    @Html.EditorFor(model => model.EmployeeName, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.EmployeeName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.InvoiceMasterDetails.ValueBeforeDiscount)
                                    @Html.EditorFor(model => model.TotaBeforeDiscountAndTax, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.TotaBeforeDiscountAndTax, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.DiscountPercentage)
                                    @Html.EditorFor(model => model.DicountPrecentage, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.DicountPrecentage, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.DiscountValue)
                                    @Html.EditorFor(model => model.TotalDiscountAmount, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.TotalDiscountAmount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.TotalAfterDiscount)
                                    @Html.EditorFor(model => model.TotalAfterDiscount, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.TotalAfterDiscount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Model.ProductTaxName)
                                    @Html.EditorFor(model => model.TotalProductsTaxAmount, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.TotalProductsTaxAmount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Model.ExtraTaxName)
                                    @Html.EditorFor(model => model.TotalExtraTaxAmount, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.TotalExtraTaxAmount, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.DisplayName(Accountingsystem.Resources.InvoiceMasterDetails.Net)
                                    @Html.EditorFor(model => model.TotalNet, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.TotalNet, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.DisplayName(Accountingsystem.Resources.SalesReceiptMasterDetails.PaymentMethod)
                                    @Html.EditorFor(model => model.PaymentMethodeName, new { htmlAttributes = new { @class = "form-control mb-4", @disabled = "disabled" } })
                                    @Html.ValidationMessageFor(model => model.PaymentMethodeName, "", new { @class = "text-danger" })
                                </div>
                            </div>


                            <div class="col-md-12">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription)
                                    @Html.TextAreaFor(model => model.Comment, 10, 40, htmlAttributes: new { @class = "form-control mb-4", @disabled = "disabled", @placeholder = Accountingsystem.Resources.OfferPriceMasterCreateOffer.OfferDescription })
                                    @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="allOrderDetailsList" class="col-md-6 mx-auto"></div>
                    <div id="allIreverseItemsOfInvoice" class="col-md-6 mx-auto"></div>
                </div>

                @*<div id="InvoicesDetailList"></div>*@
            </div>

            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                <div class="form-group">
                    @Html.Label(Accountingsystem.Resources.PointOfSaleCreate.PaymentMethod)
                    <div class="input-group">
                        @Html.DropDownListFor(model => model.SelectedPaymentMethodeID, Model.MyPaymentMethodesList, htmlAttributes: new { @class = "form-control Dropdownlist-select" })
                        <div class="input-group-append">
                            <div class="form-control">
                                <label class="text-danger">*</label>
                            </div>
                        </div>
                    </div>
                    @Html.ValidationMessageFor(model => model.SelectedPaymentMethodeID, "", new { @class = "text-danger" })
                </div>
            </div>
            @*<div class="row">
                    <div id="allIreverseItemsOfInvoice" class="col-md-11 mx-auto"></div>
                </div>*@
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.OfferPriceMasterCreateOffer.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>

                    <button id="getAllOrdersBTN" class="btn btn-block btn-outline-secondary mb-lg-0" type="button" data-toggle="modal" data-target="#alldReversdeOrderItemsModal">
                        @Accountingsystem.Resources.OfferPriceMasterIndex.Details<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </button>
                </div>
            </div>

        </form>
        <div id="alldReversdeOrderItemsModal" class="modal animated fadeInRight custo-fadeInRight" role="dialog">
            <div class="modal-dialog modal-lg">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Reversde Order Items</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-x"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div id="allOrdersPartialDialogDiv"></div>
                    </div>
                    <div class="md-button">
                        <button class="btn btn-block btn-outline-secondary mb-lg-0" data-dismiss="modal"><i class="flaticon-cancel-2"></i>@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Cancel</button>

                    </div>
                </div>
            </div>
        </div>
    </div>

}


