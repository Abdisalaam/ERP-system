    <script>
        function AddOrderDetailsToTemp(e) {
            var orderDetailId = e;
            var tempOrderId =@Model.Id;
            var qty = 1;

        $.ajax({
            url: '@Url.Action("AddInvoiceDetailsToReverse", "Cachier")',
            type: 'POST',
            data: { orderDetailId: orderDetailId, tempOrderId: tempOrderId, qty: qty }
        }).done(function (result) {

            $("#allIreverseItemsOfInvoice").load('@(Url.Action("GetAllReversdeOrderDetails", "Cachier"))?orderId=' + @Model.Id);

        });
    }
    </script>
    <script>
        function DeleteTemp(e) {
            var orderDetailId = e;
            var offerMasterId=@Model.Id;
        $.ajax({
            url: '@Url.Action("DeleteInvoiceDetails", "Cachier")',
            type: 'POST',
            data: { orderDetailId: orderDetailId }
        }).done(function (result) {
