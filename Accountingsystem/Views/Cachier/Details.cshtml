            @Accountingsystem.Resources.MasterPOSInvoice.ThermalPrinting
            <span id="PrintSpinner" style="display:none;" class="spinner-border text-primary mr-2 align-self-center loader-sm"></span>
        </a>*@
                    <a id="editOfferBtn" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action("GetAllOrderDetailsToPrintNewWindow" , new { orderId = Model.Id })' target="_blank">
                        @Accountingsystem.Resources.MasterPOSInvoice.ThermalPrinting
                        <span id="editOfferBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                    @if (customer != null && customer.Customer_TaxNumber != null)
                    {
                        var companyPrint = Accountingsystem.Models.InvoicePrintSetting.getCompanyPrint(1);

                        <a id="PrintEmail" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action(companyPrint.PrintLogo, new { controller = "InvoiceQRExternalUseres", id = Model.QRNumber })' target="_blank">
                            @Accountingsystem.Resources.InvoiceMasterDetails.PrintEmail

                        </a>
                        <a id="Print" class="btn btn-block btn-outline-primary mb-lg-0" href='@Url.Action(companyPrint.printWhite, new { controller = "InvoiceQRExternalUseres", id = Model.QRNumber })' target="_blank">
                            @Accountingsystem.Resources.InvoiceMasterDetails.Print

                        </a>

                    }
                    else
                    {
                        <a id="PrintSimple" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Detailsimple", new { controller = "InvoiceQRExternalUseres", id = Model.QRNumber })' target="_blank">
                            @Accountingsystem.Resources.validate.SimplifiedTaxInvoiceEmail

                        </a>
                        <a id="PrintSimple" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Detailsimplewhite", new { controller = "InvoiceQRExternalUseres", id = Model.QRNumber })' target="_blank">
                            @Accountingsystem.Resources.validate.SimplifiedTaxInvoice

                        </a>
                    }
                    @if (Model.Customer != null)
                    {
                        if (!string.IsNullOrEmpty(Model.Customer.Customer_Mail))
                        {
                            <a id="sendOfferByMailBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("SendOrderEmail", new { controller = "Reports", id = Model.Id})'>
                                @Accountingsystem.Resources.InvoiceMasterDetails.SentCustomerEmail
                                <span id="sendOfferByMailBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                            </a>
                        }

                    }

                    @{
                        if (Model.Customer != null && !string.IsNullOrEmpty(Model.Customer.Customer_Phone))
                        {

                            if (Model.Customer.Customer_Phone.Contains(" "))
                            {
                                Model.Customer.Customer_Phone = Model.Customer.Customer_Phone.Replace(" ", string.Empty);
                            }
                            if (Model.Customer.Customer_Phone.Contains("-"))
                            {
                                Model.Customer.Customer_Phone = Model.Customer.Customer_Phone.Replace("-", string.Empty);
                            }
                            if (Model.Customer.Customer_Phone.Contains("#"))
                            {
                                Model.Customer.Customer_Phone = Model.Customer.Customer_Phone.Replace("#", string.Empty);
                            }
                            if (!Model.Customer.Customer_Phone.StartsWith("0") && Model.Customer.Customer_Phone.Length == 9)
                            {
                                var phoneNumber = "966";
                                phoneNumber += Model.Customer.Customer_Phone;
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@phoneNumber" target="_blank">

                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />


                                </a>
                            }

                            if (Model.Customer.Customer_Phone.StartsWith("0") && Model.Customer.Customer_Phone.Length == 10)
                            {
                                var phoneNumber = "966";
                                phoneNumber += Model.Customer.Customer_Phone.Remove(0, 1);
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@phoneNumber" target="_blank">
                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />

                                </a>
                            }
                            if (Model.Customer.Customer_Phone.StartsWith("00") && Model.Customer.Customer_Phone.Length > 13)
                            {
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@Model.Customer.Customer_Phone" target="_blank">
                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />
                                </a>
                            }
                            if (Model.Customer.Customer_Phone.StartsWith("+966") && Model.Customer.Customer_Phone.Length >= 12)
                            {
                                Model.Customer.Customer_Phone = Model.Customer.Customer_Phone.Remove(0, 1);
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@Model.Customer.Customer_Phone" target="_blank">
                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />

                                </a>
                            }
                            if (Model.Customer.Customer_Phone.StartsWith("966") && Model.Customer.Customer_Phone.Length >= 12)
                            {
                                <a id="sendWhatsMessageBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="https://api.whatsapp.com/send?phone=@Model.Customer.Customer_Phone" target="_blank">

                                    <img src="~/Image/WhatsApp.png" style="height:23px;" />
                                </a>
                            }

                        }

                    }
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href="@Url.Action("Index")">
                        @Accountingsystem.Resources.InvoiceMasterDetails.BackToList
                        <span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
