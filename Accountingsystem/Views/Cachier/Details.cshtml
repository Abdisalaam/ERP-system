                            <td>@Math.Round(detail.Quantity, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.ProductPrice, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.ProductTaxAmount, 2, MidpointRounding.AwayFromZero)</td>
                            <td>@Math.Round(detail.SubTotalProduct, 2, MidpointRounding.AwayFromZero)</td>

