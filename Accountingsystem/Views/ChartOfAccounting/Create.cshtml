@model Accountingsystem.ViewModel.ChartOfAccountingVM

@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.ChartOfAccountingCreate.CreateNewAccount;
}


<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
               
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
               
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
              
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
          
            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
        }
    }


</head>

@using (Html.BeginForm("Create", "ChartOfAccounting", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.ChartOfAccountingCreate.CreateNewAccount)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ChartOfAccountingCreate.AccountName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.Account_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Account_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>



                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ChartOfAccountingCreate.AccountNumberOfCreatedAccount)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ChartOfAccountingAccount_Id, Model.chartList, Accountingsystem.Resources.ChartOfAccountingCreate.AccountNumberOfCreatedAccountInformation, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.ChartOfAccountingAccount_Id, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @*<div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.ChartOfAccountingCreate.AccountCurrency)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.Account_Curenncy, Model.CurrencyList, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                        <div class="input-group-append">
                                            <div class="form-control">
                                                <label class="text-danger">*</label>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.Account_Curenncy, "", new { @class = "text-danger" })
                                </div>
                            </div>*@


                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.ChartOfAccountingCreate.CreateAccount<span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.ChartOfAccountingCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>

}


@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>



        }
    }

    <script type="text/javascript">
        $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });
            $("#ChartOfAccountingAccount_Id").chosen();
            $("#ChartOfAccountingAccount_Id_chosen").addClass("form-control Dropdownlist-select");
            $("#Account_Curenncy").chosen();
            $("#Account_Curenncy_chosen").addClass("form-control Dropdownlist-select");
            return false;
        });


    </script>
    <script>
        $('#Account_Name').on('input', function () {
            $("#Account_Name").removeClass("addRequiredFieldToInput");

        });      
        $('#ChartOfAccountingAccount_Id').on('change', function () {
            $("#ChartOfAccountingAccount_Id_chosen").removeClass("addRequiredFieldToInput");
            $('#ChartOfAccountingAccount_Id_chosen span').css('background', '#ffffff');
            $('#ChartOfAccountingAccount_Id_chosen b').css('background', '#ffffff');
        });
        $('#Account_Curenncy').on('change', function () {
            $("#Account_Curenncy_chosen").removeClass("addRequiredFieldToInput");
            $('#Account_Curenncy_chosen span').css('background', '#ffffff');
            $('#Account_Curenncy_chosen b').css('background', '#ffffff');
        });
    </script>
    <script>

        $('#catchReceiptCreateForm').submit(function () {
          
            $('#subBut').prop('disabled', true);
            if ($('#ChartOfAccountingAccount_Id').val() == "" || $('#ChartOfAccountingAccount_Id').val() == null || $('#ChartOfAccountingAccount_Id').val() < 1 || $('#Account_Name').val() == "" || $('#Account_Name').val() == null) {
                $('#subBut').prop('disabled', false);
                $("#createExpensesSpinner").hide();
                if ($('#Account_Name').val() == "" || $('#Account_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ChartOfAccountingCreate.AccountNameRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#Account_Name").addClass("addRequiredFieldToInput");
                    $('#Account_Name').trigger('focus');
                }

                if ($('#ChartOfAccountingAccount_Id').val() == "" || $('#ChartOfAccountingAccount_Id').val() == null || $('#ChartOfAccountingAccount_Id').val() <= 0) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.ChartOfAccountingCreate.SelectAccountRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#ChartOfAccountingAccount_Id_chosen").addClass("addRequiredFieldToInput");
                    $('#ChartOfAccountingAccount_Id_chosen span').css('background', 'red');
                    $('#ChartOfAccountingAccount_Id_chosen b').css('background', 'red');
                    $('html, body').animate({
                        scrollTop: $("#ChartOfAccountingAccount_Id").offset().top
                    }, 2000);
                }
               
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }


        });

    </script>


}


