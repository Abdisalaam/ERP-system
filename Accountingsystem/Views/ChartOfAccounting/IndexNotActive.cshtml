@model IEnumerable<Accountingsystem.Models.ChartOfAccounting>

@{
    ViewBag.Title = Accountingsystem.Resources.ChartOfAccountingIndex.Title;
    HttpCookie cookie = Request.Cookies["Language"];
    var msg = ViewBag.msg;
    var count = 1;
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }

</head>
<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">
                <li class="nav-item theme-text">

                </li>
            </ul>
            <ul class="navbar-item flex-row ml-md-auto">
                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">
                            <div class="dropdown-item">
                                <ul class="nav navbar-nav navbar-right">
                                    <li>
                                        <div class="dropdown-item">
                                            <a href="@Url.Action("Create")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.ChartOfAccountingIndex.CreateNewAccount</a>
                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-item">
                                            <a href='@Url.Action("GetTreeJson")'><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-image"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>@Accountingsystem.Resources.ChartOfAccountingIndex.Diagram</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a class="BTN-style" href=" @Url.Action( "Index" )"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.ChartOfAccountingIndex.Title</a>



                                        </div>
                                    </li>
                                    <li>
                                        <div class="dropdown-item">
                                            <a href='@Url.Action("PrintChartOfAccount", new { controller = "ReportsNew" })' target="_blank"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>@Accountingsystem.Resources.ChartOfAccountingIndex.PrintAccountingTree</a>
                                        </div>
                                    </li>
                                </ul>

                            </div>
                        </div>
                    </div>
                </li>
            </ul>
        </header>
    </div>
    <!--  END NAVBAR  -->
    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            <label>@ViewBag.msg</label>
        </div>
        <div class="text-center">
            @Accountingsystem.Resources.ChartOfAccountingIndex.Title
        </div>

        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>

                    <tr>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ChartOfAccountingIndex.Number)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ChartOfAccountingIndex.AccountName)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ChartOfAccountingIndex.AccountRank)
                        </th>
                        <th>
                            @Html.DisplayName(Accountingsystem.Resources.ChartOfAccountingIndex.Balance)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @count
                                @{count = count + 1;}
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Account_Name)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Account_Level)
                            </td>
                            @{
                                if (item.BalanceSheetValue >= 0)
                                {
                                    <td>
                                        @Math.Round(item.BalanceSheetValue.Value, 2, MidpointRounding.AwayFromZero)
                                    </td>

                                }
                                else
                                {
                                    <td>
                                        (@Math.Round(item.BalanceSheetValue.Value * -1, 2, MidpointRounding.AwayFromZero))
                                    </td>
                                }

                            }
                            <td>
                                <div class="btn-group">
                                    <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">


                                        <a class="dropdown-item" href="@Url.Action("Details", new { id = item.Account_Id })">
                                            @Accountingsystem.Resources.ChartOfAccountingIndex.Details
                                        </a>

                                        <a class="dropdown-item" href='@Url.Action("getListofLedger", "ReportsNew",new {code=item.Account_Code })' target="_blank">
                                            @Accountingsystem.Resources.ChartOfAccountingIndex.Report
                                        </a>
                                        @*@if (item.ISFinalChild == true)
        {

            <a class="dropdown-item" href='@Url.Action("getLedger", new { controller = "Reports", id = item.Account_Id })' target="_blank">
                @Accountingsystem.Resources.ChartOfAccountingIndex.Report
            </a>
        }*@
                                        @if (item.Account_Id <= 238 || item.Account_Code.Contains("010120001") || item.Account_Code.Contains("010120002") || item.Account_Code.Contains("010105") || item.Account_Code.Contains("020104001") || item.Account_Code.Contains("010108001"))
                                        {


                                        }
                                        else
                                        {
                                            <a href="@Url.Action("DeleteTrans", new { id = item.Account_Id })" class="dropdown-item">
                                                @Accountingsystem.Resources.ProductDetails.TransferToNotActive
                                            </a>
                                            <a class="dropdown-item" href="@Url.Action("Edit", new { id = item.Account_Id })">
                                                @Accountingsystem.Resources.ChartOfAccountingIndex.Edit
                                            </a>
                                        }



                                    </div>
                                </div>

                            </td>


                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>




