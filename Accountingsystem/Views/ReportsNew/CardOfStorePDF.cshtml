@model Accountingsystem.ViewModel.ReportsNewVM.ProductCardVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;

    var dateto = "الي" + Convert.ToDateTime(Model.To).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.FromTo).ToString("yyyy/MM/dd ");
}

<html>

<head>

    <title>كارتة صنف فى مخزن </title>

</head>

<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>





            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <hr />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير كارت الصنف / Store Card Report

        </div>

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @Model.Store.Store_Name

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>
                <th style="text-align:center">الصنف<br />item</th>
                <th style="text-align:center">الباركود<br />Barcode</th>
                <th style="text-align:center">الرقم<br />No</th>
                @*<th style="text-align:center"> الوارد<br />Incoming</th>
                    <th style="text-align:center">المنصرف<br />Outgoing</th>*@





            </tr>

        </thead>
        <tbody>
            <tr>

                <td style="text-align:center">
                    @Model.product.Prod_Name
                </td>
                <td style="text-align:center">
                    @Model.product.Bar_Code
                </td>

                <td style="text-align:center">
                    @Model.product.Prod_Code

                </td>
                @*<td style="text-align:center">
                        @Math.Round(Model.TotalImportQuantity, 2, MidpointRounding.AwayFromZero)

                    </td>
                    <td style="text-align:center">
                        (  @Math.Round(Model.TotalExportQuantity, 2, MidpointRounding.AwayFromZero) )

                    </td>*@


            </tr>
        </tbody>


    </table>
    <br />
    <br />



    <br />
    <br />

    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>

                <th colspan="1" width="200px">النوع<br />Type</th>
                <th colspan="1" style="text-align:center">الرقم <br /> No</th>
                <th colspan="1" style="text-align:center" width="100px">التاريخ<br />Date</th>

                <th colspan="3" width="10px" style="text-align:center">الوارد<br />Incoming</th>

                <th colspan="3" width="10px" style="text-align:center">الصادر<br />Outgoing</th>

                <th colspan="3" width="10px" style="text-align:center">الرصيد<br />Balance</th>



            </tr>
        </thead>
        <thead>
            <tr>

                <th></th>
                <th></th>
                <th></th>


                <th style="text-align:center">كمية<br />Qty</th>
                <th style="text-align:center">السعر<br />Price</th>
                <th style="text-align:center">اجمالي<br />Total</th>

                <th style="text-align:center">كمية<br />Qty</th>
                <th style="text-align:center">السعر<br />Price</th>
                <th style="text-align:center">اجمالي<br />Total</th>

                <th style="text-align:center">كمية<br />Qty</th>
                <th style="text-align:center">السعر<br />Price</th>
                <th style="text-align:center">اجمالي<br />Total</th>







            </tr>
        </thead>
        @{
            decimal quantity = 0;
            decimal productCost = 0;
            decimal TotalCost = 0;
            var count = 1;
        }
        <tbody>
            @foreach (var item in Model.ProductList)
            {

                <tr>

                    @{
                        quantity = (quantity + item.importQuantity + item.StartQuantity) - item.ExportQuantity;
                        TotalCost = (TotalCost + item.importCost + item.StartCost) - item.ExportCost;
                        productCost = (productCost + item.importProCost + item.StartProCost) - item.ExportProCost;
                    }


                    <td>
                        @item.Type_Document
                    </td>

                    <td>
                        @item.Document_Serial

                    </td>
                    <td>
                        @if (item.DateOfDocument.Year == 1995)
                        {

                        }
                        else
                        {
                            @item.DateOfDocument.ToString("yyyy/MM/dd ")
                            @*@item.DateOfDocument.ToShortDateString()*@
                        }

                    </td>

                    <td>
                        @Math.Round(item.importQuantity, 2, MidpointRounding.AwayFromZero)

                    </td>
                    @if (item.importQuantity != 0)
                    {

                        <td>
                            @Math.Round(item.importCost / item.importQuantity, 2, MidpointRounding.AwayFromZero)

                        </td>

                    }
                    else
                    {
                        <td>
                            0

                        </td>
                    }

                    <td>
                        @Math.Round(item.importCost, 2, MidpointRounding.AwayFromZero)

                    </td>

                    <td>
                        @Math.Round(item.ExportQuantity, 2, MidpointRounding.AwayFromZero)

                    </td>
                    @if (item.ExportQuantity != 0)
                    {

                        <td>
                            @Math.Round(item.ExportCost / item.ExportQuantity, 2, MidpointRounding.AwayFromZero)

                        </td>

                    }
                    else
                    {
                        <td>
                            0

                        </td>
                    }

                    <td>
                        @Math.Round(item.ExportCost, 2, MidpointRounding.AwayFromZero)

                    </td>

                    <td>
                        @Math.Round(quantity, 2, MidpointRounding.AwayFromZero)

                    </td>
                    @if (quantity != 0)
                    {

                        <td>
                            @Math.Round(TotalCost / quantity, 2, MidpointRounding.AwayFromZero)

                        </td>

                    }
                    else
                    {
                        <td>
                            0

                        </td>
                    }

                    <td>
                        @Math.Round(TotalCost, 2, MidpointRounding.AwayFromZero)

                    </td>


                </tr>

            }
        </tbody>
        <thead>
            <tr>

                <th style="text-align:center" width="200px">الاجمالي<br />Total</th>
                <th></th>
                <th></th>


                @if (Math.Round(Model.TotalImportQuantity, 2, MidpointRounding.AwayFromZero) != 0)
                {
                    <th>
                        @Math.Round(Model.TotalImportQuantity, 2, MidpointRounding.AwayFromZero)

                    </th>

                    <th>
                        @Math.Round(Model.TotalImportCost / Model.TotalImportQuantity, 2, MidpointRounding.AwayFromZero)

                    </th>

                }
                else
                {
                    <th>
                        0

                    </th>
                    <th>
                        0

                    </th>
                }

                <th>
                    @Math.Round(Model.TotalImportCost, 2, MidpointRounding.AwayFromZero)

                </th>


                @if (Model.TotalExportQuantity != 0)
                {
                    <th>
                        @Math.Round(Model.TotalExportQuantity, 2, MidpointRounding.AwayFromZero)

                    </th>
                    <th>
                        @Math.Round(Model.TotalExportCost / Model.TotalExportQuantity, 2, MidpointRounding.AwayFromZero)

                    </th>

                }
                else
                {
                    <th>
                        0

                    </th>
                    <th>
                        0

                    </th>
                }

                <th>
                    @Math.Round(Model.TotalExportCost, 2, MidpointRounding.AwayFromZero)

                </th>

                <th>
                    @Math.Round(Model.TotalAllQuantity, 2, MidpointRounding.AwayFromZero)

                </th>
                @if (Model.TotalAllQuantity != 0)
                {

                    <th>
                        @Math.Round(Model.TotalAllCost / Model.TotalAllQuantity, 2, MidpointRounding.AwayFromZero)

                    </th>

                }
                else
                {
                    <th>
                        0

                    </th>
                }

                <th>
                    @Math.Round(Model.TotalAllCost, 2, MidpointRounding.AwayFromZero)

                </th>








            </tr>
        </thead>
    </table>
    
    <footer style="margin-top:15%;"></footer>

</body>

@*<footer style="margin-top:25%;">
        <hr />
        <h style="text-align:right;margin-left:65%;color:black;font-size:x-large;">Balance Due : @Model.Total</h>
    </footer>*@

</html>

