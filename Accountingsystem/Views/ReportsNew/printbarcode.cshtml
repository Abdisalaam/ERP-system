            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />


        }
    }


</head>
@using (Html.BeginForm("printbarcode", "ReportsNew", FormMethod.Post, new { @id = "offerCreateMasterForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))


{
    @Html.AntiForgeryToken()

<div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
    @Html.HiddenFor(model => model.Product_Id)
   <form id="offerCreateMasterForm">
       <div class="">
           <h3 class="text-center"><label>@ViewBag.Message</label></h3>

           <h3 class="text-center"><label>@Accountingsystem.Resources.ProductCreate.Barcode</label></h3>
           <hr />
           <div class="row">
               <div class="col-md-11 mx-auto">
                   <div class="row">






                       <div class="col-md-6">
                           <div class="form-group">
                               @Html.Label(Accountingsystem.Resources.ProductCreate.ItemName)
                               @Html.CheckBoxFor(model => model.name, new { htmlAttributes = new { @class = "form-control mb-4" } })

                           </div>
                       </div>
                       <div class="col-md-6">
                           <div class="form-group">
                               @Html.Label(Accountingsystem.Resources.ProductCreate.SellingPrice)
                               @Html.CheckBoxFor(model => model.Price, new { htmlAttributes = new { @class = "form-control mb-4" } })

                           </div>
                       </div>
                       <div class="col-md-6">
                           <div class="form-group">
                               @Html.Label(Accountingsystem.Resources.ProductDetails.PriceWithTax)
                               @Html.CheckBoxFor(model => model.PriceWithTax, new { htmlAttributes = new { @class = "form-control mb-4" } })

                           </div>
                       </div>
                       <div class="col-md-6">
                           <div class="form-group">
                               @Html.Label(Accountingsystem.Resources.ProductDetails.DateofValidate)
                               @Html.CheckBoxFor(model => model.DateOfExpire, new { htmlAttributes = new { @class = "form-control mb-4" } })

                           </div>
                       </div>
                       <div class="col-md-6">
                           <div class="form-group">
                               @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.Notes)
                               @Html.CheckBoxFor(model => model.Notes, new { htmlAttributes = new { @class = "form-control mb-4" } })

                           </div>
                       </div>
                   </div>
               </div>
           </div>



           <div class="col-md-12">
               <div class="form-group">
                   <button type="submit" id="createOfferbtn" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.OfferPriceMasterCreateOffer.Create <span id="createOfferSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>
                  
                   <a id="backToListBtn2" class="btn btn-block btn-outline-info mb-lg-0" href='@Url.Action("Index","Product")'>
                       @Accountingsystem.Resources.SlicesCreate.BackToProductsList<span id="backTolistBtnSpinner2" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                   </a>
               </div>
           </div>
       </div>
   </form>
</div>
}


