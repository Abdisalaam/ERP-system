@model Accountingsystem.ViewModel.ReportsNewVM.SubscriptionMaintainDateVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
    decimal totalamount = 0;
    decimal totaldiscount = 0;
    decimal totaltax = 0;
    decimal totalaftertax = 0;
    int counter = 0;
    var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
    var dateto = "الي" + Convert.ToDateTime(Model.to).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.From).ToString("yyyy/MM/dd ");

}


<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير مبيعات الاشتراكات لموظف معين</title>
</head>
<body>
    <div class="row">
        <div class="col-md-6">


            @if (company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>


                @*<tr>
                        <td style="text-align:right; padding-top:20px">
                            @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                            &nbsp&nbsp  : تاريخ عرض السعر
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>*@


            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير مبيعات الاشتراكات لموظف/ Subscribtion Sales For Employee Report

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @{
                if (Model.SubList.FirstOrDefault().empId != 0 || Model.SubList.FirstOrDefault().empId != null)
                {
                    var empName = Accountingsystem.Models.Employee.getEmpById(Model.SubList.FirstOrDefault().empId).Emp_Name;
                    <h>@empName</h>
                }
            }

        </div>

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>

    <br />

    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>
               
                <th>
                    رقم العميل
                    <br />
                    Customer NO
                </th>
                <th style="text-align:center;">
                     العميل
                    <br />
                    Customer
                </th>
                <th style="text-align:center;">
                    رقم الاشتراك
                    <br />
                    Sub NO
                </th>

                <th style="text-align:center;">
                    تاريخ البدء
                    <br />
                    Start Date
                </th>
                <th style="text-align:center;">
                    تاريخ الانتهاء
                    <br />
                    End Date
                </th>
                <th style="text-align:center;">
                    قيمه الاشتراك
                    <br />
                    Sub Amount
                </th>
                <th style="text-align:center;">
                    قيمة الفاتورة
                    <br />
                    Invoice Amount
                </th>
                <th style="text-align:center;">
                    الضريبة
                    <br />
                    Tax
                </th>
                <th style="text-align:center;">
                    الصافي
                    <br />
                    Net
                </th>

            </tr>
        </thead>
        @foreach (var item in Model.SubList)
        {
            totalamount = totalamount + item.EstimatedAmount;
            totaldiscount = totaldiscount + item.AfterDiscount;
            totaltax = totaltax + item.TaxAMount;
            totalaftertax = totalaftertax + item.TotalAfterTax;
            counter++;
            <tr>

                <td style="width:90px">

                    @item.CustomerCode
                </td>
                <td style="width:90px">
                    @item.CustomerNamer
                </td>

                <td style="width:90px">

                    @item.SubCode
                </td>
                <td style="width:90px">
                    @Convert.ToDateTime(item.StartDate).ToString("yyyy/MM/dd ")
                    @*@item.StartDate*@
                </td>
                <td style="width:90px">
                    @Convert.ToDateTime(item.EndDate).ToString("yyyy/MM/dd ")
                    @*@item.EndDate*@
                </td>

                <td style="width:90px">
                    @Math.Round(item.EstimatedAmount, 2, MidpointRounding.AwayFromZero)

                </td>
                <td style="width:90px">
                    @Math.Round(item.AfterDiscount, 2, MidpointRounding.AwayFromZero)

                </td>
                <td style="width:90px">
                    @Math.Round(item.TaxAMount, 2, MidpointRounding.AwayFromZero)

                </td>
                <td style="width:90px">
                    @Math.Round(item.TotalAfterTax, 2, MidpointRounding.AwayFromZero)

                </td>

            </tr>

        }
            <tr>
                <th>
                    الاجمالي
                    <br />
                    Total
                </th>
                <th>

                </th>
               

                <th style="text-align:center;">

                </th>
                <th style="text-align:center;">

                </th>
                <th style="text-align:center;">

                </th>
                <th style="text-align:center;">
                    @Math.Round(totalamount, 2, MidpointRounding.AwayFromZero)
                </th>
                <th style="text-align:center;">
                    @Math.Round(totaldiscount, 2, MidpointRounding.AwayFromZero)
                </th>
                <th style="text-align:center;">
                    @Math.Round(totaltax, 2, MidpointRounding.AwayFromZero)
                </th>
                <th style="text-align:center;">
                    @Math.Round(totalaftertax, 2, MidpointRounding.AwayFromZero)
                </th>

            </tr>
    </table>

</body>
</html>

