@model Accountingsystem.ViewModel.TaxSalesandPurchase

<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />

@*<link href="~/Content/css/Report.css" rel="stylesheet" />*@
<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }
    td{

        font-size:10px;
    }
    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
    var count = 1;

    ViewBag.Title = "تقرير الضرائب التفصيلي";
    decimal totalTax = 0;
    decimal totalSales = 0;
    decimal totalQuantity = 0;
    var dateto = "الي" + Convert.ToDateTime(Model.to).ToString("yyyy/MM/dd ")  ;
    var datefrom = "من" + Convert.ToDateTime(Model.from).ToString("yyyy/MM/dd ");
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير الضرائب التفصيلي </title>
    @*<link href="~/Template/assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/Template/assets/css/style.css" rel="stylesheet" />*@
</head>
<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>


                @*<tr>
                        <td style="text-align:right; padding-top:20px">
                            @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                            &nbsp&nbsp  : تاريخ عرض السعر
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>*@


            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />

    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير الضرائب التفصيلي / Detailed tax report

        </div>
     
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @Model.tax.Tax_Name

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>
    <hr />
    <div class="row">




        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr style="text-align:right;">


                    <th style="text-align:center">التاريخ<br />Date</th>
                    <th style="text-align:right;font-size:xx-small" >الرقم<br />No</th>
                    <th style="text-align:right">القيمة<br />Amount</th>
                    <th style="text-align:right">الضريبة<br />VAT</th>
                    <th style="text-align:right">الاسم<br />Name</th>
                    <th style="text-align:right;font-size:10px">الرقم الضريبي<br />VAT Num</th>
                    <th style="text-align:right">النوع<br />Type</th>
                    <th style="text-align:right">الكمية<br />QTY</th>
                </tr>

            </thead>
            <tbody>


                <tr>
                    <td style="text-align:center">
                        رصيد اول المدة
                    </td>
                    @*<td>
                            @count
                            @{count = count + 1;
                                totalQuantity = item.QuantityOfSales + totalQuantity;

                                totalSales = item.salesPurchValue + totalSales;
                                totalTax = item.ValueOfTax + totalTax;

                            }

                        </td>*@
                    <td></td>

                    <td></td>
                    @*<td>
                            @Html.DisplayFor(modelItem => item.Percentage)
                        </td>*@
                    <td>
                        @if (Model.BallanceBeforeDate < 0)
                        {
                            var taxvalue = "(" + Math.Round(Model.BallanceBeforeDate * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @taxvalue
                            </h>
                        }
                        else
                        {
                            @Math.Round(Model.BallanceBeforeDate, 2, MidpointRounding.AwayFromZero)
                        }
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>







                </tr>

            </tbody>

            <tbody>
                @foreach (var item in Model.details.OrderBy(a=>a.GLDate))
                {
                    {
                        count = count + 1;
                        totalQuantity = item.QuantityOfSales + totalQuantity;

                        totalSales = item.salesPurchValue + totalSales;
                        totalTax = item.ValueOfTax + totalTax;

                    }
                <tr>
                    <td style="text-align:left;font-size:10px;width:150px">
                        <h6>
                            @item.GLDate.ToString("yyyy/MM/dd ")
                        </h6>
                    </td>
                    @*<td>
            @count


        </td>*@
                    <td style="text-align:left;font-size:5px;width:150px">
                        @Html.DisplayFor(modelItem => item.Code)
                    </td>

                    <td>
                        @if (item.salesPurchValue < 0)
                        {
                            var a = "(" + Math.Round(item.salesPurchValue * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(item.salesPurchValue, 2, MidpointRounding.AwayFromZero)
                        }

                    </td>
                    @*<td>
            @Html.DisplayFor(modelItem => item.Percentage)
        </td>*@
                    <td>
                        @if (item.ValueOfTax < 0)
                        {
                            var taxvalue = "(" + Math.Round(item.ValueOfTax * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @taxvalue
                            </h>
                        }
                        else
                        {
                            @Math.Round(item.ValueOfTax, 2, MidpointRounding.AwayFromZero)
                        }
                    </td>
                    <td style="font-size:xx-small">
                        <h6>
                            @Html.DisplayFor(modelItem => item.CustomerName)
                        </h6>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CustomerTaxNum)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DocumentType)
                    </td>
                    <td style="font-size:xx-small">

                        @Math.Round(item.QuantityOfSales, 2, MidpointRounding.AwayFromZero)
                    </td>







                </tr>
                }
            </tbody>
            <thead>
                <tr style="text-align:right;">


                    <th style="text-align:center">الاجمالي<br />Total</th>
                    <th style="text-align:right"></th>
                    <th style="text-align:right">
                        @if (totalSales < 0)
                        {
                            var a = "(" + Math.Round(totalSales * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(totalSales, 2, MidpointRounding.AwayFromZero)
                        }
                    </th>
                    <th style="text-align:right">
                        @if (totalTax + Model.BallanceBeforeDate < 0)
                        {
                            var a = "(" + Math.Round((totalTax + Model.BallanceBeforeDate) * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(totalTax + Model.BallanceBeforeDate, 2, MidpointRounding.AwayFromZero)
                        }
                    </th>
                    <th style="text-align:right"></th>
                    <th style="text-align:right"></th>
                    <th style="text-align:right"></th>
                    <th style="text-align:right;font-size:xx-small ;width:100px">@Math.Round(totalQuantity, 2, MidpointRounding.AwayFromZero)</th>
                </tr>

            </thead>
        </table>
    </div>

    <footer style="margin-top:50%;"></footer>
</body>
</html>

