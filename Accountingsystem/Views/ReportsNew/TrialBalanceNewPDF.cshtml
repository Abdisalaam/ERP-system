                    <th style="text-align:center;font-size:xx-small">مدين<br />Debit</th>
                    <th style="text-align:center;font-size:xx-small">دائن<br />Credit</th>
                    <th style="text-align:center;font-size:xx-small">الصافي<br />Net</th>


                    <th style="text-align:center;font-size:xx-small"></th>


                </tr>
            </thead>


            <tbody>

                @foreach (var item in Model.Detail)
                {
                    if (item.Account.Account_Level == 1)
                    {
                <tr>

                    @if (item.ChildAccountd == null && item.Asset == null)
                    {
                        <td style="float:right;font-size:x-large;width:300px;">

                            <div style="text-align: right;">
                                <span style="white-space: pre-line" dir="rtl" ;>@item.LevelExpresion@item.Account.Account_Name</span>
                            </div>
                        </td>
                        <td style="text-align:center;font-size:small;">
                            @item.Account.Account_Code
                        </td>
                    }
                    else if (item.Asset != null)
                    {
                        <td style="float:right;font-size:x-large;width:300px;">

                            <div style="text-align: right;">
                                <span style="white-space: pre-line" dir="rtl" ;>@item.Asset.FAsset_Description</span>
                            </div>
                        </td>
                        <td style="text-align:center;font-size:small;">
                            @item.Asset.FAsset_Code
                        </td>
                    }
                    else
                    {
                        <td style="float:right;font-size:x-large;width:300px;">

                            <div style="text-align: right;">
                                <span style="white-space: pre-line" dir="rtl" ;>@item.ChildAccountd.Account_Name</span>
                            </div>
                        </td>
                        <td style="text-align:center;font-size:small;">
                            @item.ChildAccountd.Account_Code
                        </td>
                    }
                    <td style="text-align:center;font-size:small;">
                        @if (item.AmountBefor < 0)
                        {
                            var a = "(" + Math.Round(item.AmountBefor * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(item.AmountBefor, 2, MidpointRounding.AwayFromZero)
                        }

                    </td>
                    <td style="text-align:center;font-size:small;">
                        @Math.Round(item.DepitMov, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td style="text-align:center;font-size:small;">
                        @Math.Round(item.CeditMov, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td style="text-align:center;font-size:small;">
                        @if (item.AmountOfPeriod < 0)
                        {
                            var a = "(" + Math.Round(item.AmountOfPeriod * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(item.AmountOfPeriod, 2, MidpointRounding.AwayFromZero)
                        }

                    </td>

                    <td style="text-align:center;font-size:small;">
                        @if (item.FinalAmount < 0)
                        {
                            var a = "(" + Math.Round(item.FinalAmount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(item.FinalAmount, 2, MidpointRounding.AwayFromZero)
                        }

                    </td>





                </tr>
                    }
                    else
                    {
                <tr>

                    @if (item.ChildAccountd == null && item.Asset == null)
                    {
