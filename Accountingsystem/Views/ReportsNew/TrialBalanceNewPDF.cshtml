                        <td style="float:right;font-size:small;width:300px;">

                            <div style="text-align: right;">
                                <span style="white-space: pre-line" dir="rtl" ;>@item.Asset.FAsset_Description</span>
                            </div>
                        </td>
                        <td style="text-align:center;font-size:small;">
