        </div>


    </div>
    <hr />
    <div class="row">




        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr style="text-align:right;">


                    <th style="text-align:right" width="300:px">الحساب<br />Account</th>
                    <th style="text-align:center" width="300:px">رقم الحساب<br />Account NO</th>
                    <th style="text-align:center;font-size:xx-small">رصيد قبل المدة<br />Balance Before duration</th>
                    <th colspan="3" style="text-align:center;font-size:xx-small">الحركات<br />Transaction</th>
                    <th style="text-align:center;font-size:xx-small">رصيد اخر المدة<br />Final Balance</th>


                </tr>
                <tr style="text-align:right;">


                    <th style="text-align:center;" width="300:px"></th>
                    <th style="text-align:center;font-size:xx-small"></th>
