                        <td style="float:right;font-size:small;width:300px;">

                            <div style="text-align: right;">
                                <span style="white-space: pre-line" dir="rtl" ;>@item.ChildAccountd.Account_Name</span>
                            </div>
                        </td>
                        <td style="text-align:center;font-size:small;">
                            @item.ChildAccountd.Account_Code
                        </td>
                    }
                    <td style="text-align:center;font-size:small;">
                        @if (item.AmountBefor < 0)
                        {
                            var a = "(" + Math.Round(item.AmountBefor * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(item.AmountBefor, 2, MidpointRounding.AwayFromZero)
                        }

                    </td>
                    <td style="text-align:center;font-size:small;">
