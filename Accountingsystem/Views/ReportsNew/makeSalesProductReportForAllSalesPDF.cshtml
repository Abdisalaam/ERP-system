@model Accountingsystem.ViewModel.ReportsNewVM.SalesOfProductVM

@{
    Layout = null;
    var dateto = Convert.ToDateTime(Model.EndDate);
    var datefrom = Convert.ToDateTime(Model.startDate);
}
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
<!DOCTYPE html>

<html>

<head>

    <title>تقرير مبيعات الاصناف</title>

</head>

<body>
    
 
    <br />
    <br />

    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير مبيعات الاصناف / Sales Item Report

        </div>


        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            <span style="font-size:16px"><strong>  From :  @datefrom </strong></span>

            <span style="font-size:16px"> <strong> Till :  @dateto </strong></span>

        </div>


    </div>
    <hr />
    <hr />
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr style="text-align:right;">

                <th style="text-align:right" width="100">الرقم<br />NO</th>
                <th style="text-align:center">الصنف<br />Item</th>
                <th style="text-align:center">متوسط التكلفة<br />Item</th>
                <th style="text-align:center">الكمية المباعة<br />Sales Qty</th>
                <th style="text-align:center">اجمالى المبيعات<br />Total Sales</th>
                <th style="text-align:center">النسبة من المبيعات<br />Percentage Of Sales</th>
                <th style="text-align:center">تكلفة المبيعات<br />Sales Cost</th>
                <th style="text-align:center">صافي الربح<br />Net Profit</th>
                <th style="text-align:center" width="100"> %  صافي الربح <br />Net Profit %</th>




            </tr>
        </thead>
        @{
            decimal quality = 0;
            decimal ProductSaled = 0;
            decimal PrecentageSaled = 0;
            decimal Profit = 0;
            decimal PrecentageProfit = 0;
            decimal TotalCost = 0;


        }

        @foreach (var item in Model.DetailList)
        {
            quality += item.quantitySaled;
            ProductSaled += item.tatalSaledPrice;
            PrecentageSaled += item.PrecentageTotalPrice;
            Profit += item.netProfit;
            PrecentageProfit += item.PrecentageNetProfit;
            TotalCost += item.TotalCostOfProduct;
        <tr>


            <td>
                @item.product.Prod_Code

            </td>
            <td>
                @item.product.Prod_Name
            </td>

            <td>

                @Math.Round(item.ProductCost, 2, MidpointRounding.AwayFromZero)
            </td>
            <td>


                @Math.Round(item.quantitySaled, 2, MidpointRounding.AwayFromZero)
            </td>
            <td>


                @Math.Round(item.tatalSaledPrice, 2, MidpointRounding.AwayFromZero)
            </td>
            <td>


                @Math.Round(item.PrecentageTotalPrice, 2, MidpointRounding.AwayFromZero) %
            </td>

            <td>

                @Math.Round(item.TotalCostOfProduct, 2, MidpointRounding.AwayFromZero)
            </td>



            <td>

                @Math.Round(item.netProfit, 2, MidpointRounding.AwayFromZero)
            </td>
            @if (item.product.Prod_Type == Accountingsystem.Models.Prod_Type.خدمة )
            {
                <td>
                    100%
                </td>

            }
            else
            {
                <td>

                    @Math.Round(item.PrecentageNetProfit, 2, MidpointRounding.AwayFromZero) %
                </td>
            }


        </tr>


        }
        <thead>
            <tr>
                <th style="text-align:right">الاجمالي<br />Total</th>
                <th style="text-align:center"></th>
                <th style="text-align:center"></th>
                <th style="text-align:center"></th>
                <th style="text-align:center">@Math.Round(ProductSaled, 2, MidpointRounding.AwayFromZero)</th>
                <th style="text-align:center"> @Math.Round(PrecentageSaled, 2, MidpointRounding.AwayFromZero)%</th>
                <th style="text-align:center">  @Math.Round(TotalCost, 2, MidpointRounding.AwayFromZero)</th>
                <th style="text-align:center"></th>
                <th style="text-align:center" width="150"></th>



               

            </tr>
        </thead>
    </table>

    @*<table class="table" style="width:1000px;text-align:center;" dir="rtl" border="1">
        <tr>



        <tr>
            <td width="460">
                الاجمالي
            </td>

            <td width="100">

                @Math.Round(ProductSaled, 2, MidpointRounding.AwayFromZero)
            </td>
            <td width="100">
                @Math.Round(PrecentageSaled, 2, MidpointRounding.AwayFromZero)%



            </td>
            <td width="100">
                @Math.Round(TotalCost, 2, MidpointRounding.AwayFromZero)


            </td>
            <td width="100"></td>
            <td width="100"></td>

        </tr>



    </table>*@
    </body>

    </html>
