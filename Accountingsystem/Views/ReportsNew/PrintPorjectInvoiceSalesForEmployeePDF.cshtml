@model Accountingsystem.ViewModel.ReportsNewVM.ProjectDateVM

<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>

@{
    Layout = null;
    decimal totalamount = 0;
    decimal totaltax = 0;
    decimal totalaftertax = 0;
    var dateto = "الي" + Convert.ToDateTime(Model.to).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.from).ToString("yyyy/MM/dd ");
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير مبيعات المشاريع لموظف معين </title>
</head>
<body>

    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>





            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <hr />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير مبيعات المشاريع لموظف / Employee Projects Sales Report

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @Model.employee.Emp_Name

        </div>



        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr>
                    <th style="text-align:center">رقم العميل<br />Customer NO</th>
                    <th style="text-align:center">العميل<br />Customer</th>
                    <th style="text-align:center" width="150px">رقم الفاتورة<br />Invoice NO</th>
                    <th style="text-align:center" width="100px">التاريخ<br />Date</th>

                    <th style="text-align:center">قيمة الفاتورة<br /> Amount</th>

                    <th style="text-align:center">الضريبة<br />Tax</th>

                    <th style="text-align:center">الصافي<br />net</th>
                </tr>
            </thead>


            @foreach (var item in Model.List)
            {
                totalamount = totalamount + item.InvoiceAMount;
                totaltax = totaltax + item.TaxAMount;
                totalaftertax = totalaftertax + item.totalafterTax;
                <tr>

                    <td>

                        @item.CustomerCode
                    </td>
                    <td>
                        @item.customerName
                    </td>


                    <td>

                        @item.InvoiceCode
                    </td>
                    <td>
                        @Convert.ToDateTime(item.InvoiceDate).ToString("yyyy/MM/dd ")
                        @*@item.InvoiceDate*@
                    </td>
                    <td>
                        @Math.Round(item.InvoiceAMount, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>
                        @Math.Round(item.TaxAMount, 2, MidpointRounding.AwayFromZero)

                    </td>
                    <td>
                        @Math.Round(item.totalafterTax, 2, MidpointRounding.AwayFromZero)

                    </td>

                </tr>

            }
            <tr>
                <th style="text-align:center">الاجمالي<br />Total</th>
                <th style="text-align:center"></th>
                <th style="text-align:center" width="150px"></th>
                <th style="text-align:center" width="100px"></th>

                <th style="text-align:center">@Math.Round(totalamount, 2, MidpointRounding.AwayFromZero)</th>

                <th style="text-align:center">@Math.Round(totaltax, 2, MidpointRounding.AwayFromZero)</th>

                <th style="text-align:center">@Math.Round(totalaftertax, 2, MidpointRounding.AwayFromZero)</th>
            </tr>
        </table>
        

    

</body>
</html>
