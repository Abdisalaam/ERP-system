@model Accountingsystem.ViewModel.ReportsNewVM.StoreMovmentMaster
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;

    var dateto = "الي" + Convert.ToDateTime(Model.endDate).ToString("yyyy/MM/dd ");
 
}

<html>

<head>

    <title>كارتة الاصناف فى مخزن </title>

</head>

<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>





            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <hr />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير كارت الاصناف / Store Card Report

        </div>

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @Model.store.Store_Name

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
              @dateto

        </div>


    </div>

    <br />


    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>

             
                <th colspan="1" style="text-align:center">الرقم <br /> No</th>
                <th colspan="1" style="text-align:center">الصنف <br /> item</th>
          

                <th colspan="1" width="10px" style="text-align:center">الوارد<br />Incoming</th>

                <th colspan="1" width="10px" style="text-align:center">الصادر<br />Outgoing</th>

                <th colspan="1" width="10px" style="text-align:center">الرصيد<br />Balance</th>



            </tr>
        </thead>
   
        @{
            decimal income = 0;
            decimal outgoing = 0;
            decimal balance = 0;
    
        }
        <tbody>
            @foreach (var item in Model.MovmentDateilList)
            {

                <tr>

                    @{
                        income +=  item.income;
                        outgoing += item.outgoing;
                        balance += item.balance;
                     
                    }


                    <td>
                        @item.product.Bar_Code
                    </td>

                    <td>
                        @item.product.Prod_Name

                    </td>
                    <td>

                        @Math.Round(item.income, 2, MidpointRounding.AwayFromZero)
                    </td>

                    <td>
                        @Math.Round(item.outgoing, 2, MidpointRounding.AwayFromZero)

                    </td>
                 

                        <td>
                            @Math.Round(item.balance, 2, MidpointRounding.AwayFromZero)

                        </td>

          


                </tr>

            }
        </tbody>
        <thead>
            <tr>

             


                <td>
                الاجمالي
                </td>

                <td>
                 

                </td>
                <td>

                    @Math.Round(income, 2, MidpointRounding.AwayFromZero)
                </td>

                <td>
                    @Math.Round(outgoing, 2, MidpointRounding.AwayFromZero)

                </td>


                <td>
                    @Math.Round(balance, 2, MidpointRounding.AwayFromZero)

                </td>




            </tr>
        </thead>
    </table>

    <footer style="margin-top:15%;"></footer>

</body>

@*<footer style="margin-top:25%;">
        <hr />
        <h style="text-align:right;margin-left:65%;color:black;font-size:x-large;">Balance Due : @Model.Total</h>
    </footer>*@

</html>


