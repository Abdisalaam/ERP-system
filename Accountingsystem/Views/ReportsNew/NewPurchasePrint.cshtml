@model Accountingsystem.ViewModel.ReportsNewVM.PurchaseDatesVM

@{
    Layout = null;
    decimal totalamount = 0;
    decimal totarecall = 0;
    decimal totaldef = 0;
    decimal totalAllTax = 0;
    var dateto = "الي" + Convert.ToDateTime(Model.to).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.from).ToString("yyyy/MM/dd ");
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير المشتريات</title>
    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        td {
            font-size: 10px;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>

</head>
<body>
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>




            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />



    <br />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير المشتريات / Purchase Report

        </div>


        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr style="text-align:right;">
                <th style="text-align:center">رقم المورد<br />SuppLier NO</th>
                <th style="text-align:center">المورد<br />SuppLier</th>
                <th style="text-align:right" width="100px"> الرقم <br />Invoice NO</th>
                <th style="text-align:center" width="100px">التاريخ<br />Date</th>
                <th style="text-align:center" width="100px">الاستحقاق<br />Due Date</th>
                <th style="text-align:center"> قيمة الفاتورة<br />Invoice Amount</th>
                <th style="text-align:center"> الضريبة<br />Tax</th>
                <th style="text-align:center">  قيمة المردود<br />Recall Amount</th>
                <th style="text-align:center"> القيمة بدون ضريبة<br />Amount Without Tax</th>

            </tr>

        </thead>
        
        <tbody>
            @foreach (var item in Model.List.OrderBy(a=>a.InvoiceDate))
            {
                totalamount = totalamount + item.invoiceTotal;
                totarecall = totarecall + item.RecallInvoicetotal;
                totaldef = totaldef + item.TotalOFInvoicesBefor;
                totalAllTax = totalAllTax + item.totaltax;
            <tr>
                <td>
                    @item.SupplierCode
                </td>
                <td>

                    @item.supplierName
                    <br />
                    @item.SupplierTaxNumber
                </td>


                <td>

                    @item.InvoiceCode
                </td>
                <td>

                    @Convert.ToDateTime(item.InvoiceDate).ToString("yyyy/MM/dd ")
                </td>
                <td>
                    @Convert.ToDateTime(item.invoiceDeadLine).ToString("yyyy/MM/dd ")
                    @*@item.invoiceDeadLine*@
                </td>

                <td>

                    @Math.Round(item.invoiceTotal, 2, MidpointRounding.AwayFromZero)
                </td>

                <td>

                    @Math.Round(item.totaltax, 2, MidpointRounding.AwayFromZero)
                </td>
                <td>

                    @Math.Round(item.RecallInvoicetotal, 2, MidpointRounding.AwayFromZero) &nbsp&nbsp&nbsp&nbsp
                </td>

                <td>

                    @Math.Round(item.TotalOFInvoicesBefor, 2, MidpointRounding.AwayFromZero) &nbsp&nbsp
                </td>
            </tr>


            }
        </tbody>
        <tr>
           
            <th>الاجمالي</th>
            <th style="text-align:center;">

            </th>
            <th style="text-align:center;">

            </th>
            <th style="text-align:center;">

            </th>
            <th style="text-align:center;">

            </th>

            <th style="text-align:center;">
                @Math.Round(totalamount, 2, MidpointRounding.AwayFromZero)
            </th>
            <th style="text-align:center;">
                @Math.Round(totalAllTax, 2, MidpointRounding.AwayFromZero)
            </th>
            <th style="text-align:center;">
                @Math.Round(totarecall, 2, MidpointRounding.AwayFromZero)
            </th>
            <th style="text-align:center;">
                @Math.Round(totaldef, 2, MidpointRounding.AwayFromZero)
            </th>
        </tr>
    </table>

    @*<table class="table" style="width:1000px;text-align:center; direction:rtl" border="1">
        <tr>
            <td style="width:590px">
                الاجمالي  &nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp &nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp &nbsp&nbsp&nbsp&nbsp&nbsp&nbsp&nbsp
            </td>
            <td style="width:100px">
                @Math.Round(totalamount, 2, MidpointRounding.AwayFromZero)
            </td>
            <td style="width:100px">
                @Math.Round(totalAllTax, 2, MidpointRounding.AwayFromZero)
            </td>
            <td style="width:100px">
                @Math.Round(totarecall, 2, MidpointRounding.AwayFromZero)&nbsp&nbsp&nbsp&nbsp&nbsp
            </td>
            <td style="width:100px">
                @Math.Round(totaldef, 2, MidpointRounding.AwayFromZero)
            </td>
        </tr>
        </table>*@
</body>
</html>
