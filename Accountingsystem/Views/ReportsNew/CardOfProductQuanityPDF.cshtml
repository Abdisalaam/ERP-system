@model Accountingsystem.ViewModel.ReportsNewVM.ProductQuantityListVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />
<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>

@{
    Layout = null;
    var datefrom = "من" + Convert.ToDateTime(Model.FromTo).ToString("yyyy/MM/dd ");
}

<!DOCTYPE html>

<html>

<head>

    <title>كارتة صنف بالكميات</title>

</head>

<body>
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>





            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <hr />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير كارت الصنف بالكميات / Product Card Quantity Report

        </div>


        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom

        </div>


    </div>
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>
                <th style="text-align:center">الصنف<br />item</th>
                <th style="text-align:center">الباركود<br />Barcode</th>
                <th style="text-align:center">الرقم<br />No</th>
                <th style="text-align:center"> الوارد<br />Incoming</th>
                <th style="text-align:center">المنصرف<br />Outgoing</th>





            </tr>

        </thead>
        <tbody>
            <tr>

                <td style="text-align:center">
                    @Model.product.Prod_Name
                </td>
                <td style="text-align:center">
                    @Model.product.Bar_Code
                </td>

                <td style="text-align:center">
                    @Model.product.Prod_Code

                </td>
                <td style="text-align:center">
                      @Math.Round(Model.TotalImportQuantity, 2, MidpointRounding.AwayFromZero) 

                </td>
                <td style="text-align:center">
                    (  @Math.Round(Model.TotalExportQuantity, 2, MidpointRounding.AwayFromZero) )

                </td>


            </tr>
        </tbody>


    </table>
    <br />
    <br />

    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>
               
                <th width="100px">النوع<br />Type</th>
                <th style="text-align:center">الرقم <br /> No</th>
                <th style="text-align:center" width="100px">التاريخ<br />Date</th>
         
                <th width="10px"style="text-align:center">الكمية<br />Qty</th>
                
                <th width="10px" style="text-align:center">الرصيد<br />Balance</th>
                <th  style="text-align:center" >المخزن<br />Store</th>



            </tr>
        </thead>
        @{
            decimal cost = 0;
        }
        <tbody>
            @foreach (var item in Model.ProductList)
            {
            <tr>




                <td>
                    @item.Type_Document
                </td>

                <td style="text-align:center">
                    @item.Document_Serial

                </td>
                <td style="text-align:center">
                    @if (item.DateOfDocument.Year == 1995)
                    {

                    }
                    else
                    {
                        @item.DateOfDocument.ToString("yyyy/MM/dd ")
                        @*@item.DateOfDocument.ToShortDateString()*@
                    }
                </td>
              
                @if (item.importQuantity == 0 && item.ExportQuantity > 0)
                {
                    <td style="text-align:center">
                      (  @Math.Round(item.ExportQuantity , 2, MidpointRounding.AwayFromZero) )

                    </td>
                }
                else
                {
                <td style="text-align:center">
                    @Math.Round(item.importQuantity, 2, MidpointRounding.AwayFromZero)

                </td>
                }
                @{
                    cost = (cost + item.importQuantity + item.StartQuantity) - item.ExportQuantity;
                }
                <td style="text-align:center">
                    @Math.Round(cost, 2, MidpointRounding.AwayFromZero)

                </td>
                @if (item.store != null)
                {
                    <td style="text-align:center">
                        @item.store.Store_Name

                    </td>
                }
                else
                {
                    <td></td>
                }

            </tr>

            }
        </tbody>
        <thead>
            <tr>

          
                <th>الاجمالي<br />total</th>
                <th style="text-align:center"></th>
                <th style="text-align:center" width="100px"></th>
               
              
                <th style="text-align:center">@Math.Round(Model.TotalImportQuantity-Model.TotalExportQuantity, 2, MidpointRounding.AwayFromZero)</th>
                <th style="text-align:center">@Math.Round(Model.TotalAll, 2, MidpointRounding.AwayFromZero)</th>

            </tr>
        </thead>
        
    </table>
   
    <footer style="margin-top:15%;"></footer>

</body>

@*<footer style="margin-top:25%;">
        <hr />
        <h style="text-align:right;margin-left:65%;color:black;font-size:x-large;">Balance Due : @Model.Total</h>
    </footer>*@

</html>
