@model Accountingsystem.ViewModel.ReportsNewVM.SalesCusomerReport


@{
    Layout = null;
    decimal totalCustomerSales = 0;
    var dateto = "الي" + Convert.ToDateTime(Model.EndDate).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.startDate).ToString("yyyy/MM/dd ");
}
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
<!DOCTYPE html>

<html>

<head>
   
    <title>تقرير مبيعات العملاء بالتفصيل</title>

</head>


<body>


    <br />
    <br />
    <br />
    <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
        تقرير مبيعات العملاء بالتفصيل / Sales Of Customers with Details

    </div>
    <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
        @datefrom      @dateto

    </div>
    @foreach (var customer in Model.CustomersSalesReport)
    {
        totalCustomerSales += customer.cutomerBalance;
        <br />

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            عميل / @customer.customer.Customer_Name

        </div>
        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr style="text-align:right;">

                    <th style="text-align:right"width="100">التاريخ<br />Date</th>
                    <th style="text-align:right" >النوع<br />Type</th>
                    <th style="text-align:right" >الصنف<br />Item</th>
                    <th style="text-align:right" width="100" >الرقم<br />NO</th>
                    <th style="text-align:right" >الوصف<br />Describtion</th>
                    <th style="text-align:right" >التكلفة<br />Cost</th>
                    <th style="text-align:right" >الكمية<br />Qty</th>
                    <th style="text-align:right" >سعر الوحدة<br />Unit Price</th>
                    <th style="text-align:right" >الاجمالى <br />Total</th>
                    <th style="text-align:right" >الرصيد<br />Balance</th>
                  


                   


                </tr>
                </thead>


                @{
                    decimal balance = 0;
                    decimal cost = 0;



                }

                @foreach (var item in customer.customerDetail.OrderBy(a=>a.Invoice_date))
                {
                    balance += item.TotalAmount;
                    cost += item.totalCost;
                    <tr>


                        <td>
                            @Convert.ToDateTime(item.Invoice_date).ToString("yyyy/MM/dd ")

                        </td>
                        <td>
                            @item.transtype
                        </td>

                        <td width="100">

                            @item.Invoice_Serial
                        </td>
                        @if (item.Product == null)
                        {
                            <td></td>

                        }
                        else
                        {
                            <td>


                                @item.Product.Prod_Name
                            </td>
                        }
                        <td>
                            @item.Description
                        </td>
                        <td>
                            @Math.Round(item.totalCost, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>


                            @Math.Round(item.quantity, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td>


                            @Math.Round(item.Price_unit, 2, MidpointRounding.AwayFromZero)
                        </td>

                        <td>

                            @Math.Round(item.TotalAmount, 2, MidpointRounding.AwayFromZero)
                        </td>



                        <td>

                            @Math.Round(balance, 2, MidpointRounding.AwayFromZero)
                        </td>




                    </tr>
                }
        </table>
        <table class="table" style="width:1000px;text-align:center;" dir="rtl" border="1">




            <tr>

                <td width="500">
                    <h4>
                        <strong>
                            اجمالي مبيعات | Total Sales
                        </strong>
                    </h4>
                </td>



                <td width="500">
                    <h4>
                        <strong>
                            @Math.Round(customer.cutomerBalance, 2, MidpointRounding.AwayFromZero)
                        </strong>
                    </h4>

                </td>


            </tr>
            <tr>

                <td width="500">
                    <h4>
                        <strong>
                            اجمالي التكلفة | Total Cost
                        </strong>
                    </h4>
                </td>



                <td width="500">
                    <h4>
                        <strong>
                            @Math.Round(cost, 2, MidpointRounding.AwayFromZero)
                        </strong>
                    </h4>

                </td>


            </tr>
            <tr>

                <td width="500">
                    <h4>
                        <strong>
                             الصافي | Net
                        </strong>
                    </h4>
                </td>



                <td width="500">
                    <h4>
                        <strong>
                            @Math.Round(customer.cutomerBalance - cost, 2, MidpointRounding.AwayFromZero)
                        </strong>
                    </h4>

                </td>


            </tr>



        </table>
        <br />
        <br />
    }


    <br />
    <br />
    <br />
    <br />
    <br />
    @if (Model.CustomersSalesReport!=null && Model.CustomersSalesReport.Count() > 1)
    {
        <table class="table" style="width:1000px;text-align:center;" dir="rtl" border="1">




            <tr>

                <td width="500">
                    <h2>
                        <strong>
                            اجمالي مبيعات | Total Sales
                        </strong>
                    </h2>
                </td>



                <td width="500">
                    <h2>
                        <strong>
                            @Math.Round(totalCustomerSales, 2, MidpointRounding.AwayFromZero)
                        </strong>
                    </h2>

                </td>


            </tr>



        </table>
    }




</body>

</html>