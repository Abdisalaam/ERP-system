@model Accountingsystem.ViewModel.ReportsNewVM.SalesDatesVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />
@{
    Layout = null;
    decimal totalamount = 0;
    decimal totarecall = 0;
    decimal totaldef = 0;
    var dateto = "الي" + Convert.ToDateTime(Model.to).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.from).ToString("yyyy/MM/dd ");
}



<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير مردود المبيعات</title>
</head>
<body>



    @*<div class="row">
        <div class="col-md-6">


            @if (Model.ReversList.FirstOrDefault().company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.ReversList.FirstOrDefault().company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.ReversList.FirstOrDefault().company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>





            </table>
        </div>
    </div>
    <br />
    <br />
    <br />*@
    <br />
    <br />
    <br />
    <hr />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير مردودات مبيعات / Recall Of Sales Report

        </div>


        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>
                <th style="text-align:center">رقم العميل<br />Customer NO</th>
                <th style="text-align:center">العميل<br />Customer</th>
                <th style="text-align:center">رقم الفاتورة<br />Invoice NO</th>
                <th style="text-align:center">الموظف<br />Emp</th>
                <th style="text-align:center">رقم المردود<br />Recall NO</th>
                <th style="text-align:center">التاريخ<br />Date</th>
                <th style="text-align:center">قيمه المردود<br />Amount</th>
                <th style="text-align:center">الضريبة<br />Tax</th>
                <th style="text-align:center">الصافي<br />Net</th>

               
            </tr>
            </thead>
            @foreach (var item in Model.ReversList.OrderBy(a=>a.RecallDate))
            {
                totalamount = totalamount + item.TotalOFRecallamount;
                totarecall = totarecall + item.RecalltotalTax;
                totaldef = totaldef + item.RecalltotalafterTax;
                <tr>

                    <td>
                        @item.CustomerCode
                    </td>
                    <td>

                        @item.CustomerName
                    </td>
                    <td>
                        @item.Invoice_Serial
                    </td>
                    <td>

                        @item.Emp_Name
                    </td>

                    <td>

                        @item.InvoiceCode
                    </td>
                    <td>
                        @Convert.ToDateTime(item.RecallDate).ToString("yyyy/MM/dd ")
                        @*@item.RecallDate*@
                    </td>


                    <td style="width:100px">

                        @Math.Round(item.TotalOFRecallamount, 2, MidpointRounding.AwayFromZero)
                    </td>

                    <td style="width:100px">

                        @Math.Round(item.RecalltotalTax, 2, MidpointRounding.AwayFromZero) &nbsp&nbsp&nbsp&nbsp
                    </td>

                    <td style="width:100px">

                        @Math.Round(item.RecalltotalafterTax, 2, MidpointRounding.AwayFromZero) &nbsp&nbsp
                    </td>
                </tr>

            }
                <thead>
                    <tr>
                        <th style="text-align:center">الاجمالي<br />Total</th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center"></th>
                       
                       
                        <th style="text-align:center">
                            @Math.Round(totalamount, 2, MidpointRounding.AwayFromZero)
                        </th>
                        <th style="text-align:center">
                            @Math.Round(totarecall, 2, MidpointRounding.AwayFromZero)&nbsp&nbsp&nbsp&nbsp&nbsp
                        </th>
                        <th style="text-align:center">
                            @Math.Round(totaldef, 2, MidpointRounding.AwayFromZero)
                        </th>
                    </tr>
                </thead>
    </table>
    
</body>
</html>