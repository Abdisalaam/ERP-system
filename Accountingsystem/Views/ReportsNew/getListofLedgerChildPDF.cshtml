@model Accountingsystem.ViewModel.ReportsNewVM.ChildAccountGL
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
    var count = 1;
    decimal totalAmount = 0;
    ViewBag.Title = Accountingsystem.Resources.ReportsgetListofLedger.AccountReport;

    decimal Balance = Model.AmountBefor;

    var dateto = "الي" + Convert.ToDateTime(Model.Todate).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.FromDate).ToString("yyyy/MM/dd ");
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير حساب </title>
    @*<link href="~/Template/assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/Template/assets/css/style.css" rel="stylesheet" />*@
</head>
<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>


                @*<tr>
                        <td style="text-align:right; padding-top:20px">
                            @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                            &nbsp&nbsp  : تاريخ عرض السعر
                        </td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                        <td></td>
                        <td></td>
                        <td> </td>
                    </tr>*@


            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />

    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير حساب / Account Report

        </div>

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @Model.Account.Account_Name

        </div>
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>
    <hr />
    <div class="row">

        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr style="text-align:right;">

                    <th style="text-align:center;font-size:xx-small"></th>
                    <th style="text-align:center;font-size:xx-small">الدائن<br />Credit</th>

                    <th style="text-align:center;font-size:xx-small">المدين<br />Depit</th>




                </tr>

            </thead>


            <tbody>
                <tr>

                    <td style="text-align:center;font-size:5px">رصيد اول المدة | Opening balance </td>
                    <td style="text-align:center;font-size:5px">(@Math.Round(Model.Creditbefor * -1, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:center;font-size:5px"> @Math.Round(Model.Depitbefor, 2, MidpointRounding.AwayFromZero)</td>












                </tr>
                <tr>

                    <td style="text-align:center;font-size:5px">الفترة المحددة | Specified Period </td>
                    <td style="text-align:center;font-size:5px">(@Math.Round(Model.details.Where(a => a.Amount < 0).Select(a => a.Amount).Sum() * -1, 2, MidpointRounding.AwayFromZero))</td>
                    <td style="text-align:center;font-size:5px">@Math.Round(Model.details.Where(a => a.Amount > 0).Select(a => a.Amount).Sum(), 2, MidpointRounding.AwayFromZero)</td>












                </tr>
                <tr>

                    <th style="text-align:center;">الاجمالي<br />Total</th>
                    <th style="text-align:center;font-size:5px">(@Math.Round((Model.details.Where(a => a.Amount < 0).Select(a => a.Amount).Sum() + Model.Creditbefor) * -1, 2, MidpointRounding.AwayFromZero) )</th>
                    <th style="text-align:center;font-size:5px"> @Math.Round(Model.details.Where(a => a.Amount > 0).Select(a => a.Amount).Sum() + Model.Depitbefor, 2, MidpointRounding.AwayFromZero) </th>












                </tr>

            </tbody>


        </table>
        <br />
        <br />

        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr style="text-align:right;">


                    <th style="text-align:center">التاريخ<br />Date</th>
                    @if (Model.Account.Account_Code.StartsWith("EMP"))
                    {

                    }
                    else
                    {
                        <th style="text-align:center">الاستحقاق<br />Due</th>
                    }
                    <th style="text-align:center;font-size:xx-small">الرقم<br />No</th>

                    <th style="text-align:center;font-size:xx-small">الوصف<br />Description</th>
                    <th style="text-align:center;font-size:xx-small">القيمة<br />Amount</th>

                    <th style="text-align:right">الرصيد<br />Balance</th>

                </tr>

            </thead>


            <tbody>
                <tr>
                    <td style="text-align:center;font-size:10px">
                        رصيد اول المدة | Opening balance
                    </td>
                    @if (Model.Account.Account_Code.StartsWith("EMP"))
                    {

                    }
                    else
                    {
                        <td style="text-align:left;font-size:5px"></td>
                    }
                    <td style="text-align:left;font-size:5px"></td>
                    <td style="text-align:left;font-size:5px"></td>
                    <td style="text-align:left;font-size:5px"></td>


                    <td>
                        @if (Model.AmountBefor < 0)
                        {
                            var a = "(" + Math.Round(Model.AmountBefor * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(Model.AmountBefor, 2, MidpointRounding.AwayFromZero)
                        }

                    </td>









                </tr>
                @foreach (var item in Model.details.OrderBy(a => a.date))
                {
                    Balance += item.Amount;
                    totalAmount += item.Amount;
                    <tr>
                        <td style="text-align:center;font-size:xx-small;width:150px;">
                            <h6>
                                @item.date.ToString("yyyy/MM/dd ")
                            </h6>
                        </td>
                        @if (Model.Account.Account_Code.StartsWith("EMP"))
                        {

                        }
                        else
                        {
                            <td style="text-align:center;font-size:xx-small;width:150px;">
                                @if (item.dueDate != null)
                                {
                                    <h6>
                                        @item.dueDate.Value.ToString("yyyy/MM/dd ")
                                    </h6>
                                }
                            </td>
                        }
                        <td style="text-align:center;font-size:xx-small;width:150px;">
                            @Html.DisplayFor(modelItem => item.DocumentNumber)
                        </td>

                        <td style="text-align:right;font-size:5px">
                            @Html.DisplayFor(modelItem => item.Description)
                        </td>

                        <td>
                            @if (item.Amount < 0)
                            {
                                var a = "(" + Math.Round(item.Amount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                <h>
                                    @a
                                </h>
                            }
                            else
                            {
                                @Math.Round(item.Amount, 2, MidpointRounding.AwayFromZero)
                            }

                        </td>

                        <td>
                            @if (Balance < 0)
                            {
                                var taxvalue = "(" + Math.Round(Balance * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                <h>
                                    @taxvalue
                                </h>
                            }
                            else
                            {
                                @Math.Round(Balance, 2, MidpointRounding.AwayFromZero)
                            }
                        </td>


                    </tr>
                }

            </tbody>

            <thead>
                <tr style="text-align:right;">


                    <th style="text-align:center">الاجمالي<br />Total</th>
                    @if (Model.Account.Account_Code.StartsWith("EMP"))
                    {

                    }
                    else
                    {
                        <th style="text-align:right"></th>
                    }
                    <th style="text-align:right"></th>
                    <th style="text-align:right"></th>
                    <th style="text-align:right">
                        @if (totalAmount < 0)
                        {
                            var a = "(" + Math.Round(totalAmount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                            <h>
                                @a
                            </h>
                        }
                        else
                        {
                            @Math.Round(totalAmount, 2, MidpointRounding.AwayFromZero)
                        }
                    </th>
                    <th style="text-align:right"></th>

                </tr>

            </thead>
        </table>
        <br />
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
          خاص بالسندات المعتمدة

        </div>
        <br />

        @if (Model.Account.Account_Code.StartsWith("CUS") || Model.Account.Account_Code.StartsWith("SUP"))
        {
        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr>

                    <th width="200px">الرقم<br />NO</th>
                    <th style="text-align:center">الاسم<br />Name</th>
                    @*<th style="text-align:center" width="100px">الرصيد <br /> balance</th>*@

                    <th width="10px" style="text-align:center">رصيد الفترة<br />Period Balance</th>



                    <th width="10px" style="text-align:center">0-30</th>
                    <th width="10px" style="text-align:center">31-60</th>
                    <th width="10px" style="text-align:center">61-90</th>
                    <th width="10px" style="text-align:center">90+</th>



                </tr>
            </thead>


            <tbody>
             

                    <tr>




                        <td>
                            @Model.Account.Account_Code
                        </td>

                        <td>
                            @Model.Account.Account_Name

                        </td>
                        @*<td>
                            @if (Model.statistic.CurrentBalance >= 0)
                            {
                                @Math.Round(Model.statistic.CurrentBalance, 2, MidpointRounding.AwayFromZero)
                            }
                            else
                            {
                                <p> ( @Math.Round(Model.statistic.CurrentBalance * -1, 2, MidpointRounding.AwayFromZero)  )</p>
                            }

                        </td>*@
                        <td>

                            @if (Model.statistic.Datebalance >= 0)
                            {
                                @Math.Round(Model.statistic.Datebalance, 2, MidpointRounding.AwayFromZero)
                            }
                            else
                            {
                                <p> ( @Math.Round(Model.statistic.Datebalance * -1, 2, MidpointRounding.AwayFromZero)  )</p>
                            }
                        </td>
                      
                        <td>

                            @if (Model.statistic.Date30After >= 0)
                            {
                                @Math.Round(Model.statistic.Date30After, 2, MidpointRounding.AwayFromZero)
                            }
                            else
                            {
                                <p> ( @Math.Round(Model.statistic.Date30After * -1, 2, MidpointRounding.AwayFromZero)  )</p>
                            }

                        </td>
                        <td>

                            @if (Model.statistic.Date60After >= 0)
                            {
                                @Math.Round(Model.statistic.Date60After, 2, MidpointRounding.AwayFromZero)
                            }
                            else
                            {
                                <p> ( @Math.Round(Model.statistic.Date60After * -1, 2, MidpointRounding.AwayFromZero)  )</p>
                            }

                        </td>
                        <td>

                            @if (Model.statistic.Date90After >= 0)
                            {
                                @Math.Round(Model.statistic.Date90After, 2, MidpointRounding.AwayFromZero)
                            }
                            else
                            {
                                <p> ( @Math.Round(Model.statistic.Date90After * -1, 2, MidpointRounding.AwayFromZero)  )</p>
                            }

                        </td>
                        <td>

                            @if (Model.statistic.Date120After >= 0)
                            {
                                @Math.Round(Model.statistic.Date120After, 2, MidpointRounding.AwayFromZero)
                            }
                            else
                            {
                                <p> ( @Math.Round(Model.statistic.Date120After * -1, 2, MidpointRounding.AwayFromZero)  )</p>
                            }

                        </td>
                    </tr>
                }

            </tbody>




        </table>
        }
    </div>

    <footer style="margin-top:50%;"></footer>
</body>
</html>





