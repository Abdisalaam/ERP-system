@model Accountingsystem.ViewModel.ReportsNewVM.ProjectDetailsVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
}
@{
    decimal TotalDebit = 0;
    decimal TotalCredit = 0;
    decimal DiffBalance = 0;
    decimal count = 1;
    var dateto = "الي" + Convert.ToDateTime(Model.To_Date).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.From_Date).ToString("yyyy/MM/dd ");

}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير حساب المشروع</title>
</head>


<body>
    
    <div class="container">
        <div class="row">
            <div class="col-md-6">


                @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
                {
                    <div>
                        <h style="padding-top:100px">
                            <br /><br />
                        </h>
                    </div>
                }
                else
                {
                    foreach (var item2 in Model.company.CompanyPhotoDetails)
                    {
                        <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                    }
                }
            </div>
            <div class="col-md-6" style="margin-top:-70px">
                <table style="text-align:right;" data-sortable="" width="900">


                    <tr>
                        <td style="text-align:right;">@Model.company.Comp_Name</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>


                    @*<tr>
                            <td style="text-align:right; padding-top:20px">
                                @Convert.ToDateTime(Model.Invoice_Date).Day-@Convert.ToDateTime(Model.Invoice_Date).Month-@Convert.ToDateTime(Model.Invoice_Date).Year
                                &nbsp&nbsp  : تاريخ عرض السعر
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>

                            <td></td>
                            <td></td>
                            <td> </td>
                        </tr>*@


                </table>
            </div>
        </div>
        <br />
        <br />
        <br />
        <br />
        <br />
        <br />

        <div class="container">

            <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
                تقرير حساب مشروع / Project Account Report

            </div>
            <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
                @Model.ProjectName

            </div>
            <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
                @datefrom      @dateto

            </div>


        </div>

    </div>
    <hr />
    <br /> <br />
    <table style="text-align:right; margin-bottom:25px" align="right" width="500" border="1">
        <tr>
            <td>
                @Model.ProjectCode
            </td>
            <th>
                رقم المشروع
            </th>
        </tr>

        <tr>
            <td>
                @Convert.ToDateTime(Model.ProjectStartDate).ToString("yyyy/MM/dd ")
                @*@Convert.ToDateTime(Model.ProjectStartDate).ToShortDateString()*@
            </td>
            <th>
                تاريخ بداية المشروع
            </th>
        </tr>

        <tr>
            <td>
                @Model.Statu
            </td>
            <th>
                حالة المشروع
            </th>
        </tr>
        <tr>
            <td>
                @Model.CustomerName
            </td>
            <th>
                اسم العميل
            </th>
        </tr>
        <tr>
            <td>
                @Model.CustomerCode
            </td>
            <th>
                رقم العميل
            </th>
        </tr>
        <tr>
            @{
                var accountballance = @Math.Round(Accountingsystem.Models.Accounts.RefreshTheBallanceOfCustomer(Model.CustomerCode), 2, MidpointRounding.AwayFromZero);


            }
            @if (accountballance >= 0)
            {
                <td>@accountballance</td>
            }
            else
            {
                accountballance = accountballance * -1;
                <td>(@accountballance)</td>
            }

            <th>
                رصيد العميل
            </th>
        </tr>
    </table>

    <br /> <br /> <br /> <br />

    <table class="table" style="text-align:right;">
        <tr>


            <th style="text-align:center;">
                دائن &nbsp&nbsp&nbsp&nbsp
            </th>
            <th style="text-align:center;">
                مدين &nbsp&nbsp&nbsp&nbsp
            </th>
            @*<th style="text-align:center;">
                    طريقة الدفع  &nbsp&nbsp&nbsp&nbsp
                </th>*@
            <th style="text-align:center;">
                الوصف  &nbsp&nbsp&nbsp&nbsp
            </th>
            <th style="text-align:center;">
                نوع السند &nbsp&nbsp&nbsp&nbsp
            </th>
            <th style="text-align:center;">
                رقم السند &nbsp&nbsp&nbsp&nbsp
            </th>

            <th style="text-align:center;">
                تاريخ السند &nbsp&nbsp&nbsp&nbsp
            </th>
            <th style="text-align:center;">
                البيان &nbsp&nbsp&nbsp&nbsp
            </th>
        </tr>


        @foreach (var item in Model.ProjectDetailsGLVMs)
        {
            decimal credit = 0;
            decimal debit = 0;
            <tr>


                <td>
                    @Math.Round(item.Balance_Credit * -1, 2, MidpointRounding.AwayFromZero)



                    @{
                        TotalCredit += item.Balance_Credit;
                        TotalDebit += item.Balance_Debit;
                    }
                </td>
                <td>
                    @Math.Round(item.Balance_Debit, 2, MidpointRounding.AwayFromZero)

                </td>
                <td>
                    @item.GlDescrib
                </td>
                <td>
                    @item.GlType
                </td>
                <td>
                    @item.GlCode
                </td>
                <td>
                    @Convert.ToDateTime(item.GlDate).ToShortDateString()
                </td>
                <td>
                    @count
                </td>
                @{

                    count++;
                }

            </tr>
        }


    </table>

    <br /><br />
    @{
        DiffBalance = TotalDebit + TotalCredit;
    }


    <table style="text-align:right;" align="right" width="500" border="1">

        <tr>
            <td>

                @Math.Round(TotalDebit, 2, MidpointRounding.AwayFromZero)
            </td>
            <th>
                اجمالى المدين
            </th>
        </tr>
        <tr>
            @{decimal credita = TotalCredit * -1;}
            @if (@Math.Round(credita, 2, MidpointRounding.AwayFromZero) == 0)
            {
                <td>@credita</td>
            }
            else
            {
                <td>

                    (@Math.Round(credita, 2, MidpointRounding.AwayFromZero))

                </td>
            }
            <th>
                اجمالى الدائن
            </th>
        </tr>
        <tr>
            @if (@Math.Round(DiffBalance, 2, MidpointRounding.AwayFromZero) >= 0)
            {
                DiffBalance = @Math.Round(DiffBalance, 2, MidpointRounding.AwayFromZero);
                <td>@DiffBalance</td>
            }
            else
            {
                DiffBalance = @Math.Round(DiffBalance, 2, MidpointRounding.AwayFromZero);
                <td>(@DiffBalance)</td>
            }


            <th>
                الرصيد
            </th>
        </tr>

    </table>

    <br /> <br /> <br /> <br /> <br />
    <table style="text-align:right;" align="right" width="500" border="1">

        <tr>
            <td>

                @Math.Round(Model.ProjectAMount, 2, MidpointRounding.AwayFromZero)
            </td>
            <th>
                قيمة المشروع
            </th>
        </tr>

        <tr>
            <td>
                @Math.Round(Accountingsystem.Models.Project.amountofProjectRecipt(Model.ProjectId), 2, MidpointRounding.AwayFromZero)

            </td>
            <th>
                المبالغ المستلمة
            </th>
        </tr>
        <tr>
            <td>
                @Math.Round(Accountingsystem.Models.Project.amountafterpost(Model.ProjectId), 2, MidpointRounding.AwayFromZero)
            </td>
            <th>
                مبالغ الفواتير
            </th>
        </tr>
        <tr>
            <td>
                @Math.Round((Model.ReceivedAmount), 2, MidpointRounding.AwayFromZero)
            </td>
            <th>
                مبالغ مستلمة سابقاً
            </th>
        </tr>
    </table>


    <footer style="margin-top:15%;"></footer>

</body>


</html>
