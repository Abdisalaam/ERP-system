@model Accountingsystem.ViewModel.ReportsNewVM.SalesOfProductVM
@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.ReportsNewmakeSalesProductReportForAllSales.ProductsAndServicesReport;
   
    var dateto = Convert.ToDateTime(Model.EndDate);
    var datefrom = Convert.ToDateTime(Model.startDate);

}


<head>
    @{
        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }
</head>





<div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
    <!--  BEGIN NAVBAR  -->
    <div class="header-container">
        <header class="header navbar navbar-expand-sm">
            <ul class="navbar-item flex-row text-center">

                <li class="nav-item theme-text">

                </li>

            </ul>
            <ul class="navbar-item flex-row ml-md-auto">


                <li class="nav-item dropdown user-profile-dropdown">
                    <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                    </a>
                    <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                        <div class="">


                            <div class="dropdown-item">

                                <ul class="nav navbar-nav navbar-right">
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "makeSalesProductReportForAllSalesPDF")" target="_blank"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>PDF</a>
                                        </div>
                                    </li>
                                    <li>

                                        <div class="dropdown-item">
                                            <a href=" @Url.Action( "MakeSalesProductReportForAllSalesThermal")" target="_blank">@Accountingsystem.Resources.MasterPOSInvoice.ThermalPrinting</a>
                                        </div>
                                    </li>
                                </ul>

                            </div>
                        </div>
                    </div>


                </li>

            </ul>
        </header>
    </div>

    <!--  END NAVBAR  -->

    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @Accountingsystem.Resources.ReportsNewmakeSalesProductReportForAllSales.ProductsAndServicesReport
        </div>
        <div class="text-center">
            <label>@ViewBag.Message</label>
            <p class="centered">

               
                <span style="font-size:16px"><strong>  From :  @datefrom </strong></span>
                
                <span style="font-size:16px"> <strong> Till :  @dateto </strong></span>

            </p>
        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                <thead>
                    <tr style="text-align:right;">

                        <th style="text-align:right" width="100">الرقم<br />NO</th>
                        <th style="text-align:center">الصنف<br />Item</th>
                        <th style="text-align:center">متوسط التكلفة<br />Item</th>
                        <th style="text-align:center">الكمية المباعة<br />Sales Qty</th>
                        <th style="text-align:center">اجمالى المبيعات<br />Total Sales</th>
                        <th style="text-align:center">النسبة من المبيعات<br />Percentage Of Sales</th>
                        <th style="text-align:center">تكلفة المبيعات<br />Sales Cost</th>
                        <th style="text-align:center">صافي الربح<br />Net Profit</th>
                        <th style="text-align:center" width="100"> %  صافي الربح <br />Net Profit %</th>




                    </tr>
                </thead>
                @{
                    decimal quality = 0;
                    decimal ProductSaled = 0;
                    decimal PrecentageSaled = 0;
                    decimal Profit = 0;
                    decimal PrecentageProfit = 0;
                    decimal TotalCost = 0;


                }
                <tbody>
                    @foreach (var item in Model.DetailList)
                    {
                        quality += item.quantitySaled;
                        ProductSaled += item.tatalSaledPrice;
                        PrecentageSaled += item.PrecentageTotalPrice;
                        Profit += item.netProfit;
                        PrecentageProfit += item.PrecentageNetProfit;
                        TotalCost += item.TotalCostOfProduct;
                        <tr>


                            <td>
                                @item.product.Prod_Code

                            </td>
                            <td>
                                @item.product.Prod_Name
                            </td>

                            <td>

                                @Math.Round(item.ProductCost, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>


                                @Math.Round(item.quantitySaled, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>


                                @Math.Round(item.tatalSaledPrice, 2, MidpointRounding.AwayFromZero)
                            </td>
                            <td>


                                @Math.Round(item.PrecentageTotalPrice, 2, MidpointRounding.AwayFromZero) %
                            </td>

                            <td>

                                @Math.Round(item.TotalCostOfProduct, 2, MidpointRounding.AwayFromZero)
                            </td>



                            <td>

                                @Math.Round(item.netProfit, 2, MidpointRounding.AwayFromZero)
                            </td>
                            @if (item.product.Prod_Type == Accountingsystem.Models.Prod_Type.خدمة)
                            {
                                <td>
                                    100%
                                </td>

                            }
                            else
                            {
                                <td>

                                    @Math.Round(item.PrecentageNetProfit, 2, MidpointRounding.AwayFromZero) %
                                </td>
                            }


                        </tr>


                    }
                </tbody>
                <thead>
                    <tr>
                        <th style="text-align:right">الاجمالي<br />Total</th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center">@Math.Round(ProductSaled, 2, MidpointRounding.AwayFromZero)</th>
                        <th style="text-align:center"> @Math.Round(PrecentageSaled, 2, MidpointRounding.AwayFromZero)%</th>
                        <th style="text-align:center">  @Math.Round(TotalCost, 2, MidpointRounding.AwayFromZero)</th>
                        <th style="text-align:center"></th>
                        <th style="text-align:center" width="150"></th>





                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>



@section Scripts {

