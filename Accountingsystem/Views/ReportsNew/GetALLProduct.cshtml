@model Accountingsystem.ViewModel.ReportsNewVM.ProductListVM
<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
    decimal totalQuantity = 0;
    decimal totalPrice = 0;
    decimal totalCost = 0;
}

<!DOCTYPE html>

<html>

<head>

    <title>كميات الاصناف بالتكلفة وسعر البيع</title>

</head>

<body>
    <div class="row">
        <div class="col-md-6">


            @if (Model.company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in Model.company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@Model.company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>




            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            كميات الاصناف بالتكلفة وسعر البيع / Quantity items with Cost and Sale Price Report

        </div>




    </div>
    <hr />
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr style="text-align:right;">
                <th style="text-align:center">الرقم<br />NO</th>
                <th style="text-align:center" width="200">الصنف<br />Item</th>
                <th style="text-align:center">الكمية<br />Qty</th>
                <th style="text-align:center">سعر التكلفة<br />Cost Price</th>
                <th style="text-align:center">سعر البيع<br />Sale Price</th>
                <th style="text-align:center">التكلفة التقديرية<br />Estimated Cost</th>


            </tr>
        </thead>
        <tbody>
            @if (Model.all > 0)
            {
                foreach (var item in Model.Products)
                {

                    var pro = Accountingsystem.Models.Product.getTotalQuantityandCost(item.Prod_ID);
                    var probatch = item.ProductBatches.Where(a => a.Store_ID == 1).FirstOrDefault();
                    totalPrice += pro.Sale_Price.Value * item.Sale_Price.Value;
                    totalQuantity += pro.Sale_Price.Value;



            <tr>



                <td width="100">
                    @item.Prod_Code
                </td>
                <td>
                    @item.Prod_Name
                </td>

                <td>
                    @Math.Round(pro.Sale_Price.Value, 2, MidpointRounding.AwayFromZero)
                </td>
                @if (pro.Sale_Price == 0)
                {
                <td> @Math.Round(pro.Prod_Cost_Price.Value, 2, MidpointRounding.AwayFromZero)</td>
                }
                else
                {
                    <td>
                        @Math.Round(pro.Prod_Cost_Price.Value / pro.Sale_Price.Value, 2, MidpointRounding.AwayFromZero)
                        @{totalCost += pro.Prod_Cost_Price.Value;


                        }
                    </td>
                }
                @if (probatch == null|| probatch.SalesPrice==null)
                {
                    <td>  @Math.Round(item.Sale_Price.Value, 2, MidpointRounding.AwayFromZero)</td>
                }
                else
                {
                    <td>
                        @Math.Round(probatch.SalesPrice.Value, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                    <td>
                        @Math.Round(item.Prod_Cost_Price.Value, 2, MidpointRounding.AwayFromZero)
                    </td>

            </tr>

                                            }
                                        }
                                        else
                                        {
                                            foreach (var item in Model.Products)
                                            {

                                                var pro = Accountingsystem.Models.Product.getTotalQuantityandCost(item.Prod_ID);
                                                var probatch = item.ProductBatches.Where(a => a.Store_ID == 1).FirstOrDefault();
                                                totalPrice += pro.Sale_Price.Value * item.Sale_Price.Value;
                                                totalQuantity += pro.Sale_Price.Value;
                                                if (Math.Round(pro.Sale_Price.Value, 2, MidpointRounding.AwayFromZero) > 0)
                                                {


            <tr>



                <td width="100">
                    @item.Prod_Code
                </td>
                <td>
                    @item.Prod_Name
                </td>

                <td>
                    @Math.Round(pro.Sale_Price.Value, 2, MidpointRounding.AwayFromZero)
                </td>
                @if (pro.Sale_Price == 0)
                {
                    <td> @Math.Round(pro.Prod_Cost_Price.Value, 2, MidpointRounding.AwayFromZero)</td>
                }
                else
                {
                    <td>
                        @Math.Round(pro.Prod_Cost_Price.Value / pro.Sale_Price.Value, 2, MidpointRounding.AwayFromZero)
                        @{totalCost += pro.Prod_Cost_Price.Value;


                        }
                    </td>
                }
                @if (probatch == null || probatch.SalesPrice == null)
                {
                    <td>  @Math.Round(item.Sale_Price.Value, 2, MidpointRounding.AwayFromZero)</td>
                }
                else
                {
                    <td>
                        @Math.Round(probatch.SalesPrice.Value, 2, MidpointRounding.AwayFromZero)
                    </td>
                }

                <td>
                    @Math.Round(item.Prod_Cost_Price.Value, 2, MidpointRounding.AwayFromZero)
                </td>

            </tr>
                    }
                }
            }

        </tbody>

    </table>
    <br />
    <br />
    <br />
    <br />
    <br />

    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr style="text-align:right;">
                <th style="text-align:center">اجمالي الكميات<br />TotalQuantity</th>
                <th style="text-align:center">اجمالي اسعار التكلفة<br />TotalCost</th>
                <th style="text-align:center">اجمال اسعار البيع<br />TotalPrice</th>
               



            </tr>
        </thead>
        <tbody>
         

           


                    <tr>



                        <td style="text-align:center">
                            @Math.Round(totalQuantity, 2, MidpointRounding.AwayFromZero)
                        </td>
                        <td style="text-align:center">
                            @Math.Round(totalCost, 2, MidpointRounding.AwayFromZero)
                        </td>

                        <td style="text-align:center">
                            @Math.Round(totalPrice, 2, MidpointRounding.AwayFromZero)
                        </td>
                   
                    </tr>
       
        </tbody>

    </table>
    <footer style="margin-top:15%;"></footer>

</body>

