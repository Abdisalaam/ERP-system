@model Accountingsystem.ViewModel.ReportsNewVM.DailyPOSEmp
    @{ 

        var company = Accountingsystem.Models.Company.GetCompanies().FirstOrDefault();
        decimal totalAcount = 0;
    }
<head>
    <link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


    <style>
        @@media screen {
            div.divFooter {
                display: none;
            }
        }

        @@media print {
            div.divFooter {
                position: fixed;
                bottom: 0;
            }

            @@media print {
                body {
                    margin-top: 50px;
                }
            }
        }
    </style>
    <style type="text/css">
        table {
            page-break-inside: auto
        }

        td {
            font-size: 10px;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto
        }

        thead {
            display: table-header-group
        }

        tfoot {
            display: table-footer-group
        }
    </style>
    <title>  تقرير العملاء لموظف معيين </title>

</head>
@{
    Layout = null;
    decimal totalamount = 0;
    decimal totarecall = 0;
    decimal totaldef = 0;
}

<!DOCTYPE html>

<html>

<body>

    <div class="row">
        <div class="col-md-6">


            @if (company.CompanyPhotoDetails.FirstOrDefault() == null)
            {
                <div>
                    <h style="padding-top:100px">
                        <br /><br />
                    </h>
                </div>
            }
            else
            {
                foreach (var item2 in company.CompanyPhotoDetails)
                {
                    <img src="data:image/jpg;base64,@Convert.ToBase64String(item2.ProImg)" alt="Image" style="width:100px" />

                }
            }
        </div>
        <div class="col-md-6" style="margin-top:-70px">
            <table style="text-align:right;" data-sortable="" width="900">


                <tr>
                    <td style="text-align:right;">@company.Comp_Name</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>

                </tr>





            </table>
        </div>
    </div>
    <br />
    <br />
    <br />
    <br />
    <br />
    <br />

    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير العملاء لموظف معين / Customers for Empolyee Report

        </div>


        <br />
        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @Accountingsystem.Models.Employee.getEmpById(Model.Employee_Id).Emp_Name

        </div>

        <table class="table" style="text-align:right;direction:rtl;">
            <thead>
                <tr>

                    <th>رقم العميل</th>
                    <th style="text-align:center;">
                        اسم العميل &nbsp&nbsp&nbsp&nbsp
                    </th>
                    <th style="text-align:center;">
                        الايميل &nbsp&nbsp&nbsp&nbsp
                    </th>
                    <th style="text-align:center;">
                        الجوال &nbsp&nbsp&nbsp&nbsp
                    </th>
                    <th style="text-align:center;">
                        الرصيد  &nbsp&nbsp&nbsp&nbsp
                    </th>

                </tr>
            </thead>
            @foreach (var item in Model.CustomerList)
            {
                <tbody>
                    <tr>
                        <td>

                            @item.Customer_Code
                        </td>
                        <td>

                            @item.Customer_Name
                        </td>
                        <td>
                            @item.Customer_Mail
                        </td>

                        <td>

                            @item.Customer_Phone
                        </td>
                        <td>
                            @{String custBalance = "";
                                decimal account = Accountingsystem.Models.Accounts.RefreshTheBallanceOfCustomer(item.Customer_Code);
                                totalAcount += account;
                                if (Math.Round(account, 2, MidpointRounding.AwayFromZero) < 0)
                                {
                                    custBalance = "(" + (Math.Round(account, 2, MidpointRounding.AwayFromZero) * -1).ToString() + ")";
                                }
                                else
                                {
                                    custBalance = Math.Round(account, 2, MidpointRounding.AwayFromZero).ToString();
                                }

                                @custBalance
                            }

                        </td>
                    </tr>
                </tbody>

            }
            <tr>
                <th>

                 الاجمالي
                </th>
                <th>

                  
                </th>
                <th>
                   
                </th>

                <th>

                   
                </th>
                <th>
                    @{String custBalanceo = "";
                        
                        if (Math.Round(totalAcount, 2, MidpointRounding.AwayFromZero) < 0)
                        {
                            custBalanceo = "(" + (Math.Round(totalAcount, 2, MidpointRounding.AwayFromZero) * -1).ToString() + ")";
                        }
                        else
                        {
                            custBalanceo = Math.Round(totalAcount, 2, MidpointRounding.AwayFromZero).ToString();
                        }

                        @custBalanceo
                    }

                </th>
            </tr>
        </table>
    </div>
</body>
</html>
