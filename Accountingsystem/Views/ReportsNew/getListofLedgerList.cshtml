@model Accountingsystem.ViewModel.ReportsNewVM.MRGL
@{
    ViewBag.Title = Accountingsystem.Resources.ReportsgetListofLedger.GeneralLedger;
    HttpCookie cookie = Request.Cookies["Language"];
}

<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />

@*<link href="~/Content/css/Report.css" rel="stylesheet" />*@
<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
@{
    Layout = null;
    var count = 1;
    decimal totalAmount = 0;
 

    decimal Balance = Model.AmountBefor;

    var dateto = "الي" + Convert.ToDateTime(Model.Todate).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.FromDate).ToString("yyyy/MM/dd ");
}
<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/custom_dt_html5.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/dt-global_style.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/table/datatable/datatables.css")" rel="stylesheet" type="text/css" />
        }
    }




</head>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير حساب </title>
    @*<link href="~/Template/assets/libs/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
        <link href="~/Template/assets/css/style.css" rel="stylesheet" />*@
</head>
<body>
    @*<img src="~/Content/Images/Logo/Logo login-01.png" alt="Image" width="70" />*@
    <div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
        <!--  BEGIN NAVBAR  -->
        <div class="header-container">
            <header class="header navbar navbar-expand-sm">
                <ul class="navbar-item flex-row text-center">

                    <li class="nav-item theme-text">

                    </li>

                </ul>
                <ul class="navbar-item flex-row ml-md-auto">


                    <li class="nav-item dropdown user-profile-dropdown">
                        <a href="javascript:void(0);" class="nav-link dropdown-toggle user" id="userProfileDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-justify"><line x1="21" y1="10" x2="3" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="21" y1="18" x2="3" y2="18"></line></svg>
                        </a>
                        <div class="dropdown-menu position-absolute" aria-labelledby="userProfileDropdown">
                            <div class="">


                                <div class="dropdown-item">

                                    <ul class="nav navbar-nav navbar-right">

                                        <li>
                                            <div class="dropdown-item">
                                                <a href="@Url.Action( "getListofLedgerPdf")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>PDF</a>
                                            </div>

                                        </li>
                                        <li>
                                            <div class="dropdown-item">
                                                <a href="@Url.Action( "getListofLedgerNewExcel")"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-file-plus"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>Excel</a>
                                            </div>

                                        </li>
                                    </ul>

                                </div>
                            </div>
                        </div>


                    </li>

                </ul>
            </header>
        </div>
        <!--  END NAVBAR  -->
        <div class="widget-content widget-content-area br-6">
            <div class="text-center">
                <label>@ViewBag.Msg</label>
            </div>
            <div style="text-align:center;font-size:medium;margin-bottom:25px;">
                @Accountingsystem.Resources.ReportsgetListofLedger.GeneralLedger
            </div>

            <div style="text-align:center;font-size:medium;margin-bottom:25px;">
                @Model.Account.Account_Name

            </div>
            <div style="text-align:center;font-size:medium;margin-bottom:25px;">
                @datefrom      @dateto

            </div>



            <div class="table-responsive mb-4 mt-4">
                <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                    <thead>
                        <tr style="text-align:right;">


                            <th>@Accountingsystem.Resources.GLMasterDetail.GL_Date</th>
                            <th>@Accountingsystem.Resources.GLMasterDetail.ConstraintNumber</th>
                            @if (Model.Account.ChartOfAccountings.Count != 0)
                            {
                                <th>@Accountingsystem.Resources.ChartOfAccountingCreate.AccountName</th>
                            }
                            <th>@Accountingsystem.Resources.GLMasterDetail.AssistantAccount</th>

                            <th>@Accountingsystem.Resources.ReceiptCreate.ReceiptAmount</th>

                            <th>@Accountingsystem.Resources.CustomerDetails.CustomerBalance</th>
                            <th></th>
                        </tr>

                    </thead>


                    <tbody>
                        <tr>
                            <td style="text-align:center;font-size:10px">
                                رصيد قبل المدة
                            </td>

                            @if (Model.Account.ChartOfAccountings.Count != 0)
                            {
                                <td></td>
                            }
                            <td></td>
                            <td></td>

                            <td></td>
                            <td>
                                @if (Model.AmountBefor < 0)
                                {
                                    var a = "(" + Math.Round(Model.AmountBefor * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                    <h>
                                        @a
                                    </h>
                                }
                                else
                                {
                                    @Math.Round(Model.AmountBefor, 2, MidpointRounding.AwayFromZero)
                                }

                            </td>









                        </tr>
                        @foreach (var item in Model.details.OrderBy(a => a.date))
                        {
                            Balance += item.Amount;
                            totalAmount += item.Amount;
                            <tr>
                                <td>

                                    @item.date.ToString("yyyy/MM/dd ")

                                </td>
                                @*<td>
                            @count


                        </td>*@
                                <td>
                                    @Html.DisplayFor(modelItem => item.DocumentNumber)
                                </td>
                                @if (Model.Account.ChartOfAccountings.Count != 0)
                                {
                                    <td>
                                        @Html.DisplayFor(modelItem => item.ChartAccount.Account_Name)
                                    </td>
                                }
                                <td>
                                    @Html.DisplayFor(modelItem => item.AccountName)
                                </td>


                                <td>
                                    @if (item.Amount < 0)
                                    {
                                        var a = "(" + Math.Round(item.Amount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                        <h>
                                            @a
                                        </h>
                                    }
                                    else
                                    {
                                        @Math.Round(item.Amount, 2, MidpointRounding.AwayFromZero)
                                    }

                                </td>

                                <td>
                                    @if (Balance < 0)
                                    {
                                        var taxvalue = "(" + Math.Round(Balance * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                        <h>
                                            @taxvalue
                                        </h>
                                    }
                                    else
                                    {
                                        @Math.Round(Balance, 2, MidpointRounding.AwayFromZero)
                                    }
                                </td>

                                <td>
                                    <div class="btn-group">

                                        <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                                        </button>
                                        <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">

                                            <a href="@Url.Action("getdetailForAutoGL","GLMaster", new { code = item.DocumentNumber })" class="dropdown-item">
                                                @Accountingsystem.Resources.GLMasterIndexAuto.OperationDetails
                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            if (item.Description != "" && item.Description != null)
                            {
                                <tr dir="rtl">
                                    <td style="border-top-style:hidden" colspan="7"><p style="text-align:justify">@item.Description</p></td>
                                </tr>

                            }


                        }
                        <tr>


                    </tbody>

                    <thead>
                        <tr style="text-align:right;">


                            <th style="text-align:center">الاجمالي<br />Total</th>
                            <th style="text-align:right"></th>
                            @if (Model.Account.ChartOfAccountings.Count != 0)
                            {
                                <th style="text-align:right"></th>
                            }
                            <th style="text-align:right"></th>
                            <th style="text-align:right"></th>
                            <th style="text-align:right">
                                @if (totalAmount@*+Model.AmountBefor*@ /**/
                                                                                                                                                                          /**/
                                                                                                                                                                          /**/
                                                                                                                                                                          /**/
                                                                                                                                                                          /**/
                                                                                                                                                                          /**/
                                                                                                                                                                          /**/
                                                                                                                                                                          /**/
                                                                                                                                                                          < 0)
                                            {
                                                var a = "(" + Math.Round((totalAmount + Model.AmountBefor) * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(totalAmount + Model.AmountBefor, 2, MidpointRounding.AwayFromZero)
                                            }
                            </th>
                            <th style="text-align:right"></th>

                        </tr>

                    </thead>

                </table>
                @{
                    decimal SUMAmount = 0;
                    decimal Sumbefore = 0;

                }
                <div class="text-center">
                    <h3 class="text-center">@Html.Label(Accountingsystem.Resources.validate.Summary)</h3>
                </div>
                @if (Model.Account.ChartOfAccountings.Count > 0)
                {



                    <div class="table-responsive mb-4 mt-4">
                        <table id="default-ordering" class="table table-hover non-hover" style="width:100%">
                            <thead>
                                <tr style="text-align:right;">



                                    <th>@Accountingsystem.Resources.GLMasterDetail.ConstraintNumber</th>
                                    <th>@Accountingsystem.Resources.ChartOfAccountingCreate.AccountName</th>
                                    <th>@Accountingsystem.Resources.validate.AmountbeforePeriod</th>
                                    <th>@Accountingsystem.Resources.validate.AmountOfPeriod</th>

                                    <th>@Accountingsystem.Resources.validate.Balance</th>

                                </tr>

                            </thead>
                            <tbody>
                                @foreach (var Account in Model.details.Select(a => a.ChartAccount.Account_Id).Distinct())
                                {
                                    var AccountStatistic = Accountingsystem.Models.ReportsNew.getStatisticOAccount(Account, Model.FromDate, Model.Todate);
                                    var totalaAmount = AccountStatistic.details.Select(a => a.Amount).Sum();
                                    SUMAmount += totalaAmount;
                                    Sumbefore += AccountStatistic.AmountBefor;


                                    <tr>

                                        <td>
                                            @AccountStatistic.Account.Account_Code
                                        </td>
                                        <td>
                                            @AccountStatistic.Account.Account_Name
                                        </td>
                                        <td>
                                            @if (AccountStatistic.AmountBefor < 0)
                                            {
                                                var a = "(" + Math.Round(AccountStatistic.AmountBefor * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(AccountStatistic.AmountBefor, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </td>

                                        <td>
                                            @if (totalaAmount < 0)
                                            {
                                                var a = "(" + Math.Round(totalaAmount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(totalaAmount, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </td>

                                        <td>
                                            @if (totalaAmount + AccountStatistic.AmountBefor < 0)
                                            {
                                                var a = "(" + Math.Round((totalaAmount + AccountStatistic.AmountBefor) * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(totalaAmount + AccountStatistic.AmountBefor, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </td>





                                    </tr>
                                }
                            </tbody>
                            <thead>
                                <tr>



                                    <th>
                                        @Accountingsystem.Resources.validate.TotalBalance


                                    </th>
                                    <th>



                                    </th>
                                    <th>
                                        @if (Sumbefore < 0)
                                        {
                                            var a = "(" + Math.Round(Sumbefore * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                            <h>
                                                @a
                                            </h>
                                        }
                                        else
                                        {
                                            @Math.Round(Sumbefore, 2, MidpointRounding.AwayFromZero)
                                        }

                                    </th>
                                    <th>
                                        @if (SUMAmount < 0)
                                        {
                                            var a = "(" + Math.Round(SUMAmount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                            <h>
                                                @a
                                            </h>
                                        }
                                        else
                                        {
                                            @Math.Round(SUMAmount, 2, MidpointRounding.AwayFromZero)
                                        }

                                    </th>
                                    <th>
                                        @if (SUMAmount + Sumbefore < 0)
                                        {
                                            var a = "(" + Math.Round((SUMAmount + Sumbefore) * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                            <h>
                                                @a
                                            </h>
                                        }
                                        else
                                        {
                                            @Math.Round(SUMAmount + Sumbefore, 2, MidpointRounding.AwayFromZero)
                                        }

                                    </th>



                                    <th></th>
                                </tr>
                            </thead>

                        </table>
                    </div>
                }
                else
                {



                    if (Model.Account.ChartOfAccountings.Count() > 0)
                    {
                        <div class="table-responsive mb-4 mt-4">
                            <table id="default-ordering" class="table table-hover non-hover" style="width:100%" dir="rtl">
                                <thead>
                                    <tr>



                                        <th>@Accountingsystem.Resources.GLMasterDetail.ConstraintNumber</th>
                                        <th>@Accountingsystem.Resources.ChartOfAccountingCreate.AccountName</th>
                                        <th>@Accountingsystem.Resources.validate.AmountbeforePeriod</th>
                                        <th>@Accountingsystem.Resources.validate.AmountOfPeriod</th>

                                        <th>@Accountingsystem.Resources.validate.Balance</th>

                                    </tr>

                                </thead>
                                <tbody>
                                    @{
                                        var AccountStatistic = Accountingsystem.Models.ReportsNew.getStatisticOAccount(Model.accountId, Model.FromDate, Model.Todate);
                                        var totalaAmount = AccountStatistic.details.Select(a => a.Amount).Sum();
                                        SUMAmount += totalaAmount;
                                        Sumbefore += AccountStatistic.AmountBefor;
                                    }

                                    <tr style="text-align:center;">

                                        <td>
                                            @AccountStatistic.Account.Account_Code
                                        </td>
                                        <td>
                                            @AccountStatistic.Account.Account_Name
                                        </td>
                                        <td>
                                            @if (AccountStatistic.AmountBefor < 0)
                                            {
                                                var a = "(" + Math.Round(AccountStatistic.AmountBefor * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(AccountStatistic.AmountBefor, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </td>

                                        <td>
                                            @if (totalaAmount < 0)
                                            {
                                                var a = "(" + Math.Round(totalaAmount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(totalaAmount, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </td>

                                        <td>
                                            @if (totalaAmount + AccountStatistic.AmountBefor < 0)
                                            {
                                                var a = "(" + Math.Round((totalaAmount + AccountStatistic.AmountBefor) * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(totalaAmount + AccountStatistic.AmountBefor, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </td>





                                    </tr>

                                </tbody>
                                <thead>
                                    <tr>



                                        <th>
                                            @Accountingsystem.Resources.validate.TotalBalance


                                        </th>
                                        <th>



                                        </th>
                                        <th>
                                            @if (Sumbefore < 0)
                                            {
                                                var a = "(" + Math.Round(Sumbefore * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(Sumbefore, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </th>
                                        <th>
                                            @if (SUMAmount < 0)
                                            {
                                                var a = "(" + Math.Round(SUMAmount * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(SUMAmount, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </th>
                                        <th>
                                            @if (SUMAmount + Sumbefore < 0)
                                            {
                                                var a = "(" + Math.Round((SUMAmount + Sumbefore) * -1, 2, MidpointRounding.AwayFromZero) + ")";
                                                <h>
                                                    @a
                                                </h>
                                            }
                                            else
                                            {
                                                @Math.Round(SUMAmount + Sumbefore, 2, MidpointRounding.AwayFromZero)
                                            }

                                        </th>



                                        <th></th>
                                    </tr>
                                </thead>

                            </table>
                        </div>
                    }
                }
            </div>
        </div>
        </div>

            <footer style="margin-top:50%;"></footer>
</body>
</html>



