@model Accountingsystem.ViewModel.ReportsNewVM.SalesClassffied


<link href="@Server.MapPath("~/Content/bootstrap.min.css")" rel="stylesheet" />


<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>

@{
    Layout = null;
    decimal totalamount = 0;
    decimal totarecall = 0;
    decimal totaldef = 0;
    var dateto = "الي" + Convert.ToDateTime(Model.EndDate).ToString("yyyy/MM/dd ");
    var datefrom = "من" + Convert.ToDateTime(Model.startDate).ToString("yyyy/MM/dd ");
}
<style>
    @@media screen {
        div.divFooter {
            display: none;
        }
    }

    @@media print {
        div.divFooter {
            position: fixed;
            bottom: 0;
        }

        @@media print {
            body {
                margin-top: 50px;
            }
        }
    }
</style>
<style type="text/css">
    table {
        page-break-inside: auto
    }

    td {
        font-size: 10px;
    }

    tr {
        page-break-inside: avoid;
        page-break-after: auto
    }

    thead {
        display: table-header-group
    }

    tfoot {
        display: table-footer-group
    }
</style>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>تقرير المبيعات</title>
</head>
<body>

    <br />
    <br />

    <hr />
    <div class="container">

        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            تقرير  المبيعات /  Sales Report

        </div>


        <div style="text-align:center;color:black;font-size:medium;margin-bottom:25px;">
            @datefrom      @dateto

        </div>


    </div>

    <br />
    <table class="table" style="text-align:right;direction:rtl;">
        <thead>
            <tr>
                <th style="text-align:center">رقم العميل<br />Customer NO</th>
                <th style="text-align:center">العميل<br />Customer</th>
                <th style="text-align:center" width="150px">رقم الفاتورة<br />Invoice NO</th>
                <th style="text-align:center" width="100px">التاريخ<br />Date</th>
                <th style="text-align:center">الكمية<br />QY</th>
                <th style="text-align:center">الفرع<br />Branch</th>
                <th style="text-align:center">طريقة الدفع<br />PaymentMethod</th>

                <th style="text-align:center">القيمة<br />Amount</th>
                <th style="text-align:center">الضريبة<br />Tax</th>
                <th style="text-align:center">اجمالي الفاتورة<br />TotalInvoice</th>
                <th style="text-align:center">قيمة التكلفة<br />Cost Amount</th>



            </tr>
        </thead>



        @foreach (var item in Model.classvmList)
        {

            <tr>

                <td>
                    @item.customerCode
                </td>
                <td>

                    @item.customerName
                    <br />
                    @item.CustomerTaxNumber
                </td>
                <td width="150px">

                    @item.InvoiceNo
                </td>
                <td width="100px">
                    @Convert.ToDateTime(item.InvoiceDate).ToString("yyyy/MM/dd ")
                    @*@item.InvoiceDate*@
                </td>
                @if (item.Quantity > 0)
                {
                    <td>
                        @Math.Round(item.Quantity, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td>
                        ( @Math.Round(item.Quantity * -1, 2, MidpointRounding.AwayFromZero) )
                    </td>
                }
                <td>
                    @item.BranchName
                </td>
                <td>
                    @item.paymentMethodName
                </td>
                @if (item.Quantity > 0)
                {
                    <td>
                        @Math.Round(item.totalAmount - item.totalTax, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td>
                        ( @Math.Round((item.totalAmount - item.totalTax) * -1, 2, MidpointRounding.AwayFromZero) )
                    </td>
                }
                @if (item.Quantity > 0)
                {
                    <td>
                        @Math.Round(item.totalTax, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td>
                        ( @Math.Round(item.totalTax * -1, 2, MidpointRounding.AwayFromZero) )
                    </td>
                }

                @if (item.Quantity > 0)
                {
                    <td>
                        @Math.Round(item.totalAmount, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td>
                        ( @Math.Round(item.totalAmount * -1, 2, MidpointRounding.AwayFromZero) )
                    </td>
                }

                @if (item.Quantity > 0)
                {
                    <td>
                        @Math.Round(item.totalCost, 2, MidpointRounding.AwayFromZero)
                    </td>
                }
                else
                {
                    <td>
                        ( @Math.Round(item.totalCost * -1, 2, MidpointRounding.AwayFromZero) )
                    </td>
                }




            </tr>

        }
        <tr>

            <td>
                الاجمالي
            </td>
            <td></td>
            <td width="150px"></td>
            <td width="100px"></td>

            <td>
                @Math.Round(Model.classvmList.Select(z => z.Quantity).Sum(), 2, MidpointRounding.AwayFromZero)
            </td>
            <td></td>
            <td></td>
            <td>

                @Math.Round(Model.classvmList.Select(z => z.totalAmount - z.totalTax).Sum(), 2, MidpointRounding.AwayFromZero)
            </td>
            <td>

                @Math.Round(Model.classvmList.Select(z => z.totalTax).Sum(), 2, MidpointRounding.AwayFromZero)
            </td>
            <td>

                @Math.Round(Model.classvmList.Select(z => z.totalAmount).Sum(), 2, MidpointRounding.AwayFromZero)
            </td>

            <td>

                @Math.Round(Model.classvmList.Select(z => z.totalCost).Sum(), 2, MidpointRounding.AwayFromZero)
            </td>
       

        </tr>
    </table>
    
</body>
</html>


