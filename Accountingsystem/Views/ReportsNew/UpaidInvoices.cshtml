        </header>
    </div>







    <div class="widget-content widget-content-area br-6">
        <div class="text-center">
            @ViewBag.Message
        </div>
        <div class="container">

            <div class="text-center">
                 @Accountingsystem.Resources.validate.UnpaidInvoiceReport
            </div>
            <br />
            <div class="text-center">
                @Model.customer.Customer_Name
            </div>
           


        </div>
        <div class="table-responsive mb-4 mt-4">
            <table id="default-ordering" class="table table-hover non-hover" style="width:100% ;">
                <thead>
                    <tr>


                        <th> @Accountingsystem.Resources.validate.Number</th>
                        <th style="text-align:center;"> @Accountingsystem.Resources.GLMasterIndex.ConstraintNumber</th>
                        <th style="text-align:center;"> @Accountingsystem.Resources.GLMasterIndex.ConstraintDate</th>
                        <th style="text-align:center;"> @Accountingsystem.Resources.InvoiceMasterAddNewInvoice.DueDate</th>
                        <th style="text-align:center;"> @Accountingsystem.Resources.InvoiceMasterAddNewInvoice.TotalAmount</th>
                        <th style="text-align:center;">@Accountingsystem.Resources.InvoiceMasterDetails.PaidValue</th>
                        <th style="text-align:center;">@Accountingsystem.Resources.InvoiceMasterDetails.RemainingValueOfInvoiceValue</th>



                        <th></th>
                    </tr>
                </thead>

                @{
                    decimal invoicevalue = 0;
                    var Count = 0;
                    decimal totalPaid = 0;
                    decimal totalRemaining = 0;

                }

                @foreach (var item in Model.details)
                {
                    invoicevalue += item.invoiceValue;
                    totalPaid += item.invoicePaid;
                    totalRemaining += item.Remaining;
                    Count++;
                <tr>

                    <td>
                        @Count
                    </td>
                    <td>
                        @item.serialNumber
                        @*@item.GLdate*@
                    </td>
                    <td>
                        @item.Date.ToString("yyyy/MM/dd ")
                    </td>
                    @if(item.DueDate!=null)
                    {
                    <td>
                        @item.DueDate.Value.ToString("yyyy/MM/dd ")
                    </td>
                    }
                    else
                    {
                    <td></td>
                    }
                    <td>


                        @Math.Round(item.invoiceValue, 2, MidpointRounding.AwayFromZero)
                    </td>


                    <td>


                        @Math.Round(item.invoicePaid, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>

                        @Math.Round(item.Remaining, 2, MidpointRounding.AwayFromZero)


                    </td>

                    <td>
                        <div class="btn-group">

                            <button type="button" class="btn btn-dark btn-sm dropdown-toggle dropdown-toggle-split" id="dropdownMenuReference2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" data-reference="parent">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-chevron-down"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            <div class="dropdown-menu" aria-labelledby="dropdownMenuReference2">

                                <a href="@Url.Action("getdetailForAutoGL","GLMaster", new { code = item.GLCode })" class="dropdown-item">
                                    @Accountingsystem.Resources.GLMasterIndexAuto.OperationDetails
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
                }
                <tr>

                    <td>
                       الاجمالي
                    </td>
                    <td>
                     
                    </td>
                    <td>
                     
                    </td>
                    <td>
                      
                    </td>
                    <td>


                        @Math.Round(invoicevalue,2,MidpointRounding.AwayFromZero)
                    </td>


                    <td>


                        @Math.Round(totalPaid, 2, MidpointRounding.AwayFromZero)
                    </td>
                    <td>

                        @Math.Round(totalRemaining, 2, MidpointRounding.AwayFromZero)


                    </td>

                    <td>
                   
                    </td>
                </tr>
            </table>

        </div>


    </div>
</div>
