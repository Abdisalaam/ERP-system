@model IEnumerable<Accountingsystem.Models.PartnerFileDetail>

@{
    ViewBag.Title = Accountingsystem.Resources.PartnerCreate.PartnerRelatedFiles;
}

<h2>@Accountingsystem.Resources.PartnerCreate.PartnerRelatedFiles</h2>

<p>
  
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.FileLength)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.ExpenseDetails.FileNumber)
        </th>
        <th>
            @Html.DisplayName(Accountingsystem.Resources.PartnerCreate.PartnerNumber)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.ContentLength)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FileName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PartnerPart_Id)
        </td>
        <td>
        <td>

            @Html.ActionLink(Accountingsystem.Resources.InvoiceMasterDetails.Download, "ReturnpartFile", new { fileId = item.Id })
        </td>
        </td>
    </tr>
}

</table>
