@model Accountingsystem.ViewModel.SubLedgerVM

@{
    HttpCookie cookie = Request.Cookies["Language"];
    ViewBag.Title = Accountingsystem.Resources.SubLedgerCreate.CreateCostCenter;
}

<head>
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                Layout = "~/Views/Shared/_LayoutLTR.cshtml";
               
                <link href="@Url.Content("~/ContentLTR/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

            }
            else
            {
                Layout = "~/Views/Shared/_Layout.cshtml";
               
                <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
                <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />
            }
        }
        else
        {
            Layout = "~/Views/Shared/_Layout.cshtml";
           
            <link href="@Url.Content("~/ContentRTL/assets/css/chosen.css")" rel="stylesheet" type="text/css" />
            <link href="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.css")" rel="stylesheet" type="text/css" />

        }
    }


</head>


@using (Html.BeginForm("Create", "SubLedger", FormMethod.Post, new { @id = "catchReceiptCreateForm", @class = "col-xl-12 col-lg-12 col-md-12 layout-spacing", role = "form", enctype = "multipart/form-data" }))
{

    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="col-xl-12 col-lg-12 col-md-12 layout-spacing">
        <form id="catchReceiptCreateForm">
            <div class="">
                <h3 class="text-center">@Html.Label(Accountingsystem.Resources.SubLedgerCreate.CreateCostCenter)</h3>
                <hr />
                <div class="row">
                    <div class="col-md-11 mx-auto">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubLedgerCreate.CostCenterName)
                                    <div class="input-group">
                                        @Html.EditorFor(model => model.SubLed_Name, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                        <div class="input-group-append">
                                            <div>
                                                <span class="form-control text-danger">*</span>
                                            </div>
                                        </div>
                                    </div>
                                    @Html.ValidationMessageFor(model => model.SubLed_Name, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.SubLedgerCreate.CostCenterDescription)
                                    @Html.EditorFor(model => model.SubLed_Desc, new { htmlAttributes = new { @class = "form-control mb-4" } })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    @Html.Label(Accountingsystem.Resources.OfferPriceMasterCreateOffer.CostCenter)
                                    <div class="input-group">
                                        @Html.DropDownListFor(model => model.ParentSubledger_Id, Model.SubledgerList, Accountingsystem.Resources.OfferPriceMasterCreateOffer.SelectCostCenter, htmlAttributes: new { @class = "form-control mb-4 Dropdownlist-select" })
                                    </div>
                                </div>
                            </div>

                          

                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <button type="submit" id="subBut" class="btn btn-block btn-outline-primary mb-lg-0">@Accountingsystem.Resources.SubLedgerCreate.Create<span id="createExpensesSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span></button>

                </div>
            </div>
            <div class="col-md-12">
                <div class="form-group">
                    <a id="backToListBtn" class="btn btn-block btn-outline-secondary mb-lg-0" href='@Url.Action("Index")'>
                        @Accountingsystem.Resources.SubLedgerCreate.BackToList<span id="backTolistBtnSpinner" style="display:none;" class="spinner-border text-dark mr-2 align-self-center loader-sm"></span>
                    </a>
                </div>
            </div>
        </form>
    </div>
}

@section Scripts {
    @{

        if (cookie != null && cookie.Value != null)
        {
            if (cookie.Value == "en")
            {
                <script src="@Url.Content("~/ContentLTR/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
            else
            {
                <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
                <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>


            }
        }
        else
        {
            <script src="@Url.Content("~/ContentRTL/assets/js/chosen.jquery.js")"></script>
            <script src="@Url.Content("~/ContentRTL/plugins/notification/snackbar/snackbar.min.js")"></script>



        }
    }

    <script type="text/javascript">
        $(document).ready(function () {

            if ($('.chosen-container').length > 0) {
                $('.chosen-container').on('touchstart', function (e) {
                    e.stopPropagation(); e.preventDefault();
                    $(this).trigger('mousedown');

                });
            }
            $("#backToListBtn").click(function (e) {
                $("#backTolistBtnSpinner").show();
            });
            $("#ParentSubledger_Id").chosen();
            $("#ParentSubledger_Id_chosen").addClass("form-control Dropdownlist-select");
            return false;
        });


    </script>
    <script>
        $('#SubLed_Name').on('input', function () {
            $("#SubLed_Name").removeClass("addRequiredFieldToInput");
        });
      
    </script>
    <script>

        $('#catchReceiptCreateForm').submit(function () {
            $('#subBut').prop('disabled', true);
            if ($('#SubLed_Name').val() == "" || $('#SubLed_Name').val() == null ) {
                $('#subBut').prop('disabled', false);
                $("#createExpensesSpinner").hide();       
                if ($('#SubLed_Name').val() == "" || $('#SubLed_Name').val() == null) {
                    Snackbar.show({
                        text: "@Accountingsystem.Resources.SubLedgerCreate.CostCenterNameRequiredMessage",
                        pos: 'top-center'
                    });
                    $("#SubLed_Name").addClass("addRequiredFieldToInput");
                    $('#SubLed_Name').trigger('focus');
                }
               
                event.preventDefault();
            }
            else {
                $("#createExpensesSpinner").show();
            }


        });

    </script>


}


