        <script src="@Url.Content("~/ContentLTR/assets/js/libs/jquery-3.1.1.min.js")"></script>
        <script src="@Url.Content("~/ContentLTR/bootstrap/js/popper.min.js")"></script>
        <script src="@Url.Content("~/ContentLTR/bootstrap/js/bootstrap.min.js")"></script>
        <script src="@Url.Content("~/ContentLTR/assets/js/authentication/form-2.js")"></script>
        <script src="@Url.Content("~/ContentLTR/plugins/notification/snackbar/snackbar.min.js")"></script>

    }
}

@Scripts.Render("~/bundles/jqueryval")
<script>
    document.getElementById('toggle-password').onclick = function () {
        var textObj = document.getElementById("Password");

        if (textObj.type == 'text') {

            textObj.type = "password";

        } else {
            textObj.type = "text";
        }
    };
</script>
<script>
    $(document).ready(function () {
        $("#mySpinner").hide();

    });

    $("#myLoginForm").submit(function (e) {
        var _email = $("#Email").val();
        var _password = $("#Password").val();
        if (_email == "" || _password == "" || !validateEmail(_email)) {
              if (_email == "") {
            $("#Email").addClass("addRequiredFieldToInput");
           
        }
        if (_password == "") {
            $("#Password").addClass("addRequiredFieldToInput");
           
        }
        if (!validateEmail(_email)) {           
            $("#Email").addClass("addRequiredFieldToInput");
            Snackbar.show({
                text: "@Accountingsystem.Resources.AccountRegister.EmailStructureRequiredMSG",
                pos: 'top-center'
            });
            
            }
            event.preventDefault();
        }
        else {
            $("#mySpinner").show();
        }
           
    });
    $('#Email').on('input', function () {
        $("#Email").removeClass("addRequiredFieldToInput");
    });
    $('#Password').on('input', function () {
        $("#Password").removeClass("addRequiredFieldToInput");
    });
    function validateEmail($email) {

        var emailReg = /^([\w-\.]+@@([\w-]+\.)+[\w-]{2,4})?$/;

        return emailReg.test($email);
    }
</script>
@section Scripts {

    <!-- BEGIN GLOBAL MANDATORY SCRIPTS -->
    <!-- END GLOBAL MANDATORY SCRIPTS -->


