@Scripts.Render("~/bundles/jqueryval")
<script>
    document.getElementById('toggle-password').onclick = function () {
        var textObj = document.getElementById("Password");

        if (textObj.type == 'text') {

            textObj.type = "password";

        } else {
            textObj.type = "text";
        }
    };
    document.getElementById('toggle-password2').onclick = function () {
        var textObj = document.getElementById("ConfirmPassword");

        if (textObj.type == 'text') {

            textObj.type = "password";

        } else {
            textObj.type = "text";
        }
    };
</script>
<script>
    $(document).ready(function () {
        $("#mySpinner").hide();

    });

    $("#myResetForm").submit(function (e) {     
        var _email = $("#Email").val();
        var _password = $("#Password").val();
        var _confirmPassword = $("#ConfirmPassword").val();
        if (_email == "") {
            $("#Email").addClass("addRequiredFieldToInput");
             Snackbar.show({
                text: "@Accountingsystem.Resources.AccountRegister.EmailReqiuredMSG",
                pos: 'top-center'
            });
            event.preventDefault();
        }
        if (_password == "") {
            $("#Password").addClass("addRequiredFieldToInput");
              Snackbar.show({
                text: "@Accountingsystem.Resources.AccountRegister.PasswordRequiredMSG",
                pos: 'top-center'
            });
            event.preventDefault();
        }
        if (_confirmPassword == "") {
            $("#ConfirmPassword").addClass("addRequiredFieldToInput");
             Snackbar.show({
                text: "@Accountingsystem.Resources.AccountRegister.ConfirmPasswordRequiredMSG",
                pos: 'top-center'
            });
            event.preventDefault();
        }
        if (_confirmPassword != _password ) {
            $("#Password").addClass("addRequiredFieldToInput");
            $("#ConfirmPassword").addClass("addRequiredFieldToInput");
             Snackbar.show({
                text: "@Accountingsystem.Resources.AccountRegister.PasswordAndConfirmAreNotEqual",
                pos: 'top-center'
            });
            event.preventDefault();
        }
        if (!validateEmail(_email) || _email == "") {
            $("#Email").addClass("addRequiredFieldToInput");
            Snackbar.show({
                text: "@Accountingsystem.Resources.AccountRegister.EmailStructureRequiredMSG",
                pos: 'top-center'
            });
            event.preventDefault();
        }
       
    });
    $('#Email').on('input', function () {
        $("#Email").removeClass("addRequiredFieldToInput");
    });
    $('#Password').on('input', function () {
        $("#Password").removeClass("addRequiredFieldToInput");
    });
    $('#ConfirmPassword').on('input', function () {
        $("#ConfirmPassword").removeClass("addRequiredFieldToInput");
    });
    function validateEmail($email) {

        var emailReg = /^([\w-\.]+@@([\w-]+\.)+[\w-]{2,4})?$/;

        return emailReg.test($email);
    }
</script>
@section Scripts {

